      command {
        instruction: "Switch WebSocketServer to noServer with an explicit /api/live-voice upgrade handler and set hmr: false in createViteServer middlewareMode options in server.ts"
        is_edit: true
        file {
          absolute_uri: "file:///server.ts"
        }
        use_fast_apply: true
        replacement_chunks {
          target_content: "  // Real-Time Gemini 3.8 Live API WebSocket Bridge\n  const wss = new WebSocketServer({ server, path: \'/api/live-voice\' });"
          replacement_content: "  // Real-Time Gemini 3.8 Live API WebSocket Bridge\n  const wss = new WebSocketServer({ noServer: true });\n\n  server.on(\'upgrade\', (request, socket, head) => {\n    const reqUrl = new URL(request.url || \'/\', `http://${request.headers.host || \'localhost\'}`);\n    if (reqUrl.pathname === \'/api/live-voice\') {\n      wss.handleUpgrade(request, socket, head, (ws) => {\n        wss.emit(\'connection\', ws, request);\n      });\n    } else {\n      socket.destroy();\n    }\n  });"
          start_line: 1158
          end_line: 1163
        }
        replacement_chunks {
          target_content: "    const vite = await createViteServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });"
          replacement_content: "    const vite = await createViteServer({\n      server: { middlewareMode: true, hmr: false },\n      appType: \'spa\',\n    });"
          start_line: 1332
          end_line: 1338
        }
      }
