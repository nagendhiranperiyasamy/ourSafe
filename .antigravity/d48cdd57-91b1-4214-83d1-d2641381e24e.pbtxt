          target_content: "          <p className=\"text-xs text-[#4B5844] leading-relaxed\">\n            Recordings require explicit browser microphone/camera permission, stay stored privately on your device (IndexedDB), and can be played back, shared as an evidence summary with guardians, or permanently deleted anytime from Evidence History.\n          </p>"
          replacement_content: "          <p className=\"text-xs text-[#4B5844] leading-relaxed\">\n            Starts <strong>automatically without confirmation</strong> as soon as Threat Mode activates (Video + Audio, with automatic Audio fallback if camera is unavailable). All evidence saves privately to your device (IndexedDB) and can be reviewed, shared, or deleted in Evidence History.\n          </p>"
