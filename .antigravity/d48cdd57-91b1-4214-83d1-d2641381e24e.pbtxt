      arguments_json: "{\"Description\":\"Add Android TextToSpeech spoken greeting and House Safe phonetic match in OurSafeBackgroundShieldService.kt\", \"Instruction\":\"Import TextToSpeech, initialize TTS in onCreate, clean up in stopShieldInternal, expand wake-word matching to include House Safe / Tamil forms, and speak \\\"OurSafe app is here, how can I help you?\\\" when waking.\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":36, \"ReplacementContent\":\"import android.speech.RecognitionListener\\nimport android.speech.RecognizerIntent\\nimport android.speech.SpeechRecognizer\\nimport android.speech.tts.TextToSpeech\\nimport android.telephony.SmsManager\", \"StartLine\":29, \"TargetContent\":\"import android.speech.RecognitionListener\\nimport android.speech.RecognizerIntent\\nimport android.speech.SpeechRecognizer\\nimport android.telephony.SmsManager\"}, {\"AllowMultiple\":false, \"EndLine\":96, \"ReplacementContent\":\"    private var windowManager: WindowManager? = null\\n    private var overlayView: View? = null\\n    private var speechRecognizer: SpeechRecognizer? = null\\n    private var textToSpeech: TextToSpeech? = null\\n    private val mainHandler = Handler(Looper.getMainLooper())\", \"StartLine\":89, \"TargetContent\":\"    private var windowManager: WindowManager? = null\\n    private var overlayView: View? = null\\n    private var speechRecognizer: SpeechRecognizer? = null\\n    private val mainHandler = Handler(Looper.getMainLooper())\"}, {\"AllowMultiple\":false, \"EndLine\":118, \"ReplacementContent\":\"    override fun onCreate() {\\n        super.onCreate()\\n        sensorManager = getSystemService(Context.SENSOR_SERVICE) as SensorManager\\n        accelerometer = sensorManager.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)\\n        windowManager = getSystemService(Context.WINDOW_SERVICE) as WindowManager\\n        textToSpeech = TextToSpeech(this) { status ->\\n            if (status == TextToSpeech.SUCCESS) {\\n                textToSpeech?.language = Locale(\\\"en\\\", \\\"IN\\\")\\n            }\\n        }\\n        createNotificationChannel()\\n    }\", \"StartLine\":109, \"TargetContent\":\"    override fun onCreate() {\\n        super.onCreate()\\n        sensorManager = getSystemService(Context.SENSOR_SERVICE) as SensorManager\\n        accelerometer = sensorManager.getDefaultSensor(Sensor.TYPE_ACCELEROMETER)\\n        windowManager = getSystemService(Context.WINDOW_SERVICE) as WindowManager\\n        createNotificationChannel()\\n    }\"}, {\"AllowMultiple\":false, \"EndLine\":162, \"ReplacementContent\":\"        stopSecretVoiceCodeListener()\\n        removeOverlayShield()\\n        try {\\n            textToSpeech?.stop()\\n            textToSpeech?.shutdown()\\n        } catch (_: Exception) {}\\n        textToSpeech = null\\n        try {\\n            wakeLock?.let { if (it.isHeld) it.release() }\\n        } catch (_: Exception) {}\\n        wakeLock = null\\n    }\", \"StartLine\":153, \"TargetContent\":\"        stopSecretVoiceCodeListener()\\n        removeOverlayShield()\\n        try {\\n            wakeLock?.let { if (it.isHeld) it.release() }\\n        } catch (_: Exception) {}\\n        wakeLock = null\\n    }\"}, {\"AllowMultiple\":false, \"EndLine\":334, \"ReplacementContent\":\"            if (wakeWordEnabled && (\\n                normalized.contains(wakeWord) ||\\n                normalized.contains(\\\"our safe\\\") ||\\n                normalized.contains(\\\"house safe\\\") ||\\n                normalized.contains(\\\"hour safe\\\") ||\\n                normalized.contains(\\\"\340\256\271\340\256\265\340\257\201\340\256\270\340\257\215 \340\256\232\340\257\207\340\256\203\340\256\252\340\257\215\\\") ||\\n                normalized.contains(\\\"\340\256\205\340\256\265\340\256\260\340\257\215 \340\256\232\340\257\207\340\256\203\340\256\252\340\257\215\\\") ||\\n                compactSpoken.contains(compactWake) ||\\n                compactSpoken.contains(\\\"oursafe\\\") ||\\n                compactSpoken.contains(\\\"housesafe\\\")\\n            )) {\\n                launchOurSafeVoiceAssistant(spoken)\\n                break\\n            }\\n        }\\n    }\\n\\n    private fun launchOurSafeVoiceAssistant(spoken: String) {\\n        try {\\n            textToSpeech?.speak(\\n                \\\"OurSafe app is here, how can I help you?\\\",\\n                TextToSpeech.QUEUE_FLUSH,\\n                null,\\n                \\\"oursafe_wake_greeting\\\"\\n            )\\n        } catch (_: Exception) {}\\n\\n        val launchIntent = packageManager.getLaunchIntentForPackage(packageName)?.apply {\\n            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)\\n            putExtra(\\\"oursafe_voice_wake\\\", true)\\n            putExtra(\\\"oursafe_spoken_command\\\", spoken)\\n        }\\n        if (launchIntent != null) {\\n            try {\\n                startActivity(launchIntent)\\n            } catch (_: Exception) {}\\n        }\\n    }\", \"StartLine\":309, \"TargetContent\":\"            if (wakeWordEnabled && (\\n                normalized.contains(wakeWord) ||\\n                normalized.contains(\\\"our safe\\\") ||\\n                compactSpoken.contains(compactWake) ||\\n                compactSpoken.contains(\\\"oursafe\\\")\\n            )) {\\n                launchOurSafeVoiceAssistant(spoken)\\n                break\\n            }\\n        }\\n    }\\n\\n    private fun launchOurSafeVoiceAssistant(spoken: String) {\\n        val launchIntent = packageManager.getLaunchIntentForPackage(packageName)?.apply {\\n            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)\\n            putExtra(\\\"oursafe_voice_wake\\\", true)\\n            putExtra(\\\"oursafe_spoken_command\\\", spoken)\\n        }\\n        if (launchIntent != null) {\\n            try {\\n                startActivity(launchIntent)\\n            } catch (_: Exception) {}\\n        }\\n    }\"}], \"TargetFile\":\"/android-native/OurSafeBackgroundShieldService.kt\", \"toolAction\":\"Updating Android shield with TTS greeting\", \"toolSummary\":\"Update Android shield TTS greeting\"}"
