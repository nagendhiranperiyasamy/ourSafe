    combined_output {
      full: "Generated 4 valid PNG PWA icons"
    }
    command_line: "node -e \'\nconst fs = require(\"fs\");\nconst zlib = require(\"zlib\");\n\nfunction crc32(buf) {\n  let c = -1;\n  for (let i = 0; i < buf.length; i++) {\n    c ^= buf[i];\n    for (let k = 0; k < 8; k++) c = (c >>> 1) ^ (0xedb88320 & -(c & 1));\n  }\n  return (c ^ -1) >>> 0;\n}\n\nfunction chunk(type, data) {\n  const len = Buffer.alloc(4);\n  len.writeUInt32BE(data.length, 0);\n  const t = Buffer.from(type);\n  const crc = Buffer.alloc(4);\n  crc.writeUInt32BE(crc32(Buffer.concat([t, data])), 0);\n  return Buffer.concat([len, t, data, crc]);\n}\n\nfunction makeIcon(size, maskable, outPath) {\n  const raw = Buffer.alloc((size * 4 + 1) * size);\n  const cx = size / 2;\n  const cy = size / 2;\n  const scale = maskable ? 0.68 : 0.84;\n\n  for (let y = 0; y < size; y++) {\n    const rowStart = y * (size * 4 + 1);\n    raw[rowStart] = 0;\n    for (let x = 0; x < size; x++) {\n      const idx = rowStart + 1 + x * 4;\n      // Normalized coords in [-1, 1]\n      const nx = ((x - cx) / (size / 2)) / scale;\n      const ny = ((y - cy) / (size / 2)) / scale;\n      // Default deep olive background #2F4526\n      let r = 47, g = 69, b = 38, a = 255;\n\n      // Soft botanical ring\n      const dist = Math.hypot(nx, ny);\n      if (dist < 0.92 && dist > 0.82) {\n        r = 82; g = 112; b = 68;\n      }\n\n      // Shield silhouette inside safe zone\n      const inShieldY = ny >= -0.72 && ny <= 0.78;\n      const maxX = ny < 0.05\n        ? 0.62 - Math.max(0, (-0.35 - ny) * 0.55)\n        : 0.62 * Math.max(0, 1 - Math.pow((ny - 0.05) / 0.76, 1.45));\n      const inOuterShield = inShieldY && Math.abs(nx) <= maxX;\n      const inInnerShield =\n        ny >= -0.52 && ny <= 0.58 &&\n        Math.abs(nx) <= (ny < 0.05\n          ? 0.44 - Math.max(0, (-0.25 - ny) * 0.45)\n          : 0.44 * Math.max(0, 1 - Math.pow((ny - 0.05) / 0.56, 1.45)));\n\n      if (inOuterShield) {\n        r = 252; g = 253; b = 249; // #FCFDF9\n      }\n      if (inInnerShield) {\n        r = 47; g = 69; b = 38; // #2F4526\n      }\n\n      // Checkmark inside inner shield\n      const d1 = Math.abs((ny - 0.14) - (nx + 0.04)) / Math.SQRT2;\n      const seg1 = nx >= -0.22 && nx <= -0.02 && d1 < 0.075;\n      const d2 = Math.abs((ny - 0.14) + (nx + 0.04)) / Math.SQRT2;\n      const seg2 = nx >= -0.04 && nx <= 0.25 && d2 < 0.075;\n      if (seg1 || seg2) {\n        r = 205; g = 215; b = 193; // #CDD7C1\n      }\n\n      raw[idx] = r; raw[idx + 1] = g; raw[idx + 2] = b; raw[idx + 3] = a;\n    }\n  }\n\n  const ihdr = Buffer.alloc(13);\n  ihdr.writeUInt32BE(size, 0);\n  ihdr.writeUInt32BE(size, 4);\n  ihdr[8] = 8; ihdr[9] = 6; ihdr[10] = 0; ihdr[11] = 0; ihdr[12] = 0;\n  const sig = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]);\n  const png = Buffer.concat([\n    sig,\n    chunk(\"IHDR\", ihdr),\n    chunk(\"IDAT\", zlib.deflateSync(raw)),\n    chunk(\"IEND\", Buffer.alloc(0)),\n  ]);\n  fs.writeFileSync(outPath, png);\n}\n\nmakeIcon(192, false, \"public/pwa-192x192.png\");\nmakeIcon(512, false, \"public/pwa-512x512.png\");\nmakeIcon(512, true, \"public/pwa-maskable-512x512.png\");\nmakeIcon(180, false, \"public/apple-touch-icon.png\");\nconsole.log(\"Generated 4 valid PNG PWA icons\");\n\'"
    proposed_command_line: "node -e \'\nconst fs = require(\"fs\");\nconst zlib = require(\"zlib\");\n\nfunction crc32(buf) {\n  let c = -1;\n  for (let i = 0; i < buf.length; i++) {\n    c ^= buf[i];\n    for (let k = 0; k < 8; k++) c = (c >>> 1) ^ (0xedb88320 & -(c & 1));\n  }\n  return (c ^ -1) >>> 0;\n}\n\nfunction chunk(type, data) {\n  const len = Buffer.alloc(4);\n  len.writeUInt32BE(data.length, 0);\n  const t = Buffer.from(type);\n  const crc = Buffer.alloc(4);\n  crc.writeUInt32BE(crc32(Buffer.concat([t, data])), 0);\n  return Buffer.concat([len, t, data, crc]);\n}\n\nfunction makeIcon(size, maskable, outPath) {\n  const raw = Buffer.alloc((size * 4 + 1) * size);\n  const cx = size / 2;\n  const cy = size / 2;\n  const scale = maskable ? 0.68 : 0.84;\n\n  for (let y = 0; y < size; y++) {\n    const rowStart = y * (size * 4 + 1);\n    raw[rowStart] = 0;\n    for (let x = 0; x < size; x++) {\n      const idx = rowStart + 1 + x * 4;\n      // Normalized coords in [-1, 1]\n      const nx = ((x - cx) / (size / 2)) / scale;\n      const ny = ((y - cy) / (size / 2)) / scale;\n      // Default deep olive background #2F4526\n      let r = 47, g = 69, b = 38, a = 255;\n\n      // Soft botanical ring\n      const dist = Math.hypot(nx, ny);\n      if (dist < 0.92 && dist > 0.82) {\n        r = 82; g = 112; b = 68;\n      }\n\n      // Shield silhouette inside safe zone\n      const inShieldY = ny >= -0.72 && ny <= 0.78;\n      const maxX = ny < 0.05\n        ? 0.62 - Math.max(0, (-0.35 - ny) * 0.55)\n        : 0.62 * Math.max(0, 1 - Math.pow((ny - 0.05) / 0.76, 1.45));\n      const inOuterShield = inShieldY && Math.abs(nx) <= maxX;\n      const inInnerShield =\n        ny >= -0.52 && ny <= 0.58 &&\n        Math.abs(nx) <= (ny < 0.05\n          ? 0.44 - Math.max(0, (-0.25 - ny) * 0.45)\n          : 0.44 * Math.max(0, 1 - Math.pow((ny - 0.05) / 0.56, 1.45)));\n\n      if (inOuterShield) {\n        r = 252; g = 253; b = 249; // #FCFDF9\n      }\n      if (inInnerShield) {\n        r = 47; g = 69; b = 38; // #2F4526\n      }\n\n      // Checkmark inside inner shield\n      const d1 = Math.abs((ny - 0.14) - (nx + 0.04)) / Math.SQRT2;\n      const seg1 = nx >= -0.22 && nx <= -0.02 && d1 < 0.075;\n      const d2 = Math.abs((ny - 0.14) + (nx + 0.04)) / Math.SQRT2;\n      const seg2 = nx >= -0.04 && nx <= 0.25 && d2 < 0.075;\n      if (seg1 || seg2) {\n        r = 205; g = 215; b = 193; // #CDD7C1\n      }\n\n      raw[idx] = r; raw[idx + 1] = g; raw[idx + 2] = b; raw[idx + 3] = a;\n    }\n  }\n\n  const ihdr = Buffer.alloc(13);\n  ihdr.writeUInt32BE(size, 0);\n  ihdr.writeUInt32BE(size, 4);\n  ihdr[8] = 8; ihdr[9] = 6; ihdr[10] = 0; ihdr[11] = 0; ihdr[12] = 0;\n  const sig = Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]);\n  const png = Buffer.concat([\n    sig,\n    chunk(\"IHDR\", ihdr),\n    chunk(\"IDAT\", zlib.deflateSync(raw)),\n    chunk(\"IEND\", Buffer.alloc(0)),\n  ]);\n  fs.writeFileSync(outPath, png);\n}\n\nmakeIcon(192, false, \"public/pwa-192x192.png\");\nmakeIcon(512, false, \"public/pwa-512x512.png\");\nmakeIcon(512, true, \"public/pwa-maskable-512x512.png\");\nmakeIcon(180, false, \"public/apple-touch-icon.png\");\nconsole.log(\"Generated 4 valid PNG PWA icons\");\n\'"
