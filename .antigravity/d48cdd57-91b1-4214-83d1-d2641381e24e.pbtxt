  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  AlertTriangle,\n  ArrowRight,\n  CheckCircle2,\n  Compass,\n  History,\n  MapPin,\n  Mic,\n  Pencil,\n  Phone,\n  ShieldAlert,\n  ShieldCheck,\n  Star,\n  Users,\n} from \'lucide-react\';\nimport { AppPage, TeamInfoConfig, UserReviewItem } from \'../../types/safety\';\nimport {\n  formatTimeShort,\n  getReviews,\n  getTeamInfo,\n  saveReviews,\n  saveTeamInfo,\n} from \'../../utils/storage\';\n\ninterface HomeAboutPageProps {\n  userName: string;\n  onNavigatePage: (page: AppPage) => void;\n  onOpenContacts: () => void;\n}\n\nconst EMERGENCY_HELP_NUMBERS = [\n  {\n    number: \'112\',\n    label: \'Emergency Response\',\n    detail: \'All-in-one national emergency helpline (Police, Fire, Medical)\',\n  },\n  {\n    number: \'181\',\n    label: \'Women Helpline\',\n    detail: \'24/7 support and emergency intervention for women in distress\',\n  },\n  {\n    number: \'100\',\n    label: \'Police\',\n    detail: \'Direct police control room dispatch\',\n  },\n  {\n    number: \'108\',\n    label: \'Ambulance\',\n    detail: \'Emergency medical response and ambulance service\',\n  },\n  {\n    number: \'1098\',\n    label: \'Child Helpline\',\n    detail: \'24/7 emergency assistance for children in need of care and protection\',\n  },\n];\n\nconst FEATURE_OVERVIEW: Array<{\n  title: string;\n  description: string;\n  page: AppPage;\n  icon: React.ReactNode;\n}> = [\n  {\n    title: \'AI Voice App Controller\',\n    description:\n      \'Speak naturally in real time to open SOS, activate Threat Mode, call guardians, share live location, or locate nearby police stations.\',\n    page: \'assistant\',\n    icon: <Mic className=\"w-5 h-5\" />,\n  },\n  {\n    title: \'SOS Emergency Workflow\',\n    description:\n      \'One-tap or voice-triggered emergency interface with guardian calling, location alert dispatch, nearest police options, and delivery status tracking.\',\n    page: \'sos\',\n    icon: <ShieldAlert className=\"w-5 h-5\" />,\n  },\n  {\n    title: \'Intelligent Threat Mode\',\n    description:\n      \'Discreet protection with audio/video evidence recording, instant guardian notifications, and connectivity/battery continuity snapshots.\',\n    page: \'threat\',\n    icon: <AlertTriangle className=\"w-5 h-5\" />,\n  },\n  {\n    title: \'Travel Mode & Safety Check-In\',\n    description:\n      \'Log your journey route, set timed safety check-ins that alert guardians if missed, and trigger a realistic Fake Call when needed.\',\n    page: \'travel\',\n    icon: <Compass className=\"w-5 h-5\" />,\n  },\n  {\n    title: \'Nearby Police & Safe Places\',\n    description:\n      \'Locate verified nearby police stations and public restrooms using live browser GPS coordinates without fabricated mock pins.\',\n    page: \'nearby\',\n    icon: <MapPin className=\"w-5 h-5\" />,\n  },\n  {\n    title: \'Emergency Evidence History\',\n    description:\n      \'Access-protected timeline storing Threat Mode activations, SOS alerts, GPS snapshots, connectivity events, and local recordings.\',\n    page: \'history\',\n    icon: <History className=\"w-5 h-5\" />,\n  },\n];\n\nconst WORKFLOW_STEPS = [\n  {\n    step: \'01\',\n    title: \'Register & Verify Profile\',\n    detail:\n      \'Create your local safety profile with personal details and primary guardian contact information.\',\n  },\n  {\n    step: \'02\',\n    title: \'Build Your Trusted Guardian Network\',\n    detail:\n      \'Add multiple family members or close friends to your SOS contacts list\342\200\224cached locally so numbers stay reachable offline.\',\n  },\n  {\n    step: \'03\',\n    title: \'Activate Travel Mode or Safety Check-In\',\n    detail:\n      \'Before commuting or walking alone, record your destination, assign a guardian, and set an automatic check-in countdown.\',\n  },\n  {\n    step: \'04\',\n    title: \'Engage Threat Mode Early\',\n    detail:\n      \'If a situation feels unsafe, activate Threat Mode to notify guardians, record audio/video evidence locally, and preserve last-known GPS snapshots.\',\n  },\n  {\n    step: \'05\',\n    title: \'Trigger SOS by Voice or Tap\',\n    detail:\n      \'Say \"Open SOS\" to the AI Voice Assistant or press SOS directly to initiate guardian alerts, dial trusted contacts, and reach police quickly.\',\n  },\n];\n\nexport const HomeAboutPage: React.FC<HomeAboutPageProps> = ({\n  userName,\n  onNavigatePage,\n  onOpenContacts,\n}) => {\n  const [reviews, setReviews] = useState<UserReviewItem[]>(() => getReviews());\n  const [reviewAuthor, setReviewAuthor] = useState(userName);\n  const [reviewRole, setReviewRole] = useState(\'\');\n  const [reviewRating, setReviewRating] = useState(5);\n  const [reviewComment, setReviewComment] = useState(\'\');\n  const [reviewFeedback, setReviewFeedback] = useState(\'\');\n\n  const [teamInfo, setTeamInfo] = useState<TeamInfoConfig>(() => getTeamInfo());\n  const [editingTeam, setEditingTeam] = useState(false);\n  const [teamDraft, setTeamDraft] = useState<TeamInfoConfig>(teamInfo);\n\n  const averageRating =\n    reviews.length > 0\n      ? (\n          reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length\n        ).toFixed(1)\n      : \'0.0\';\n\n  const handleReviewSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!reviewAuthor.trim() || !reviewComment.trim()) return;\n    const nextItem: UserReviewItem = {\n      id: `user-rev-${Date.now()}`,\n      author: reviewAuthor.trim(),\n      role: reviewRole.trim() || \'App User Feedback\',\n      rating: reviewRating,\n      comment: reviewComment.trim(),\n      createdAt: new Date().toISOString(),\n      isSample: false,\n    };\n    const next = [nextItem, ...reviews];\n    setReviews(next);\n    saveReviews(next);\n    setReviewComment(\'\');\n    setReviewRole(\'\');\n    setReviewFeedback(\'Thank you. Your feedback has been saved locally.\');\n    window.setTimeout(() => setReviewFeedback(\'\'), 3500);\n  };\n\n  const handleSaveTeam = (e: React.FormEvent) => {\n    e.preventDefault();\n    setTeamInfo(teamDraft);\n    saveTeamInfo(teamDraft);\n    setEditingTeam(false);\n  };\n\n  return (\n    <div className=\"space-y-8\">\n      {/* Section 1: About the Application Hero */}\n      <section className=\"bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-8 lg:p-10 shadow-sm shadow-violet-950/[0.02]\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\">\n          <div className=\"lg:col-span-7 space-y-4\">\n            <p className=\"text-xs font-semibold text-violet-700\">\n              About AuraSafe \302\267 Prevention, Protection &amp; Rapid Response\n            </p>\n            <h1 className=\"text-3xl sm:text-4xl font-bold text-[#1A132B] leading-[1.15] tracking-tight\">\n              Intelligent personal safety designed around calm, fast action.\n            </h1>\n            <p className=\"text-sm sm:text-base text-[#4A4063] leading-relaxed\">\n              AuraSafe is an AI-powered women&apos;s safety companion built to reduce friction during stressful moments. Whether you are commuting late, walking through an unfamiliar neighborhood, or facing an urgent threat, AuraSafe keeps voice-activated controls, trusted guardians, and emergency evidence tools immediately accessible.\n            </p>\n\n            <div className=\"pt-2 flex flex-wrap items-center gap-3\">\n              <button\n                type=\"button\"\n                onClick={() => onNavigatePage(\'assistant\')}\n                className=\"min-h-[46px] px-5 py-2.5 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold inline-flex items-center gap-2 transition-colors whitespace-nowrap cursor-pointer\"\n              >\n                <Mic className=\"w-4 h-4\" />\n                <span>Open AI Voice Controller</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => onNavigatePage(\'sos\')}\n                className=\"min-h-[46px] px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-semibold inline-flex items-center gap-2 transition-colors whitespace-nowrap cursor-pointer\"\n              >\n                <ShieldAlert className=\"w-4 h-4\" />\n                <span>Open SOS Emergency</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={onOpenContacts}\n                className=\"min-h-[46px] px-5 py-2.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-sm font-semibold inline-flex items-center gap-2 transition-colors whitespace-nowrap cursor-pointer\"\n              >\n                <Users className=\"w-4 h-4 text-violet-700\" />\n                <span>Trusted Guardians</span>\n              </button>\n            </div>\n          </div>\n\n          {/* Problems Solved & Safety Pillars */}\n          <div className=\"lg:col-span-5 rounded-2xl bg-[#FAF8FF] border border-violet-200/80 p-5 sm:p-6 space-y-4\">\n            <h2 className=\"text-base font-bold text-[#1A132B]\">\n              Problems AuraSafe Solves\n            </h2>\n            <ul className=\"space-y-3 text-sm text-[#4A4063]\">\n              <li className=\"space-y-0.5\">\n                <p className=\"font-semibold text-[#1A132B]\">\n                  1. Prevention before escalation\n                </p>\n                <p className=\"text-xs leading-relaxed\">\n                  Travel Mode, timed Safety Check-Ins, and the discreet Fake Call tool help women exit uncomfortable situations before they turn dangerous.\n                </p>\n              </li>\n              <li className=\"space-y-0.5 pt-2 border-t border-violet-100\">\n                <p className=\"font-semibold text-[#1A132B]\">\n                  2. Hands-free protection under stress\n                </p>\n                <p className=\"text-xs leading-relaxed\">\n                  Navigating small menus during panic is difficult. Real-time AI voice commands let users trigger SOS, Threat Mode, or live location sharing by speaking naturally.\n                </p>\n              </li>\n              <li className=\"space-y-0.5 pt-2 border-t border-violet-100\">\n                <p className=\"font-semibold text-[#1A132B]\">\n                  3. Preserved response &amp; evidence timeline\n                </p>\n                <p className=\"text-xs leading-relaxed\">\n                  Threat Mode captures local audio/video recordings, tracks connectivity and last known GPS coordinates, and preserves an organized timeline for guardians.\n                </p>\n              </li>\n            </ul>\n          </div>\n        </div>\n      </section>\n\n      {/* Section 2: Application Features Overview */}\n      <section className=\"space-y-4\">\n        <div className=\"flex flex-wrap items-end justify-between gap-3\">\n          <div>\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Dedicated Safety Modules\n            </p>\n            <h2 className=\"mt-1 text-2xl font-bold text-[#1A132B]\">\n              Application Features\n            </h2>\n          </div>\n          <p className=\"text-xs text-[#6B6182]\">\n            Select any module to open its dedicated page\n          </p>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n          {FEATURE_OVERVIEW.map((feat) => (\n            <button\n              key={feat.title}\n              type=\"button\"\n              onClick={() => onNavigatePage(feat.page)}\n              className=\"group text-left bg-white hover:bg-[#FAF8FF] rounded-2xl border border-violet-200/80 p-5 flex flex-col justify-between gap-4 transition-colors cursor-pointer\"\n            >\n              <div className=\"space-y-3\">\n                <div className=\"w-10 h-10 rounded-xl bg-[#F4F0FF] text-violet-700 flex items-center justify-center\">\n                  {feat.icon}\n                </div>\n                <div>\n                  <h3 className=\"text-base font-bold text-[#1A132B] group-hover:text-violet-800 transition-colors\">\n                    {feat.title}\n                  </h3>\n                  <p className=\"mt-1.5 text-xs text-[#574E6B] leading-relaxed\">\n                    {feat.description}\n                  </p>\n                </div>\n              </div>\n              <span className=\"inline-flex items-center gap-1.5 text-xs font-semibold text-violet-700\">\n                <span>Open Module</span>\n                <ArrowRight className=\"w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5\" />\n              </span>\n            </button>\n          ))}\n        </div>\n      </section>\n\n      {/* Section 3: How It Works (Step-by-step) */}\n      <section className=\"bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-8 shadow-sm shadow-violet-950/[0.02]\">\n        <div className=\"mb-6\">\n          <p className=\"text-xs font-semibold text-violet-700\">\n            Step-by-Step Safety Workflow\n          </p>\n          <h2 className=\"mt-1 text-2xl font-bold text-[#1A132B]\">\n            How AuraSafe Works\n          </h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-5 gap-4\">\n          {WORKFLOW_STEPS.map((item) => (\n            <div\n              key={item.step}\n              className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-4 flex flex-col gap-2\"\n            >\n              <span className=\"text-xs font-mono font-bold text-violet-700 tabular-nums\">\n                {item.step}.\n              </span>\n              <h3 className=\"text-sm font-bold text-[#1A132B] leading-snug\">\n                {item.title}\n              </h3>\n              <p className=\"text-xs text-[#574E6B] leading-relaxed\">\n                {item.detail}\n              </p>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* Section 4: Emergency Help Numbers (112, 181, 100, 108, 1098) */}\n      <section className=\"bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-8 shadow-sm shadow-violet-950/[0.02]\">\n        <div className=\"flex flex-wrap items-start justify-between gap-4 mb-5\">\n          <div>\n            <p className=\"text-xs font-semibold text-red-700\">\n              Direct Emergency Assistance \302\267 Works Offline via Device Dialer\n            </p>\n            <h2 className=\"mt-1 text-2xl font-bold text-[#1A132B]\">\n              Emergency Help Numbers\n            </h2>\n          </div>\n          <button\n            type=\"button\"\n            onClick={() => onNavigatePage(\'sos\')}\n            className=\"min-h-[42px] px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\"\n          >\n            <ShieldAlert className=\"w-4 h-4\" />\n            <span>Go to SOS Page</span>\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5\">\n          {EMERGENCY_HELP_NUMBERS.map((item) => (\n            <div\n              key={item.number}\n              className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/80 p-4 flex flex-col justify-between gap-4\"\n            >\n              <div>\n                <p className=\"text-2xl font-bold font-mono tabular-nums text-[#1A132B]\">\n                  {item.number}\n                </p>\n                <p className=\"mt-1 text-sm font-bold text-violet-900\">\n                  {item.label}\n                </p>\n                <p className=\"mt-1 text-xs text-[#574E6B] leading-relaxed\">\n                  {item.detail}\n                </p>\n              </div>\n\n              <a\n                href={`tel:${item.number}`}\n                className=\"w-full min-h-[42px] px-3 py-2 rounded-xl bg-white hover:bg-red-600 hover:text-white hover:border-red-600 border border-violet-200 text-[#1A132B] text-xs font-semibold inline-flex items-center justify-center gap-1.5 transition-colors whitespace-nowrap\"\n              >\n                <Phone className=\"w-3.5 h-3.5\" />\n                <span>Call {item.number}</span>\n              </a>\n            </div>\n          ))}\n        </div>\n      </section>\n\n      {/* Section 5: User Reviews & Feedback */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        <div className=\"lg:col-span-7 bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-7 space-y-5\">\n          <div className=\"flex flex-wrap items-baseline justify-between gap-2\">\n            <div>\n              <p className=\"text-xs font-semibold text-violet-700\">\n                Community Feedback \302\267 Includes Clearly Labelled Sample Reviews\n              </p>\n              <h2 className=\"mt-1 text-2xl font-bold text-[#1A132B]\">\n                User Reviews &amp; Ratings\n              </h2>\n            </div>\n            <div className=\"text-sm font-bold text-[#1A132B] tabular-nums flex items-center gap-1.5\">\n              <Star className=\"w-4 h-4 fill-amber-400 text-amber-500\" />\n              <span>{averageRating} / 5.0</span>\n              <span className=\"text-xs font-normal text-[#6B6182]\">\n                ({reviews.length} reviews)\n              </span>\n            </div>\n          </div>\n\n          <div className=\"divide-y divide-violet-100\">\n            {reviews.map((rev) => (\n              <article key={rev.id} className=\"py-4 first:pt-0 last:pb-0 space-y-2\">\n                <div className=\"flex flex-wrap items-center justify-between gap-2\">\n                  <div>\n                    <p className=\"text-sm font-bold text-[#1A132B]\">\n                      {rev.author}\n                    </p>\n                    <p className=\"text-xs text-[#6B6182]\">\n                      {rev.role}\n                      {rev.isSample ? \' \302\267 Sample Prototype Entry\' : \' \302\267 Submitted Locally\'}\n                      {\' \302\267 \'}\n                      {formatTimeShort(rev.createdAt)}\n                    </p>\n                  </div>\n                  <div\n                    aria-label={`${rev.rating} out of 5 stars`}\n                    className=\"flex items-center gap-0.5 text-amber-500\"\n                  >\n                    {Array.from({ length: 5 }).map((_, idx) => (\n                      <Star\n                        key={idx}\n                        className={`w-3.5 h-3.5 ${\n                          idx < rev.rating ? \'fill-amber-400 text-amber-500\' : \'text-violet-200\'\n                        }`}\n                      />\n                    ))}\n                  </div>\n                </div>\n                <p className=\"text-sm text-[#4A4063] leading-relaxed\">\n                  &ldquo;{rev.comment}&rdquo;\n                </p>\n              </article>\n            ))}\n          </div>\n        </div>\n\n        {/* Submit Feedback Form */}\n        <div className=\"lg:col-span-5 bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-7 space-y-4\">\n          <div>\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Share Your Experience\n            </p>\n            <h3 className=\"mt-1 text-xl font-bold text-[#1A132B]\">\n              Submit Prototype Feedback\n            </h3>\n          </div>\n\n          {reviewFeedback && (\n            <div className=\"rounded-xl bg-emerald-50 border border-emerald-200 px-3.5 py-2.5 text-xs font-medium text-emerald-800 flex items-center gap-2\">\n              <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n              <span>{reviewFeedback}</span>\n            </div>\n          )}\n\n          <form onSubmit={handleReviewSubmit} className=\"space-y-3.5\">\n            <div>\n              <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                Your Name\n              </label>\n              <input\n                type=\"text\"\n                required\n                value={reviewAuthor}\n                onChange={(e) => setReviewAuthor(e.target.value)}\n                placeholder=\"Enter your name\"\n                className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                Role or Context (Optional)\n              </label>\n              <input\n                type=\"text\"\n                value={reviewRole}\n                onChange={(e) => setReviewRole(e.target.value)}\n                placeholder=\"e.g. Daily Commuter, Parent, Student\"\n                className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n              />\n            </div>\n\n            <div>\n              <span className=\"block text-xs font-semibold text-[#1A132B] mb-1.5\">\n                Rating\n              </span>\n              <div className=\"flex items-center gap-1.5\">\n                {[1, 2, 3, 4, 5].map((star) => (\n                  <button\n                    key={star}\n                    type=\"button\"\n                    onClick={() => setReviewRating(star)}\n                    aria-label={`Rate ${star} stars`}\n                    className=\"min-w-[40px] min-h-[40px] rounded-xl bg-[#FAF8FF] border border-violet-200 flex items-center justify-center hover:bg-violet-50 cursor-pointer\"\n                  >\n                    <Star\n                      className={`w-4 h-4 ${\n                        star <= reviewRating\n                          ? \'fill-amber-400 text-amber-500\'\n                          : \'text-violet-300\'\n                      }`}\n                    />\n                  </button>\n                ))}\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                Feedback Comment\n              </label>\n              <textarea\n                rows={3}\n                required\n                value={reviewComment}\n                onChange={(e) => setReviewComment(e.target.value)}\n                placeholder=\"Tell us what worked well or what safety capability you want next...\"\n                className=\"w-full px-3.5 py-2.5 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none resize-none\"\n              />\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold transition-colors cursor-pointer\"\n            >\n              Post Feedback\n            </button>\n          </form>\n        </div>\n      </section>\n\n      {/* Section 6: Founder & Team Details (Editable Placeholders) */}\n      <section className=\"bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-8 shadow-sm shadow-violet-950/[0.02]\">\n        <div className=\"flex flex-wrap items-start justify-between gap-4 mb-5\">\n          <div>\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Founder, Team &amp; Mission \302\267 Editable Placeholders\n            </p>\n            <h2 className=\"mt-1 text-2xl font-bold text-[#1A132B]\">\n              Founder &amp; Project Team\n            </h2>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={() => {\n              setTeamDraft(teamInfo);\n              setEditingTeam((prev) => !prev);\n            }}\n            className=\"min-h-[42px] px-4 py-2 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\"\n          >\n            <Pencil className=\"w-3.5 h-3.5\" />\n            <span>{editingTeam ? \'Cancel Editing\' : \'Edit Team Details\'}</span>\n          </button>\n        </div>\n\n        {editingTeam ? (\n          <form onSubmit={handleSaveTeam} className=\"space-y-4\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Founder Name\n                </label>\n                <input\n                  type=\"text\"\n                  value={teamDraft.founderName}\n                  onChange={(e) =>\n                    setTeamDraft((p) => ({ ...p, founderName: e.target.value }))\n                  }\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Project Team Details\n                </label>\n                <input\n                  type=\"text\"\n                  value={teamDraft.teamMembers}\n                  onChange={(e) =>\n                    setTeamDraft((p) => ({ ...p, teamMembers: e.target.value }))\n                  }\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n              <div className=\"md:col-span-2\">\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Founder Introduction\n                </label>\n                <textarea\n                  rows={2}\n                  value={teamDraft.founderIntro}\n                  onChange={(e) =>\n                    setTeamDraft((p) => ({ ...p, founderIntro: e.target.value }))\n                  }\n                  className=\"w-full px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Project Vision\n                </label>\n                <textarea\n                  rows={2}\n                  value={teamDraft.vision}\n                  onChange={(e) =>\n                    setTeamDraft((p) => ({ ...p, vision: e.target.value }))\n                  }\n                  className=\"w-full px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Project Mission\n                </label>\n                <textarea\n                  rows={2}\n                  value={teamDraft.mission}\n                  onChange={(e) =>\n                    setTeamDraft((p) => ({ ...p, mission: e.target.value }))\n                  }\n                  className=\"w-full px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n            </div>\n            <div className=\"flex justify-end\">\n              <button\n                type=\"submit\"\n                className=\"min-h-[44px] px-5 py-2 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold cursor-pointer\"\n              >\n                Save Team Details\n              </button>\n            </div>\n          </form>\n        ) : (\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n            <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-5 space-y-2\">\n              <div className=\"flex items-center gap-2 text-xs font-semibold text-violet-700\">\n                <ShieldCheck className=\"w-4 h-4\" />\n                <span>Founder</span>\n              </div>\n              <h3 className=\"text-base font-bold text-[#1A132B]\">\n                {teamInfo.founderName}\n              </h3>\n              <p className=\"text-xs text-[#4A4063] leading-relaxed\">\n                {teamInfo.founderIntro}\n              </p>\n            </div>\n\n            <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-5 space-y-2\">\n              <p className=\"text-xs font-semibold text-violet-700\">\n                Project Team\n              </p>\n              <p className=\"text-sm font-semibold text-[#1A132B] leading-relaxed\">\n                {teamInfo.teamMembers}\n              </p>\n            </div>\n\n            <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-5 space-y-3\">\n              <div>\n                <p className=\"text-xs font-semibold text-violet-700\">Vision</p>\n                <p className=\"mt-1 text-xs text-[#4A4063] leading-relaxed\">\n                  {teamInfo.vision}\n                </p>\n              </div>\n              <div className=\"pt-2.5 border-t border-violet-200/60\">\n                <p className=\"text-xs font-semibold text-violet-700\">Mission</p>\n                <p className=\"mt-1 text-xs text-[#4A4063] leading-relaxed\">\n                  {teamInfo.mission}\n                </p>\n              </div>\n            </div>\n          </div>\n        )}\n      </section>\n    </div>\n  );\n};\n"
