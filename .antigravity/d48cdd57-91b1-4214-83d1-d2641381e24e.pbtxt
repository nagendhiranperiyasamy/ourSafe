  planner_response {
    thinking: "**Implementing Storage Updates**\n\nI\'m currently focused on implementing persistent storage helpers within `/src/utils/storage.ts`. I\'m integrating functions to manage emergency evidence history, including retrieval, appending, and clearing. I\'m also addressing threat mode sessions, implementing both retrieval and saving capabilities, and the safety check-in session too. These updates ensure session persistence and seamless recovery of crucial data.\n\n\n**Expanding Storage Features**\n\nI\'m now expanding `/src/utils/storage.ts` to include functions for managing user reviews and testimonials (`getReviews`, `addReview`), enabling editable founder and team details (`getTeamInfo`, `saveTeamInfo`), and creating an emergency offline snapshot (`getOfflineEmergencySnapshot`) for critical data caching. I\'m also planning the new feature pages, including the `/HomeAboutPage.tsx` with all the app content, and `/SosPage.tsx` to handle SOS features.\n\n\n"
    message_id: "5bkBa-qSDfinmtkP6e_m2Ao"
    tool_calls {
      id: "call_4683307059967638248"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import {\\n  AppNotification,\\n  EmergencyHistoryEntry,\\n  SafetyCheckInSession,\\n  SafetyPreferences,\\n  TeamInfoConfig,\\n  ThreatSessionState,\\n  TravelSession,\\n  UserProfile,\\n  UserReviewItem,\\n} from \'../types/safety\';\\n\\nconst USERS_KEY = \'aurasafe_users_v1\';\\nconst SESSION_KEY = \'aurasafe_session_v1\';\\nconst TRAVEL_KEY_PREFIX = \'aurasafe_travel_v1_\';\\nconst CHECKIN_KEY_PREFIX = \'aurasafe_checkin_v1_\';\\nconst THREAT_KEY_PREFIX = \'aurasafe_threat_v1_\';\\nconst HISTORY_KEY_PREFIX = \'aurasafe_history_v1_\';\\nconst NOTIFICATIONS_KEY_PREFIX = \'aurasafe_notifications_v1_\';\\nconst REVIEWS_KEY = \'aurasafe_reviews_v1\';\\nconst TEAM_KEY = \'aurasafe_team_v1\';\\n\\nexport const DEFAULT_PREFERENCES: SafetyPreferences = {\\n  travelCheckInReminders: true,\\n  guardianUpdates: true,\\n  soundAlarmEnabled: true,\\n  locationOnlyDuringEmergency: true,\\n  maskLockscreenPreviews: false,\\n  shakeDetectionEnabled: false,\\n  voiceActivationEnabled: false,\\n  voiceKeyword: \'Help me now\',\\n  quickDialGuardianOnVoiceSos: false,\\n};\\n\\nexport const DEMO_ACCOUNT_CREDENTIALS = {\\n  fullName: \'Maya Sharma\',\\n  phone: \'9876543210\',\\n  password: \'Safe@1234\',\\n};\\n\\nexport const DEFAULT_TEAM_INFO: TeamInfoConfig = {\\n  founderName: \'[Founder Name \342\200\224 Click Edit to Customize]\',\\n  founderIntro:\\n    \'Placeholder founder bio: Replace this introduction with your founder background, personal motivation for building AuraSafe, and commitment to safer public spaces for women.\',\\n  teamMembers:\\n    \'Frontend Architecture & UI/UX Lead \302\267 AI Voice & Safety Systems Engineer \302\267 Mobile & Emergency Infrastructure Contributor (Editable placeholder)\',\\n  vision:\\n    \'A world where every woman can commute, travel, and move freely at any hour with immediate, reliable protection and trusted guardian support.\',\\n  mission:\\n    \'Combine real-time voice-controlled emergency actions, proactive threat preservation, and privacy-first personal safety tools into one calm, dependable companion.\',\\n};\\n\\nconst SAMPLE_REVIEWS: UserReviewItem[] = [\\n  {\\n    id: \'sample-rev-1\',\\n    author: \'Riya K.\',\\n    role: \'Evening Commuter (Sample Prototype Review)\',\\n    rating: 5,\\n    comment:\\n      \'Having separate, uncluttered screens for Travel Mode, Threat Mode, and SOS makes it easy to reach the right safety control without panic.\',\\n    createdAt: \'2026-10-12T18:30:00.000Z\',\\n    isSample: true,\\n  },\\n  {\\n    id: \'sample-rev-2\',\\n    author: \'Neha M.\',\\n    role: \'University Student (Sample Prototype Review)\',\\n    rating: 5,\\n    comment:\\n      \'The voice assistant controller and the simulated Fake Call screen are genuinely thoughtful touches for late-night walks back to the hostel.\',\\n    createdAt: \'2026-10-28T20:15:00.000Z\',\\n    isSample: true,\\n  },\\n  {\\n    id: \'sample-rev-3\',\\n    author: \'Kavitha R.\',\\n    role: \'Working Professional (Sample Prototype Review)\',\\n    rating: 4,\\n    comment:\\n      \'Clear separation between offline emergency dialers and online features builds real trust. The emergency evidence timeline is easy for guardians to review.\',\\n    createdAt: \'2026-11-05T09:45:00.000Z\',\\n    isSample: true,\\n  },\\n];\\n\\nfunction createDemoUser(): UserProfile {\\n  return {\\n    id: \'demo-user-maya\',\\n    fullName: DEMO_ACCOUNT_CREDENTIALS.fullName,\\n    phone: DEMO_ACCOUNT_CREDENTIALS.phone,\\n    email: \'maya.sharma@example.com\',\\n    age: 26,\\n    guardianName: \'Priya Sharma\',\\n    guardianPhone: \'9820112233\',\\n    password: DEMO_ACCOUNT_CREDENTIALS.password,\\n    createdAt: new Date().toISOString(),\\n    sosContacts: [\\n      {\\n        id: \'contact-primary-demo\',\\n        name: \'Priya Sharma\',\\n        phone: \'9820112233\',\\n        relation: \'Primary Guardian\',\\n        isPrimary: true,\\n      },\\n      {\\n        id: \'contact-secondary-demo\',\\n        name: \'Ananya Verma\',\\n        phone: \'9811445566\',\\n        relation: \'Trusted Friend\',\\n      },\\n    ],\\n    preferences: { ...DEFAULT_PREFERENCES },\\n  };\\n}\\n\\nfunction hydrateUser(u: UserProfile): UserProfile {\\n  return {\\n    ...u,\\n    preferences: {\\n      ...DEFAULT_PREFERENCES,\\n      ...(u.preferences ?? {}),\\n    },\\n    sosContacts: Array.isArray(u.sosContacts) ? u.sosContacts : [],\\n  };\\n}\\n\\nexport function normalizePhone(value: string): string {\\n  return value.replace(/[\\\\s\\\\-().]/g, \'\');\\n}\\n\\nexport function isValidPhoneNumber(value: string): boolean {\\n  const cleaned = normalizePhone(value);\\n  return /^\\\\+?\\\\d{10,15}$/.test(cleaned);\\n}\\n\\nexport function isValidEmail(value: string): boolean {\\n  return /^[^\\\\s@]+@[^\\\\s@]+\\\\.[^\\\\s@]+$/.test(value.trim());\\n}\\n\\nexport function formatPhoneForTel(phone: string): string {\\n  return phone.replace(/[^\\\\d+]/g, \'\');\\n}\\n\\nexport function generateDemoOtp(): string {\\n  return String(Math.floor(100000 + Math.random() * 900000));\\n}\\n\\nexport function getUsers(): UserProfile[] {\\n  try {\\n    const raw = localStorage.getItem(USERS_KEY);\\n    if (!raw) {\\n      const seeded = [createDemoUser()];\\n      localStorage.setItem(USERS_KEY, JSON.stringify(seeded));\\n      return seeded;\\n    }\\n    const parsed = JSON.parse(raw);\\n    if (!Array.isArray(parsed) || parsed.length === 0) {\\n      const seeded = [createDemoUser()];\\n      localStorage.setItem(USERS_KEY, JSON.stringify(seeded));\\n      return seeded;\\n    }\\n    return (parsed as UserProfile[]).map(hydrateUser);\\n  } catch {\\n    return [createDemoUser()];\\n  }\\n}\\n\\nexport function saveUsers(users: UserProfile[]): void {\\n  localStorage.setItem(USERS_KEY, JSON.stringify(users));\\n}\\n\\nexport function findUserByIdentifier(identifier: string): UserProfile | undefined {\\n  const trimmed = identifier.trim();\\n  const normalizedPhone = normalizePhone(trimmed);\\n  const lower = trimmed.toLowerCase();\\n  return getUsers().find(\\n    (u) =>\\n      normalizePhone(u.phone) === normalizedPhone ||\\n      u.fullName.trim().toLowerCase() === lower ||\\n      u.email.trim().toLowerCase() === lower\\n  );\\n}\\n\\nexport function registerUser(newUser: UserProfile): { ok: boolean; error?: string } {\\n  const users = getUsers();\\n  const normalizedPhone = normalizePhone(newUser.phone);\\n  const existsPhone = users.some((u) => normalizePhone(u.phone) === normalizedPhone);\\n  if (existsPhone) {\\n    return {\\n      ok: false,\\n      error: \'An account with this phone number already exists. Please sign in instead.\',\\n    };\\n  }\\n  const existsEmail = users.some(\\n    (u) => u.email.trim().toLowerCase() === newUser.email.trim().toLowerCase()\\n  );\\n  if (existsEmail) {\\n    return {\\n      ok: false,\\n      error: \'An account with this email address already exists. Please sign in instead.\',\\n    };\\n  }\\n  const updated = [...users, hydrateUser(newUser)];\\n  saveUsers(updated);\\n  setSessionUserId(newUser.id);\\n  return { ok: true };\\n}\\n\\nexport function updateUserProfile(updatedUser: UserProfile): UserProfile {\\n  const hydrated = hydrateUser(updatedUser);\\n  const users = getUsers();\\n  const next = users.map((u) => (u.id === hydrated.id ? hydrated : u));\\n  saveUsers(next);\\n  return hydrated;\\n}\\n\\nexport function resetPasswordByIdentifier(\\n  identifier: string,\\n  newPassword: string\\n): { ok: boolean; error?: string } {\\n  const users = getUsers();\\n  const target = findUserByIdentifier(identifier);\\n  if (!target) {\\n    return {\\n      ok: false,\\n      error: \'No local prototype account matches that phone number, name, or email.\',\\n    };\\n  }\\n  const next = users.map((u) =>\\n    u.id === target.id ? { ...u, password: newPassword } : u\\n  );\\n  saveUsers(next);\\n  return { ok: true };\\n}\\n\\nexport function setSessionUserId(userId: string): void {\\n  localStorage.setItem(SESSION_KEY, userId);\\n}\\n\\nexport function clearSession(): void {\\n  localStorage.removeItem(SESSION_KEY);\\n}\\n\\nexport function getActiveSessionUser(): UserProfile | null {\\n  try {\\n    const id = localStorage.getItem(SESSION_KEY);\\n    if (!id) return null;\\n    const users = getUsers();\\n    return users.find((u) => u.id === id) ?? null;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nexport function getTravelSession(userId: string): TravelSession | null {\\n  try {\\n    const raw = localStorage.getItem(`${TRAVEL_KEY_PREFIX}${userId}`);\\n    if (!raw) return null;\\n    return JSON.parse(raw) as TravelSession;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nexport function saveTravelSession(userId: string, session: TravelSession | null): void {\\n  if (!session) {\\n    localStorage.removeItem(`${TRAVEL_KEY_PREFIX}${userId}`);\\n    return;\\n  }\\n  localStorage.setItem(`${TRAVEL_KEY_PREFIX}${userId}`, JSON.stringify(session));\\n}\\n\\nexport function getSafetyCheckIn(userId: string): SafetyCheckInSession | null {\\n  try {\\n    const raw = localStorage.getItem(`${CHECKIN_KEY_PREFIX}${userId}`);\\n    if (!raw) return null;\\n    return JSON.parse(raw) as SafetyCheckInSession;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nexport function saveSafetyCheckIn(\\n  userId: string,\\n  session: SafetyCheckInSession | null\\n): void {\\n  if (!session) {\\n    localStorage.removeItem(`${CHECKIN_KEY_PREFIX}${userId}`);\\n    return;\\n  }\\n  localStorage.setItem(`${CHECKIN_KEY_PREFIX}${userId}`, JSON.stringify(session));\\n}\\n\\nexport function getThreatSession(userId: string): ThreatSessionState | null {\\n  try {\\n    const raw = localStorage.getItem(`${THREAT_KEY_PREFIX}${userId}`);\\n    if (!raw) return null;\\n    return JSON.parse(raw) as ThreatSessionState;\\n  } catch {\\n    return null;\\n  }\\n}\\n\\nexport function saveThreatSession(\\n  userId: string,\\n  session: ThreatSessionState | null\\n): void {\\n  if (!session) {\\n    localStorage.removeItem(`${THREAT_KEY_PREFIX}${userId}`);\\n    return;\\n  }\\n  localStorage.setItem(`${THREAT_KEY_PREFIX}${userId}`, JSON.stringify(session));\\n}\\n\\nexport function getEmergencyHistory(userId: string): EmergencyHistoryEntry[] {\\n  try {\\n    const raw = localStorage.getItem(`${HISTORY_KEY_PREFIX}${userId}`);\\n    if (!raw) return [];\\n    const parsed = JSON.parse(raw);\\n    return Array.isArray(parsed) ? (parsed as EmergencyHistoryEntry[]) : [];\\n  } catch {\\n    return [];\\n  }\\n}\\n\\nexport function saveEmergencyHistory(\\n  userId: string,\\n  entries: EmergencyHistoryEntry[]\\n): void {\\n  localStorage.setItem(\\n    `${HISTORY_KEY_PREFIX}${userId}`,\\n    JSON.stringify(entries.slice(0, 120))\\n  );\\n}\\n\\nexport function getNotifications(userId: string): AppNotification[] {\\n  try {\\n    const raw = localStorage.getItem(`${NOTIFICATIONS_KEY_PREFIX}${userId}`);\\n    if (!raw) {\\n      return [\\n        {\\n          id: \'welcome-notif\',\\n          title: \'Safety profile ready\',\\n          detail:\\n            \'Your trusted guardian circle is cached locally for offline readiness. Try the AI Voice Controller or dedicated safety modes anytime.\',\\n          timestamp: new Date().toISOString(),\\n          category: \'account\',\\n          read: false,\\n        },\\n      ];\\n    }\\n    return JSON.parse(raw) as AppNotification[];\\n  } catch {\\n    return [];\\n  }\\n}\\n\\nexport function saveNotifications(\\n  userId: string,\\n  notifications: AppNotification[]\\n): void {\\n  localStorage.setItem(\\n    `${NOTIFICATIONS_KEY_PREFIX}${userId}`,\\n    JSON.stringify(notifications.slice(0, 40))\\n  );\\n}\\n\\nexport function getReviews(): UserReviewItem[] {\\n  try {\\n    const raw = localStorage.getItem(REVIEWS_KEY);\\n    if (!raw) {\\n      localStorage.setItem(REVIEWS_KEY, JSON.stringify(SAMPLE_REVIEWS));\\n      return SAMPLE_REVIEWS;\\n    }\\n    const parsed = JSON.parse(raw);\\n    return Array.isArray(parsed) && parsed.length > 0\\n      ? (parsed as UserReviewItem[])\\n      : SAMPLE_REVIEWS;\\n  } catch {\\n    return SAMPLE_REVIEWS;\\n  }\\n}\\n\\nexport function saveReviews(reviews: UserReviewItem[]): void {\\n  localStorage.setItem(REVIEWS_KEY, JSON.stringify(reviews));\\n}\\n\\nexport function getTeamInfo(): TeamInfoConfig {\\n  try {\\n    const raw = localStorage.getItem(TEAM_KEY);\\n    if (!raw) return DEFAULT_TEAM_INFO;\\n    return { ...DEFAULT_TEAM_INFO, ...(JSON.parse(raw) as Partial<TeamInfoConfig>) };\\n  } catch {\\n    return DEFAULT_TEAM_INFO;\\n  }\\n}\\n\\nexport function saveTeamInfo(info: TeamInfoConfig): void {\\n  localStorage.setItem(TEAM_KEY, JSON.stringify(info));\\n}\\n\\nexport function formatTimeShort(iso: string): string {\\n  try {\\n    return new Date(iso).toLocaleTimeString([], {\\n      hour: \'2-digit\',\\n      minute: \'2-digit\',\\n    });\\n  } catch {\\n    return \'\';\\n  }\\n}\\n\\nexport function formatDateTimeShort(iso: string): string {\\n  try {\\n    return new Date(iso).toLocaleString([], {\\n      month: \'short\',\\n      day: \'numeric\',\\n      hour: \'2-digit\',\\n      minute: \'2-digit\',\\n      second: \'2-digit\',\\n    });\\n  } catch {\\n    return \'\';\\n  }\\n}\\n\", \"Description\":\"Expand LocalStorage persistence to support Threat Mode sessions, Emergency Evidence History, Safety Check-In, User Reviews, and editable Founder & Team info\", \"Overwrite\":true, \"TargetFile\":\"/src/utils/storage.ts\", \"toolAction\":\"Updating storage utilities\", \"toolSummary\":\"Update storage.ts\"}"
      thinking_signature: "\022\233\023\n\230\023\001i\024}\023%\351N}\230d\275\237#\v#_5\222W\230\220\225\313\320\255\351\243\360##e9ZS\274\344$I\313A\330\217\034\360\350\317\261\3220\210\330\366:\"\371\274\342y\234\2615\024$\246\224W\030pp\354S`\241\341A!\034\\\220\321\361?\344\351\3122\000\273LB\365\301~p\322d\343\002=M\240\376g\330U\240\266\274\211qch*\002gx\206/\216-8dV ,\227\033\336\337n\2658@\274\021\332\203\016\267i*\221-\032\325\262\026{o\177\002\231m\205\b\353\367ac\347\216\322\306Af\224\350\017\373\230\202\016\035<\274f[\006\354F\231\"\206S\241Rg\3026\252D\343\262\a\236\316\322\253w\314\266>\335\317\355\002c\317d\315T\376\360\006b@\315\r\003\336\265_\315\216x,lqrc\233M\027\273\211\355\353\367\177\374T\372\030F\303\221\275#\2404g\361\212\231\v\207\315F\233\265~\fX\225\313t\206\371H\227{.{ v4\372\323m\207\r\206g\334\025\311%\341 \256\2207\354\vm\262n\021\315\353\333O\237j\325i\232\352\b\357n\252\347\353\376\237\215\t\207\355\3202\350\375\313\330\277\035\224\177\354\274%\351\026#\030\210\366!\377s\322[4\244IA\254\352\331d^Z\325i\245\257\211ldA\257\024\312\313\020\261\375\254\314t\337\037_\030k\335\342\263\037<\fK>\230j\t\241\352\021\025|:KZC\twx\004Ro\000y\222\225\376\247(\203/$\354\204n\276\0330B\330i`\346\232\034G\327\311c\3614j\354\212yU\314\312\263\312\251\036\003\360\262\365\277$_\v\276\244o#\324\311\374\031\360B\t\230N\220\304\326\226\'\227\225\244:m\227\2423\022QQQ\026\374\336]\004ZbG\217e\bUi\312\374B\200\370\315\205\220<\034\230\362\024\020\31477\342\022k\302\366\314\215z\351\227\342\252\204v=f9cIa\200O\205\260_\3417\237L\230\366@W\036#\376\202\231\377V62\337\255\242\202%\210\316\003&\005\331\266^\350\240\tj\347\240\\q\001Q\bx\345\305/\360nAt\356\"\214\016\337aRd\004\256\003m\346}\v\0207M\326`9\215\331\234\376\027\336\337\346`\372\035\243\356d\261\034\330\346\305\202N\370\253\272\272|\376\312\374t\351\003c\361\340\1770A\200\'\324\026c\312\331\344\341e\321i\346\032\216\246\321\351n\231\3426\216bw\272|{`\350\330\227\300\a\314\037\325\334\030\037eb\306\261\035\203\203\370\333\335\255G\360F\202\217.\210\200R{\305\326I\217\362\212\267\340\266\333XyT\311\265\222\331G \356\217j\324YK\336vtU\371r\371\272\202e\205\204%h-\237iO\025l\033\313\334!+N\356\240<\243@\342\324T\312_C\335\323\033\227)\2220\333\027Y%\002\243\\r\220.\000\341W6\342\234\030:\025\217\033e\016::\'\334_v\025\316\213\230\374m\235D\'\033\025\332\f\365\322\266>\035=\324\264\225Y*\016V\275\266\344\351\022}\217\277%\220\\\366a\036\330i\350\216\320\352\036\035a;Q1\355\225\201o\361`{\'H\247\246\n\266a\231\2418\327)5\0275\367eJ\354\200\002\2360\317\224\241\221\200\026\033\322\343|GP\303\377\221\023\377AW\226)\a20f5\271\202\241\336\035\030\022.\265,j`v\263\304\207d\221\246\305bCF$d\206\001\373a4\302\257\373\235\177\323%<\032 \260b\212Wt-\a9q\021\311\272a\3725\003i\006\314\216\257\372I\245\224\333\177;\030\357-\363\350.\364\034\267\345\376\271-\'\343q\340 \322\245z\021m\370Y|\210k\211A\202\334Z%t\352/\226\334\331Lu\2429\321\252~\0337\355\201/\022\003\3027\220\304>TB[\031\331~\303\356<\276\346r\216\237HW1C\317\370\326xjt\246\335\021_^\313\333\220\370}\200\317\232\237=\214\273\245\370h\024\036\247\\\036u\240}\274N\036\317\314\361\205F\037\311\024J\226 \322\026\353\202sM\334N5\246Z\375\351\214\317,3\333\a\3164\300\211\250\3479_|\202\331\236\362\354\031\345FZ\340\213\036\225\372\227\n\342\254\363\026M\321\340U\345R\372\032v\254\032\230{\371j\267-\002\367Z\247\r\017]5Y.\201\307\230\325\000\002),\223l\277S.P\376\317\203\016ha\320pb\222a\303b\241\366\326\361\264\351C\006C\000\r\274\205p\215\312:R\274\374$\375k\tj$\023\317\001\237a&G\204\005r\242\260\334\270\224l\321|vo;;\240\245\365\214KULR\311\016\346\221\301\335O\356\331K\373\263|W\030Rd9R\245#\321\244\240\200\002\307]\306:T\314j\354\347\244m\301\360\1771\367*\255X\030\346\016\305\200\302/\2248\362E}\337\236E\337\343\232\262\310\n\301\256!\274\335\341\356\r\226\002\035\344\027\244L\376\260\363N\265t\024]\262\031>8\372\217\213\227|\bF\265\033EU\214$(.F\204W\217u\254\372\351\037\206I\337\003\324\211\306Q\344\\\244\303\202\221\326\247\266c\277\tj<\353\201\376-no\215\256U\320\f\202\036\267\216\220Qa\"\206\206\241\2536\331\233\b\263z\241\237\241L\204\323\204\247T\023\333\262$\216d0\221t\002V\352]\000\313\017;\354gv$\036\000\3050\205\300\335\355,J\243sf1\347ik\245\225\313\367\003\354\025!\'J\204n~\021*\213/%%\352\313x\255\210\250\262\215#\350\347\267H\330\351>\342\316\351\321\n\217cW9\247\004\321\247\f\210(\271\315|\375\333v\371\242=\020\241\034\301\335\030\342\312\260\0003\206\231\230JT\257M\3745T\350(\f\201eS\214#`b9\245\242\251\300\335\025\262(U\360\'\326\373\004ks\301\307\352\265\257a\302B\2768\225\232\371\200\021QA\306\177\302a\3127DZ\245wx\245n\377\017(\311\200\317h\231\201f3\270\220\232^\n\344\332Qs\315\255\360w\322\034\220!\314\246\370X\260T\2551\031U\277\"\374~Zr\377\266`\331^\224\364\325\323\232\306\223\271\270\203+\226\016\022\357\245>\242\273?\303\024B\215\271\237\300\022\250\261\317\256\307\210\324\031\177,\312\314\327\024nW\215&\352\201\310,\240\222B\357\247\266tn\337\366i\307}8\215\222\224\203\260L\257\351\254m\\\266-P\335\326C\257\036H\354\324\2065P\023\t\000!u*nr\f\200h\315\244\317]\254\370\253\377\216r\277vbLi\211x\306\241\327\033\307\334\254Q\237j>\003\0376\376\312\214\337\201%\375\367\255\267\325\255)\230w\207\2665PI9\017>\266\202\037\n\033\225^\0202W\226w(~&\270\201\375Z\370(\006z6\2128\320\276\354\353\377\260\035u\301\277}EW\261U\305ji+\274M/\215\035\271\303\262 \236\224\373\311d.\021\230\335\216g\2116\033|X\373\254F\345\345\361\377\374\361rD\321\214LI\035\3532\a\371R\227\337\301vG\325\237\251\354]\030\256\256\370mt\362\203!\021\224\247\231\244_t\240\017\nx\211VD\267gVd\341\203g\270\263\257\213)s`\1776G\371DN\241\336a\2676\247\376*obQ\003\224\230\21514\304\354\201s\344\244\322\206U\270\026\360\225\232,=C\343\333\224\022\322\003\317b\261BUA\033\203f\366\362\261h@s\256\307U\354[\271\237\242\211\327\313\324iE\317\026=v\344\327~O\265$SO\262}f\212\250o\250\363*\377s\027Py\300\210\004A\333\243\214\350\320;Cmk\003\006>\022\002q\316\262nx\033\355\030\177\3363\342U3\b\224\334\266\362\356\263+D\357\351\360]J\336}e\016\205\326\245\266f\251\"/A\204{O\303\302g\253\t\222\334oM\317\366\323\265j\367\202\001\351\267)\371L\271i\214\345!Nr\200\275>\266\361\241\225+\340G\260\313\332\024?\326V%N`y\343\f\276N\0243\347\024-\v\241\251)\206\247\037r2`tT\352\0341$%\243\347\003\001\216/\364q\320v\242\334q\310J\232\304\224\367~\345~j\364Hp\263L\004\261\266\313\246\020\255\356\361\345\250\004K\334\327\034$9\332t$\037\375\261YHp\352I<\356\254\364\373\315\317<\375\247\bLd\240\350\030\355\260`\3008\030\216j\276\226\354\374kU\242\204\301p d\034>,\370dV\347T\222H\255K;ZU\372\327\362\036\353&U)\234\256\312\313\220 \026O\314\270\234\216\000\263\367\2164\'\"\2700\315\"8\376\20441Gb\v\330\264Y*\301\375pZ>\225E/M\275\204\364\316\210\370?\'L\3124\037\252dg\313\002c^r\276\005\210\214\000\320\2704\311,q#&!\262\314Eb\334\330Vx=\236\240C\303\272\202<\230\200\344\331=8i\225\204\255\326\311\353EB\215\f\210\271\006\346y\311/\364e\024\3105\226KM\370\3543\004[\255\363\304\361\246\322g,\252\267Z\253u"
