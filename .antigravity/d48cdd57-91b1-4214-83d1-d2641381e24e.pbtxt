      arguments_json: "{\"Description\":\"Support ?mode=lockshield URL launch and Home Screen Widget SOS trigger in App.tsx pre-login mode\", \"Instruction\":\"Initialize preLoginLockShieldOpen from ?mode=lockshield and pass onQuickWidgetSos in App.tsx\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":42, \"ReplacementContent\":\"  // Pre-login / Outside-App Emergency Shield & Trigger State\\n  const [preLoginLockShieldOpen, setPreLoginLockShieldOpen] = useState<boolean>(\\n    () => {\\n      if (typeof window === \'undefined\') return false;\\n      return (\\n        new URLSearchParams(window.location.search).get(\'mode\') === \'lockshield\'\\n      );\\n    }\\n  );\", \"StartLine\":33, \"TargetContent\":\"  // Pre-login / Outside-App Emergency Shield & Trigger State\\n  const [preLoginLockShieldOpen, setPreLoginLockShieldOpen] = useState(false);\"}, {\"AllowMultiple\":false, \"EndLine\":164, \"ReplacementContent\":\"      {preLoginLockShieldOpen && (\\n        <EmergencyLockScreenShield\\n          preferences={fallbackUser.preferences}\\n          guardianName={primaryGuardian?.name}\\n          guardianPhone={primaryGuardian?.phone}\\n          triggers={preLoginTriggers}\\n          onQuickWidgetSos={() => {\\n            requestPreLoginLocation();\\n            setPreLoginTriggerEvent({\\n              id: `pre-widget-sos-${Date.now()}`,\\n              kind: \'screen_tap\',\\n              label: \'Home Screen SOS Widget\',\\n              detail:\\n                \'Triggered directly from OurSafe Phone Home Screen Widget without signing in.\',\\n              triggeredAt: new Date().toISOString(),\\n              fromLockScreen: false,\\n            });\\n          }}\\n          onExit={() => setPreLoginLockShieldOpen(false)}\\n        />\\n      )}\", \"StartLine\":152, \"TargetContent\":\"      {preLoginLockShieldOpen && (\\n        <EmergencyLockScreenShield\\n          preferences={fallbackUser.preferences}\\n          guardianName={primaryGuardian?.name}\\n          guardianPhone={primaryGuardian?.phone}\\n          triggers={preLoginTriggers}\\n          onExit={() => setPreLoginLockShieldOpen(false)}\\n        />\\n      )}\"}], \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating App.tsx for ?mode=lockshield and Home Screen widget SOS\", \"toolSummary\":\"Update App.tsx\"}"
