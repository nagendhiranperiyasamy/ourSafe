    tool_calls {
      id: "call_16957589474990676990"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  Check,\\n  Pencil,\\n  Phone,\\n  Plus,\\n  Star,\\n  Trash2,\\n  UserPlus,\\n  X,\\n} from \'lucide-react\';\\nimport { SosContact } from \'../../types/safety\';\\nimport { formatPhoneForTel, isValidPhoneNumber } from \'../../utils/storage\';\\n\\ninterface SosContactsModalProps {\\n  contacts: SosContact[];\\n  onSaveContacts: (nextContacts: SosContact[]) => void;\\n  onClose: () => void;\\n}\\n\\nexport const SosContactsModal: React.FC<SosContactsModalProps> = ({\\n  contacts,\\n  onSaveContacts,\\n  onClose,\\n}) => {\\n  const [isAdding, setIsAdding] = useState(contacts.length === 0);\\n  const [name, setName] = useState(\'\');\\n  const [phone, setPhone] = useState(\'\');\\n  const [relation, setRelation] = useState(\'Guardian\');\\n  const [formError, setFormError] = useState(\'\');\\n\\n  const [editingId, setEditingId] = useState<string | null>(null);\\n  const [editName, setEditName] = useState(\'\');\\n  const [editPhone, setEditPhone] = useState(\'\');\\n  const [editRelation, setEditRelation] = useState(\'\');\\n  const [editError, setEditError] = useState(\'\');\\n\\n  const handleAddContact = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setFormError(\'\');\\n\\n    if (!name.trim() || name.trim().length < 2) {\\n      setFormError(\'Enter a guardian name (at least 2 characters).\');\\n      return;\\n    }\\n    if (!isValidPhoneNumber(phone)) {\\n      setFormError(\'Enter a valid phone number (10 to 15 digits).\');\\n      return;\\n    }\\n\\n    const newContact: SosContact = {\\n      id: `contact-${Date.now()}`,\\n      name: name.trim(),\\n      phone: phone.trim(),\\n      relation: relation.trim() || \'Emergency Contact\',\\n      isPrimary: contacts.length === 0,\\n    };\\n\\n    onSaveContacts([...contacts, newContact]);\\n    setName(\'\');\\n    setPhone(\'\');\\n    setRelation(\'Guardian\');\\n    setIsAdding(false);\\n  };\\n\\n  const startEdit = (contact: SosContact) => {\\n    setEditingId(contact.id);\\n    setEditName(contact.name);\\n    setEditPhone(contact.phone);\\n    setEditRelation(contact.relation);\\n    setEditError(\'\');\\n  };\\n\\n  const saveEdit = (id: string) => {\\n    setEditError(\'\');\\n    if (!editName.trim() || editName.trim().length < 2) {\\n      setEditError(\'Name must be at least 2 characters.\');\\n      return;\\n    }\\n    if (!isValidPhoneNumber(editPhone)) {\\n      setEditError(\'Enter a valid phone number (10 to 15 digits).\');\\n      return;\\n    }\\n\\n    const next = contacts.map((c) =>\\n      c.id === id\\n        ? {\\n            ...c,\\n            name: editName.trim(),\\n            phone: editPhone.trim(),\\n            relation: editRelation.trim() || \'Emergency Contact\',\\n          }\\n        : c\\n    );\\n    onSaveContacts(next);\\n    setEditingId(null);\\n  };\\n\\n  const handleDelete = (id: string) => {\\n    const remaining = contacts.filter((c) => c.id !== id);\\n    if (remaining.length > 0 && !remaining.some((c) => c.isPrimary)) {\\n      remaining[0] = { ...remaining[0], isPrimary: true };\\n    }\\n    onSaveContacts(remaining);\\n  };\\n\\n  const handleMakePrimary = (id: string) => {\\n    const next = contacts.map((c) => ({ ...c, isPrimary: c.id === id }));\\n    onSaveContacts(next);\\n  };\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 bg-[#182215]/55 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto\\\"\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-labelledby=\\\"sos-contacts-heading\\\"\\n    >\\n      <div className=\\\"w-full max-w-xl bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 sm:p-7 shadow-2xl my-auto max-h-[90vh] overflow-y-auto\\\">\\n        <div className=\\\"flex items-start justify-between gap-4 mb-5\\\">\\n          <div>\\n            <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n              Emergency Circle \302\267 Offline-Ready Contacts\\n            </p>\\n            <h2\\n              id=\\\"sos-contacts-heading\\\"\\n              className=\\\"text-xl font-semibold text-[#182215] mt-0.5\\\"\\n            >\\n              Manage SOS Contacts\\n            </h2>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            aria-label=\\\"Close contacts manager\\\"\\n            className=\\\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#54634D] hover:bg-[#EAF0E2] cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Add SOS Number Trigger / Form */}\\n        {!isAdding ? (\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setIsAdding(true);\\n              setFormError(\'\');\\n            }}\\n            className=\\\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#2F4526] hover:bg-[#23351C] text-[#F6F9F2] text-sm font-semibold flex items-center justify-center gap-2 transition-colors mb-5 cursor-pointer\\\"\\n          >\\n            <Plus className=\\\"w-4 h-4\\\" />\\n            <span>Add SOS Number</span>\\n          </button>\\n        ) : (\\n          <form\\n            onSubmit={handleAddContact}\\n            className=\\\"mb-5 rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] p-4 space-y-3\\\"\\n          >\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <span className=\\\"text-sm font-bold text-[#182215] flex items-center gap-1.5\\\">\\n                <UserPlus className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n                <span>Add New Emergency Contact</span>\\n              </span>\\n              {contacts.length > 0 && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => setIsAdding(false)}\\n                  className=\\\"text-xs font-semibold text-[#4B5844] hover:text-[#182215] cursor-pointer\\\"\\n                >\\n                  Cancel\\n                </button>\\n              )}\\n            </div>\\n\\n            {formError && (\\n              <p className=\\\"text-xs font-medium text-red-600\\\">{formError}</p>\\n            )}\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#182215] mb-1\\\">\\n                  Guardian Name\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={name}\\n                  onChange={(e) => setName(e.target.value)}\\n                  placeholder=\\\"e.g. Meera Nair\\\"\\n                  className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-white border border-[#C5D2B7] text-sm focus:border-[#2F4526] focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#182215] mb-1\\\">\\n                  Guardian Phone Number\\n                </label>\\n                <input\\n                  type=\\\"tel\\\"\\n                  value={phone}\\n                  onChange={(e) => setPhone(e.target.value)}\\n                  placeholder=\\\"e.g. 9820112233\\\"\\n                  className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-white border border-[#C5D2B7] text-sm font-mono tabular-nums focus:border-[#2F4526] focus:outline-none\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-12 gap-3 items-end\\\">\\n              <div className=\\\"sm:col-span-7\\\">\\n                <label className=\\\"block text-xs font-semibold text-[#182215] mb-1\\\">\\n                  Relationship\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={relation}\\n                  onChange={(e) => setRelation(e.target.value)}\\n                  placeholder=\\\"Mother, Sister, Friend, Partner...\\\"\\n                  className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-white border border-[#C5D2B7] text-sm focus:border-[#2F4526] focus:outline-none\\\"\\n                />\\n              </div>\\n              <div className=\\\"sm:col-span-5\\\">\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"w-full min-h-[44px] px-4 py-2 rounded-xl bg-[#2F4526] hover:bg-[#23351C] text-[#F6F9F2] text-sm font-semibold cursor-pointer\\\"\\n                >\\n                  Save Contact\\n                </button>\\n              </div>\\n            </div>\\n          </form>\\n        )}\\n\\n        {/* Saved Contacts List */}\\n        {contacts.length === 0 ? (\\n          <p className=\\\"text-sm text-[#54634D] text-center py-6\\\">\\n            No SOS contacts saved yet. Add at least one trusted guardian above.\\n          </p>\\n        ) : (\\n          <div className=\\\"divide-y divide-[#DCE5D1] border border-[#CFD9C3] rounded-2xl overflow-hidden\\\">\\n            {contacts.map((contact) => {\\n              const isEditing = editingId === contact.id;\\n              return (\\n                <div key={contact.id} className=\\\"p-4 bg-white\\\">\\n                  {isEditing ? (\\n                    <div className=\\\"space-y-3\\\">\\n                      {editError && (\\n                        <p className=\\\"text-xs font-medium text-red-600\\\">{editError}</p>\\n                      )}\\n                      <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-2.5\\\">\\n                        <input\\n                          type=\\\"text\\\"\\n                          value={editName}\\n                          onChange={(e) => setEditName(e.target.value)}\\n                          placeholder=\\\"Name\\\"\\n                          aria-label=\\\"Edit guardian name\\\"\\n                          className=\\\"min-h-[42px] px-3 py-1.5 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n                        />\\n                        <input\\n                          type=\\\"tel\\\"\\n                          value={editPhone}\\n                          onChange={(e) => setEditPhone(e.target.value)}\\n                          placeholder=\\\"Phone\\\"\\n                          aria-label=\\\"Edit guardian phone\\\"\\n                          className=\\\"min-h-[42px] px-3 py-1.5 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm font-mono tabular-nums focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n                        />\\n                        <input\\n                          type=\\\"text\\\"\\n                          value={editRelation}\\n                          onChange={(e) => setEditRelation(e.target.value)}\\n                          placeholder=\\\"Relation\\\"\\n                          aria-label=\\\"Edit relation\\\"\\n                          className=\\\"min-h-[42px] px-3 py-1.5 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n                        />\\n                      </div>\\n                      <div className=\\\"flex items-center justify-end gap-2\\\">\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => setEditingId(null)}\\n                          className=\\\"min-h-[38px] px-3 py-1.5 rounded-lg text-xs font-semibold text-[#4B5844] hover:bg-[#EAF0E2] cursor-pointer\\\"\\n                        >\\n                          Cancel\\n                        </button>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => saveEdit(contact.id)}\\n                          className=\\\"min-h-[38px] px-3.5 py-1.5 rounded-lg bg-[#2F4526] hover:bg-[#23351C] text-white text-xs font-semibold flex items-center gap-1 cursor-pointer\\\"\\n                        >\\n                          <Check className=\\\"w-3.5 h-3.5\\\" />\\n                          <span>Save</span>\\n                        </button>\\n                      </div>\\n                    </div>\\n                  ) : (\\n                    <div className=\\\"flex flex-wrap items-center justify-between gap-3\\\">\\n                      <div className=\\\"min-w-0\\\">\\n                        <div className=\\\"flex items-center gap-2 text-sm font-bold text-[#182215]\\\">\\n                          <span className=\\\"truncate\\\">{contact.name}</span>\\n                          {contact.isPrimary && (\\n                            <span className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n                              \302\267 Primary\\n                            </span>\\n                          )}\\n                        </div>\\n                        <p className=\\\"text-xs text-[#54634D] mt-0.5\\\">\\n                          <span className=\\\"font-mono tabular-nums\\\">\\n                            {contact.phone}\\n                          </span>{\' \'}\\n                          \302\267 {contact.relation || \'Emergency Contact\'}\\n                        </p>\\n                      </div>\\n\\n                      <div className=\\\"flex items-center gap-1.5\\\">\\n                        {!contact.isPrimary && (\\n                          <button\\n                            type=\\\"button\\\"\\n                            onClick={() => handleMakePrimary(contact.id)}\\n                            title=\\\"Set as Primary Guardian\\\"\\n                            className=\\\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#54634D] hover:text-[#2F4526] hover:bg-[#EAF0E2] transition-colors cursor-pointer\\\"\\n                          >\\n                            <Star className=\\\"w-4 h-4\\\" />\\n                          </button>\\n                        )}\\n                        <a\\n                          href={`tel:${formatPhoneForTel(contact.phone)}`}\\n                          title={`Call ${contact.name}`}\\n                          className=\\\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#2F4526] hover:bg-[#EAF0E2] transition-colors\\\"\\n                        >\\n                          <Phone className=\\\"w-4 h-4\\\" />\\n                        </a>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => startEdit(contact)}\\n                          aria-label={`Edit ${contact.name}`}\\n                          className=\\\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#4B5844] hover:text-[#2F4526] hover:bg-[#EAF0E2] transition-colors cursor-pointer\\\"\\n                        >\\n                          <Pencil className=\\\"w-4 h-4\\\" />\\n                        </button>\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => handleDelete(contact.id)}\\n                          aria-label={`Delete ${contact.name}`}\\n                          className=\\\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#4B5844] hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer\\\"\\n                        >\\n                          <Trash2 className=\\\"w-4 h-4\\\" />\\n                        </button>\\n                      </div>\\n                    </div>\\n                  )}\\n                </div>\\n              );\\n            })}\\n          </div>\\n        )}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update SosContactsModal to OurSafe botanical sage theme\", \"Overwrite\":true, \"TargetFile\":\"/src/components/dashboard/SosContactsModal.tsx\", \"toolAction\":\"Updating SosContactsModal to sage theme\", \"toolSummary\":\"Update SosContactsModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16957589474990675525"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useRef, useState } from \'react\';\\nimport {\\n  Camera,\\n  CheckCircle2,\\n  Mail,\\n  Pencil,\\n  Phone,\\n  User,\\n  UserCheck,\\n  X,\\n} from \'lucide-react\';\\nimport { UserProfile } from \'../../types/safety\';\\nimport { isValidEmail, isValidPhoneNumber } from \'../../utils/storage\';\\n\\ninterface ProfileModalProps {\\n  user: UserProfile;\\n  initialEditing?: boolean;\\n  onSaveProfile: (updated: UserProfile) => void;\\n  onClose: () => void;\\n}\\n\\nexport const ProfileModal: React.FC<ProfileModalProps> = ({\\n  user,\\n  initialEditing = false,\\n  onSaveProfile,\\n  onClose,\\n}) => {\\n  const [editing, setEditing] = useState(initialEditing);\\n  const [fullName, setFullName] = useState(user.fullName);\\n  const [phone, setPhone] = useState(user.phone);\\n  const [email, setEmail] = useState(user.email);\\n  const [age, setAge] = useState(String(user.age));\\n  const [guardianName, setGuardianName] = useState(user.guardianName);\\n  const [guardianPhone, setGuardianPhone] = useState(user.guardianPhone);\\n  const [photoDataUrl, setPhotoDataUrl] = useState(user.photoDataUrl ?? \'\');\\n  const [error, setError] = useState(\'\');\\n  const [savedNotice, setSavedNotice] = useState(false);\\n\\n  const fileInputRef = useRef<HTMLInputElement | null>(null);\\n\\n  const initials = user.fullName\\n    .split(\' \')\\n    .filter(Boolean)\\n    .slice(0, 2)\\n    .map((part) => part[0]?.toUpperCase() ?? \'\')\\n    .join(\'\');\\n\\n  const handlePhotoSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\\n    const file = e.target.files?.[0];\\n    if (!file) return;\\n    if (file.size > 1_500_000) {\\n      setError(\'Please choose an image smaller than 1.5 MB.\');\\n      return;\\n    }\\n    const reader = new FileReader();\\n    reader.onload = () => {\\n      if (typeof reader.result === \'string\') {\\n        setPhotoDataUrl(reader.result);\\n        setError(\'\');\\n        if (!editing) {\\n          onSaveProfile({ ...user, photoDataUrl: reader.result });\\n          setSavedNotice(true);\\n          window.setTimeout(() => setSavedNotice(false), 2500);\\n        }\\n      }\\n    };\\n    reader.readAsDataURL(file);\\n  };\\n\\n  const handleSave = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(\'\');\\n\\n    if (!fullName.trim() || fullName.trim().length < 2) {\\n      setError(\'Full name must be at least 2 characters.\');\\n      return;\\n    }\\n    if (!isValidPhoneNumber(phone)) {\\n      setError(\'Enter a valid phone number (10 to 15 digits).\');\\n      return;\\n    }\\n    if (!isValidEmail(email)) {\\n      setError(\'Enter a valid email address.\');\\n      return;\\n    }\\n    const numericAge = Number(age);\\n    if (!age || Number.isNaN(numericAge) || numericAge < 13 || numericAge > 120) {\\n      setError(\'Age must be between 13 and 120.\');\\n      return;\\n    }\\n    if (!guardianName.trim() || guardianName.trim().length < 2) {\\n      setError(\'Guardian name must be at least 2 characters.\');\\n      return;\\n    }\\n    if (!isValidPhoneNumber(guardianPhone)) {\\n      setError(\'Enter a valid guardian phone number (10 to 15 digits).\');\\n      return;\\n    }\\n\\n    const updatedContacts = user.sosContacts.map((c) =>\\n      c.isPrimary\\n        ? { ...c, name: guardianName.trim(), phone: guardianPhone.trim() }\\n        : c\\n    );\\n\\n    onSaveProfile({\\n      ...user,\\n      fullName: fullName.trim(),\\n      phone: phone.trim(),\\n      email: email.trim(),\\n      age: numericAge,\\n      guardianName: guardianName.trim(),\\n      guardianPhone: guardianPhone.trim(),\\n      photoDataUrl: photoDataUrl || undefined,\\n      sosContacts: updatedContacts,\\n    });\\n    setEditing(false);\\n    setSavedNotice(true);\\n    window.setTimeout(() => setSavedNotice(false), 2500);\\n  };\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 bg-[#182215]/55 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto\\\"\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-labelledby=\\\"profile-modal-title\\\"\\n    >\\n      <div className=\\\"w-full max-w-lg bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 sm:p-7 shadow-2xl my-auto max-h-[92vh] overflow-y-auto\\\">\\n        <div className=\\\"flex items-start justify-between gap-4 mb-5\\\">\\n          <div>\\n            <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n              Personal Profile \302\267 OurSafe Account\\n            </p>\\n            <h2\\n              id=\\\"profile-modal-title\\\"\\n              className=\\\"text-xl font-semibold text-[#182215] mt-0.5\\\"\\n            >\\n              {editing ? \'Edit Profile Details\' : \'Your Safety Profile\'}\\n            </h2>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            aria-label=\\\"Close profile\\\"\\n            className=\\\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#54634D] hover:bg-[#EAF0E2] cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Profile Photo + Upload */}\\n        <div className=\\\"flex items-center gap-4 pb-5 border-b border-[#DCE5D1]\\\">\\n          <div className=\\\"relative shrink-0\\\">\\n            {photoDataUrl ? (\\n              <img\\n                src={photoDataUrl}\\n                alt={`${user.fullName} profile`}\\n                className=\\\"w-16 h-16 rounded-2xl object-cover border border-[#B8C6A8]\\\"\\n              />\\n            ) : (\\n              <div className=\\\"w-16 h-16 rounded-2xl bg-[#EAF0E2] border border-[#B8C6A8] text-[#24371D] font-bold text-xl flex items-center justify-center\\\">\\n                {initials || <User className=\\\"w-7 h-7\\\" />}\\n              </div>\\n            )}\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => fileInputRef.current?.click()}\\n              aria-label=\\\"Upload profile photo\\\"\\n              className=\\\"absolute -bottom-1.5 -right-1.5 w-7 h-7 rounded-lg bg-[#2F4526] hover:bg-[#23351C] text-white flex items-center justify-center shadow-sm cursor-pointer\\\"\\n            >\\n              <Camera className=\\\"w-3.5 h-3.5\\\" />\\n            </button>\\n            <input\\n              ref={fileInputRef}\\n              type=\\\"file\\\"\\n              accept=\\\"image/*\\\"\\n              onChange={handlePhotoSelect}\\n              className=\\\"hidden\\\"\\n            />\\n          </div>\\n\\n          <div className=\\\"min-w-0 flex-1\\\">\\n            <h3 className=\\\"text-lg font-semibold text-[#182215] truncate\\\">\\n              {user.fullName}\\n            </h3>\\n            <p className=\\\"text-xs text-[#54634D] mt-0.5\\\">\\n              Age {user.age} \302\267 {user.email}\\n            </p>\\n          </div>\\n\\n          {!editing && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setEditing(true);\\n                setError(\'\');\\n              }}\\n              className=\\\"min-h-[40px] px-3.5 py-2 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] text-[#24371D] text-xs font-semibold flex items-center gap-1.5 whitespace-nowrap shrink-0 cursor-pointer\\\"\\n            >\\n              <Pencil className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Edit Profile</span>\\n            </button>\\n          )}\\n        </div>\\n\\n        {savedNotice && (\\n          <div className=\\\"mt-4 rounded-xl bg-emerald-50 border border-emerald-200 px-3.5 py-2.5 text-xs font-medium text-emerald-800 flex items-center gap-2\\\">\\n            <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600 shrink-0\\\" />\\n            <span>Profile changes saved.</span>\\n          </div>\\n        )}\\n\\n        {error && (\\n          <p className=\\\"mt-4 rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs font-medium text-red-700\\\">\\n            {error}\\n          </p>\\n        )}\\n\\n        {editing ? (\\n          <form onSubmit={handleSave} className=\\\"mt-5 space-y-4\\\">\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3.5\\\">\\n              <div className=\\\"sm:col-span-2\\\">\\n                <label className=\\\"block text-xs font-semibold text-[#182215] mb-1\\\">\\n                  Full Name\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={fullName}\\n                  onChange={(e) => setFullName(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#182215] mb-1\\\">\\n                  Phone Number\\n                </label>\\n                <input\\n                  type=\\\"tel\\\"\\n                  value={phone}\\n                  onChange={(e) => setPhone(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm font-mono tabular-nums focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#182215] mb-1\\\">\\n                  Age\\n                </label>\\n                <input\\n                  type=\\\"number\\\"\\n                  min={13}\\n                  max={120}\\n                  value={age}\\n                  onChange={(e) => setAge(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm tabular-nums focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div className=\\\"sm:col-span-2\\\">\\n                <label className=\\\"block text-xs font-semibold text-[#182215] mb-1\\\">\\n                  Email Address\\n                </label>\\n                <input\\n                  type=\\\"email\\\"\\n                  value={email}\\n                  onChange={(e) => setEmail(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#182215] mb-1\\\">\\n                  Primary Guardian Name\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={guardianName}\\n                  onChange={(e) => setGuardianName(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n                />\\n              </div>\\n\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#182215] mb-1\\\">\\n                  Guardian Phone Number\\n                </label>\\n                <input\\n                  type=\\\"tel\\\"\\n                  value={guardianPhone}\\n                  onChange={(e) => setGuardianPhone(e.target.value)}\\n                  className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm font-mono tabular-nums focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            <div className=\\\"pt-2 flex items-center justify-end gap-2.5\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  setEditing(false);\\n                  setFullName(user.fullName);\\n                  setPhone(user.phone);\\n                  setEmail(user.email);\\n                  setAge(String(user.age));\\n                  setGuardianName(user.guardianName);\\n                  setGuardianPhone(user.guardianPhone);\\n                  setError(\'\');\\n                }}\\n                className=\\\"min-h-[44px] px-4 py-2 rounded-xl text-sm font-semibold text-[#4B5844] hover:bg-[#EAF0E2] cursor-pointer\\\"\\n              >\\n                Cancel\\n              </button>\\n              <button\\n                type=\\\"submit\\\"\\n                className=\\\"min-h-[44px] px-5 py-2 rounded-xl bg-[#2F4526] hover:bg-[#23351C] text-[#F6F9F2] text-sm font-semibold cursor-pointer\\\"\\n              >\\n                Save Changes\\n              </button>\\n            </div>\\n          </form>\\n        ) : (\\n          <div className=\\\"mt-5 space-y-3\\\">\\n            <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] divide-y divide-[#DCE5D1]\\\">\\n              <div className=\\\"p-3.5 flex items-center justify-between gap-4 text-sm\\\">\\n                <span className=\\\"text-[#54634D] flex items-center gap-2\\\">\\n                  <Phone className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n                  <span>Phone Number</span>\\n                </span>\\n                <span className=\\\"font-mono tabular-nums font-semibold text-[#182215]\\\">\\n                  {user.phone}\\n                </span>\\n              </div>\\n\\n              <div className=\\\"p-3.5 flex items-center justify-between gap-4 text-sm\\\">\\n                <span className=\\\"text-[#54634D] flex items-center gap-2\\\">\\n                  <Mail className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n                  <span>Email</span>\\n                </span>\\n                <span className=\\\"font-semibold text-[#182215] truncate\\\">\\n                  {user.email}\\n                </span>\\n              </div>\\n\\n              <div className=\\\"p-3.5 flex items-center justify-between gap-4 text-sm\\\">\\n                <span className=\\\"text-[#54634D] flex items-center gap-2\\\">\\n                  <User className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n                  <span>Age</span>\\n                </span>\\n                <span className=\\\"font-semibold tabular-nums text-[#182215]\\\">\\n                  {user.age} years\\n                </span>\\n              </div>\\n\\n              <div className=\\\"p-3.5 flex items-center justify-between gap-4 text-sm\\\">\\n                <span className=\\\"text-[#54634D] flex items-center gap-2\\\">\\n                  <UserCheck className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n                  <span>Guardian Name</span>\\n                </span>\\n                <span className=\\\"font-semibold text-[#182215]\\\">\\n                  {user.guardianName}\\n                </span>\\n              </div>\\n\\n              <div className=\\\"p-3.5 flex items-center justify-between gap-4 text-sm\\\">\\n                <span className=\\\"text-[#54634D] flex items-center gap-2\\\">\\n                  <Phone className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n                  <span>Guardian Phone</span>\\n                </span>\\n                <span className=\\\"font-mono tabular-nums font-semibold text-[#182215]\\\">\\n                  {user.guardianPhone}\\n                </span>\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update ProfileModal to OurSafe sage theme and remove prototype text\", \"Overwrite\":true, \"TargetFile\":\"/src/components/dashboard/ProfileModal.tsx\", \"toolAction\":\"Updating ProfileModal to sage theme\", \"toolSummary\":\"Update ProfileModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16957589474990674060"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  Bell,\\n  CheckCircle2,\\n  ChevronRight,\\n  KeyRound,\\n  LogOut,\\n  Shield,\\n  User,\\n  Users,\\n  X,\\n} from \'lucide-react\';\\nimport { SafetyPreferences, UserProfile } from \'../../types/safety\';\\n\\ninterface SettingsModalProps {\\n  user: UserProfile;\\n  onUpdatePreferences: (partial: Partial<SafetyPreferences>) => void;\\n  onChangePassword: (newPassword: string) => void;\\n  onOpenEditProfile: () => void;\\n  onOpenManageContacts: () => void;\\n  onLogout: () => void;\\n  onClose: () => void;\\n}\\n\\nexport const SettingsModal: React.FC<SettingsModalProps> = ({\\n  user,\\n  onUpdatePreferences,\\n  onChangePassword,\\n  onOpenEditProfile,\\n  onOpenManageContacts,\\n  onLogout,\\n  onClose,\\n}) => {\\n  const [showPasswordForm, setShowPasswordForm] = useState(false);\\n  const [currentPwd, setCurrentPwd] = useState(\'\');\\n  const [newPwd, setNewPwd] = useState(\'\');\\n  const [confirmPwd, setConfirmPwd] = useState(\'\');\\n  const [pwdFeedback, setPwdFeedback] = useState<{\\n    type: \'error\' | \'success\';\\n    text: string;\\n  } | null>(null);\\n\\n  const handlePasswordSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setPwdFeedback(null);\\n\\n    if (currentPwd !== user.password) {\\n      setPwdFeedback({ type: \'error\', text: \'Current password is incorrect.\' });\\n      return;\\n    }\\n    if (newPwd.length < 6) {\\n      setPwdFeedback({\\n        type: \'error\',\\n        text: \'New password must be at least 6 characters.\',\\n      });\\n      return;\\n    }\\n    if (newPwd !== confirmPwd) {\\n      setPwdFeedback({\\n        type: \'error\',\\n        text: \'New password and confirmation do not match.\',\\n      });\\n      return;\\n    }\\n\\n    onChangePassword(newPwd);\\n    setCurrentPwd(\'\');\\n    setNewPwd(\'\');\\n    setConfirmPwd(\'\');\\n    setPwdFeedback({\\n      type: \'success\',\\n      text: \'Password updated successfully.\',\\n    });\\n  };\\n\\n  const ToggleRow: React.FC<{\\n    label: string;\\n    description: string;\\n    checked: boolean;\\n    onToggle: () => void;\\n  }> = ({ label, description, checked, onToggle }) => (\\n    <div className=\\\"py-3 flex items-center justify-between gap-4\\\">\\n      <div className=\\\"min-w-0\\\">\\n        <p className=\\\"text-sm font-semibold text-[#182215]\\\">{label}</p>\\n        <p className=\\\"text-xs text-[#54634D]\\\">{description}</p>\\n      </div>\\n      <button\\n        type=\\\"button\\\"\\n        role=\\\"switch\\\"\\n        aria-checked={checked}\\n        onClick={onToggle}\\n        className={`w-12 h-7 rounded-full p-1 transition-colors shrink-0 cursor-pointer flex items-center ${\\n          checked ? \'bg-[#2F4526] justify-end\' : \'bg-[#C4D1B6] justify-start\'\\n        }`}\\n      >\\n        <span className=\\\"w-5 h-5 rounded-full bg-white shadow-sm block\\\" />\\n      </button>\\n    </div>\\n  );\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 bg-[#182215]/55 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto\\\"\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-labelledby=\\\"settings-modal-title\\\"\\n    >\\n      <div className=\\\"w-full max-w-xl bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 sm:p-7 shadow-2xl my-auto max-h-[92vh] overflow-y-auto space-y-6\\\">\\n        <div className=\\\"flex items-start justify-between gap-4\\\">\\n          <div>\\n            <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n              Account &amp; Safety Configuration\\n            </p>\\n            <h2\\n              id=\\\"settings-modal-title\\\"\\n              className=\\\"text-xl font-semibold text-[#182215] mt-0.5\\\"\\n            >\\n              Settings\\n            </h2>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            aria-label=\\\"Close settings\\\"\\n            className=\\\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#54634D] hover:bg-[#EAF0E2] cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Account Shortcuts */}\\n        <div className=\\\"divide-y divide-[#DCE5D1] rounded-2xl border border-[#CFD9C3] overflow-hidden\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onOpenEditProfile}\\n            className=\\\"w-full min-h-[56px] px-4 py-3 bg-white hover:bg-[#F4F7EF] flex items-center justify-between gap-3 text-left transition-colors cursor-pointer\\\"\\n          >\\n            <div className=\\\"flex items-center gap-3\\\">\\n              <div className=\\\"w-9 h-9 rounded-xl bg-[#EAF0E2] text-[#2F4526] flex items-center justify-center shrink-0\\\">\\n                <User className=\\\"w-4 h-4\\\" />\\n              </div>\\n              <div>\\n                <p className=\\\"text-sm font-semibold text-[#182215]\\\">Edit Profile</p>\\n                <p className=\\\"text-xs text-[#54634D]\\\">\\n                  Update your name, phone, email, age, or guardian details\\n                </p>\\n              </div>\\n            </div>\\n            <ChevronRight className=\\\"w-4 h-4 text-[#5D6C55] shrink-0\\\" />\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onOpenManageContacts}\\n            className=\\\"w-full min-h-[56px] px-4 py-3 bg-white hover:bg-[#F4F7EF] flex items-center justify-between gap-3 text-left transition-colors cursor-pointer\\\"\\n          >\\n            <div className=\\\"flex items-center gap-3\\\">\\n              <div className=\\\"w-9 h-9 rounded-xl bg-[#EAF0E2] text-[#2F4526] flex items-center justify-center shrink-0\\\">\\n                <Users className=\\\"w-4 h-4\\\" />\\n              </div>\\n              <div>\\n                <p className=\\\"text-sm font-semibold text-[#182215]\\\">\\n                  Manage Emergency Contacts\\n                </p>\\n                <p className=\\\"text-xs text-[#54634D]\\\">\\n                  {user.sosContacts.length} contact(s) configured for SOS and Travel Mode\\n                </p>\\n              </div>\\n            </div>\\n            <ChevronRight className=\\\"w-4 h-4 text-[#5D6C55] shrink-0\\\" />\\n          </button>\\n\\n          <div className=\\\"bg-white\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setShowPasswordForm((prev) => !prev);\\n                setPwdFeedback(null);\\n              }}\\n              className=\\\"w-full min-h-[56px] px-4 py-3 hover:bg-[#F4F7EF] flex items-center justify-between gap-3 text-left transition-colors cursor-pointer\\\"\\n            >\\n              <div className=\\\"flex items-center gap-3\\\">\\n                <div className=\\\"w-9 h-9 rounded-xl bg-[#EAF0E2] text-[#2F4526] flex items-center justify-center shrink-0\\\">\\n                  <KeyRound className=\\\"w-4 h-4\\\" />\\n                </div>\\n                <div>\\n                  <p className=\\\"text-sm font-semibold text-[#182215]\\\">\\n                    Change Password\\n                  </p>\\n                  <p className=\\\"text-xs text-[#54634D]\\\">\\n                    Update the password for your account and Evidence Vault\\n                  </p>\\n                </div>\\n              </div>\\n              <span className=\\\"text-xs font-semibold text-[#2F4526]\\\">\\n                {showPasswordForm ? \'Hide\' : \'Open\'}\\n              </span>\\n            </button>\\n\\n            {showPasswordForm && (\\n              <form\\n                onSubmit={handlePasswordSubmit}\\n                className=\\\"px-4 pb-4 pt-2 bg-[#F4F7EF] border-t border-[#DCE5D1] space-y-3\\\"\\n              >\\n                {pwdFeedback && (\\n                  <div\\n                    className={`rounded-xl px-3 py-2 text-xs font-medium flex items-center gap-2 ${\\n                      pwdFeedback.type === \'success\'\\n                        ? \'bg-emerald-50 border border-emerald-200 text-emerald-800\'\\n                        : \'bg-red-50 border border-red-200 text-red-700\'\\n                    }`}\\n                  >\\n                    {pwdFeedback.type === \'success\' && (\\n                      <CheckCircle2 className=\\\"w-3.5 h-3.5 shrink-0\\\" />\\n                    )}\\n                    <span>{pwdFeedback.text}</span>\\n                  </div>\\n                )}\\n\\n                <input\\n                  type=\\\"password\\\"\\n                  value={currentPwd}\\n                  onChange={(e) => setCurrentPwd(e.target.value)}\\n                  placeholder=\\\"Current password\\\"\\n                  aria-label=\\\"Current password\\\"\\n                  className=\\\"w-full min-h-[42px] px-3.5 py-2 rounded-xl bg-white border border-[#C5D2B7] text-sm focus:border-[#2F4526] focus:outline-none\\\"\\n                />\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\\\">\\n                  <input\\n                    type=\\\"password\\\"\\n                    value={newPwd}\\n                    onChange={(e) => setNewPwd(e.target.value)}\\n                    placeholder=\\\"New password (min 6)\\\"\\n                    aria-label=\\\"New password\\\"\\n                    className=\\\"w-full min-h-[42px] px-3.5 py-2 rounded-xl bg-white border border-[#C5D2B7] text-sm focus:border-[#2F4526] focus:outline-none\\\"\\n                  />\\n                  <input\\n                    type=\\\"password\\\"\\n                    value={confirmPwd}\\n                    onChange={(e) => setConfirmPwd(e.target.value)}\\n                    placeholder=\\\"Confirm new password\\\"\\n                    aria-label=\\\"Confirm new password\\\"\\n                    className=\\\"w-full min-h-[42px] px-3.5 py-2 rounded-xl bg-white border border-[#C5D2B7] text-sm focus:border-[#2F4526] focus:outline-none\\\"\\n                  />\\n                </div>\\n                <div className=\\\"flex justify-end\\\">\\n                  <button\\n                    type=\\\"submit\\\"\\n                    className=\\\"min-h-[40px] px-4 py-1.5 rounded-xl bg-[#2F4526] hover:bg-[#23351C] text-[#F6F9F2] text-xs font-semibold cursor-pointer\\\"\\n                  >\\n                    Save New Password\\n                  </button>\\n                </div>\\n              </form>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Notification Preferences */}\\n        <div className=\\\"space-y-1\\\">\\n          <div className=\\\"flex items-center gap-2 text-sm font-bold text-[#182215]\\\">\\n            <Bell className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n            <span>Notification Preferences</span>\\n          </div>\\n          <div className=\\\"divide-y divide-[#DCE5D1] rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] px-4\\\">\\n            <ToggleRow\\n              label=\\\"Travel Check-in Reminders\\\"\\n              description=\\\"Remind me to confirm safe progress during active Travel Mode\\\"\\n              checked={user.preferences.travelCheckInReminders}\\n              onToggle={() =>\\n                onUpdatePreferences({\\n                  travelCheckInReminders: !user.preferences.travelCheckInReminders,\\n                })\\n              }\\n            />\\n            <ToggleRow\\n              label=\\\"Guardian Activity Log\\\"\\n              description=\\\"Record safety notifications when contacts or alerts update\\\"\\n              checked={user.preferences.guardianUpdates}\\n              onToggle={() =>\\n                onUpdatePreferences({\\n                  guardianUpdates: !user.preferences.guardianUpdates,\\n                })\\n              }\\n            />\\n            <ToggleRow\\n              label=\\\"Threat Mode Attention Alarm\\\"\\n              description=\\\"Enable the manual siren tone option inside Threat Mode\\\"\\n              checked={user.preferences.soundAlarmEnabled}\\n              onToggle={() =>\\n                onUpdatePreferences({\\n                  soundAlarmEnabled: !user.preferences.soundAlarmEnabled,\\n                })\\n              }\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Privacy Settings */}\\n        <div className=\\\"space-y-1\\\">\\n          <div className=\\\"flex items-center gap-2 text-sm font-bold text-[#182215]\\\">\\n            <Shield className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n            <span>Privacy Settings</span>\\n          </div>\\n          <div className=\\\"divide-y divide-[#DCE5D1] rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] px-4\\\">\\n            <ToggleRow\\n              label=\\\"GPS Only During Active Safety Actions\\\"\\n              description=\\\"Request GPS location only when opening SOS, Threat, Travel, or Nearby\\\"\\n              checked={user.preferences.locationOnlyDuringEmergency}\\n              onToggle={() =>\\n                onUpdatePreferences({\\n                  locationOnlyDuringEmergency:\\n                    !user.preferences.locationOnlyDuringEmergency,\\n                })\\n              }\\n            />\\n            <ToggleRow\\n              label=\\\"Discreet Notification Text\\\"\\n              description=\\\"Hide detailed alert text inside notification previews\\\"\\n              checked={user.preferences.maskLockscreenPreviews}\\n              onToggle={() =>\\n                onUpdatePreferences({\\n                  maskLockscreenPreviews: !user.preferences.maskLockscreenPreviews,\\n                })\\n              }\\n            />\\n          </div>\\n        </div>\\n\\n        {/* Logout */}\\n        <div className=\\\"pt-2 border-t border-[#DCE5D1] flex flex-wrap items-center justify-between gap-3\\\">\\n          <p className=\\\"text-xs text-[#54634D]\\\">\\n            Your safety profile stays saved so you can sign back in anytime.\\n          </p>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onLogout}\\n            className=\\\"min-h-[44px] px-5 py-2.5 rounded-xl bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 text-sm font-semibold flex items-center gap-2 transition-colors cursor-pointer whitespace-nowrap\\\"\\n          >\\n            <LogOut className=\\\"w-4 h-4\\\" />\\n            <span>Log Out</span>\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update SettingsModal to OurSafe sage theme and remove prototype text\", \"Overwrite\":true, \"TargetFile\":\"/src/components/dashboard/SettingsModal.tsx\", \"toolAction\":\"Updating SettingsModal to sage theme\", \"toolSummary\":\"Update SettingsModal.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_16957589474990676691"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { Bell, CheckCheck, Trash2, X } from \'lucide-react\';\\nimport { AppNotification } from \'../../types/safety\';\\nimport { formatTimeShort } from \'../../utils/storage\';\\n\\ninterface NotificationsModalProps {\\n  notifications: AppNotification[];\\n  maskPreviews: boolean;\\n  onMarkAllRead: () => void;\\n  onClearAll: () => void;\\n  onClose: () => void;\\n}\\n\\nexport const NotificationsModal: React.FC<NotificationsModalProps> = ({\\n  notifications,\\n  maskPreviews,\\n  onMarkAllRead,\\n  onClearAll,\\n  onClose,\\n}) => {\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 z-50 bg-[#182215]/55 backdrop-blur-sm flex items-center justify-center p-4\\\"\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-labelledby=\\\"notifications-modal-title\\\"\\n    >\\n      <div className=\\\"w-full max-w-md bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 shadow-2xl max-h-[85vh] flex flex-col\\\">\\n        <div className=\\\"flex items-start justify-between gap-4 mb-4\\\">\\n          <div className=\\\"flex items-center gap-2.5\\\">\\n            <div className=\\\"w-10 h-10 rounded-xl bg-[#EAF0E2] text-[#2F4526] flex items-center justify-center shrink-0\\\">\\n              <Bell className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <h2\\n                id=\\\"notifications-modal-title\\\"\\n                className=\\\"text-lg font-semibold text-[#182215]\\\"\\n              >\\n                Safety Activity Log\\n              </h2>\\n              <p className=\\\"text-xs text-[#54634D]\\\">\\n                Session notifications ({notifications.length})\\n              </p>\\n            </div>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            aria-label=\\\"Close notifications\\\"\\n            className=\\\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#54634D] hover:bg-[#EAF0E2] cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {notifications.length > 0 && (\\n          <div className=\\\"flex items-center justify-end gap-2 mb-3\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onMarkAllRead}\\n              className=\\\"min-h-[36px] px-3 py-1 rounded-lg bg-[#EAF0E2] hover:bg-[#DCE7D2] text-[#24371D] text-xs font-semibold flex items-center gap-1 cursor-pointer\\\"\\n            >\\n              <CheckCheck className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Mark All Read</span>\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onClearAll}\\n              className=\\\"min-h-[36px] px-3 py-1 rounded-lg hover:bg-red-50 text-[#54634D] hover:text-red-700 text-xs font-semibold flex items-center gap-1 cursor-pointer\\\"\\n            >\\n              <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Clear</span>\\n            </button>\\n          </div>\\n        )}\\n\\n        <div className=\\\"flex-1 overflow-y-auto space-y-2.5 pr-0.5\\\">\\n          {notifications.length === 0 ? (\\n            <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] p-6 text-center text-xs text-[#54634D]\\\">\\n              No safety notifications recorded yet.\\n            </div>\\n          ) : (\\n            notifications.map((item) => (\\n              <div\\n                key={item.id}\\n                className={`rounded-2xl p-3.5 border text-sm ${\\n                  item.read\\n                    ? \'bg-white border-[#DCE5D1]\'\\n                    : \'bg-[#F4F7EF] border-[#B8C6A8]\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-baseline justify-between gap-3\\\">\\n                  <p className=\\\"font-bold text-[#182215] text-xs\\\">\\n                    {item.title}\\n                  </p>\\n                  <span className=\\\"text-[11px] font-mono tabular-nums text-[#5D6C55] shrink-0\\\">\\n                    {formatTimeShort(item.timestamp)}\\n                  </span>\\n                </div>\\n                <p className=\\\"mt-1 text-xs text-[#465340] leading-relaxed\\\">\\n                  {maskPreviews\\n                    ? \'Discreet preview enabled in Privacy Settings.\'\\n                    : item.detail}\\n                </p>\\n              </div>\\n            ))\\n          )}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update NotificationsModal to OurSafe botanical sage theme\", \"Overwrite\":true, \"TargetFile\":\"/src/components/dashboard/NotificationsModal.tsx\", \"toolAction\":\"Updating NotificationsModal to sage theme\", \"toolSummary\":\"Update NotificationsModal.tsx\"}"
      original_name: "write_to_file"
    }
