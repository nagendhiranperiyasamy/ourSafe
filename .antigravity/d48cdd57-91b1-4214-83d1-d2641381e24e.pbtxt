      thinking_signature: "\022\301\n\n\276\n\001i\024}\023\365\355\350\304\000b\\}B\246\033Q,Yq\252\312*\352\273\270\227\002\256\344\267ps!\307\034\254\214L\034~&\373*\374\251-_\"\034\373\373a\330,\303A\224\236\334X\001+[\275\242\346\312\353\344\031\030\177\330\002\217BO\005>Mm\273\031\000C\241\037)\000:Y\273\363\202\321|\364\214z\235\212\256\372\310\260\034\207\365f\260\375\032\224.\326=\2501jL\3358\326w(\314\024\253\277\003\263q/\233?\251W\022\326\035q\327a\212\214\026\332\225!\024\206\320X\026\217\371cB\036O\314U\017\217\233\330\335\214\354\224T\003G\236P\362\246\342\375ZJ\3242\206\233\204\303\213\201\036\325\205\352\201\276#\240\037\316\334\276\244\362d\350\\\361\217\300\347\355\250r\250\036\343\031Uv\353\224\260{&\253WL\321\202;\272\364\261\356\225\034\257A!\t\342\255\001X\346Y+:9z\243r\307\210\367,\343b\310-\257g$\221\204\n\'\337\237\020&vH\240p\271F\337Z5Uc\a\333O\321\242\336\342\220\202\215\265\313\272\277{\300<a\334+]K\002Y\213\350\272w\320o\016j4\205O\373\227ouZ\366\f\362\230\222\337%\\\324Q\322\342WA\n\347e\037B\376\270\203\331\2449\302\033\234\377\211\262\242\032\023*l7+\021\340\247\220\324\241\rw\376n\362\\#plMB9\243\371Z\006\244?\260\336\005\373\025Qi\206#{C\243#\225\361\245\203\374\302o*\341\211OE-\321\224\302:~\r\006\204X\214\224D\355\276\'\373\316\206\\N\021\020\255\0216\v;.rj-\240C\225b\242D\365\342\243D\324\367\236\230\345\f\034\t\037\351b]\a\227I\314\025\026\304U\035s\363@v\232\302\264\335\361\035\215H\005o\246\035\310\215W\3239rg\250\363\236\a}\000\232V\224\357=\342!\213r\226&\"\256\306\r\306\326\021\226@\220\345\237\032\252\177(I\261s\357\376\251\356_\327\335\346\223\001x\335,?\031\323\376\337\245\313\205\f\377\324\217\357\346s\2729\036-\266LO\333n\005\177\002\271\037\264\223\020\327\375\231\023\351\257JJ\"_\037\252\034\021\026\323\337\245cm\331\226\260\215\315*\316,f\3656\t\243[H~p\302\204\222\243o\027\352\271\033\365g\203\312\002E\024\207\302\255\330\334aK\v\2063\352c\227L\025\254\272{0\236\025dw\353\377e\260\2315q\203c\3317\303\233\254\036\