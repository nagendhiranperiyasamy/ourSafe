    tool_calls {
      id: "call_9405163852928914998"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Persist wake-word, minimal lock-screen badge style, and auto-share location preferences in Android Capacitor plugin\", \"EndLine\":154, \"Instruction\":\"Save wakeWordEnabled, wakeWordPhrase, lockScreenDisplayStyle, and autoShareLocationOnTrigger into SharedPreferences in OurSafeShieldPlugin.kt\", \"ReplacementContent\":\"    private fun saveConfigToPrefs(call: PluginCall) {\\n        val prefs = context.getSharedPreferences(\\n            OurSafeBackgroundShieldService.PREFS_NAME,\\n            Context.MODE_PRIVATE\\n        )\\n        prefs.edit()\\n            .putBoolean(\\\"shakeEnabled\\\", call.getBoolean(\\\"shakeEnabled\\\", true) ?: true)\\n            .putBoolean(\\\"voiceCodeEnabled\\\", call.getBoolean(\\\"voiceCodeEnabled\\\", true) ?: true)\\n            .putString(\\\"secretVoiceCode\\\", call.getString(\\\"secretVoiceCode\\\", \\\"Red Rose\\\"))\\n            .putString(\\\"voiceLanguage\\\", call.getString(\\\"voiceLanguage\\\", \\\"en-IN\\\"))\\n            .putBoolean(\\\"wakeWordEnabled\\\", call.getBoolean(\\\"wakeWordEnabled\\\", true) ?: true)\\n            .putString(\\\"wakeWordPhrase\\\", call.getString(\\\"wakeWordPhrase\\\", \\\"OurSafe\\\"))\\n            .putBoolean(\\\"screenTapEnabled\\\", call.getBoolean(\\\"screenTapEnabled\\\", true) ?: true)\\n            .putInt(\\\"screenTapCount\\\", call.getInt(\\\"screenTapCount\\\", 3) ?: 3)\\n            .putString(\\\"lockScreenDisplayStyle\\\", call.getString(\\\"lockScreenDisplayStyle\\\", \\\"icon_and_name\\\"))\\n            .putBoolean(\\\"autoShareLocationOnTrigger\\\", call.getBoolean(\\\"autoShareLocationOnTrigger\\\", true) ?: true)\\n            .putBoolean(\\\"autoDialEnabled\\\", call.getBoolean(\\\"autoDialEnabled\\\", true) ?: true)\\n            .putString(\\\"userName\\\", call.getString(\\\"userName\\\", \\\"OurSafe User\\\"))\\n            .putString(\\\"guardianName\\\", call.getString(\\\"guardianName\\\", \\\"\\\"))\\n            .putString(\\\"guardianPhone\\\", call.getString(\\\"guardianPhone\\\", \\\"\\\"))\\n            .putString(\\\"policePhone\\\", call.getString(\\\"policePhone\\\", \\\"100\\\"))\\n            .apply()\\n    }\\n}\", \"StartLine\":133, \"TargetContent\":\"    private fun saveConfigToPrefs(call: PluginCall) {\\n        val prefs = context.getSharedPreferences(\\n            OurSafeBackgroundShieldService.PREFS_NAME,\\n            Context.MODE_PRIVATE\\n        )\\n        prefs.edit()\\n            .putBoolean(\\\"shakeEnabled\\\", call.getBoolean(\\\"shakeEnabled\\\", true) ?: true)\\n            .putBoolean(\\\"voiceCodeEnabled\\\", call.getBoolean(\\\"voiceCodeEnabled\\\", true) ?: true)\\n            .putString(\\\"secretVoiceCode\\\", call.getString(\\\"secretVoiceCode\\\", \\\"Red Rose\\\"))\\n            .putString(\\\"voiceLanguage\\\", call.getString(\\\"voiceLanguage\\\", \\\"en-IN\\\"))\\n            .putBoolean(\\\"screenTapEnabled\\\", call.getBoolean(\\\"screenTapEnabled\\\", true) ?: true)\\n            .putInt(\\\"screenTapCount\\\", call.getInt(\\\"screenTapCount\\\", 3) ?: 3)\\n            .putBoolean(\\\"autoDialEnabled\\\", call.getBoolean(\\\"autoDialEnabled\\\", true) ?: true)\\n            .putString(\\\"userName\\\", call.getString(\\\"userName\\\", \\\"OurSafe User\\\"))\\n            .putString(\\\"guardianName\\\", call.getString(\\\"guardianName\\\", \\\"\\\"))\\n            .putString(\\\"guardianPhone\\\", call.getString(\\\"guardianPhone\\\", \\\"\\\"))\\n            .putString(\\\"policePhone\\\", call.getString(\\\"policePhone\\\", \\\"100\\\"))\\n            .apply()\\n    }\\n}\", \"TargetFile\":\"/android-native/OurSafeShieldPlugin.kt\", \"toolAction\":\"Updating Android plugin preferences sync\", \"toolSummary\":\"Update OurSafeShieldPlugin.kt\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_9405163852928916885"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Make Android lock-screen overlay a tiny SOS icon / OurSafe badge instead of full screen, and support OurSafe Hey-Google style voice app launch\", \"Instruction\":\"Update speech matching for OurSafe wake-word launch, shrink Android lock-screen overlay to a compact SOS icon or OurSafe badge, and ensure live GPS SMS sends when autoShareLocationOnTrigger is true in OurSafeBackgroundShieldService.kt\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":231, \"ReplacementContent\":\"    private fun armSecretVoiceCodeListener() {\\n        val prefs = getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)\\n        val voiceEnabled = prefs.getBoolean(\\\"voiceCodeEnabled\\\", true)\\n        val wakeEnabled = prefs.getBoolean(\\\"wakeWordEnabled\\\", true)\\n        if (!voiceEnabled && !wakeEnabled) {\\n            stopSecretVoiceCodeListener()\\n            return\\n        }\\n        if (ActivityCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {\\n            return\\n        }\\n        mainHandler.post { startSpeechLoop() }\\n    }\", \"StartLine\":220, \"TargetContent\":\"    private fun armSecretVoiceCodeListener() {\\n        val prefs = getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)\\n        val voiceEnabled = prefs.getBoolean(\\\"voiceCodeEnabled\\\", true)\\n        if (!voiceEnabled) {\\n            stopSecretVoiceCodeListener()\\n            return\\n        }\\n        if (ActivityCompat.checkSelfPermission(this, Manifest.permission.RECORD_AUDIO) != PackageManager.PERMISSION_GRANTED) {\\n            return\\n        }\\n        mainHandler.post { startSpeechLoop() }\\n    }\"}, {\"AllowMultiple\":false, \"EndLine\":300, \"ReplacementContent\":\"    private fun checkSpeechMatches(bundle: Bundle?, secretCode: String) {\\n        val matches = bundle?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION) ?: return\\n        val prefs = getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)\\n        val voiceCodeEnabled = prefs.getBoolean(\\\"voiceCodeEnabled\\\", true)\\n        val wakeWordEnabled = prefs.getBoolean(\\\"wakeWordEnabled\\\", true)\\n        val wakeWord = (prefs.getString(\\\"wakeWordPhrase\\\", \\\"OurSafe\\\") ?: \\\"OurSafe\\\")\\n            .lowercase(Locale.ROOT).trim()\\n        val compactCode = secretCode.replace(\\\" \\\", \\\"\\\")\\n        val compactWake = wakeWord.replace(\\\" \\\", \\\"\\\")\\n\\n        for (spoken in matches) {\\n            val normalized = spoken.lowercase(Locale.ROOT).trim()\\n            val compactSpoken = normalized.replace(\\\" \\\", \\\"\\\")\\n\\n            if (voiceCodeEnabled && (normalized.contains(secretCode) || compactSpoken.contains(compactCode))) {\\n                executeNativeEmergencyDispatch(\\n                    kind = \\\"voice_code\\\",\\n                    label = \\\"Secret Voice Code (\\\\\\\"$secretCode\\\\\\\")\\\",\\n                    detail = \\\"Heard secret phrase \\\\\\\"$spoken\\\\\\\" on ${currentSurfaceName().replace(\'_\', \' \')}.\\\",\\n                    surface = currentSurfaceName()\\n                )\\n                break\\n            }\\n\\n            if (wakeWordEnabled && (\\n                normalized.contains(wakeWord) ||\\n                normalized.contains(\\\"our safe\\\") ||\\n                compactSpoken.contains(compactWake) ||\\n                compactSpoken.contains(\\\"oursafe\\\")\\n            )) {\\n                launchOurSafeVoiceAssistant(spoken)\\n                break\\n            }\\n        }\\n    }\\n\\n    private fun launchOurSafeVoiceAssistant(spoken: String) {\\n        val launchIntent = packageManager.getLaunchIntentForPackage(packageName)?.apply {\\n            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_ACTIVITY_SINGLE_TOP)\\n            putExtra(\\\"oursafe_voice_wake\\\", true)\\n            putExtra(\\\"oursafe_spoken_command\\\", spoken)\\n        }\\n        if (launchIntent != null) {\\n            try {\\n                startActivity(launchIntent)\\n            } catch (_: Exception) {}\\n        }\\n    }\", \"StartLine\":284, \"TargetContent\":\"    private fun checkSpeechMatches(bundle: Bundle?, secretCode: String) {\\n        val matches = bundle?.getStringArrayList(SpeechRecognizer.RESULTS_RECOGNITION) ?: return\\n        val compactCode = secretCode.replace(\\\" \\\", \\\"\\\")\\n        for (spoken in matches) {\\n            val normalized = spoken.lowercase(Locale.ROOT).trim()\\n            if (normalized.contains(secretCode) || normalized.replace(\\\" \\\", \\\"\\\").contains(compactCode)) {\\n                executeNativeEmergencyDispatch(\\n                    kind = \\\"voice_code\\\",\\n                    label = \\\"Secret Voice Code (\\\\\\\"$secretCode\\\\\\\")\\\",\\n                    detail = \\\"Heard secret phrase \\\\\\\"$spoken\\\\\\\" on ${currentSurfaceName().replace(\'_\', \' \')}.\\\",\\n                    surface = currentSurfaceName()\\n                )\\n                break\\n            }\\n        }\\n    }\"}, {\"AllowMultiple\":false, \"EndLine\":386, \"ReplacementContent\":\"    /**\\n     * Attaches a minimal, unobtrusive floating SOS icon (or compact SOS + OurSafe badge)\\n     * on the phone\'s Lock Screen & Home Screen \342\200\224 NEVER captures the whole screen.\\n     */\\n    private fun attachLockAndHomeOverlayShield() {\\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M && !Settings.canDrawOverlays(this)) {\\n            return\\n        }\\n        mainHandler.post {\\n            removeOverlayShield()\\n            val prefs = getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)\\n            val requiredTaps = prefs.getInt(\\\"screenTapCount\\\", 3)\\n            val displayStyle = prefs.getString(\\\"lockScreenDisplayStyle\\\", \\\"icon_and_name\\\") ?: \\\"icon_and_name\\\"\\n\\n            val badgeBg = android.graphics.drawable.GradientDrawable().apply {\\n                setColor(Color.parseColor(\\\"#E6DC2626\\\"))\\n                cornerRadius = 999f\\n                setStroke(3, Color.parseColor(\\\"#FFFFFF\\\"))\\n            }\\n\\n            val container = LinearLayout(this).apply {\\n                orientation = LinearLayout.HORIZONTAL\\n                gravity = Gravity.CENTER_VERTICAL\\n                setPadding(if (displayStyle == \\\"icon_only\\\") 24 else 26, 16, if (displayStyle == \\\"icon_only\\\") 24 else 26, 16)\\n                background = badgeBg\\n            }\\n\\n            val label = TextView(this).apply {\\n                text = if (displayStyle == \\\"icon_only\\\") \\\"SOS\\\" else \\\"SOS \302\267 OurSafe\\\"\\n                setTextColor(Color.WHITE)\\n                textSize = 12f\\n            }\\n            container.addView(label)\\n\\n            container.setOnTouchListener { _, event ->\\n                if (event.action == MotionEvent.ACTION_DOWN) {\\n                    val now = System.currentTimeMillis()\\n                    while (overlayTapTimes.isNotEmpty() && now - overlayTapTimes.first() > 800L) {\\n                        overlayTapTimes.removeFirst()\\n                    }\\n                    overlayTapTimes.addLast(now)\\n                    if (overlayTapTimes.size >= requiredTaps) {\\n                        overlayTapTimes.clear()\\n                        executeNativeEmergencyDispatch(\\n                            kind = \\\"screen_tap\\\",\\n                            label = if (requiredTaps == 2) \\\"Double-Tap Shield SOS\\\" else \\\"Triple-Tap Shield SOS\\\",\\n                            detail = \\\"Tapped minimal OurSafe SOS icon ${requiredTaps}x on ${currentSurfaceName().replace(\'_\', \' \')}.\\\",\\n                            surface = currentSurfaceName()\\n                        )\\n                    }\\n                    true\\n                } else {\\n                    false\\n                }\\n            }\\n\\n            val overlayType = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {\\n                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY\\n            } else {\\n                @Suppress(\\\"DEPRECATION\\\")\\n                WindowManager.LayoutParams.TYPE_PHONE\\n            }\\n\\n            @Suppress(\\\"DEPRECATION\\\")\\n            val params = WindowManager.LayoutParams(\\n                WindowManager.LayoutParams.WRAP_CONTENT,\\n                WindowManager.LayoutParams.WRAP_CONTENT,\\n                overlayType,\\n                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or\\n                    WindowManager.LayoutParams.FLAG_SHOW_WHEN_LOCKED or\\n                    WindowManager.LayoutParams.FLAG_TURN_SCREEN_ON,\\n                PixelFormat.TRANSLUCENT\\n            ).apply {\\n                gravity = Gravity.BOTTOM or Gravity.END\\n                x = 28\\n                y = 140\\n            }\\n\\n            try {\\n                windowManager?.addView(container, params)\\n                overlayView = container\\n            } catch (_: Exception) {}\\n        }\\n    }\", \"StartLine\":310, \"TargetContent\":\"    /**\\n     * Attaches a compact, persistent floating OurSafe Lock/Home Shield pill over BOTH\\n     * the phone\'s Home Screen AND the phone\'s Main Lock Screen (when SYSTEM_ALERT_WINDOW is granted).\\n     */\\n    private fun attachLockAndHomeOverlayShield() {\\n        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M && !Settings.canDrawOverlays(this)) {\\n            return\\n        }\\n        mainHandler.post {\\n            removeOverlayShield()\\n            val prefs = getSharedPreferences(PREFS_NAME, Context.MODE_PRIVATE)\\n            val requiredTaps = prefs.getInt(\\\"screenTapCount\\\", 3)\\n\\n            val container = LinearLayout(this).apply {\\n                orientation = LinearLayout.HORIZONTAL\\n                setPadding(28, 18, 28, 18)\\n                setBackgroundColor(Color.parseColor(\\\"#E6182215\\\"))\\n            }\\n\\n            val label = TextView(this).apply {\\n                text = \\\"OurSafe Shield \302\267 ${requiredTaps}x Tap SOS\\\"\\n                setTextColor(Color.parseColor(\\\"#F5F9F2\\\"))\\n                textSize = 12f\\n            }\\n            container.addView(label)\\n\\n            container.setOnTouchListener { _, event ->\\n                if (event.action == MotionEvent.ACTION_DOWN) {\\n                    val now = System.currentTimeMillis()\\n                    while (overlayTapTimes.isNotEmpty() && now - overlayTapTimes.first() > 800L) {\\n                        overlayTapTimes.removeFirst()\\n                    }\\n                    overlayTapTimes.addLast(now)\\n                    if (overlayTapTimes.size >= requiredTaps) {\\n                        overlayTapTimes.clear()\\n                        executeNativeEmergencyDispatch(\\n                            kind = \\\"screen_tap\\\",\\n                            label = if (requiredTaps == 2) \\\"Double-Tap Shield SOS\\\" else \\\"Triple-Tap Shield SOS\\\",\\n                            detail = \\\"Tapped OurSafe Overlay Shield ${requiredTaps}x on ${currentSurfaceName().replace(\'_\', \' \')}.\\\",\\n                            surface = currentSurfaceName()\\n                        )\\n                    }\\n                    true\\n                } else {\\n                    false\\n                }\\n            }\\n\\n            val overlayType = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {\\n                WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY\\n            } else {\\n                @Suppress(\\\"DEPRECATION\\\")\\n                WindowManager.LayoutParams.TYPE_PHONE\\n            }\\n\\n            @Suppress(\\\"DEPRECATION\\\")\\n            val params = WindowManager.LayoutParams(\\n                WindowManager.LayoutParams.WRAP_CONTENT,\\n                WindowManager.LayoutParams.WRAP_CONTENT,\\n                overlayType,\\n                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or\\n                    WindowManager.LayoutParams.FLAG_SHOW_WHEN_LOCKED or\\n                    WindowManager.LayoutParams.FLAG_TURN_SCREEN_ON,\\n                PixelFormat.TRANSLUCENT\\n            ).apply {\\n                gravity = Gravity.TOP or Gravity.END\\n                x = 24\\n                y = 140\\n            }\\n\\n            try {\\n                windowManager?.addView(container, params)\\n                overlayView = container\\n            } catch (_: Exception) {}\\n        }\\n    }\"}], \"TargetFile\":\"/android-native/OurSafeBackgroundShieldService.kt\", \"toolAction\":\"Updating Android lock-screen icon overlay and wake word\", \"toolSummary\":\"Update OurSafeBackgroundShieldService.kt\"}"
      original_name: "multi_replace_file_content"
    }
