      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Expand OurSafe wake word matching to include phonetic variants like House Safe and Tamil transliterations\", \"EndLine\":410, \"Instruction\":\"Add house safe, hey house safe, ok house safe, how safe, all safe, and Tamil phonetic forms into matchWakeWordAndExtract.\", \"ReplacementContent\":\"  const matchWakeWordAndExtract = useCallback(\\n    (normalizedHeard: string): { matched: boolean; followUpCommand: string } => {\\n      const rawWake = prefsRef.current.wakeWordPhrase?.trim() || \'OurSafe\';\\n      const normalizedWake = normalizeText(rawWake);\\n      const candidates = [\\n        normalizedWake,\\n        \'hey oursafe\',\\n        \'hey our safe\',\\n        \'ok oursafe\',\\n        \'ok our safe\',\\n        \'hey house safe\',\\n        \'ok house safe\',\\n        \'our safe\',\\n        \'oursafe\',\\n        \'house safe\',\\n        \'housesafe\',\\n        \'hour safe\',\\n        \'are safe\',\\n        \'how safe\',\\n        \'all safe\',\\n        \'\340\256\271\340\256\265\340\257\201\340\256\270\340\257\215 \340\256\232\340\257\207\340\256\203\340\256\252\340\257\215\',\\n        \'\340\256\205\340\256\265\340\256\260\340\257\215 \340\256\232\340\257\207\340\256\203\340\256\252\340\257\215\',\\n        \'\340\256\205\340\256\265\340\256\260\340\257\215\340\256\232\340\257\207\340\256\203\340\256\252\340\257\215\',\\n      ].filter(Boolean);\\n\\n      for (const candidate of candidates) {\\n        const idx = normalizedHeard.indexOf(candidate);\\n        if (idx !== -1) {\\n          const after = normalizedHeard.slice(idx + candidate.length).trim();\\n          return { matched: true, followUpCommand: after };\\n        }\\n      }\\n\\n      const compactHeard = normalizedHeard.replace(/\\\\s+/g, \'\');\\n      const compactWake = normalizedWake.replace(/\\\\s+/g, \'\');\\n      if (\\n        (compactWake && compactHeard.includes(compactWake)) ||\\n        compactHeard.includes(\'housesafe\') ||\\n        compactHeard.includes(\'oursafe\')\\n      ) {\\n        return { matched: true, followUpCommand: \'\' };\\n      }\\n      return { matched: false, followUpCommand: \'\' };\\n    },\\n    []\\n  );\", \"StartLine\":376, \"TargetContent\":\"  const matchWakeWordAndExtract = useCallback(\\n    (normalizedHeard: string): { matched: boolean; followUpCommand: string } => {\\n      const rawWake = prefsRef.current.wakeWordPhrase?.trim() || \'OurSafe\';\\n      const normalizedWake = normalizeText(rawWake);\\n      const candidates = [\\n        normalizedWake,\\n        \'our safe\',\\n        \'oursafe\',\\n        \'hey oursafe\',\\n        \'hey our safe\',\\n        \'ok oursafe\',\\n        \'ok our safe\',\\n        \'hour safe\',\\n        \'are safe\',\\n      ].filter(Boolean);\\n\\n      for (const candidate of candidates) {\\n        const idx = normalizedHeard.indexOf(candidate);\\n        if (idx !== -1) {\\n          const after = normalizedHeard.slice(idx + candidate.length).trim();\\n          return { matched: true, followUpCommand: after };\\n        }\\n      }\\n\\n      const compactHeard = normalizedHeard.replace(/\\\\s+/g, \'\');\\n      const compactWake = normalizedWake.replace(/\\\\s+/g, \'\');\\n      if (compactWake && compactHeard.includes(compactWake)) {\\n        return { matched: true, followUpCommand: \'\' };\\n      }\\n      return { matched: false, followUpCommand: \'\' };\\n    },\\n    []\\n  );\", \"TargetFile\":\"/src/hooks/useEmergencyQuickTriggers.ts\", \"toolAction\":\"Expanding wake-word phonetic recognition\", \"toolSummary\":\"Expand wake-word recognition\"}"
