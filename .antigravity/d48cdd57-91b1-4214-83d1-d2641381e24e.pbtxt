    end_line: 746
    content: "import React, { useCallback, useEffect, useRef, useState } from \'react\';\nimport {\n  AlertCircle,\n  AlertTriangle,\n  Bot,\n  CheckCircle2,\n  MapPin,\n  Mic,\n  MicOff,\n  Phone,\n  Radio,\n  Send,\n  ShieldAlert,\n  Volume2,\n  WifiOff,\n} from \'lucide-react\';\nimport { VoiceCommandAction } from \'../../types/safety\';\nimport { formatTimeShort } from \'../../utils/storage\';\n\ninterface AiVoiceAssistantPageProps {\n  userName: string;\n  primaryGuardianName?: string;\n  primaryGuardianPhone?: string;\n  threatActive: boolean;\n  sosActive: boolean;\n  isOnline: boolean;\n  onExecuteVoiceCommand: (\n    call: VoiceCommandAction\n  ) => Promise<{ ok: boolean; summary: string; data?: Record<string, unknown> }>;\n  onManualSos: () => void;\n  onDualCallNow: () => void;\n}\n\ninterface TranscriptItem {\n  id: string;\n  role: \'user\' | \'assistant\' | \'action\';\n  text: string;\n  timestamp: string;\n}\n\nconst SAMPLE_VOICE_COMMANDS = [\n  \'Call Both Guardian and Police\',\n  \'Open SOS\',\n  \'Activate Threat Mode\',\n  \'Call My Guardian\',\n  \'Send Emergency Alert\',\n  \'Share My Live Location\',\n  \'Open Nearby Police Stations\',\n  \'Deactivate Threat Mode\',\n];\n\nfunction float32ToPcm16Base64(float32: Float32Array): string {\n  const buffer = new ArrayBuffer(float32.length * 2);\n  const view = new DataView(buffer);\n  for (let i = 0; i < float32.length; i += 1) {\n    const s = Math.max(-1, Math.min(1, float32[i]));\n    view.setInt16(i * 2, s < 0 ? s * 0x8000 : s * 0x7fff, true);\n  }\n  const bytes = new Uint8Array(buffer);\n  let binary = \'\';\n  const chunkSize = 0x8000;\n  for (let i = 0; i < bytes.length; i += chunkSize) {\n    binary += String.fromCharCode(...bytes.subarray(i, i + chunkSize));\n  }\n  return btoa(binary);\n}\n\nfunction base64Pcm16ToFloat32(base64: string): Float32Array<ArrayBuffer> {\n  const binary = atob(base64);\n  const byteLength = binary.length;\n  const bytes = new Uint8Array(byteLength);\n  for (let i = 0; i < byteLength; i += 1) {\n    bytes[i] = binary.charCodeAt(i);\n  }\n  const view = new DataView(bytes.buffer);\n  const sampleCount = Math.floor(byteLength / 2);\n  const float32 = new Float32Array(new ArrayBuffer(sampleCount * 4));\n  for (let i = 0; i < sampleCount; i += 1) {\n    float32[i] = view.getInt16(i * 2, true) / 32768;\n  }\n  return float32;\n}\n\nexport const AiVoiceAssistantPage: React.FC<AiVoiceAssistantPageProps> = ({\n  userName,\n  primaryGuardianName,\n  primaryGuardianPhone,\n  threatActive,\n  sosActive,\n  isOnline,\n  onExecuteVoiceCommand,\n  onManualSos,\n  onDualCallNow,\n}) => {\n  const [liveStatus, setLiveStatus] = useState<\n    \'idle\' | \'connecting\' | \'connected\' | \'error\'\n  >(\'idle\');\n  const [liveError, setLiveError] = useState(\'\');\n  const [isSpeaking, setIsSpeaking] = useState(false);\n  const [textInput, setTextInput] = useState(\'\');\n  const [textBusy, setTextBusy] = useState(false);\n  const [entries, setEntries] = useState<TranscriptItem[]>([\n    {\n      id: \'init-voice\',\n      role: \'assistant\',\n      text: `Ready, ${userName}. Tap \"Start Live Voice\" to speak in real time using Gemini Live. Say \"Call both guardian and police\", \"Open SOS\", or \"Activate Threat Mode\" to control OurSafe directly.`,\n      timestamp: new Date().toISOString(),\n    },\n  ]);\n\n  const wsRef = useRef<WebSocket | null>(null);\n  const inputCtxRef = useRef<AudioContext | null>(null);\n  const outputCtxRef = useRef<AudioContext | null>(null);\n  const micStreamRef = useRef<MediaStream | null>(null);\n  const processorRef = useRef<ScriptProcessorNode | null>(null);\n  const nextStartTimeRef = useRef<number>(0);\n  const activeSourcesRef = useRef<AudioBufferSourceNode[]>([]);\n  const liveConnectedRef = useRef<boolean>(false);\n  const executeCommandRef = useRef(onExecuteVoiceCommand);\n  const listEndRef = useRef<HTMLDivElement | null>(null);\n\n  useEffect(() => {\n    executeCommandRef.current = onExecuteVoiceCommand;\n  }, [onExecuteVoiceCommand]);\n\n  useEffect(() => {\n    listEndRef.current?.scrollIntoView({ behavior: \'smooth\', block: \'nearest\' });\n  }, [entries]);\n\n  const appendEntry = useCallback(\n    (role: TranscriptItem[\'role\'], text: string) => {\n      const cleaned = text.trim();\n      if (!cleaned) return;\n      setEntries((prev) => {\n        const last = prev[prev.length - 1];\n        if (\n          last &&\n          last.role === role &&\n          role !== \'action\' &&\n          Date.now() - new Date(last.timestamp).getTime() < 2600\n        ) {\n          return [\n            ...prev.slice(0, -1),\n            {\n              ...last,\n              text: `${last.text} ${cleaned}`.replace(/\\s+/g, \' \').trim(),\n              timestamp: new Date().toISOString(),\n            },\n          ];\n        }\n        return [\n          ...prev,\n          {\n            id: `${role}-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\n            role,\n            text: cleaned,\n            timestamp: new Date().toISOString(),\n          },\n        ];\n      });\n    },\n    []\n  );\n\n  const stopPlaybackQueue = useCallback(() => {\n    activeSourcesRef.current.forEach((src) => {\n      try {\n        src.stop();\n      } catch {\n        // ignore\n      }\n    });\n    activeSourcesRef.current = [];\n    if (outputCtxRef.current) {\n      nextStartTimeRef.current = outputCtxRef.current.currentTime;\n    } else {\n      nextStartTimeRef.current = 0;\n    }\n    setIsSpeaking(false);\n  }, []);\n\n  const schedulePcmPlayback = useCallback((base64Pcm: string) => {\n    const outCtx = outputCtxRef.current;\n    if (!outCtx) return;\n    if (outCtx.state === \'suspended\') {\n      outCtx.resume().catch(() => {});\n    }\n\n    const floatData = base64Pcm16ToFloat32(base64Pcm);\n    if (floatData.length === 0) return;\n\n    const audioBuffer = outCtx.createBuffer(1, floatData.length, 24000);\n    audioBuffer.copyToChannel(floatData, 0);\n\n    const source = outCtx.createBufferSource();\n    source.buffer = audioBuffer;\n    source.connect(outCtx.destination);\n\n    const now = outCtx.currentTime;\n    const startAt = Math.max(now + 0.01, nextStartTimeRef.current);\n    nextStartTimeRef.current = startAt + audioBuffer.duration;\n\n    setIsSpeaking(true);\n    activeSourcesRef.current.push(source);\n    source.onended = () => {\n      activeSourcesRef.current = activeSourcesRef.current.filter(\n        (s) => s !== source\n      );\n      if (activeSourcesRef.current.length === 0) {\n        setIsSpeaking(false);\n      }\n    };\n    source.start(startAt);\n  }, []);\n\n  const disconnectLiveVoice = useCallback(() => {\n    liveConnectedRef.current = false;\n    stopPlaybackQueue();\n\n    if (processorRef.current) {\n      try {\n        processorRef.current.disconnect();\n      } catch {\n        // ignore\n      }\n      processorRef.current = null;\n    }\n    if (micStreamRef.current) {\n      micStreamRef.current.getTracks().forEach((t) => t.stop());\n      micStreamRef.current = null;\n    }\n    if (inputCtxRef.current) {\n      inputCtxRef.current.close().catch(() => {});\n      inputCtxRef.current = null;\n    }\n    if (outputCtxRef.current) {\n      outputCtxRef.current.close().catch(() => {});\n      outputCtxRef.current = null;\n    }\n    if (wsRef.current) {\n      try {\n        wsRef.current.close();\n      } catch {\n        // ignore\n      }\n      wsRef.current = null;\n    }\n    setLiveStatus(\'idle\');\n  }, [stopPlaybackQueue]);\n\n  useEffect(() => {\n    return () => {\n      disconnectLiveVoice();\n    };\n  }, [disconnectLiveVoice]);\n\n  const startLiveVoice = async () => {\n    setLiveError(\'\');\n    if (!isOnline) {\n      setLiveError(\n        \'Live AI Voice requires an internet connection. Offline emergency calling and SOS contacts remain available on the SOS page.\'\n      );\n      setLiveStatus(\'error\');\n      return;\n    }\n\n    if (!navigator.mediaDevices?.getUserMedia) {\n      setLiveError(\'Microphone capture is not supported in this browser.\');\n      setLiveStatus(\'error\');\n      return;\n    }\n\n    disconnectLiveVoice();\n    setLiveStatus(\'connecting\');\n\n    try {\n      const micStream = await navigator.mediaDevices.getUserMedia({\n        audio: {\n          channelCount: 1,\n          sampleRate: 16000,\n          echoCancellation: true,\n          noiseSuppression: true,\n        },\n      });\n      micStreamRef.current = micStream;\n\n      const AudioCtx =\n        window.AudioContext ||\n        (window as unknown as { webkitAudioContext: typeof AudioContext })\n          .webkitAudioContext;\n\n      const inputCtx = new AudioCtx({ sampleRate: 16000 });\n      const outputCtx = new AudioCtx({ sampleRate: 24000 });\n      inputCtxRef.current = inputCtx;\n      outputCtxRef.current = outputCtx;\n      nextStartTimeRef.current = outputCtx.currentTime;\n\n      const wsProtocol = window.location.protocol === \'https:\' ? \'wss:\' : \'ws:\';\n      const ws = new WebSocket(`${wsProtocol}//${window.location.host}/api/live-voice`);\n      wsRef.current = ws;\n\n      ws.onopen = () => {\n        ws.send(\n          JSON.stringify({\n            type: \'init\',\n            userContext: {\n              userName,\n              primaryGuardianName,\n              primaryGuardianPhone,\n              threatActive,\n              sosActive,\n            },\n          })\n        );\n      };\n\n      ws.onmessage = async (event) => {\n        try {\n          const msg = JSON.parse(event.data) as {\n            type: string;\n            data?: string;\n            text?: string;\n            message?: string;\n            calls?: VoiceCommandAction[];\n          };\n\n          if (msg.type === \'ready\') {\n            liveConnectedRef.current = true;\n            setLiveStatus(\'connected\');\n            appendEntry(\n              \'action\',\n              \'Gemini 3.8 Live voice controller connected. Say \"Call both guardian and police\" or any safety command.\'\n            );\n\n            if (inputCtxRef.current && micStreamRef.current) {\n              const source = inputCtxRef.current.createMediaStreamSource(\n                micStreamRef.current\n              );\n              const processor = inputCtxRef.current.createScriptProcessor(\n                4096,\n                1,\n                1\n              );\n              processorRef.current = processor;\n\n              processor.onaudioprocess = (audioEvent) => {\n                if (\n                  !liveConnectedRef.current ||\n                  !wsRef.current ||\n                  wsRef.current.readyState !== WebSocket.OPEN\n                ) {\n                  return;\n                }\n                const channelData = audioEvent.inputBuffer.getChannelData(0);\n                const pcmBase64 = float32ToPcm16Base64(channelData);\n                wsRef.current.send(\n                  JSON.stringify({ type: \'audio\', audio: pcmBase64 })\n                );\n              };\n\n              source.connect(processor);\n              processor.connect(inputCtxRef.current.destination);\n            }\n          } else if (msg.type === \'audio\' && msg.data) {\n            schedulePcmPlayback(msg.data);\n          } else if (msg.type === \'interrupted\') {\n            stopPlaybackQueue();\n          } else if (msg.type === \'inputTranscript\' && msg.text) {\n            appendEntry(\'user\', msg.text);\n          } else if (msg.type === \'outputTranscript\' && msg.text) {\n            appendEntry(\'assistant\', msg.text);\n          } else if (msg.type === \'toolCall\' && Array.isArray(msg.calls)) {\n            const responses = [];\n            for (const call of msg.calls) {\n              const outcome = await executeCommandRef.current(call);\n              appendEntry(\'action\', outcome.summary);\n              responses.push({\n                id: call.id,\n                name: call.name,\n                response: {\n                  result: outcome.summary,\n                  ok: outcome.ok,\n                  ...(outcome.data ?? {}),\n                },\n              });\n            }\n            if (wsRef.current && wsRef.current.readyState === WebSocket.OPEN) {\n              wsRef.current.send(\n                JSON.stringify({ type: \'toolResponse\', responses })\n              );\n            }\n          } else if (msg.type === \'error\') {\n            setLiveError(msg.message || \'Live voice session encountered an error.\');\n            setLiveStatus(\'error\');\n            disconnectLiveVoice();\n          } else if (msg.type === \'closed\') {\n            disconnectLiveVoice();\n          }\n        } catch {\n          // ignore\n        }\n      };\n\n      ws.onerror = () => {\n        setLiveError(\n          \'Unable to connect to the live voice server. Check connectivity and try again.\'\n        );\n        setLiveStatus(\'error\');\n        disconnectLiveVoice();\n      };\n\n      ws.onclose = () => {\n        if (liveConnectedRef.current) {\n          disconnectLiveVoice();\n        }\n      };\n    } catch {\n      setLiveError(\n        \'Microphone permission denied or unavailable. You can still run any command via text or quick buttons below.\'\n      );\n      setLiveStatus(\'error\');\n      disconnectLiveVoice();\n    }\n  };\n\n  const runTextCommand = async (commandText: string) => {\n    const trimmed = commandText.trim();\n    if (!trimmed) return;\n\n    setLiveError(\'\');\n    setTextInput(\'\');\n    appendEntry(\'user\', trimmed);\n\n    if (\n      liveStatus === \'connected\' &&\n      wsRef.current &&\n      wsRef.current.readyState === WebSocket.OPEN\n    ) {\n      wsRef.current.send(JSON.stringify({ type: \'text\', text: trimmed }));\n      return;\n    }\n\n    if (!isOnline) {\n      setLiveError(\n        \'AI command processing requires internet connectivity. Use the dedicated SOS or Threat Mode tabs offline.\'\n      );\n      return;\n    }\n\n    setTextBusy(true);\n    try {\n      const res = await fetch(\'/api/assistant/command\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          text: trimmed,\n          userContext: {\n            userName,\n            primaryGuardianName,\n            primaryGuardianPhone,\n            threatActive,\n            sosActive,\n          },\n        }),\n      });\n      const data = (await res.json()) as {\n        reply?: string;\n        toolCalls?: VoiceCommandAction[];\n        error?: string;\n      };\n\n      if (!res.ok) {\n        throw new Error(data.error || \'AI command failed.\');\n      }\n\n      if (Array.isArray(data.toolCalls) && data.toolCalls.length > 0) {\n        for (const call of data.toolCalls) {\n          const outcome = await executeCommandRef.current(call);\n          appendEntry(\'action\', outcome.summary);\n        }\n      }\n\n      if (data.reply) {\n        appendEntry(\'assistant\', data.reply);\n      }\n    } catch (err) {\n      const msg =\n        err instanceof Error\n          ? err.message\n          : \'Could not reach the AI command endpoint.\';\n      setLiveError(msg);\n    } finally {\n      setTextBusy(false);\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Live Voice Controller Hero Card */}\n      <section className=\"bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 sm:p-8 shadow-sm\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\">\n          <div className=\"lg:col-span-7 space-y-3\">\n            <div className=\"flex flex-wrap items-center gap-2 text-xs font-semibold\">\n              <span className=\"text-[#3E5632]\">\n                OurSafe AI Voice Controller \302\267 Complete App Control\n              </span>\n              <span aria-hidden=\"true\" className=\"text-[#78886F]\">\n                \302\267\n              </span>\n              <span\n                className={\n                  liveStatus === \'connected\'\n                    ? \'text-emerald-700\'\n                    : liveStatus === \'connecting\'\n                      ? \'text-amber-700\'\n                      : \'text-[#54634D]\'\n                }\n              >\n                {liveStatus === \'connected\'\n                  ? isSpeaking\n                    ? \'Live Audio Active \302\267 Assistant Speaking\'\n                    : \'Live Audio Active \302\267 Listening\'\n                  : liveStatus === \'connecting\'\n                    ? \'Connecting to Live Voice...\'\n                    : \'Standby\'}\n              </span>\n            </div>\n\n            <h1 className=\"text-2xl sm:text-3xl font-semibold text-[#182215] tracking-tight\">\n              Hands-Free Voice Control for Guardian &amp; Police Calls\n            </h1>\n            <p className=\"text-sm text-[#465340] leading-relaxed\">\n              Speak naturally in real time to call both your guardian and police, open SOS, activate Threat Mode (with AI nearby police numbers), share live location, or trigger a Fake Call.\n            </p>\n          </div>\n\n          <div className=\"lg:col-span-5 flex flex-col gap-3\">\n            {liveStatus === \'connected\' || liveStatus === \'connecting\' ? (\n              <button\n                type=\"button\"\n                onClick={disconnectLiveVoice}\n                className=\"w-full min-h-[54px] px-6 py-3 rounded-2xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold flex items-center justify-center gap-2.5 transition-colors cursor-pointer\"\n              >\n                <MicOff className=\"w-5 h-5\" />\n                <span>End Live Voice Session</span>\n              </button>\n            ) : (\n              <button\n                type=\"button\"\n                onClick={startLiveVoice}\n                className=\"w-full min-h-[54px] px-6 py-3 rounded-2xl bg-[#2F4526] hover:bg-[#23351C] text-[#F6F9F2] text-sm font-bold flex items-center justify-center gap-2.5 shadow-sm transition-colors cursor-pointer\"\n              >\n                <Mic className=\"w-5 h-5\" />\n                <span>Start Live Voice Conversation</span>\n              </button>\n            )}\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n              <button\n                type=\"button\"\n                onClick={onDualCallNow}\n                className=\"min-h-[46px] px-4 py-2.5 rounded-2xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer whitespace-nowrap\"\n              >\n                <Phone className=\"w-4 h-4\" />\n                <span>Call Guardian &amp; Police</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={onManualSos}\n                className=\"min-h-[46px] px-4 py-2.5 rounded-2xl bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 text-xs font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer whitespace-nowrap\"\n              >\n                <ShieldAlert className=\"w-4 h-4\" />\n                <span>Manual SOS</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        {!isOnline && (\n          <div className=\"mt-5 rounded-2xl bg-amber-50 border border-amber-200 p-3.5 text-xs text-amber-900 flex items-center gap-2\">\n            <WifiOff className=\"w-4 h-4 shrink-0 text-amber-700\" />\n            <span>\n              You are currently offline. Live AI Voice needs an active internet connection; use the SOS page for offline guardian numbers and direct dialers.\n            </span>\n          </div>\n        )}\n\n        {liveError && (\n          <div\n            role=\"alert\"\n            className=\"mt-5 rounded-2xl bg-red-50 border border-red-200 p-3.5 text-xs text-red-800 flex items-start gap-2\"\n          >\n            <AlertCircle className=\"w-4 h-4 text-red-600 shrink-0 mt-0.5\" />\n            <span>{liveError}</span>\n          </div>\n        )}\n      </section>\n\n      {/* Quick Executable Commands + Live Conversation Feed */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        <div className=\"lg:col-span-5 bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 space-y-4\">\n          <div>\n            <p className=\"text-xs font-semibold text-[#3E5632]\">\n              Instant App Control Commands\n            </p>\n            <h2 className=\"mt-1 text-lg font-semibold text-[#182215]\">\n              Say or Tap a Safety Command\n            </h2>\n            <p className=\"mt-1 text-xs text-[#54634D]\">\n              Each command triggers the matching OurSafe safety workflow immediately via AI tool execution.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-2.5\">\n            {SAMPLE_VOICE_COMMANDS.map((cmd) => {\n              const isUrgent =\n                cmd.toLowerCase().includes(\'sos\') ||\n                cmd.toLowerCase().includes(\'alert\') ||\n                cmd.toLowerCase().includes(\'both guardian\');\n              return (\n                <button\n                  key={cmd}\n                  type=\"button\"\n                  disabled={textBusy}\n                  onClick={() => runTextCommand(cmd)}\n                  className={`min-h-[44px] px-4 py-2.5 rounded-xl border text-left text-xs font-semibold flex items-center justify-between gap-2 transition-colors cursor-pointer disabled:opacity-60 ${\n                    isUrgent\n                      ? \'bg-red-50/70 hover:bg-red-100 border-red-200 text-red-800\'\n                      : \'bg-[#F4F7EF] hover:bg-[#E7EFE0] border-[#CFD9C3] text-[#182215]\'\n                  }`}\n                >\n                  <span>&ldquo;{cmd}&rdquo;</span>\n                  {cmd.toLowerCase().includes(\'police\') &&\n                  !cmd.toLowerCase().includes(\'both\') ? (\n                    <MapPin className=\"w-3.5 h-3.5 shrink-0 text-[#2F4526]\" />\n                  ) : cmd.toLowerCase().includes(\'guardian\') ||\n                    cmd.toLowerCase().includes(\'call\') ? (\n                    <Phone\n                      className={`w-3.5 h-3.5 shrink-0 ${\n                        isUrgent ? \'text-red-600\' : \'text-[#2F4526]\'\n                      }`}\n                    />\n                  ) : cmd.toLowerCase().includes(\'location\') ? (\n                    <Radio className=\"w-3.5 h-3.5 shrink-0 text-[#2F4526]\" />\n                  ) : cmd.toLowerCase().includes(\'threat\') ? (\n                    <AlertTriangle className=\"w-3.5 h-3.5 shrink-0 text-[#2F4526]\" />\n                  ) : (\n                    <ShieldAlert className=\"w-3.5 h-3.5 shrink-0 text-red-600\" />\n                  )}\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Right: Live Transcript & Action Execution Log */}\n        <div className=\"lg:col-span-7 bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 flex flex-col\">\n          <div className=\"flex items-center justify-between gap-3 mb-4\">\n            <div>\n              <p className=\"text-xs font-semibold text-[#3E5632]\">\n                Real-Time Transcript &amp; Controller Actions\n              </p>\n              <h2 className=\"mt-0.5 text-lg font-semibold text-[#182215]\">\n                Voice Conversation Log\n              </h2>\n            </div>\n            {liveStatus === \'connected\' && (\n              <span className=\"text-xs font-semibold text-emerald-700 inline-flex items-center gap-1.5\">\n                <Volume2 className=\"w-4 h-4\" />\n                <span>24kHz Audio Output Ready</span>\n              </span>\n            )}\n          </div>\n\n          <div className=\"rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] p-4 h-[350px] overflow-y-auto space-y-3\">\n            {entries.map((item) => (\n              <div\n                key={item.id}\n                className={`flex flex-col ${\n                  item.role === \'user\'\n                    ? \'items-end\'\n                    : item.role === \'action\'\n                      ? \'items-center\'\n                      : \'items-start\'\n                }`}\n              >\n                {item.role === \'action\' ? (\n                  <div className=\"w-full rounded-xl bg-[#E7EFE0] border border-[#C3D0B4] px-3.5 py-2 text-xs font-semibold text-[#1E2E18] flex items-center gap-2\">\n                    <CheckCircle2 className=\"w-4 h-4 text-[#2F4526] shrink-0\" />\n                    <span>{item.text}</span>\n                  </div>\n                ) : (\n                  <div\n                    className={`max-w-[88%] rounded-2xl px-4 py-3 text-sm leading-relaxed ${\n                      item.role === \'user\'\n                        ? \'bg-[#2F4526] text-[#F6F9F2]\'\n                        : \'bg-[#FCFDF9] border border-[#CFD9C3] text-[#182215]\'\n                    }`}\n                  >\n                    {item.role === \'assistant\' && (\n                      <div className=\"flex items-center gap-1.5 text-[11px] font-semibold text-[#3E5632] mb-1\">\n                        <Bot className=\"w-3.5 h-3.5\" />\n                        <span>OurSafe AI Controller</span>\n                      </div>\n                    )}\n                    <p>{item.text}</p>\n                  </div>\n                )}\n                <span className=\"mt-1 text-[11px] text-[#5C6B55] tabular-nums px-1\">\n                  {formatTimeShort(item.timestamp)}\n                </span>\n              </div>\n            ))}\n            <div ref={listEndRef} />\n          </div>\n\n          <form\n            onSubmit={(e) => {\n              e.preventDefault();\n              runTextCommand(textInput);\n            }}\n            className=\"mt-4 flex items-center gap-2.5\"\n          >\n            <input\n              type=\"text\"\n              value={textInput}\n              onChange={(e) => setTextInput(e.target.value)}\n              disabled={textBusy}\n              placeholder=\'Type a command (e.g. \"Call both guardian and police\")...\'\n              aria-label=\"Send a voice or text app command\"\n              className=\"flex-1 min-h-[46px] px-4 py-2.5 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm text-[#182215] placeholder:text-[#6B7A63] focus:bg-white focus:border-[#2F4526] focus:outline-none\"\n            />\n            <button\n              type=\"submit\"\n              disabled={textBusy || !textInput.trim()}\n              className=\"min-h-[46px] px-5 py-2.5 rounded-xl bg-[#2F4526] hover:bg-[#23351C] disabled:opacity-50 text-[#F6F9F2] text-sm font-semibold flex items-center gap-1.5 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n            >\n              <span>{textBusy ? \'Running...\' : \'Send\'}</span>\n              <Send className=\"w-4 h-4\" />\n            </button>\n          </form>\n        </div>\n      </section>\n    </div>\n  );\n};\n"
    num_lines: 747
    num_bytes: 26204
    line_range_bytes: 26204
  }
}
