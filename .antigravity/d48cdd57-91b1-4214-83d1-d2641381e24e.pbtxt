        target_content: "import {\n  GeoLocationState,\n  SosContact,\n  TravelSession,\n} from \'../../types/safety\';\nimport { formatPhoneForTel, formatTimeShort } from \'../../utils/storage\';\n\ninterface TravelModePanelProps {\n  contacts: SosContact[];\n  travelSession: TravelSession | null;\n  geoLocation: GeoLocationState;\n  onRequestLocation: () => void;\n  onStartTravel: (session: TravelSession) => void;\n  onCheckInTravel: () => void;\n  onEndTravel: () => void;\n  onManageContacts: () => void;\n}\n\nexport const TravelModePanel: React.FC<TravelModePanelProps> = ({\n  contacts,\n  travelSession,\n  geoLocation,\n  onRequestLocation,\n  onStartTravel,\n  onCheckInTravel,\n  onEndTravel,\n  onManageContacts,\n}) => {"
        replacement_content: "import {\n  GeoLocationState,\n  SosContact,\n  TravelSession,\n  VehicleVerificationRecord,\n} from \'../../types/safety\';\nimport { formatPhoneForTel, formatTimeShort } from \'../../utils/storage\';\n\ninterface TravelModePanelProps {\n  contacts: SosContact[];\n  travelSession: TravelSession | null;\n  geoLocation: GeoLocationState;\n  verifiedVehicle?: VehicleVerificationRecord | null;\n  onDraftRouteChange?: (start: string, destination: string) => void;\n  onRequestLocation: () => void;\n  onStartTravel: (session: TravelSession) => void;\n  onCheckInTravel: () => void;\n  onEndTravel: () => void;\n  onManageContacts: () => void;\n}\n\nexport const TravelModePanel: React.FC<TravelModePanelProps> = ({\n  contacts,\n  travelSession,\n  geoLocation,\n  verifiedVehicle,\n  onDraftRouteChange,\n  onRequestLocation,\n  onStartTravel,\n  onCheckInTravel,\n  onEndTravel,\n  onManageContacts,\n}) => {"
