sPage\';\\nimport { ThreatModePage } from \'./pages/ThreatModePage\';\\nimport { TravelModePage } from \'./pages/TravelModePage\';\"}, {\"AllowMultiple\":false, \"EndLine\":118, \"ReplacementContent\":\"  // AI Nearby Police Station Numbers state (Gemini Maps Grounding)\\n  const [nearbyPoliceResult, setNearbyPoliceResult] =\\n    useState<NearbyPoliceAiResult | null>(null);\\n  const [nearbyPoliceLoading, setNearbyPoliceLoading] = useState(false);\\n  const [nearbyPoliceError, setNearbyPoliceError] = useState(\'\');\\n  const autoFetchPendingRef = useRef(false);\\n\\n  // Outside-App Lock-Screen Shield & Hands-Free Quick-Trigger SOS state\\n  const [lockScreenShieldOpen, setLockScreenShieldOpen] = useState(false);\\n  const [activeQuickTriggerEvent, setActiveQuickTriggerEvent] =\\n    useState<QuickTriggerEvent | null>(null);\", \"StartLine\":110, \"TargetContent\":\"  // AI Nearby Police Station Numbers state (Gemini Maps Grounding)\\n  const [nearbyPoliceResult, setNearbyPoliceResult] =\\n    useState<NearbyPoliceAiResult | null>(null);\\n  const [nearbyPoliceLoading, setNearbyPoliceLoading] = useState(false);\\n  const [nearbyPoliceError, setNearbyPoliceError] = useState(\'\');\\n  const autoFetchPendingRef = useRef(false);\"}, {\"AllowMultiple\":false, \"EndLine\":1224, \"ReplacementContent\":\"  const primaryGuardian =\\n    user.sosContacts.find((c) => c.isPrimary) ?? user.sosContacts[0];\\n  const unreadCount = notifications.filter((n) => !n.read).length;\\n  const firstName = user.fullName.trim().split(\' \')[0] || user.fullName;\\n\\n  // Global Hands-Free & Outside-App Emergency Triggers (3x Shake, Secret Voice Code, Double/Triple Screen Tap)\\n  const quickTriggers = useEmergencyQuickTriggers({\\n    preferences: user.preferences,\\n    isLockScreenActive: lockScreenShieldOpen,\\n    suspended: Boolean(activeQuickTriggerEvent),\\n    onTriggerSos: (event) => {\\n      requestGeoLocation();\\n      setActiveQuickTriggerEvent(event);\\n    },\\n  });\\n\\n