  planner_response {
    thinking: "**Developing Core Modules**\n\nI\'m excited to dive into building three impactful modules concurrently. First up is `/src/hooks/useGlobalVoiceController.ts`, which I\'m designing to integrate the Gemini 3.8 Live WebSocket with microphone and speaker audio, as well as REST command execution at the `HomeDashboard` level. This approach allows for global voice control within the application, and I\'m eager to get started.\n\n\n**Implementing Global Voice Control**\n\nI\'ve confirmed that the AI voice feature will be active universally across all pages, enabling hands-free app control. I\'m also now focused on the `/src/components/dashboard/TravelRouteMap.tsx` component. I\'m excited about leveraging the `@vis.gl/react-google-maps` library for a live Google Maps route with an API provider and an aliased GoogleMap, modern Route library usage, and AdvancedMarker for dynamic location updates. I\'m planning to use real-time GPS tracking.\n\n\n**Calculating Route Deviation**\n\nI\'m now focusing on calculating the precise Haversine distance from the vehicle\'s current coordinates to the Google Maps route. If deviation exceeds 200 meters, or a test is initiated, I\'ll trigger an off-route alert: a siren, device vibration, and a crimson panel displaying the exact deviation, with options to notify a guardian, contact police, or escalate to SOS. I\'m also addressing quota exhaustion issues from `Route.computeRoutes()`, dispatching a specific event if encountered.\n\n\n"
    message_id: "IxIDa429MKTBjMcPsp_koQk"
    tool_calls {
      id: "call_17223966292749354527"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useCallback, useEffect, useRef, useState } from \'react\';\\nimport { VoiceCommandAction } from \'../types/safety\';\\n\\nexport interface VoiceTranscriptItem {\\n  id: string;\\n  role: \'user\' | \'assistant\' | \'action\';\\n  text: string;\\n  timestamp: string;\\n}\\n\\nexport interface GlobalVoiceControllerState {\\n  liveStatus: \'idle\' | \'connecting\' | \'connected\' | \'error\';\\n  liveError: string;\\n  isSpeaking: boolean;\\n  textBusy: boolean;\\n  entries: VoiceTranscriptItem[];\\n  lastActionSummary: string;\\n  startLiveVoice: () => Promise<void>;\\n  disconnectLiveVoice: () => void;\\n  runTextCommand: (commandText: string) => Promise<void>;\\n}\\n\\ninterface UseGlobalVoiceControllerOptions {\\n  userName: string;\\n  primaryGuardianName?: string;\\n  primaryGuardianPhone?: string;\\n  threatActive: boolean;\\n  sosActive: boolean;\\n  isOnline: boolean;\\n  onExecuteVoiceCommand: (\\n    call: VoiceCommandAction\\n  ) => Promise<{ ok: boolean; summary: string; data?: Record<string, unknown> }>;\\n}\\n\\nfunction float32ToPcm16Base64(float32: Float32Array): string {\\n  const buffer = new ArrayBuffer(float32.length * 2);\\n  const view = new DataView(buffer);\\n  for (let i = 0; i < float32.length; i += 1) {\\n    const s = Math.max(-1, Math.min(1, float32[i]));\\n    view.setInt16(i * 2, s < 0 ? s * 0x8000 : s * 0x7fff, true);\\n  }\\n  const bytes = new Uint8Array(buffer);\\n  let binary = \'\';\\n  const chunkSize = 0x8000;\\n  for (let i = 0; i < bytes.length; i += chunkSize) {\\n    binary += String.fromCharCode(...bytes.subarray(i, i + chunkSize));\\n  }\\n  return btoa(binary);\\n}\\n\\nfunction base64Pcm16ToFloat32(base64: string): Float32Array<ArrayBuffer> {\\n  const binary = atob(base64);\\n  const byteLength = binary.length;\\n  const bytes = new Uint8Array(byteLength);\\n  for (let i = 0; i < byteLength; i += 1) {\\n    bytes[i] = binary.charCodeAt(i);\\n  }\\n  const view = new DataView(bytes.buffer);\\n  const sampleCount = Math.floor(byteLength / 2);\\n  const float32 = new Float32Array(new ArrayBuffer(sampleCount * 4));\\n  for (let i = 0; i < sampleCount; i += 1) {\\n    float32[i] = view.getInt16(i * 2, true) / 32768;\\n  }\\n  return float32;\\n}\\n\\nexport function useGlobalVoiceController({\\n  userName,\\n  primaryGuardianName,\\n  primaryGuardianPhone,\\n  threatActive,\\n  sosActive,\\n  isOnline,\\n  onExecuteVoiceCommand,\\n}: UseGlobalVoiceControllerOptions): GlobalVoiceControllerState {\\n  const [liveStatus, setLiveStatus] = useState<\\n    \'idle\' | \'connecting\' | \'connected\' | \'error\'\\n  >(\'idle\');\\n  const [liveError, setLiveError] = useState(\'\');\\n  const [isSpeaking, setIsSpeaking] = useState(false);\\n  const [textBusy, setTextBusy] = useState(false);\\n  const [lastActionSummary, setLastActionSummary] = useState(\'\');\\n  const [entries, setEntries] = useState<VoiceTranscriptItem[]>([\\n    {\\n      id: \'init-voice\',\\n      role: \'assistant\',\\n      text: `Ready, ${userName}. Tap \\\"Start Live Voice\\\" to control the entire OurSafe app hands-free across every screen. Say \\\"Go to SOS\\\", \\\"Activate Threat Mode\\\", \\\"Share my location\\\", \\\"Open Travel Mode\\\", or \\\"Find police numbers\\\".`,\\n      timestamp: new Date().toISOString(),\\n    },\\n  ]);\\n\\n  const wsRef = useRef<WebSocket | null>(null);\\n  const inputCtxRef = useRef<AudioContext | null>(null);\\n  const outputCtxRef = useRef<AudioContext | null>(null);\\n  const micStreamRef = useRef<MediaStream | null>(null);\\n  const processorRef = useRef<ScriptProcessorNode | null>(null);\\n  const nextStartTimeRef = useRef<number>(0);\\n  const activeSourcesRef = useRef<AudioBufferSourceNode[]>([]);\\n  const liveConnectedRef = useRef<boolean>(false);\\n  const executeCommandRef = useRef(onExecuteVoiceCommand);\\n\\n  useEffect(() => {\\n    executeCommandRef.current = onExecuteVoiceCommand;\\n  }, [onExecuteVoiceCommand]);\\n\\n  const appendEntry = useCallback(\\n    (role: VoiceTranscriptItem[\'role\'], text: string) => {\\n      const cleaned = text.trim();\\n      if (!cleaned) return;\\n      if (role === \'action\') {\\n        setLastActionSummary(cleaned);\\n      }\\n      setEntries((prev) => {\\n        const last = prev[prev.length - 1];\\n        if (\\n          last &&\\n          last.role === role &&\\n          role !== \'action\' &&\\n          Date.now() - new Date(last.timestamp).getTime() < 2600\\n        ) {\\n          return [\\n            ...prev.slice(0, -1),\\n            {\\n              ...last,\\n              text: `${last.text} ${cleaned}`.replace(/\\\\s+/g, \' \').trim(),\\n              timestamp: new Date().toISOString(),\\n            },\\n          ];\\n        }\\n        return [\\n          ...prev,\\n          {\\n            id: `${role}-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\\n            role,\\n            text: cleaned,\\n            timestamp: new Date().toISOString(),\\n          },\\n        ];\\n      });\\n    },\\n    []\\n  );\\n\\n  const stopPlaybackQueue = useCallback(() => {\\n    activeSourcesRef.current.forEach((src) => {\\n      try {\\n        src.stop();\\n      } catch {\\n        // ignore\\n      }\\n    });\\n    activeSourcesRef.current = [];\\n    if (outputCtxRef.current) {\\n      nextStartTimeRef.current = outputCtxRef.current.currentTime;\\n    } else {\\n      nextStartTimeRef.current = 0;\\n    }\\n    setIsSpeaking(false);\\n  }, []);\\n\\n  const schedulePcmPlayback = useCallback((base64Pcm: string) => {\\n    const outCtx = outputCtxRef.current;\\n    if (!outCtx) return;\\n    if (outCtx.state === \'suspended\') {\\n      outCtx.resume().catch(() => {});\\n    }\\n\\n    const floatData = base64Pcm16ToFloat32(base64Pcm);\\n    if (floatData.length === 0) return;\\n\\n    const audioBuffer = outCtx.createBuffer(1, floatData.length, 24000);\\n    audioBuffer.copyToChannel(floatData, 0);\\n\\n    const source = outCtx.createBufferSource();\\n    source.buffer = audioBuffer;\\n    source.connect(outCtx.destination);\\n\\n    const now = outCtx.currentTime;\\n    const startAt = Math.max(now + 0.01, nextStartTimeRef.current);\\n    nextStartTimeRef.current = startAt + audioBuffer.duration;\\n\\n    setIsSpeaking(true);\\n    activeSourcesRef.current.push(source);\\n    source.onended = () => {\\n      activeSourcesRef.current = activeSourcesRef.current.filter(\\n        (s) => s !== source\\n      );\\n      if (activeSourcesRef.current.length === 0) {\\n        setIsSpeaking(false);\\n      }\\n    };\\n    source.start(startAt);\\n  }, []);\\n\\n  const disconnectLiveVoice = useCallback(() => {\\n    liveConnectedRef.current = false;\\n    stopPlaybackQueue();\\n\\n    if (processorRef.current) {\\n      try {\\n        processorRef.current.disconnect();\\n      } catch {\\n        // ignore\\n      }\\n      processorRef.current = null;\\n    }\\n    if (micStreamRef.current) {\\n      micStreamRef.current.getTracks().forEach((t) => t.stop());\\n      micStreamRef.current = null;\\n    }\\n    if (inputCtxRef.current) {\\n      inputCtxRef.current.close().catch(() => {});\\n      inputCtxRef.current = null;\\n    }\\n    if (outputCtxRef.current) {\\n      outputCtxRef.current.close().catch(() => {});\\n      outputCtxRef.current = null;\\n    }\\n    if (wsRef.current) {\\n      try {\\n        wsRef.current.close();\\n      } catch {\\n        // ignore\\n      }\\n      wsRef.current = null;\\n    }\\n    setLiveStatus(\'idle\');\\n  }, [stopPlaybackQueue]);\\n\\n  useEffect(() => {\\n    return () => {\\n      disconnectLiveVoice();\\n    };\\n  }, [disconnectLiveVoice]);\\n\\n  const startLiveVoice = useCallback(async () => {\\n    setLiveError(\'\');\\n    if (!isOnline) {\\n      setLiveError(\\n        \'Live AI Voice requires an internet connection. Offline emergency calling and SOS contacts remain available on the SOS page.\'\\n      );\\n      setLiveStatus(\'error\');\\n      return;\\n    }\\n\\n    if (!navigator.mediaDevices?.getUserMedia) {\\n      setLiveError(\'Microphone capture is not supported in this browser.\');\\n      setLiveStatus(\'error\');\\n      return;\\n    }\\n\\n    disconnectLiveVoice();\\n    setLiveStatus(\'connecting\');\\n\\n    try {\\n      const micStream = await navigator.mediaDevices.getUserMedia({\\n        audio: {\\n          channelCount: 1,\\n          sampleRate: 16000,\\n          echoCancellation: true,\\n          noiseSuppression: true,\\n        },\\n      });\\n      micStreamRef.current = micStream;\\n\\n      const AudioCtx =\\n        window.AudioContext ||\\n        (window as unknown as { webkitAudioContext: typeof AudioContext })\\n          .webkitAudioContext;\\n\\n      const inputCtx = new AudioCtx({ sampleRate: 16000 });\\n      const outputCtx = new AudioCtx({ sampleRate: 24000 });\\n      inputCtxRef.current = inputCtx;\\n      outputCtxRef.current = outputCtx;\\n      nextStartTimeRef.current = outputCtx.currentTime;\\n\\n      const wsProtocol = window.location.protocol === \'https:\' ? \'wss:\' : \'ws:\';\\n      const ws = new WebSocket(`${wsProtocol}//${window.location.host}/api/live-voice`);\\n      wsRef.current = ws;\\n\\n      ws.onopen = () => {\\n        ws.send(\\n          JSON.stringify({\\n            type: \'init\',\\n            userContext: {\\n              userName,\\n              primaryGuardianName,\\n              primaryGuardianPhone,\\n              threatActive,\\n              sosActive,\\n            },\\n          })\\n        );\\n      };\\n\\n      ws.onmessage = async (event) => {\\n        try {\\n          const msg = JSON.parse(event.data) as {\\n            type: string;\\n            data?: string;\\n            text?: string;\\n            message?: string;\\n            calls?: VoiceCommandAction[];\\n          };\\n\\n          if (msg.type === \'ready\') {\\n            liveConnectedRef.current = true;\\n            setLiveStatus(\'connected\');\\n            appendEntry(\\n              \'action\',\\n              \'Full-App AI Voice Controller connected \342\200\224 stays active as you navigate between SOS, Threat, Travel, and Nearby pages.\'\\n            );\\n\\n            if (inputCtxRef.current && micStreamRef.current) {\\n              const source = inputCtxRef.current.createMediaStreamSource(\\n                micStreamRef.current\\n              );\\n              const processor = inputCtxRef.current.createScriptProcessor(\\n                4096,\\n                1,\\n                1\\n              );\\n              processorRef.current = processor;\\n\\n              processor.onaudioprocess = (audioEvent) => {\\n                if (\\n                  !liveConnectedRef.current ||\\n                  !wsRef.current ||\\n                  wsRef.current.readyState !== WebSocket.OPEN\\n                ) {\\n                  return;\\n                }\\n                const channelData = audioEvent.inputBuffer.getChannelData(0);\\n                const pcmBase64 = float32ToPcm16Base64(channelData);\\n                wsRef.current.send(\\n                  JSON.stringify({ type: \'audio\', audio: pcmBase64 })\\n                );\\n              };\\n\\n              source.connect(processor);\\n              processor.connect(inputCtxRef.current.destination);\\n            }\\n          } else if (msg.type === \'audio\' && msg.data) {\\n            schedulePcmPlayback(msg.data);\\n          } else if (msg.type === \'interrupted\') {\\n            stopPlaybackQueue();\\n          } else if (msg.type === \'inputTranscript\' && msg.text) {\\n            appendEntry(\'user\', msg.text);\\n          } else if (msg.type === \'outputTranscript\' && msg.text) {\\n            appendEntry(\'assistant\', msg.text);\\n          } else if (msg.type === \'toolCall\' && Array.isArray(msg.calls)) {\\n            const responses = [];\\n            for (const call of msg.calls) {\\n              const outcome = await executeCommandRef.current(call);\\n              appendEntry(\'action\', outcome.summary);\\n              responses.push({\\n                id: call.id,\\n                name: call.name,\\n                response: {\\n                  result: outcome.summary,\\n                  ok: outcome.ok,\\n                  ...(outcome.data ?? {}),\\n                },\\n              });\\n            }\\n            if (wsRef.current && wsRef.current.readyState === WebSocket.OPEN) {\\n              wsRef.current.send(\\n                JSON.stringify({ type: \'toolResponse\', responses })\\n              );\\n            }\\n          } else if (msg.type === \'error\') {\\n            setLiveError(msg.message || \'Live voice session encountered an error.\');\\n            setLiveStatus(\'error\');\\n            disconnectLiveVoice();\\n          } else if (msg.type === \'closed\') {\\n            disconnectLiveVoice();\\n          }\\n        } catch {\\n          // ignore malformed messages\\n        }\\n      };\\n\\n      ws.onerror = () => {\\n        setLiveError(\\n          \'Unable to connect to the live voice server. Check connectivity and try again.\'\\n        );\\n        setLiveStatus(\'error\');\\n        disconnectLiveVoice();\\n      };\\n\\n      ws.onclose = () => {\\n        if (liveConnectedRef.current) {\\n          disconnectLiveVoice();\\n        }\\n      };\\n    } catch {\\n      setLiveError(\\n        \'Microphone permission denied or unavailable. You can still run any command via text or quick buttons.\'\\n      );\\n      setLiveStatus(\'error\');\\n      disconnectLiveVoice();\\n    }\\n  }, [\\n    isOnline,\\n    disconnectLiveVoice,\\n    userName,\\n    primaryGuardianName,\\n    primaryGuardianPhone,\\n    threatActive,\\n    sosActive,\\n    appendEntry,\\n    schedulePcmPlayback,\\n    stopPlaybackQueue,\\n  ]);\\n\\n  const runTextCommand = useCallback(\\n    async (commandText: string) => {\\n      const trimmed = commandText.trim();\\n      if (!trimmed) return;\\n\\n      setLiveError(\'\');\\n      appendEntry(\'user\', trimmed);\\n\\n      if (\\n        liveStatus === \'connected\' &&\\n        wsRef.current &&\\n        wsRef.current.readyState === WebSocket.OPEN\\n      ) {\\n        wsRef.current.send(JSON.stringify({ type: \'text\', text: trimmed }));\\n        return;\\n      }\\n\\n      if (!isOnline) {\\n        setLiveError(\\n          \'AI command processing requires internet connectivity. Use the dedicated SOS or Threat Mode tabs offline.\'\\n        );\\n        return;\\n      }\\n\\n      setTextBusy(true);\\n      try {\\n        const res = await fetch(\'/api/assistant/command\', {\\n          method: \'POST\',\\n          headers: { \'Content-Type\': \'application/json\' },\\n          body: JSON.stringify({\\n            text: trimmed,\\n            userContext: {\\n              userName,\\n              primaryGuardianName,\\n              primaryGuardianPhone,\\n              threatActive,\\n              sosActive,\\n            },\\n          }),\\n        });\\n        const data = (await res.json()) as {\\n          reply?: string;\\n          toolCalls?: VoiceCommandAction[];\\n          error?: string;\\n        };\\n\\n        if (!res.ok) {\\n          throw new Error(data.error || \'AI command failed.\');\\n        }\\n\\n        if (Array.isArray(data.toolCalls) && data.toolCalls.length > 0) {\\n          for (const call of data.toolCalls) {\\n            const outcome = await executeCommandRef.current(call);\\n            appendEntry(\'action\', outcome.summary);\\n          }\\n        }\\n\\n        if (data.reply) {\\n          appendEntry(\'assistant\', data.reply);\\n        }\\n      } catch (err) {\\n        const msg =\\n          err instanceof Error\\n            ? err.message\\n            : \'Could not reach the AI command endpoint.\';\\n        setLiveError(msg);\\n      } finally {\\n        setTextBusy(false);\\n      }\\n    },\\n    [\\n      liveStatus,\\n      isOnline,\\n      userName,\\n      primaryGuardianName,\\n      primaryGuardianPhone,\\n      threatActive,\\n      sosActive,\\n      appendEntry,\\n    ]\\n  );\\n\\n  return {\\n    liveStatus,\\n    liveError,\\n    isSpeaking,\\n    textBusy,\\n    entries,\\n    lastActionSummary,\\n    startLiveVoice,\\n    disconnectLiveVoice,\\n    runTextCommand,\\n  };\\n}\\n\", \"Description\":\"Create persistent global AI Voice Controller hook so Live Voice stays active across every page in OurSafe\", \"Overwrite\":true, \"TargetFile\":\"/src/hooks/useGlobalVoiceController.ts\", \"toolAction\":\"Creating global persistent AI Voice Controller hook\", \"toolSummary\":\"Create useGlobalVoiceController.ts\"}"
      thinking_signature: "\022\332\032\n\327\032\001i\024}\023\303\335:#>\337\274w\f6\210\n\300`.\327\215\r\221V\016\275\213\257\020\035\334\274\023\020\f\264\262\201\2100\255\356j\347\315\031\016~#\344\334\003\332,\320\363\343\\P\314\323\210\323i\243\304\017M\001}l\313f>\330\312\203\"\326\ts\274E\253\032\310\322^\277\342D\345\347B\354\'V,\316\305%T)\345\312\345\353\360\274\t&\327L\215\337\220\211N\005\227\353ak\037}\235J\032\310\370-\202\274#\353\245\266\264\025/\033U{s\341\364\222x\325=\004\357eH\344~wA5\336$\332$\030\326\374\321\206f\326\334\352\253\202\350\277\026\r\031@;\343\267\262\026\323I\337\026\365\003\005v\242\205\026e\360\200\036\352[\250N\312\200,U\341FB~\226D\023\215\305\256\266n\361\222\004\357v+\211\260\3739dh1\370\375\253\253*\263\332\271\222\361\225_M\270p\310C\207h*]\360v\004\344AI\213\327\242\036\223\326\3452\247l\332k\273\255)~\022\016\315l|C\234\257\251$\023\323\372!7\323J\373\365\020\332&\306\276\364s\n\201\020\343J\256\rVD,\266_\rLH\026 \a\023M\001\200\374L\305S\345o\347{p\332bkoj\3519\034\260\347\201\020jo\202\031\202Xy@\307\234\r\364\237\004b\361\314\024\340\2038\376\v,=Q\267s\033\324T$\0011\365\3413\311\252\001DX)\"\344\370\363\315w\375\270]\001\233\254\210m\355\205#F/9\324\342\354\357\027\334\350d<\"\022\276\021\277\305\206\240+\266\025\000\357\004G\320|eR\355-3\300\n\314o\2263\305\n\221\275\bC?HDV\360!\021\263\026\347\361\256g\333\306\026\305\346z\342(2\243OQ\2354\355e~9\261Q2\260[\036Cr\343*\264\n\305H\227\371\370\244j\362\371\206{h\234\252\371\247O\214\024\322\024\326\337\2672\207b`U\002\\j\237DZ\b\373\336\224\334\260\331\317\233\315\032\265\265\321\017}F\247\227G\275\372\202\314\334\031s\021\r\236\372{Z\000u\253\026\207\031\'\031\230&\274\0058\373+6\216\352\212\003\365\311\373P(<\303\362?\222\346Z\354\325\317K\302\"\217\306P\370\251@0m\205\231\000DR\341uT\237\367\'\000\344\r\356\334\375\256\363\317\233\277U\271\252TV\324\215s\366\307(\266S7\352y\263@\333\324\342\305\\=\346\311[x\233\267\3309!8J\261\311\350\233e\223\027!\t\214\245\302\321\305\264N\031\026\234\322\252/\222\277{\363\352;\351H\336\332W\361U\351\226\325\250\031\326tH\340P\335l\021\222S\326\2545\312\a\360\331?\324\017\340\006\346\374}l\r\tAtf\022\217`C\316\306\202\3168\306l\004te\217\304^\360\025\363y0\242\257 hN\274\254i\037\220\340s\351\377\257@y\207\322\340\024\267F\202\251\026\243\377\331f\r\235}\243\'NB\270gr\274\304\331\220~\316\261\033\302f\323fa6h\227Z\256\221\234 p\252)\020\242\203\320\277J\034\367\364dG\212\303\272\241\a\276\212\330\217\222\017\a\bA\310\376\027d\241\023q\342\257\341\006\036^y\3054sP\232\022r\346/u\270\326\341\f\244GG\016\254w+?\026\3366FyN\331p\261\031\330\244\373\244\r\216\320\205\316\ry\276\245\330\336\214\350\376\325\334\275\327\3564e[\255IV\226\321\244PS\313\272\237t\226<\265zj#\240JY\256\226\351\321\276\357\036\223G\374\240(\256\304SUQ\211\221@\276\v\023\246\273\277c\327lG\200\230\315J\217\211\035\244\350u\252E\234\364Q\324\246\223Zb\3618\204\362\244\031\332\350\351\311}\267\225l%\363\333/\367\307a\347oGCd]\020c0k\251R\004n\315d\200\304\033\n\226U\264V\031\317a\370\216`\252v\314\273I*\376\244P\275ny{\206\t\267\233=u\306\001\330\311Vc\314\0331k\323\303{\021!E\f\022\220R1L\"\0213.`\244Z\221\a\255\304\246@]\031{\255H\033\303\246\323x\324\205\217(\f\244\372\272\2446\217\t\257v\304\226\335`\200\254\340\3001\230\2725f\215\320#\213\244\245,u\334\337\344JN6w\350\241\205\377\235\331cK\033\374,\234=\352\257\277d\300L\'\317\247\314]}4\372\207e\271\277\t\037gB\207qe\266\370\356\320\022\017w\312{\025\235T\372\\gxV\220/Z%\266\234\355\245\264:\210\246\240\272\304\215\177\316@Y\333\r>\243u\244\2655\354(}\251\214\367\222cH\376\253\200\333I\000\206u\340\205>\366f1\r\324\353T\341\252\020\026\360\020v9\220\344Vkob\003\262\301[\351\357k7:cT=\236\002\003\365\273\260V.&\233)2\235\000\377\201\022\270\234 \036Q\274\344\0223\026\304\016\254\222j\033\\ \235\030\203\026U\374NBc\225\342\256{\317~\221M]\242^\261\213\022\300\021o\206\035\3418U\266\200\2763\237\351y\265x!\361\210\306\234\024\333p\024z#\203\201.P\v\237\362\t\251sM\254