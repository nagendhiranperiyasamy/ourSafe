      thinking_signature: "\022\346\a\n\343\a\001i\024}\023\226\314\263\351?I|3\211\202\251-w\006\'\265\267< \200\267\205\267\271\3659\352;\032k\005\347\224\363\304\227\004G\275\330s\356\330\243\366\030<\022Aj\374\233\255\257\200q\036\253\225\277!\204\031w\374y\025\332\030\023@\244\241F\273\204\367\226\340\320\335D\262;\307}O\316\211\336z\365^\301\224\330\356\373\303_-\222\024\350\t\217\020V|v\352\351\264\315\315D\032\277\'\274\212\2330\363\032\275\201W\177r\321\026\272/\343\340\200\235\272:a\034\314\2756\023\373\202\337\377\b\346?V\227\340\236\316\224\030\312a\335\314\255JY\202I\306\374;\24719Nz\351\303\'G\020b\36382\247e\352c\350\036\r\345eZ1\327\203\217\323\276\353\326\375X\221y\235\207\314\222GS\226\3625\227\035%\004\017\bFmY\371\325\317\246HSl\211\250\236wD\235aX2\222\023u\000,\330\002\343\205}b\224\351\371\265\325j\027\370\037\216rP|Yr\203\237\235\202\352\360t\023\360J\205\262^4\360\322\344.\251\345\030e\301EVIe\241\317\246\235\325\250\231lX\260\317C\026U\3108S9\212k\\|b\036\343\331\224\034\375\274\347\\\274\244\346az\312\1776K\r\231\276n\034K\245m\254\t\n \206\300c\024\3242sA\206\376%\235\365\004\243\026\362\206\334\233F\350o\241\023\377\226\220nz\307K\244R\r\222\3044T\276\023\375\304\276\003\302\215\202}\241\026\347\221\000r\367\026R\250\254\235\265Z\340Y\205\232\354t\372\311\\\260,\201|Mg\254\313v\200\207\332\342\210[ -\2773?\177\203\265Lp\022\177|\354$\025\t0u|\244\242\212\356\001\203&\275\347\022\025\200\017\253\300\202\033\024R(J\234\320\030*W\027,h\223\023\r6\326\206\255s\342\337/#6\261\312I\204W\311,Q\005\\\255\303\252\025\250hmc\252\035D\313p\227\023^\'G\207\213Q%\263\2214u\376Mm\370\tn\306\306TEP\200.\252\250\237\305_\0361\360\213\311\220}\377\360z\n\304\254Zu\244\370\005c-m-{\034a\247z\205\220\226\016a\261%\2574\265\312-\020\220\214o\246\326!4g\203Y\207.\226\363\234%_\034\376\021\001\306\\\020\344\002jn\345RQ\337\230\234\177\307\375z\370\375M\250[\272\217\r\321I\366\315\215\023\a\274\3012\027\030\021@\236\302\370\"\370%\235\201\266\005\005\023\264\375~,\233\231\022\300\234/\036xD\004~\352\366\177,\3050k\301\246\017c\003X\222S\331\'\027\214\003\317\205\255]\250c\311\325\306m\221\037\367\362\266\307\350\301\331\230y\300\001\243\261\221W\325\004F\022\260\244\335\'a\257\350sU:\311\023\003\251\324\344\301\\\226r\'6g\260\334\320\351\002:c\nb\233\0269m\304\267 \202P\324XM\317o\273\341\264_\341\314\326A\001\347\"v\344\322\267\307?\313\365\331y\021\342\322T\325\245w5\345\374o\313\033et\356u\031bM%\356n\030\332\270+%\264\306h\205\355~_\365\\\316\205G\337\274\032\326\350\270TS;\324\330%o\241z\353\326&\233\017\177G\232\353\023\226:\000\312\351\031\fb1|v\305>\364\252\212\300\r\211\247\315\352o\240\332\203\0020\304\247a\235\211\262\2025\333\016z\232\264j\000\261\310\034\350/\321\255\021)v\372^\236\356X8OLH.\2640mE!\n\355\340p\202\231[\364fz\232\310}\250d\346\367`p\331\374\205C@6\227\364\t]\222uw\213X\226P#\260\030\034\261\365%\315\224\'B\272\212YC\364\356\324LX\226Ou\366\251"
