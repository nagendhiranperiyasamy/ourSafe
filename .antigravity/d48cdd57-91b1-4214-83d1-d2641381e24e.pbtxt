    content: "import React, { useState } from \'react\';\nimport {\n  AlertCircle,\n  ArrowRight,\n  CheckCircle2,\n  Eye,\n  EyeOff,\n  Info,\n  KeyRound,\n  Lock,\n  ShieldCheck,\n  User,\n  X,\n} from \'lucide-react\';\nimport { UserProfile } from \'../types/safety\';\nimport {\n  DEMO_ACCOUNT_CREDENTIALS,\n  findUserByIdentifier,\n  isValidPhoneNumber,\n  resetPasswordByIdentifier,\n  setSessionUserId,\n} from \'../utils/storage\';\nimport { BrandLogo } from \'./BrandLogo\';\n\ninterface LoginScreenProps {\n  onLoginSuccess: (user: UserProfile) => void;\n  onNavigateSignup: () => void;\n}\n\nexport const LoginScreen: React.FC<LoginScreenProps> = ({\n  onLoginSuccess,\n  onNavigateSignup,\n}) => {\n  const [identifier, setIdentifier] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [showPassword, setShowPassword] = useState(false);\n  const [error, setError] = useState(\'\');\n  const [fieldErrors, setFieldErrors] = useState<{\n    identifier?: string;\n    password?: string;\n  }>({});\n\n  const [showForgotModal, setShowForgotModal] = useState(false);\n  const [resetIdentifier, setResetIdentifier] = useState(\'\');\n  const [resetPassword, setResetPassword] = useState(\'\');\n  const [resetConfirm, setResetConfirm] = useState(\'\');\n  const [resetFeedback, setResetFeedback] = useState<{\n    type: \'error\' | \'success\';\n    text: string;\n  } | null>(null);\n\n  const [showGoogleNotice, setShowGoogleNotice] = useState(false);\n\n  const validateAndSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(\'\');\n    const nextFieldErrors: { identifier?: string; password?: string } = {};\n\n    const trimmedId = identifier.trim();\n    if (!trimmedId) {\n      nextFieldErrors.identifier = \'Enter your registered name or phone number.\';\n    } else if (/^[\\d+\\s\\-().]+$/.test(trimmedId) && !isValidPhoneNumber(trimmedId)) {\n      nextFieldErrors.identifier =\n        \'Enter a valid phone number (10 to 15 digits) or your full name.\';\n    }\n\n    if (!password) {\n      nextFieldErrors.password = \'Enter your password.\';\n    } else if (password.length < 6) {\n      nextFieldErrors.password = \'Password must be at least 6 characters.\';\n    }\n\n    setFieldErrors(nextFieldErrors);\n    if (Object.keys(nextFieldErrors).length > 0) return;\n\n    const matchedUser = findUserByIdentifier(trimmedId);\n    if (!matchedUser) {\n      setError(\n        \'No account found for that name or phone number. Create a new account or load the demo credentials below.\'\n      );\n      return;\n    }\n\n    if (matchedUser.password !== password) {\n      setError(\'Incorrect password. Check your entry or use Forgot Password.\');\n      return;\n    }\n\n    setSessionUserId(matchedUser.id);\n    onLoginSuccess(matchedUser);\n  };\n\n  const handleFillDemo = () => {\n    setIdentifier(DEMO_ACCOUNT_CREDENTIALS.phone);\n    setPassword(DEMO_ACCOUNT_CREDENTIALS.password);\n    setFieldErrors({});\n    setError(\'\');\n  };\n\n  const handleResetSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setResetFeedback(null);\n\n    if (!resetIdentifier.trim()) {\n      setResetFeedback({\n        type: \'error\',\n        text: \'Enter your registered phone number, name, or email.\',\n      });\n      return;\n    }\n    if (resetPassword.length < 6) {\n      setResetFeedback({\n        type: \'error\',\n        text: \'New password must be at least 6 characters.\',\n      });\n      return;\n    }\n    if (resetPassword !== resetConfirm) {\n      setResetFeedback({\n        type: \'error\',\n        text: \'New password and confirmation do not match.\',\n      });\n      return;\n    }\n\n    const res = resetPasswordByIdentifier(resetIdentifier, resetPassword);\n    if (!res.ok) {\n      setResetFeedback({ type: \'error\', text: res.error ?? \'Could not reset password.\' });\n      return;\n    }\n\n    setResetFeedback({\n      type: \'success\',\n      text: \'Local prototype password updated. You can sign in with your new password now.\',\n    });\n    setIdentifier(resetIdentifier.trim());\n    setPassword(\'\');\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#FAF8FF] flex flex-col\">\n      {/* Compact Top Header */}\n      <header className=\"w-full border-b border-violet-200/70 bg-white/90 backdrop-blur-md sticky top-0 z-20\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4\">\n          <BrandLogo />\n          <div className=\"flex items-center gap-3\">\n            <button\n              type=\"button\"\n              onClick={onNavigateSignup}\n              className=\"min-h-[44px] px-4 py-2 text-sm font-semibold text-violet-700 hover:bg-violet-50 rounded-xl transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n            >\n              Create Account\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Split Content */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-12 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-stretch\">\n        {/* Left Editorial Visual Column (Desktop & Tablet) */}\n        <section className=\"lg:col-span-6 flex flex-col justify-between rounded-3xl overflow-hidden relative min-h-[280px] sm:min-h-[340px] lg:min-h-[620px] bg-[#241642] border border-violet-200/60\">\n          <img\n            src=\"/src/assets/images/auth_safety_editorial_1795271550839.jpg\"\n            alt=\"Woman walking confidently along a softly illuminated city promenade at twilight\"\n            referrerPolicy=\"no-referrer\"\n            className=\"absolute inset-0 w-full h-full object-cover object-center\"\n          />\n          <div className=\"absolute inset-0 bg-gradient-to-t from-[#170E2E]/95 via-[#1C1136]/45 to-[#170E2E]/25\" />\n\n          <div className=\"relative z-10 p-6 sm:p-8 lg:p-10 flex flex-col justify-between h-full\">\n            <div className=\"flex items-center gap-2 text-xs font-medium text-violet-100/90\">\n              <ShieldCheck className=\"w-4 h-4 text-violet-200 shrink-0\" />\n              <span>Personal Safety Companion</span>\n              <span aria-hidden=\"true\">\302\267</span>\n              <span>Frontend Prototype</span>\n            </div>\n\n            <div className=\"max-w-lg mt-auto pt-12\">\n              <h1 className=\"text-3xl sm:text-4xl lg:text-[2.65rem] font-bold text-white leading-[1.12] tracking-tight\">\n                Quiet confidence for every journey.\n              </h1>\n              <p className=\"mt-4 text-sm sm:text-base text-violet-100/90 leading-relaxed\">\n                Keep trusted guardians one tap away with Travel Mode check-ins, calm Threat Mode safety checks, and instant SOS confirmation.\n              </p>\n\n              <div className=\"mt-6 pt-5 border-t border-white/15 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs sm:text-sm text-violet-100/85\">\n                <span>Guardian Check-ins</span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span>One-Tap SOS Flow</span>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span>Smart Trigger Concepts</span>\n              </div>\n            </div>\n          </div>\n        </section>\n\n        {/* Right Sign-In Form Column */}\n        <section className=\"lg:col-span-6 flex items-center justify-center\">\n          <div className=\"w-full max-w-md bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-8 shadow-sm shadow-violet-950/[0.03]\">\n            <div className=\"mb-6\">\n              <p className=\"text-xs font-semibold text-violet-700 mb-1.5\">\n                Welcome back\n              </p>\n              <h2 className=\"text-2xl sm:text-3xl font-bold text-[#1A132B] tracking-tight\">\n                Sign in to AuraSafe\n              </h2>\n              <p className=\"mt-2 text-sm text-[#574E6B] leading-relaxed\">\n                Access your safety dashboard, emergency contacts, and journey protection tools.\n              </p>\n            </div>\n\n            {error && (\n              <div\n                role=\"alert\"\n                className=\"mb-5 rounded-2xl bg-red-50 border border-red-200 p-3.5 flex items-start gap-2.5 text-sm text-red-800\"\n              >\n                <AlertCircle className=\"w-4 h-4 text-red-600 shrink-0 mt-0.5\" />\n                <span>{error}</span>\n              </div>\n            )}\n\n            <form onSubmit={validateAndSubmit} noValidate className=\"space-y-4\">\n              <div>\n                <label\n                  htmlFor=\"login-identifier\"\n                  className=\"block text-sm font-semibold text-[#1A132B] mb-1.5\"\n                >\n                  Full Name or Phone Number\n                </label>\n                <div className=\"relative\">\n                  <User className=\"w-4 h-4 text-[#73698A] absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\" />\n                  <input\n                    id=\"login-identifier\"\n                    type=\"text\"\n                    autoComplete=\"username\"\n                    value={identifier}\n                    onChange={(e) => {\n                      setIdentifier(e.target.value);\n                      if (fieldErrors.identifier) {\n                        setFieldErrors((prev) => ({ ...prev, identifier: undefined }));\n                      }\n                    }}\n                    placeholder=\"e.g. 9876543210 or Maya Sharma\"\n                    className={`w-full min-h-[46px] pl-10 pr-4 py-2.5 rounded-xl bg-[#FAF8FF] border text-sm text-[#1A132B] placeholder:text-[#8E84A6] transition-colors focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-600/25 ${\n                      fieldErrors.identifier\n                        ? \'border-red-400 focus:border-red-500\'\n                        : \'border-violet-200 focus:border-violet-600\'\n                    }`}\n                  />\n                </div>\n                {fieldErrors.identifier && (\n                  <p className=\"mt-1.5 text-xs text-red-600 font-medium\">\n                    {fieldErrors.identifier}\n                  </p>\n                )}\n              </div>\n\n              <div>\n                <div className=\"flex items-center justify-between mb-1.5\">\n                  <label\n                    htmlFor=\"login-password\"\n                    className=\"block text-sm font-semibold text-[#1A132B]\"\n                  >\n                    Password\n                  </label>\n                  <button\n                    type=\"button\"\n                    onClick={() => {\n                      setResetIdentifier(identifier);\n                      setResetPassword(\'\');\n                      setResetConfirm(\'\');\n                      setResetFeedback(null);\n                      setShowForgotModal(true);\n                    }}\n                    className=\"text-xs font-semibold text-violet-700 hover:text-violet-900 underline-offset-2 hover:underline cursor-pointer\"\n                  >\n                    Forgot Password?\n                  </button>\n                </div>\n                <div className=\"relative\">\n                  <Lock className=\"w-4 h-4 text-[#73698A] absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\" />\n                  <input\n                    id=\"login-password\"\n                    type={showPassword ? \'text\' : \'password\'}\n                    autoComplete=\"current-password\"\n                    value={password}\n                    onChange={(e) => {\n                      setPassword(e.target.value);\n                      if (fieldErrors.password) {\n                        setFieldErrors((prev) => ({ ...prev, password: undefined }));\n                      }\n                    }}\n                    placeholder=\"Enter your password\"\n                    className={`w-full min-h-[46px] pl-10 pr-12 py-2.5 rounded-xl bg-[#FAF8FF] border text-sm text-[#1A132B] placeholder:text-[#8E84A6] transition-colors focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-600/25 ${\n                      fieldErrors.password\n                        ? \'border-red-400 focus:border-red-500\'\n                        : \'border-violet-200 focus:border-violet-600\'\n                    }`}\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={() => setShowPassword((prev) => !prev)}\n                    aria-label={showPassword ? \'Hide password\' : \'Show password\'}\n                    className=\"absolute right-1.5 top-1/2 -translate-y-1/2 min-w-[40px] min-h-[40px] flex items-center justify-center text-[#6C6284] hover:text-violet-700 rounded-lg transition-colors cursor-pointer\"\n                  >\n                    {showPassword ? (\n                      <EyeOff className=\"w-4 h-4\" />\n                    ) : (\n                      <Eye className=\"w-4 h-4\" />\n                    )}\n                  </button>\n                </div>\n                {fieldErrors.password && (\n                  <p className=\"mt-1.5 text-xs text-red-600 font-medium\">\n                    {fieldErrors.password}\n                  </p>\n                )}\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"w-full min-h-[48px] px-5 py-3 rounded-xl bg-violet-700 hover:bg-violet-800 active:scale-[0.99] text-white text-sm font-semibold flex items-center justify-center gap-2 transition-all shadow-sm shadow-violet-900/15 cursor-pointer whitespace-nowrap\"\n              >\n                <span>Sign In</span>\n                <ArrowRight className=\"w-4 h-4\" />\n              </button>\n            </form>\n\n            {/* Prototype Demo Credential Helper */}\n            <div className=\"mt-4 rounded-2xl bg-[#F4F0FF] border border-violet-200/70 p-3.5 flex items-center justify-between gap-3\">\n              <div className=\"text-xs text-[#4A4063] leading-snug\">\n                <p className=\"font-semibold text-[#1A132B]\">Prototype Demo Account</p>\n                <p className=\"font-mono tabular-nums mt-0.5 text-[11px]\">\n                  {DEMO_ACCOUNT_CREDENTIALS.phone} \302\267 {DEMO_ACCOUNT_CREDENTIALS.password}\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                onClick={handleFillDemo}\n                className=\"min-h-[38px] px-3 py-1.5 rounded-lg bg-white border border-violet-200 text-xs font-semibold text-violet-700 hover:bg-violet-50 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              >\n                Fill Demo\n              </button>\n            </div>\n\n            {/* Divider */}\n            <div className=\"my-5 flex items-center gap-3\">\n              <div className=\"h-px flex-1 bg-violet-200/70\" />\n              <span className=\"text-xs text-[#73698A]\">or</span>\n              <div className=\"h-px flex-1 bg-violet-200/70\" />\n            </div>\n\n            {/* Visual Google Sign-In Option */}\n            <button\n              type=\"button\"\n              onClick={() => setShowGoogleNotice(true)}\n              className=\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-white hover:bg-[#FAF8FF] border border-violet-200 text-[#1A132B] text-sm font-semibold flex items-center justify-center gap-2.5 transition-colors cursor-pointer whitespace-nowrap\"\n            >\n              <svg className=\"w-4 h-4 shrink-0\" viewBox=\"0 0 24 24\" aria-hidden=\"true\">\n                <path\n                  fill=\"#4285F4\"\n                  d=\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\"\n                />\n                <path\n                  fill=\"#34A853\"\n                  d=\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\"\n                />\n                <path\n                  fill=\"#FBBC05\"\n                  d=\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\"\n                />\n                <path\n                  fill=\"#EA4335\"\n                  d=\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\"\n                />\n              </svg>\n              <span>Continue with Google</span>\n            </button>\n\n            <div className=\"mt-6 pt-5 border-t border-violet-100 text-center\">\n              <p className=\"text-sm text-[#574E6B]\">\n                New to AuraSafe?{\' \'}\n                <button\n                  type=\"button\"\n                  onClick={onNavigateSignup}\n                  className=\"font-semibold text-violet-700 hover:text-violet-900 hover:underline underline-offset-2 cursor-pointer\"\n                >\n                  Create New Account\n                </button>\n              </p>\n            </div>\n          </div>\n        </section>\n      </main>\n\n      {/* Forgot Password Modal */}\n      {showForgotModal && (\n        <div\n          className=\"fixed inset-0 z-50 bg-[#1A132B]/50 backdrop-blur-sm flex items-center justify-center p-4\"\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"forgot-password-title\"\n        >\n          <div className=\"w-full max-w-md bg-white rounded-3xl border border-violet-200 p-6 shadow-xl\">\n            <div className=\"flex items-start justify-between gap-4 mb-4\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-10 h-10 rounded-xl bg-[#F3EEFF] text-violet-700 flex items-center justify-center shrink-0\">\n                  <KeyRound className=\"w-5 h-5\" />\n                </div>\n                <div>\n                  <h3\n                    id=\"forgot-password-title\"\n                    className=\"text-lg font-bold text-[#1A132B]\"\n                  >\n                    Reset Prototype Password\n                  </h3>\n                  <p className=\"text-xs text-[#6B6182]\">\n                    Updates your locally stored browser account\n                  </p>\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setShowForgotModal(false)}\n                aria-label=\"Close modal\"\n                className=\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#6B6182] hover:bg-violet-50 hover:text-[#1A132B] cursor-pointer\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            {resetFeedback && (\n              <div\n                className={`mb-4 rounded-xl p-3 text-xs flex items-start gap-2 border ${\n                  resetFeedback.type === \'success\'\n                    ? \'bg-emerald-50 border-emerald-200 text-emerald-800\'\n                    : \'bg-red-50 border-red-200 text-red-800\'\n                }`}\n              >\n                {resetFeedback.type === \'success\' ? (\n                  <CheckCircle2 className=\"w-4 h-4 shrink-0 mt-0.5 text-emerald-600\" />\n                ) : (\n                  <AlertCircle className=\"w-4 h-4 shrink-0 mt-0.5 text-red-600\" />\n                )}\n                <span>{resetFeedback.text}</span>\n              </div>\n            )}\n\n            <form onSubmit={handleResetSubmit} className=\"space-y-3.5\">\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Registered Phone, Name, or Email\n                </label>\n                <input\n                  type=\"text\"\n                  value={resetIdentifier}\n                  onChange={(e) => setResetIdentifier(e.target.value)}\n                  placeholder=\"e.g. 9876543210\"\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  New Password\n                </label>\n                <input\n                  type=\"password\"\n                  value={resetPassword}\n                  onChange={(e) => setResetPassword(e.target.value)}\n                  placeholder=\"Minimum 6 characters\"\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Confirm New Password\n                </label>\n                <input\n                  type=\"password\"\n                  value={resetConfirm}\n                  onChange={(e) => setResetConfirm(e.target.value)}\n                  placeholder=\"Re-enter new password\"\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"pt-2 flex items-center justify-end gap-2.5\">\n                <button\n                  type=\"button\"\n                  onClick={() => setShowForgotModal(false)}\n                  className=\"min-h-[44px] px-4 py-2 rounded-xl text-sm font-semibold text-[#574E6B] hover:bg-violet-50 cursor-pointer\"\n                >\n                  Close\n                </button>\n                <button\n                  type=\"submit\"\n                  className=\"min-h-[44px] px-4 py-2 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold cursor-pointer\"\n                >\n                  Update Password\n                </button>\n              </div>\n            </form>\n          </div>\n        </div>\n      )}\n\n      {/* Honest Google OAuth Notice Modal */}\n      {showGoogleNotice && (\n        <div\n          className=\"fixed inset-0 z-50 bg-[#1A132B]/50 backdrop-blur-sm flex items-center justify-center p-4\"\n          role=\"dialog\"\n          aria-modal=\"true\"\n          aria-labelledby=\"google-oauth-notice-title\"\n        >\n          <div className=\"w-full max-w-md bg-white rounded-3xl border border-violet-200 p-6 shadow-xl\">\n            <div className=\"flex items-start justify-between gap-4 mb-3\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-10 h-10 rounded-xl bg-[#F3EEFF] text-violet-700 flex items-center justify-center shrink-0\">\n                  <Info className=\"w-5 h-5\" />\n                </div>\n                <h3\n                  id=\"google-oauth-notice-title\"\n                  className=\"text-lg font-bold text-[#1A132B]\"\n                >\n                  Google Sign-In Integration Notice\n                </h3>\n              </div>\n              <button\n                type=\"button\"\n                onClick={() => setShowGoogleNotice(false)}\n                aria-label=\"Close notice\"\n                className=\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#6B6182] hover:bg-violet-50 cursor-pointer\"\n              >\n                <X className=\"w-5 h-5\" />\n              </button>\n            </div>\n\n            <p className=\"text-sm text-[#4A4063] leading-relaxed\">\n              Real Google authentication requires an OAuth 2.0 client configuration and backend verification, which is planned for Phase 2.\n            </p>\n            <p className=\"mt-2.5 text-sm text-[#4A4063] leading-relaxed\">\n              For this Round 1 frontend prototype, please create a local account or use the demo credentials to explore all safety features.\n            </p>\n\n            <div className=\"mt-5 flex flex-wrap items-center justify-end gap-2.5\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowGoogleNotice(false);\n                  handleFillDemo();\n                }}\n                className=\"min-h-[44px] px-4 py-2 rounded-xl bg-[#F3EEFF] hover:bg-violet-100 text-violet-800 text-sm font-semibold cursor-pointer whitespace-nowrap\"\n              >\n                Use Demo Login\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setShowGoogleNotice(false);\n                  onNavigateSignup();\n                }}\n                className=\"min-h-[44px] px-4 py-2 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold cursor-pointer whitespace-nowrap\"\n              >\n                Create Account\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
    num_lines: 573
    num_bytes: 24506
    line_range_bytes: 24506
  }
}
