  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useState } from \'react\';\nimport {\n  BellRing,\n  CheckCircle2,\n  Clock,\n  PhoneIncoming,\n  ShieldCheck,\n} from \'lucide-react\';\nimport {\n  GeoLocationState,\n  SafetyCheckInSession,\n  SosContact,\n  TravelSession,\n} from \'../../types/safety\';\nimport { TravelModePanel } from \'../dashboard/TravelModePanel\';\n\ninterface TravelModePageProps {\n  contacts: SosContact[];\n  travelSession: TravelSession | null;\n  checkInSession: SafetyCheckInSession | null;\n  geoLocation: GeoLocationState;\n  onRequestLocation: () => void;\n  onStartTravel: (session: TravelSession) => void;\n  onCheckInTravel: () => void;\n  onEndTravel: () => void;\n  onManageContacts: () => void;\n  onStartSafetyCheckIn: (\n    label: string,\n    durationSeconds: number,\n    guardianId: string\n  ) => void;\n  onConfirmSafetyCheckIn: () => void;\n  onCancelSafetyCheckIn: () => void;\n  onTriggerFakeCall: (callerName: string, delaySeconds: number) => void;\n}\n\nexport const TravelModePage: React.FC<TravelModePageProps> = ({\n  contacts,\n  travelSession,\n  checkInSession,\n  geoLocation,\n  onRequestLocation,\n  onStartTravel,\n  onCheckInTravel,\n  onEndTravel,\n  onManageContacts,\n  onStartSafetyCheckIn,\n  onConfirmSafetyCheckIn,\n  onCancelSafetyCheckIn,\n  onTriggerFakeCall,\n}) => {\n  const [checkInLabel, setCheckInLabel] = useState(\'Walking home\');\n  const [checkInSeconds, setCheckInSeconds] = useState(600);\n  const [checkInGuardianId, setCheckInGuardianId] = useState(\n    contacts[0]?.id ?? \'\'\n  );\n  const [remainingSec, setRemainingSec] = useState(0);\n\n  const [fakeCallerName, setFakeCallerName] = useState(\'Mom\');\n  const [fakeCallDelay, setFakeCallDelay] = useState(0);\n  const [scheduledDelayCountdown, setScheduledDelayCountdown] = useState<\n    number | null\n  >(null);\n\n  useEffect(() => {\n    if (contacts.length > 0 && !contacts.some((c) => c.id === checkInGuardianId)) {\n      setCheckInGuardianId(contacts[0].id);\n    }\n  }, [contacts, checkInGuardianId]);\n\n  useEffect(() => {\n    if (!checkInSession || !checkInSession.active) {\n      setRemainingSec(0);\n      return;\n    }\n\n    const updateRemaining = () => {\n      const rem = Math.max(\n        0,\n        Math.ceil((new Date(checkInSession.dueAt).getTime() - Date.now()) / 1000)\n      );\n      setRemainingSec(rem);\n    };\n    updateRemaining();\n    const id = window.setInterval(updateRemaining, 1000);\n    return () => window.clearInterval(id);\n  }, [checkInSession]);\n\n  const handleLaunchFakeCall = (e: React.FormEvent) => {\n    e.preventDefault();\n    const name = fakeCallerName.trim() || \'Mom\';\n    if (fakeCallDelay <= 0) {\n      onTriggerFakeCall(name, 0);\n      return;\n    }\n    setScheduledDelayCountdown(fakeCallDelay);\n    onTriggerFakeCall(name, fakeCallDelay);\n  };\n\n  useEffect(() => {\n    if (scheduledDelayCountdown === null) return;\n    if (scheduledDelayCountdown <= 0) {\n      setScheduledDelayCountdown(null);\n      return;\n    }\n    const id = window.setTimeout(\n      () => setScheduledDelayCountdown((c) => (c !== null ? c - 1 : null)),\n      1000\n    );\n    return () => window.clearTimeout(id);\n  }, [scheduledDelayCountdown]);\n\n  const mins = Math.floor(remainingSec / 60);\n  const secs = remainingSec % 60;\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Dedicated Travel Mode Panel */}\n      <TravelModePanel\n        contacts={contacts}\n        travelSession={travelSession}\n        geoLocation={geoLocation}\n        onRequestLocation={onRequestLocation}\n        onStartTravel={onStartTravel}\n        onCheckInTravel={onCheckInTravel}\n        onEndTravel={onEndTravel}\n        onManageContacts={onManageContacts}\n      />\n\n      {/* Safety Check-In Timer & Fake Call Tool */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\">\n        {/* Safety Check-In Timer */}\n        <section className=\"lg:col-span-7 bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\">\n          <div>\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Proactive Prevention \302\267 Timed Safety Check-In\n            </p>\n            <h2 className=\"mt-1 text-lg sm:text-xl font-bold text-[#1A132B]\">\n              Safety Check-In Timer\n            </h2>\n            <p className=\"mt-1 text-xs text-[#574E6B] leading-relaxed\">\n              Set a check-in window before commuting or meeting someone new. If you do not tap &ldquo;I&apos;m Safe&rdquo; before time runs out, AuraSafe automatically logs a missed check-in alert for your chosen guardian.\n            </p>\n          </div>\n\n          {checkInSession?.active ? (\n            <div className=\"rounded-2xl bg-[#F4F0FF] border border-violet-200 p-5 space-y-4\">\n              <div className=\"flex flex-wrap items-center justify-between gap-3\">\n                <div>\n                  <p className=\"text-xs font-semibold text-violet-800\">\n                    Check-In Active \302\267 {checkInSession.label}\n                  </p>\n                  <p className=\"text-xs text-[#4A4063] mt-0.5\">\n                    Guardian on standby: <strong>{checkInSession.guardianName}</strong>{\' \'}\n                    ({checkInSession.guardianPhone})\n                  </p>\n                </div>\n                <div className=\"flex items-center gap-1.5 text-2xl font-bold font-mono tabular-nums text-violet-900\">\n                  <Clock className=\"w-5 h-5\" />\n                  <span>\n                    {String(mins).padStart(2, \'0\')}:{String(secs).padStart(2, \'0\')}\n                  </span>\n                </div>\n              </div>\n\n              <div className=\"flex flex-wrap items-center gap-3\">\n                <button\n                  type=\"button\"\n                  onClick={onConfirmSafetyCheckIn}\n                  className=\"flex-1 min-h-[46px] px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold inline-flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap\"\n                >\n                  <CheckCircle2 className=\"w-4 h-4\" />\n                  <span>I&apos;m Safe \342\200\224 Confirm Check-In</span>\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={onCancelSafetyCheckIn}\n                  className=\"min-h-[46px] px-4 py-2.5 rounded-xl bg-white hover:bg-violet-50 border border-violet-200 text-[#1A132B] text-xs font-semibold cursor-pointer\"\n                >\n                  Cancel Timer\n                </button>\n              </div>\n            </div>\n          ) : (\n            <form\n              onSubmit={(e) => {\n                e.preventDefault();\n                onStartSafetyCheckIn(\n                  checkInLabel.trim() || \'Safety Check-In\',\n                  checkInSeconds,\n                  checkInGuardianId\n                );\n              }}\n              className=\"space-y-3.5\"\n            >\n              {checkInSession?.status === \'missed\' && (\n                <div className=\"rounded-xl bg-red-50 border border-red-200 p-3.5 text-xs text-red-800 flex items-center gap-2\">\n                  <BellRing className=\"w-4 h-4 text-red-600 shrink-0\" />\n                  <span>\n                    Previous check-in expired without confirmation. Guardian alert has been logged in Emergency History.\n                  </span>\n                </div>\n              )}\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div>\n                  <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                    Activity Label\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={checkInLabel}\n                    onChange={(e) => setCheckInLabel(e.target.value)}\n                    placeholder=\"e.g. Late bus commute\"\n                    className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                  />\n                </div>\n                <div>\n                  <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                    Check-In Window\n                  </label>\n                  <select\n                    value={checkInSeconds}\n                    onChange={(e) => setCheckInSeconds(Number(e.target.value))}\n                    className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                  >\n                    <option value={20}>20 seconds (Quick prototype test)</option>\n                    <option value={300}>5 minutes</option>\n                    <option value={600}>10 minutes</option>\n                    <option value={900}>15 minutes</option>\n                    <option value={1800}>30 minutes</option>\n                  </select>\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 sm:grid-cols-12 gap-3 items-end\">\n                <div className=\"sm:col-span-7\">\n                  <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                    Notify Guardian If Missed\n                  </label>\n                  <select\n                    value={checkInGuardianId}\n                    onChange={(e) => setCheckInGuardianId(e.target.value)}\n                    className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                  >\n                    {contacts.length === 0 ? (\n                      <option value=\"\">No guardian contacts saved</option>\n                    ) : (\n                      contacts.map((c) => (\n                        <option key={c.id} value={c.id}>\n                          {c.name} ({c.phone})\n                        </option>\n                      ))\n                    )}\n                  </select>\n                </div>\n                <div className=\"sm:col-span-5\">\n                  <button\n                    type=\"submit\"\n                    disabled={contacts.length === 0}\n                    className=\"w-full min-h-[44px] px-4 py-2 rounded-xl bg-violet-700 hover:bg-violet-800 disabled:opacity-50 text-white text-sm font-semibold inline-flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap\"\n                  >\n                    <ShieldCheck className=\"w-4 h-4\" />\n                    <span>Start Check-In</span>\n                  </button>\n                </div>\n              </div>\n            </form>\n          )}\n        </section>\n\n        {/* Simulated Fake Call Tool */}\n        <section className=\"lg:col-span-5 bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\">\n          <div>\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Discreet Exit Tool \302\267 Works Offline\n            </p>\n            <h2 className=\"mt-1 text-lg sm:text-xl font-bold text-[#1A132B]\">\n              Simulated Fake Call\n            </h2>\n            <p className=\"mt-1 text-xs text-[#574E6B] leading-relaxed\">\n              Trigger a realistic incoming call screen with optional ringtone so you can step away politely from an uncomfortable situation.\n            </p>\n          </div>\n\n          <form onSubmit={handleLaunchFakeCall} className=\"space-y-3.5\">\n            <div>\n              <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                Caller Display Name\n              </label>\n              <input\n                type=\"text\"\n                value={fakeCallerName}\n                onChange={(e) => setFakeCallerName(e.target.value)}\n                placeholder=\"e.g. Mom, Dad, Office Manager\"\n                className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                Ring Delay\n              </label>\n              <select\n                value={fakeCallDelay}\n                onChange={(e) => setFakeCallDelay(Number(e.target.value))}\n                className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n              >\n                <option value={0}>Ring Immediately</option>\n                <option value={5}>Ring in 5 seconds</option>\n                <option value={10}>Ring in 10 seconds</option>\n              </select>\n            </div>\n\n            <button\n              type=\"submit\"\n              className=\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#1A132B] hover:bg-[#2C2147] text-white text-sm font-semibold inline-flex items-center justify-center gap-2 transition-colors cursor-pointer\"\n            >\n              <PhoneIncoming className=\"w-4 h-4\" />\n              <span>\n                {scheduledDelayCountdown !== null\n                  ? `Ringing in ${scheduledDelayCountdown}s...`\n                  : \'Trigger Simulated Fake Call\'}\n              </span>\n            </button>\n          </form>\n        </section>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/pages/TravelModePage.tsx"
        }
        overwrite: true
      }
    }
    action_result {
      edit {
