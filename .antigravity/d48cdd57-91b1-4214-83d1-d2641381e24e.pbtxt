  view_file {
    absolute_path_uri: "file:///.gmp_cache/index.json"
    end_line: 212
    content: "[\n  {\n    \"name\": \"address-validation-api-web-api\",\n    \"description\": \"Use this skill when the user wants to validate, standardize, or geocode postal addresses using the Google Maps Platform Address Validation API via HTTP REST requests. This skill helps developers verify partial or complete addresses, retrieve latitude/longitude coordinates, Place IDs, and Plus Codes, determine address types (business, residential, or PO box), obtain English-language equivalents, and access USPS CASS-certified validation and delivery metadata.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/address-validation-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"aerial-view-api-web-api\",\n    \"description\": \"Use this skill when retrieving pre-rendered, photorealistic 3D flyover videos and associated metadata for specific physical addresses or locations using the Google Maps Platform Aerial View HTTP REST API. It applies when users want to look up existing aerial videos, fetch video URLs in various formats and resolutions, or request video metadata via web API endpoints.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/aerial-view-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"air-quality-api-web-api\",\n    \"description\": \"Use this skill when the user wants to retrieve air quality data using the Google Maps Platform Air Quality REST API. Apply this skill to fetch current air quality conditions, 4-day forecasts, or 30-day historical data for a specific geographic location, including Air Quality Indexes (AQI), condition descriptions, pollutant concentrations, pollutant sources and effects, and health recommendations, as well as to request air quality heatmap image tiles.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/air-quality-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"compliance-review\",\n    \"description\": \"Use this skill to review implementation plans or code that uses Google Maps Platform in order to identify revisions that need to be made based on Google Maps Platform Terms of Service, Acceptable Use Policy, EEA terms, AI terms, and deprecation policies. Use this skill each time there is a significant revision to an implementation plan or code such as a change in the Google Maps Platform products selected or the handling of responses from Google Maps Platform.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/compliance-review/SKILL.md\"\n  },\n  {\n    \"name\": \"consumer-sdk-for-android-android\",\n    \"description\": \"Use this skill when integrating the Google Maps Platform Consumer SDK for Android to build real-time trip tracking and journey sharing experiences in Android mobile apps. This skill covers embedding interactive maps that track Fleet Engine trips, rendering and updating route polylines, customizing vehicle and waypoint markers, and applying custom map styles (including zoom-level styling, feature visibility, place density, and styling for roads, buildings, landmarks, icons, and labels).\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/consumer-sdk-for-android-android/SKILL.md\"\n  },\n  {\n    \"name\": \"consumer-sdk-for-ios-ios\",\n    \"description\": \"Use this skill when building iOS applications with the Google Maps Platform Consumer SDK for iOS. Trigger this skill to embed customizable, interactive maps that track Fleet Engine trip progress, render and update real-time route polylines, customize trip markers and polylines, and apply custom map styling (including adjusting roads, polygons, icons, text labels, zoom-level styles, place density, buildings, landmarks, and feature visibility).\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/consumer-sdk-for-ios-ios/SKILL.md\"\n  },\n  {\n    \"name\": \"driver-sdk-for-android-android\",\n    \"description\": \"Use this skill when developing Android applications with the Google Maps Platform Driver SDK for Android. Apply this skill to report real-time vehicle positions, active routes, trip waypoint coordinates, remaining distances, and estimated times of arrival (ETAs) from the Navigation SDK to the Fleet Engine service, as well as to retrieve vehicle trip information.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/driver-sdk-for-android-android/SKILL.md\"\n  },\n  {\n    \"name\": \"driver-sdk-for-ios-ios\",\n    \"description\": \"Use this skill when developing iOS mobility, ridesharing, or delivery driver applications using the Google Maps Platform Driver SDK for iOS. Apply this skill to integrate the Navigation SDK with the Fleet Engine service, report real-time vehicle positions, transmit active routes and waypoint coordinates, update remaining distance and estimated time of arrival (ETA) to the next waypoint, and retrieve vehicle trip information.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/driver-sdk-for-ios-ios/SKILL.md\"\n  },\n  {\n    \"name\": \"elevation-api-web-api\",\n    \"description\": \"Use this skill when retrieving elevation data for specific geographic locations or calculating elevation profiles along paths using the Google Maps Platform Elevation API.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/elevation-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"fleet-engine-service-web-api\",\n    \"description\": \"Use this skill when building or integrating with the Google Maps Platform Fleet Engine Service web API for on-demand rideshare and deliveries. Apply this skill to create, retrieve, search, list, and update vehicles and trips, update vehicle attributes, and report billable trip usage via HTTP REST endpoints.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/fleet-engine-service-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"geocoding-api-web-api\",\n    \"description\": \"Use this skill when converting addresses into geographic coordinates (geocoding), translating latitude/longitude coordinates into human-readable addresses (reverse geocoding), or retrieving addresses from Google Place IDs using the Google Maps Platform Geocoding HTTP REST API. It should also be used to restrict requests by viewport, region, country, postal code, or address type, as well as to retrieve building outlines, building entrances, and proximity information to landmarks and areas.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/geocoding-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"geolocation-api-web-api\",\n    \"description\": \"Use this skill when estimating the geographic location (latitude and longitude coordinates and accuracy radius) of a device without native GPS using the Google Maps Platform Geolocation API via HTTPS POST requests based on cell tower, WiFi access point, or IP address data.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/geolocation-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"gmp-common-api-keys\",\n    \"description\": \"Manage Google Maps Platform API keys, including generation, security, and required authentication mechanisms.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/gmp-common-api-keys/SKILL.md\"\n  },\n  {\n    \"name\": \"gmp-common-grounding\",\n    \"description\": \"Use this skill to access rules and specifications for the Google Maps Platform Grounding Lite service and its Model Context Protocol (MCP) tools for AI applications.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/gmp-common-grounding/SKILL.md\"\n  },\n  {\n    \"name\": \"gmp-common-pricing\",\n    \"description\": \"Provide comprehensive guidelines on Google Maps Platform pricing, including subscription tiers, pay-as-you-go model, free usage caps, volume discounts, and detailed CPM pricing tables.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/gmp-common-pricing/SKILL.md\"\n  },\n  {\n    \"name\": \"gmp-framework-flutter\",\n    \"description\": \"This skill provides the architectural foundation and implementation best practices for developing Google Maps Platform applications using Flutter and the `google_maps_flutter` package. It focuses on the declarative nature of the Flutter SDK, managing map state and objects through widget properties, and handling asynchronous operations via `GoogleMapController`.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/gmp-framework-flutter/SKILL.md\"\n  },\n  {\n    \"name\": \"gmp-framework-react\",\n    \"description\": \"This guide serves as the mandatory entry point and architectural router for building Google Maps Platform applications using the **React** framework, specifically leveraging the official `@vis.gl/react-google-maps` SDK and modern API features. The content is rigorously curated to enforce the **Absolute Universal Zero-Legacy Mandate**, ensuring all generated solutions utilize current, future-proof, cost-optimized, and performant APIs. Developers are proactively guided toward modern replacements like `AdvancedMarkerElement`, the `Place` class (Places API New), and the `Route` class (Routes API), strictly forbidding any reliance on deprecated or disabled callback-based services. This router ensures comprehensive coverage of React patterns, from basic initialization to complex data visualization and clustering techniques.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/gmp-framework-react/SKILL.md\"\n  },\n  {\n    \"name\": \"javascript-consumer-sdk-javascript\",\n    \"description\": \"Use this skill when building or customizing web-based trip tracking and order progress experiences using the Google Maps Platform JavaScript Consumer SDK with Fleet Engine. Apply this skill when the user wants to render route polylines, update live trip progress, customize markers or route polylines, or adjust map styles (including roads, buildings, landmarks, labels, place density, and zoom-level styling) for on-demand rides and deliveries.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/javascript-consumer-sdk-javascript/SKILL.md\"\n  },\n  {\n    \"name\": \"map-tiles-api-web-api\",\n    \"description\": \"Use this skill when the user wants to fetch 2D map tiles (roadmap, satellite, terrain), customize 2D roadmap styles and features, render photorealistic 3D tiles using OGC format or CesiumJS, or retrieve Google Street View tiles, thumbnails, and metadata via the Map Tiles API.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/map-tiles-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"maps-3d-sdk-for-android-android\",\n    \"description\": \"Use this skill when building Android applications with the Maps 3D SDK for Android to display interactive, photorealistic 3D maps. Trigger this skill when users need to initialize a 3D map view, add and customize 3D markers, render 3D models, draw 3D polylines and polygons, handle map click and camera events, customize UI controls, or manage camera paths, animations, and restrictions on Android.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/maps-3d-sdk-for-android-android/SKILL.md\"\n  },\n  {\n    \"name\": \"maps-3d-sdk-for-ios-ios\",\n    \"description\": \"Use this skill when building iOS applications with the Google Maps Platform Maps 3D SDK for iOS. Apply this skill to add interactive, photorealistic 3D maps, place and customize 3D markers, render 3D models, draw 3D polylines and polygons, handle user interactions and map events, customize UI controls, and manage camera paths, animations, and restrictions.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/maps-3d-sdk-for-ios-ios/SKILL.md\"\n  },\n  {\n    \"name\": \"maps-datasets-api-web-api\",\n    \"description\": \"Use this skill when the user wants to create, manage, or query custom geospatial datasets using the Google Maps Datasets REST API. This includes creating datasets for map styling and visualizations, uploading geospatial data from CSV, GeoJSON, or KML sources, listing all custom datasets, retrieving dataset metadata, and downloading or returning data from a custom dataset.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/maps-datasets-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"maps-embed-api-javascript\",\n    \"description\": \"Use this skill when embedding interactive Google Maps, Street View panoramas, place search results, or directions into a web page using an HTML iframe and JavaScript with the Google Maps Embed API.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/maps-embed-api-javascript/SKILL.md\"\n  },\n  {\n    \"name\": \"maps-javascript-api-javascript\",\n    \"description\": \"Use this skill when building interactive 2D or photorealistic 3D maps, integrating Street View, rendering custom markers, overlays, and geospatial datasets, or implementing client-side location services in JavaScript. This skill covers the Google Maps JavaScript API, including cloud-based map styling, Places searches and UI widgets, autocomplete, directions, route matrices, geocoding, address validation, elevation queries, and Fleet Engine tracking.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/maps-javascript-api-javascript/SKILL.md\"\n  },\n  {\n    \"name\": \"maps-sdk-for-android-android\",\n    \"description\": \"Use this skill when building Android or Wear OS applications using the Google Maps SDK for Android. Trigger this skill when the user wants to embed interactive maps or Google Street View, configure map controls, gestures, and camera animations, or add markers, info windows, shapes, polylines, polygons, ground overlays, and tile overlays. Also use it for data visualization and custom styling, including cloud-based map styling, Map IDs, KML, GeoJSON, heatmaps, choropleth maps, boundary styling, and custom geospatial datasets.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/maps-sdk-for-android-android/SKILL.md\"\n  },\n  {\n    \"name\": \"maps-sdk-for-ios-ios\",\n    \"description\": \"Use this skill when building iOS applications with the Google Maps SDK for iOS. It should be invoked whenever a user needs to display interactive vector maps or Street View panoramas, customize map styles and features, manage camera movements, gestures, and UI controls, draw overlays (markers, info windows, polylines, polygons, ground overlays, tiles, heatmaps), integrate geospatial data (KML, GeoJSON, custom datasets, boundaries, quadtrees), or perform reverse geocoding on iOS using Swift or Objective-C.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/maps-sdk-for-ios-ios/SKILL.md\"\n  },\n  {\n    \"name\": \"maps-static-api-web-api\",\n    \"description\": \"Use this skill when the user wants to generate or embed a non-interactive, static Google Map image into a web page or application using the Maps Static API via HTTP URL requests. Apply this skill to configure static map parameters including image size, scale, format, map type, markers, paths, polygons, and custom cloud-based or inline map styling.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/maps-static-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"navigation-sdk-for-android-android\",\n    \"description\": \"Use this skill when building or enhancing Android applications with the Google Maps Platform Navigation SDK for Android. Use it to implement interactive turn-by-turn navigation, customize map views, configure routing and travel modes, handle real-time navigation events (location, arrival, route changes, speed), display and report route disruptions, and integrate with Android Auto or Wear OS.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/navigation-sdk-for-android-android/SKILL.md\"\n  },\n  {\n    \"name\": \"navigation-sdk-for-ios-ios\",\n    \"description\": \"Use this skill when building iOS applications with the Google Maps Platform Navigation SDK for iOS. Apply this skill to integrate interactive turn-by-turn navigation, configure routing and arrival preferences, track real-time session updates (location, ETA, speed, route changes), customize navigation UI and camera behaviors, implement CarPlay support, and manage real-time route disruption alerts and user reporting.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/navigation-sdk-for-ios-ios/SKILL.md\"\n  },\n  {\n    \"name\": \"places-aggregate-api-web-api\",\n    \"description\": \"Use this skill when querying the Google Maps Platform Places Aggregate HTTP REST API to retrieve the count or Google place identifiers of places within a specified geographic area, filtered by criteria such as place types, operating status, price levels, and user ratings.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/places-aggregate-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"places-api-web-api\",\n    \"description\": \"Use this skill when the user wants to search for places, retrieve place details, fetch place photos, get autocomplete suggestions, generate Google Maps action URIs, calculate routing distances and travel times to search results, or retrieve AI-powered place, review, and area summaries using the Google Maps Platform Places API (Web API / REST).\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/places-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"places-insights-api-web-api\",\n    \"description\": \"Use this skill when the user wants to analyze aggregated place metrics, perform geospatial data analysis, or write SQL queries against the Google Maps Platform Places Insights BigQuery dataset. Trigger this skill for tasks involving configuring BigQuery access for Places Insights, querying place counts directly from tables or using built-in SQL functions, aggregating places by type or H3 spatial grid cells, filtering analytics by commercial brand identifiers or geographic boundaries, and understanding core and country-specific table schemas.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/places-insights-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"places-sdk-for-android-android\",\n    \"description\": \"Use this skill when building location-aware Android applications using the Google Maps Platform Places SDK for Android. Trigger this skill when the user wants to search for places by text query, find nearby places, locate places along a route, retrieve detailed place information (including ratings, reviews, and Google Maps URIs), fetch and resize place photos, determine the device\'s current place, implement place autocomplete (programmatically or via UI widgets), generate AI-powered place, area, EV charging, or review summaries, calculate routing distances and travel times to search results, or integrate customizable Places UI Kit components into an Android app.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/places-sdk-for-android-android/SKILL.md\"\n  },\n  {\n    \"name\": \"places-sdk-for-ios-ios\",\n    \"description\": \"Use this skill when building iOS applications with the Google Maps Platform Places SDK for iOS. Invoke this skill whenever the user wants to search for places by text or proximity, implement place autocomplete (programmatically or via UI widgets), fetch detailed place data, photos, ratings, reviews, or AI-powered summaries (place overviews, area summaries, review summaries, EV charging amenities), detect the device\'s current place, search along routes, calculate travel distances and times to places, or integrate and customize pre-built Place UI elements in Swift or Objective-C.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/places-sdk-for-ios-ios/SKILL.md\"\n  },\n  {\n    \"name\": \"pollen-api-web-api\",\n    \"description\": \"Use this skill when retrieving localized pollen data, five-day pollen forecasts, plant allergen information, health recommendations, or pollen condition heatmap tiles via the Google Maps Platform Pollen HTTP REST API.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/pollen-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"roads-api-web-api\",\n    \"description\": \"Use this skill when working with the Google Maps Platform Roads API via HTTP REST requests. Activate this skill to snap GPS coordinates to the most likely road path, find the nearest road segments to specified coordinates, retrieve Google Place IDs for road segments, or query posted speed limits along a path or for specific road Place IDs.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/roads-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"route-optimization-api-web-api\",\n    \"description\": \"Use this skill when generating and optimizing multi-stop delivery plans, fleet routes, and logistics schedules using the Google Maps Platform Route Optimization API via HTTP REST requests. This skill helps configure shipment pickup and delivery time windows, vehicle load limits, cost models, parking buffers, live traffic consideration, and routing constraints like avoiding U-turns, as well as retrieving route polylines, navigation tokens, stop durations, and batch optimization results written to Google Cloud Storage.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/route-optimization-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"routes-api-web-api\",\n    \"description\": \"Use this skill when generating directions, calculating travel distances and times, or computing route matrices between multiple origins and destinations using the Google Maps Platform Routes API (HTTP REST). Apply this skill to requests involving route polylines, step-by-step maneuvers, toll calculations, waypoint optimization, traffic-aware routing, eco-friendly routes, or specific travel modes (drive, transit, walk, two-wheeled).\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/routes-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"solar-api-web-api\",\n    \"description\": \"Use this skill when the user wants to evaluate solar potential, roof geometry, or sunlight exposure for buildings at a specific location using the Google Maps Platform Solar API. This skill should be triggered to estimate solar panel capacity, annual sunshine hours, carbon offset potential, and financial benefits of solar installations via HTTP REST endpoints, or to retrieve GeoTIFF data layers including RGB aerial imagery, Digital Surface Models (DSM), building rooftop masks, annual or monthly solar flux, and hourly shade.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/solar-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"street-view-static-api-web-api\",\n    \"description\": \"Use this skill when generating URLs for static, non-interactive Google Street View images or querying Street View panorama metadata via HTTP requests. It covers specifying locations or panorama IDs, customizing camera point of view (heading, pitch, field of view), and securing requests with API keys and digital signatures.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/street-view-static-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"time-zone-api-web-api\",\n    \"description\": \"Use this skill when a user needs to retrieve time zone data for specific latitude and longitude coordinates using the Google Maps Platform Time Zone API. Invoke this skill to calculate local times, determine UTC and daylight saving time (DST) offsets, retrieve Unicode CLDR time zone IDs, or localize time zone names via HTTP REST requests.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/time-zone-api-web-api/SKILL.md\"\n  },\n  {\n    \"name\": \"weather-api-web-api\",\n    \"description\": \"Use this skill when a user needs to retrieve meteorological data for specific latitude and longitude coordinates using the Google Maps Platform Weather API. Invoke this skill to fetch current weather conditions, generate daily or hourly weather forecasts, retrieve up to 24 hours of historical hourly weather data, or check real-time severe weather alerts via HTTP REST endpoints.\",\n    \"entrypoint\": \"https://www.gstatic.com/googlemapsplatform-agent-skills/weather-api-web-api/SKILL.md\"\n  }\n]\n"
    num_lines: 213
    num_bytes: 24221
    line_range_bytes: 24221
  }
}
