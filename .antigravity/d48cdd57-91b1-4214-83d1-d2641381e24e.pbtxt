      original_chunk {
        target_content: "  {\n    name: \'share_live_location\',\n    description:\n      \'Starts live location sharing with registered trusted guardian contacts and requests fresh GPS coordinates.\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        durationMinutes: {\n          type: Type.NUMBER,\n          description: \'Optional sharing duration in minutes (default 30).\',\n        },\n      },\n    },\n  },\n  {\n    name: \'open_nearby_police\',\n    description:\n      \'Navigates directly to the Nearby Safe Places page filtered to Nearby Police Stations with live GPS centering.\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        category: {\n          type: Type.STRING,\n          description: \'Either \"police\" or \"restrooms\". Defaults to \"police\".\',\n        },\n      },\n    },\n  },\n  {\n    name: \'trigger_fake_call\',\n    description:\n      \'Launches the simulated incoming Fake Call screen to help the user leave an uncomfortable situation smoothly.\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        callerName: {\n          type: Type.STRING,\n          description: \'Optional simulated caller display name (e.g. Mom, Office).\',\n        },\n      },\n    },\n  },\n  {\n    name: \'start_safety_checkin\',\n    description:\n      \'Starts a timed Safety Check-In countdown on the Travel & Check-In page.\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        minutes: {\n          type: Type.NUMBER,\n          description: \'Minutes until check-in is due (default 10).\',\n        },\n      },\n    },\n  },\n  {\n    name: \'navigate_page\',\n    description:\n      \'Navigates to a specific dedicated page in OurSafe: \"home\", \"sos\", \"threat\", \"travel\", \"assistant\", \"nearby\", or \"history\".\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        page: {\n          type: Type.STRING,\n          description:\n            \'Target page identifier: home, sos, threat, travel, assistant, nearby, or history.\',\n        },\n      },\n      required: [\'page\'],\n    },\n  },\n];\n\nfunction buildSystemInstruction(userContext?: {\n  userName?: string;\n  primaryGuardianName?: string;\n  primaryGuardianPhone?: string;\n  threatActive?: boolean;\n  sosActive?: boolean;\n}): string {\n  const userName = userContext?.userName || \'the user\';\n  const guardian = userContext?.primaryGuardianName\n    ? `${userContext.primaryGuardianName} (${userContext.primaryGuardianPhone || \'number on file\'})`\n    : \'not yet configured\';\n\n  return `You are OurSafe Voice Controller, a calm, decisive, trustworthy AI safety assistant built into the OurSafe Women Safety Application.\nYou are speaking with ${userName}. Their primary registered guardian is ${guardian}.\nCurrent state: Threat Mode is ${userContext?.threatActive ? \'ACTIVE\' : \'inactive\'}, SOS is ${userContext?.sosActive ? \'ACTIVE\' : \'inactive\'}.\n\nCRITICAL ROLE:\n- You are an APPLICATION CONTROLLER, not just a conversational chatbot.\n- Whenever the user asks to perform an app action (\"Open SOS\", \"Call both guardian and police\", \"Call my guardian and police\", \"Call police\", \"Call my guardian\", \"Activate Threat Mode\", \"Deactivate Threat Mode\", \"Send emergency alert\", \"Share my live location\", \"Open nearby police stations\", \"Start a fake call\", \"Set a check-in\", etc.), you MUST immediately call the matching tool function first, then briefly confirm what happened in a calm, concise voice.\n- When the user asks to call both guardian and police (or makes an urgent SOS call request), call call_guardian_and_police immediately so the dual emergency call controller opens for BOTH their guardian and police (100 / 112 / nearest station).\n- For \"Open SOS\", call open_sos with initiateAlert: true and callBothGuardianAndPolice: true so the SOS screen opens with dual guardian + police call actions ready.\n- Never invent fake phone numbers or street addresses. Keep spoken replies brief (1 to 3 short sentences), clear, and reassuring.`;\n}"
        replacement_content: "  {\n    name: \'share_live_location\',\n    description:\n      \'Starts live location sharing with BOTH registered trusted guardians AND nearest police dispatch, requesting fresh GPS coordinates. Call when the user says \"Share my location\", \"Share my business\", \"Share my live location\", or \"Send location to guardian and police\".\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        durationMinutes: {\n          type: Type.NUMBER,\n          description: \'Optional sharing duration in minutes (default 30).\',\n        },\n        includePolice: {\n          type: Type.BOOLEAN,\n          description: \'Share live GPS with Police in addition to guardians (default true).\',\n        },\n      },\n    },\n  },\n  {\n    name: \'open_nearby_police\',\n    description:\n      \'Navigates directly to the Nearby Safe Places page filtered to Nearby Police Stations with live GPS centering and runs AI police station number lookup.\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        category: {\n          type: Type.STRING,\n          description: \'Either \"police\" or \"restrooms\". Defaults to \"police\".\',\n        },\n      },\n    },\n  },\n  {\n    name: \'open_travel_mode\',\n    description:\n      \'Opens Travel Mode with live Google Maps route tracking, off-route vehicle deviation alerts, and Auto / Cab Vehicle Number Verification.\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        focusSection: {\n          type: Type.STRING,\n          description: \'Optional focus: \"route\", \"vehicle_verify\", or \"checkin\".\',\n        },\n      },\n    },\n  },\n  {\n    name: \'open_lock_shield\',\n    description:\n      \'Opens the full-screen OurSafe Standby Lock Shield for 3x Shake, Secret Voice Code, and Screen Tap SOS protection.\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        surface: {\n          type: Type.STRING,\n          description: \'Either \"lock_screen\" or \"home_screen\". Defaults to \"lock_screen\".\',\n        },\n      },\n    },\n  },\n  {\n    name: \'trigger_fake_call\',\n    description:\n      \'Launches the simulated incoming Fake Call screen to help the user leave an uncomfortable situation smoothly.\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        callerName: {\n          type: Type.STRING,\n          description: \'Optional simulated caller display name (e.g. Mom, Office).\',\n        },\n      },\n    },\n  },\n  {\n    name: \'start_safety_checkin\',\n    description:\n      \'Starts a timed Safety Check-In countdown on the Travel & Check-In page.\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        minutes: {\n          type: Type.NUMBER,\n          description: \'Minutes until check-in is due (default 10).\',\n        },\n      },\n    },\n  },\n  {\n    name: \'navigate_page\',\n    description:\n      \'Navigates to a specific dedicated page in OurSafe: \"home\", \"sos\", \"threat\", \"travel\", \"assistant\", \"nearby\", or \"history\".\',\n    parameters: {\n      type: Type.OBJECT,\n      properties: {\n        page: {\n          type: Type.STRING,\n          description:\n            \'Target page identifier: home, sos, threat, travel, assistant, nearby, or history.\',\n        },\n      },\n      required: [\'page\'],\n    },\n  },\n];\n\nfunction buildSystemInstruction(userContext?: {\n  userName?: string;\n  primaryGuardianName?: string;\n  primaryGuardianPhone?: string;\n  threatActive?: boolean;\n  sosActive?: boolean;\n}): string {\n  const userName = userContext?.userName || \'the user\';\n  const guardian = userContext?.primaryGuardianName\n    ? `${userContext.primaryGuardianName} (${userContext.primaryGuardianPhone || \'number on file\'})`\n    : \'not yet configured\';\n\n  return `You are OurSafe Voice Controller, a calm, decisive, trustworthy AI safety assistant built into the OurSafe Women Safety Application.\nYou are speaking with ${userName}. Their primary registered guardian is ${guardian}.\nCurrent state: Threat Mode is ${userContext?.threatActive ? \'ACTIVE\' : \'inactive\'}, SOS is ${userContext?.sosActive ? \'ACTIVE\' : \'inactive\'}.\n\nCRITICAL ROLE \342\200\224 FULL HANDS-FREE VOICE APP AUTOMATION:\n- When AI Voice is ON, the user controls the ENTIRE OurSafe application purely by voice without needing manual taps.\n- Whenever the user says commands like \"Go to SOS\", \"Open SOS\", \"Call both guardian and police\", \"Call police\", \"Call my guardian\", \"Activate Threat Mode\", \"Dread mode\", \"Deactivate Threat Mode\", \"Send emergency alert\", \"Share my location\", \"Share my business\", \"Find police numbers\", \"Open nearby police\", \"Open travel mode\", \"Verify auto number\", \"Open lock shield\", \"Start a fake call\", \"Set a check-in\", or \"Open history\", you MUST immediately execute the matching tool function first, then briefly confirm in 1 to 2 calm sentences.\n- For \"Go to SOS\" or \"Open SOS\": call open_sos with initiateAlert: true and callBothGuardianAndPolice: true immediately.\n- For \"Activate Threat Mode\" or \"Dread Mode\": call activate_threat_mode with autoStartRecording: \"video\" immediately (continuous video+audio recording starts automatically without extra confirmations).\n- For \"Share my location\" or \"Share my business\": call share_live_location with includePolice: true so live GPS is shared with BOTH registered guardians AND nearest police.\n- Never invent fake phone numbers or street addresses. Keep spoken replies concise, calm, and reassuring.`;\n}"
