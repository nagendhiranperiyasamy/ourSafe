er,\n  ]);\n\n  // Auto-arm always-on voice wake listener on first user gesture if voice safety is enabled\n  useEffect(() => {\n    const anyVoiceEnabled =\n      preferences.voiceActivationEnabled || preferences.wakeWordEnabled;\n    if (!anyVoiceEnabled || !voiceSupported || suspended) return;\n    if (autoArmedGestureRef.current) return;\n\n    const handleFirstGesture = () => {\n      if (autoArmedGestureRef.current) return;\n      autoArmedGestureRef.current = true;\n      if (\n        !shouldKeepVoiceRunningRef.current &&\n        !suspendedRef.current &&\n        (prefsRef.current.voiceActivationEnabled || prefsRef.current.wakeWordEnabled)\n      ) {\n        startVoiceWakeListener();\n      }\n    };\n\n    window.addEventListener(\'pointerdown\', handleFirstGesture, { once: true, passive: true });\n    return () => {\n      window.removeEventListener(\'pointerdown\', handleFirstGesture);\n    };\n  }, [\n    preferences.voiceActivationEnabled,\n    preferences.wakeWordEnabled,\n    voiceSupported,\n    suspended,\n    startVoiceWakeListener,\n  ]);"
