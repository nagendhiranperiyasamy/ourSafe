    tool_calls {
      id: "call_8419051136860987201"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import \'dotenv/config\';\\nimport express from \'express\';\\nimport http from \'http\';\\nimport path from \'path\';\\nimport { fileURLToPath } from \'url\';\\nimport { WebSocketServer, WebSocket } from \'ws\';\\nimport {\\n  GoogleGenAI,\\n  Modality,\\n  Type,\\n  type FunctionDeclaration,\\n  type LiveServerMessage,\\n} from \'@google/genai\';\\n\\nconst __filename = fileURLToPath(import.meta.url);\\nconst __dirname = path.dirname(__filename);\\n\\nconst PORT = Number(process.env.PORT || 3000);\\n\\nfunction getAiClient(): GoogleGenAI {\\n  const apiKey = process.env.GEMINI_API_KEY;\\n  if (!apiKey) {\\n    throw new Error(\\n      \'GEMINI_API_KEY is not configured. Add it in Settings > Secrets to use the live AI Voice Assistant.\'\\n    );\\n  }\\n  return new GoogleGenAI({\\n    apiKey,\\n    httpOptions: {\\n      headers: {\\n        \'User-Agent\': \'aistudio-build\',\\n      },\\n    },\\n  });\\n}\\n\\nconst SAFETY_VOICE_TOOLS: FunctionDeclaration[] = [\\n  {\\n    name: \'open_sos\',\\n    description:\\n      \'Opens the dedicated SOS Emergency page, identifies the registered guardian, prepares emergency call and alert delivery with current location, and surfaces nearest police station contact options. Call immediately when the user says \\\"Open SOS\\\", \\\"SOS\\\", \\\"Emergency\\\", or asks for urgent help.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        initiateAlert: {\\n          type: Type.BOOLEAN,\\n          description:\\n            \'Whether to immediately initiate the emergency alert status workflow with available location.\',\\n        },\\n        reason: {\\n          type: Type.STRING,\\n          description: \'Short summary of why SOS was triggered.\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'activate_threat_mode\',\\n    description:\\n      \'Navigates to the Threat Mode page and activates Intelligent Threat Mode protection (notifies guardians, captures location snapshot, enables audio/video evidence recording and device connectivity monitoring).\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        autoStartRecording: {\\n          type: Type.STRING,\\n          description: \'Optional recording preference: \\\"none\\\", \\\"audio\\\", or \\\"video\\\".\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'deactivate_threat_mode\',\\n    description:\\n      \'Deactivates an active Threat Mode session, stops emergency recording if active, and logs safe stand-down in Emergency History.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        note: {\\n          type: Type.STRING,\\n          description: \'Optional user status note.\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'call_guardian\',\\n    description:\\n      \'Prepares and opens the emergency guardian call action for the registered primary guardian or a specifically named guardian contact.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        guardianName: {\\n          type: Type.STRING,\\n          description: \'Optional name of a specific guardian contact to call.\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'send_emergency_alert\',\\n    description:\\n      \'Dispatches an emergency alert containing the user available GPS location to all registered emergency contacts and updates emergency delivery status.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        message: {\\n          type: Type.STRING,\\n          description: \'Optional custom emergency note to include in the alert.\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'share_live_location\',\\n    description:\\n      \'Starts live location sharing with registered trusted guardian contacts and requests fresh GPS coordinates.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        durationMinutes: {\\n          type: Type.NUMBER,\\n          description: \'Optional sharing duration in minutes (default 30).\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'open_nearby_police\',\\n    description:\\n      \'Navigates directly to the Nearby Safe Places page filtered to Nearby Police Stations with live GPS centering.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        category: {\\n          type: Type.STRING,\\n          description: \'Either \\\"police\\\" or \\\"restrooms\\\". Defaults to \\\"police\\\".\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'trigger_fake_call\',\\n    description:\\n      \'Launches the simulated incoming Fake Call screen to help the user leave an uncomfortable situation smoothly.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        callerName: {\\n          type: Type.STRING,\\n          description: \'Optional simulated caller display name (e.g. Mom, Office).\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'start_safety_checkin\',\\n    description:\\n      \'Starts a timed Safety Check-In countdown on the Travel & Check-In page.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        minutes: {\\n          type: Type.NUMBER,\\n          description: \'Minutes until check-in is due (default 10).\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'navigate_page\',\\n    description:\\n      \'Navigates to a specific dedicated page in AuraSafe: \\\"home\\\", \\\"sos\\\", \\\"threat\\\", \\\"travel\\\", \\\"assistant\\\", \\\"nearby\\\", or \\\"history\\\".\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        page: {\\n          type: Type.STRING,\\n          description:\\n            \'Target page identifier: home, sos, threat, travel, assistant, nearby, or history.\',\\n        },\\n      },\\n      required: [\'page\'],\\n    },\\n  },\\n];\\n\\nfunction buildSystemInstruction(userContext?: {\\n  userName?: string;\\n  primaryGuardianName?: string;\\n  primaryGuardianPhone?: string;\\n  threatActive?: boolean;\\n  sosActive?: boolean;\\n}): string {\\n  const userName = userContext?.userName || \'the user\';\\n  const guardian = userContext?.primaryGuardianName\\n    ? `${userContext.primaryGuardianName} (${userContext.primaryGuardianPhone || \'number on file\'})`\\n    : \'not yet configured\';\\n\\n  return `You are AuraSafe Voice Controller, a calm, decisive, trustworthy AI safety assistant built into the AuraSafe Women Safety Application.\\nYou are speaking with ${userName}. Their primary registered guardian is ${guardian}.\\nCurrent state: Threat Mode is ${userContext?.threatActive ? \'ACTIVE\' : \'inactive\'}, SOS is ${userContext?.sosActive ? \'ACTIVE\' : \'inactive\'}.\\n\\nCRITICAL ROLE:\\n- You are an APPLICATION CONTROLLER, not just a conversational chatbot.\\n- Whenever the user asks to perform an app action (\\\"Open SOS\\\", \\\"Activate Threat Mode\\\", \\\"Deactivate Threat Mode\\\", \\\"Call my guardian\\\", \\\"Send emergency alert\\\", \\\"Share my live location\\\", \\\"Open nearby police stations\\\", \\\"Start a fake call\\\", \\\"Set a check-in\\\", \\\"Open history\\\", etc.), you MUST immediately call the matching tool function first, then briefly confirm what happened in a calm, concise voice.\\n- For \\\"Open SOS\\\", call open_sos with initiateAlert: true so the SOS screen opens, guardian details are surfaced, emergency alert workflow initiates, and nearest police station options are shown.\\n- Never claim a real phone call was placed automatically without user confirmation on the dialer, and never invent fake street addresses. Keep spoken replies brief (1 to 3 short sentences), clear, and reassuring, especially during urgent situations.`;\\n}\\n\\nasync function startServer() {\\n  const app = express();\\n  app.use(express.json({ limit: \'2mb\' }));\\n\\n  app.get(\'/api/health\', (_req, res) => {\\n    res.json({ ok: true, liveVoiceReady: Boolean(process.env.GEMINI_API_KEY) });\\n  });\\n\\n  // REST AI App-Controller Endpoint (gemini-4-hydrogen + function calling) for typed commands & fallback\\n  app.post(\'/api/assistant/command\', async (req, res) => {\\n    try {\\n      const { text, userContext } = req.body as {\\n        text?: string;\\n        userContext?: {\\n          userName?: string;\\n          primaryGuardianName?: string;\\n          primaryGuardianPhone?: string;\\n          threatActive?: boolean;\\n          sosActive?: boolean;\\n        };\\n      };\\n\\n      if (!text || typeof text !== \'string\' || !text.trim()) {\\n        res.status(400).json({ error: \'Command text is required.\' });\\n        return;\\n      }\\n\\n      const ai = getAiClient();\\n      const response = await ai.models.generateContent({\\n        model: \'gemini-4-hydrogen\',\\n        contents: text.trim(),\\n        config: {\\n          systemInstruction: buildSystemInstruction(userContext),\\n          tools: [{ functionDeclarations: SAFETY_VOICE_TOOLS }],\\n        },\\n      });\\n\\n      const functionCalls = (response.functionCalls ?? []).map((fc) => ({\\n        id: fc.id ?? `fc-${Date.now()}`,\\n        name: fc.name ?? \'\',\\n        args: fc.args ?? {},\\n      }));\\n\\n      res.json({\\n        reply:\\n          response.text?.trim() ||\\n          (functionCalls.length > 0\\n            ? `Executing ${functionCalls.map((c) => c.name.replace(/_/g, \' \')).join(\', \')}.`\\n            : \'I am ready to help. You can say or type commands like \\\"Open SOS\\\", \\\"Activate Threat Mode\\\", or \\\"Open Nearby Police Stations\\\".\'),\\n        toolCalls: functionCalls,\\n      });\\n    } catch (err) {\\n      const message =\\n        err instanceof Error ? err.message : \'Failed to process AI command.\';\\n      res.status(500).json({ error: message });\\n    }\\n  });\\n\\n  const server = http.createServer(app);\\n\\n  // Real-Time Gemini 3.8 Live API WebSocket Bridge\\n  const wss = new WebSocketServer({ server, path: \'/api/live-voice\' });\\n\\n  wss.on(\'connection\', (clientWs: WebSocket) => {\\n    let liveSession: Awaited<ReturnType<GoogleGenAI[\'live\'][\'connect\']>> | null =\\n      null;\\n    let closed = false;\\n\\n    const sendJson = (payload: Record<string, unknown>) => {\\n      if (clientWs.readyState === WebSocket.OPEN) {\\n        clientWs.send(JSON.stringify(payload));\\n      }\\n    };\\n\\n    const connectLiveSession = async (userContext?: {\\n      userName?: string;\\n      primaryGuardianName?: string;\\n      primaryGuardianPhone?: string;\\n      threatActive?: boolean;\\n      sosActive?: boolean;\\n    }) => {\\n      try {\\n        const ai = getAiClient();\\n        liveSession = await ai.live.connect({\\n          model: \'gemini-3.8-live\',\\n          config: {\\n            responseModalities: [Modality.AUDIO],\\n            speechConfig: {\\n              voiceConfig: {\\n                prebuiltVoiceConfig: { voiceName: \'Kore\' },\\n              },\\n            },\\n            inputAudioTranscription: {},\\n            outputAudioTranscription: {},\\n            tools: [{ functionDeclarations: SAFETY_VOICE_TOOLS }],\\n            systemInstruction: buildSystemInstruction(userContext),\\n          },\\n          callbacks: {\\n            onopen: () => {\\n              if (!closed) {\\n                sendJson({ type: \'ready\' });\\n              }\\n            },\\n            onmessage: (message: LiveServerMessage) => {\\n              if (closed) return;\\n\\n              const content = message.serverContent;\\n              if (content?.inputTranscription?.text) {\\n                sendJson({\\n                  type: \'inputTranscript\',\\n                  text: content.inputTranscription.text,\\n                });\\n              }\\n              if (content?.outputTranscription?.text) {\\n                sendJson({\\n                  type: \'outputTranscript\',\\n                  text: content.outputTranscription.text,\\n                });\\n              }\\n\\n              for (const part of content?.modelTurn?.parts ?? []) {\\n                if (part.inlineData?.data) {\\n                  sendJson({\\n                    type: \'audio\',\\n                    data: part.inlineData.data,\\n                  });\\n                }\\n              }\\n\\n              if (content?.interrupted) {\\n                sendJson({ type: \'interrupted\' });\\n              }\\n\\n              if (content?.turnComplete) {\\n                sendJson({ type: \'turnComplete\' });\\n              }\\n\\n              const calls = message.toolCall?.functionCalls;\\n              if (calls && calls.length > 0) {\\n                sendJson({\\n                  type: \'toolCall\',\\n                  calls: calls.map((c) => ({\\n                    id: c.id ?? `live-tc-${Date.now()}`,\\n                    name: c.name ?? \'\',\\n                    args: c.args ?? {},\\n                  })),\\n                });\\n              }\\n            },\\n            onerror: (err: unknown) => {\\n              const msg =\\n                err instanceof Error\\n                  ? err.message\\n                  : \'Gemini Live session encountered an error.\';\\n              sendJson({ type: \'error\', message: msg });\\n            },\\n            onclose: () => {\\n              if (!closed) {\\n                sendJson({ type: \'closed\' });\\n              }\\n            },\\n          },\\n        });\\n      } catch (err) {\\n        const message =\\n          err instanceof Error\\n            ? err.message\\n            : \'Unable to connect to Gemini Live API.\';\\n        sendJson({ type: \'error\', message });\\n      }\\n    };\\n\\n    clientWs.on(\'message\', async (raw) => {\\n      try {\\n        const msg = JSON.parse(raw.toString()) as {\\n          type?: string;\\n          audio?: string;\\n          text?: string;\\n          userContext?: {\\n            userName?: string;\\n            primaryGuardianName?: string;\\n            primaryGuardianPhone?: string;\\n            threatActive?: boolean;\\n            sosActive?: boolean;\\n          };\\n          responses?: Array<{\\n            id: string;\\n            name: string;\\n            response: Record<string, unknown>;\\n          }>;\\n        };\\n\\n        if (msg.type === \'init\') {\\n          if (!liveSession) {\\n            await connectLiveSession(msg.userContext);\\n          }\\n          return;\\n        }\\n\\n        if (!liveSession) return;\\n\\n        if (msg.type === \'audio\' && msg.audio) {\\n          liveSession.sendRealtimeInput({\\n            audio: { data: msg.audio, mimeType: \'audio/pcm;rate=16000\' },\\n          });\\n        } else if (msg.type === \'text\' && msg.text) {\\n          liveSession.sendRealtimeInput({ text: msg.text });\\n        } else if (msg.type === \'toolResponse\' && Array.isArray(msg.responses)) {\\n          liveSession.sendToolResponse({\\n            functionResponses: msg.responses,\\n          });\\n        }\\n      } catch (err) {\\n        const message =\\n          err instanceof Error ? err.message : \'Invalid Live Voice message.\';\\n        sendJson({ type: \'error\', message });\\n      }\\n    });\\n\\n    clientWs.on(\'close\', () => {\\n      closed = true;\\n      if (liveSession) {\\n        try {\\n          liveSession.close();\\n        } catch {\\n          // ignore close errors\\n        }\\n        liveSession = null;\\n      }\\n    });\\n  });\\n\\n  if (process.env.NODE_ENV !== \'production\') {\\n    const { createServer: createViteServer } = await import(\'vite\');\\n    const vite = await createViteServer({\\n      server: { middlewareMode: true },\\n      appType: \'spa\',\\n    });\\n    app.use(vite.middlewares);\\n  } else {\\n    const distPath = path.resolve(__dirname, \'dist\');\\n    app.use(express.static(distPath));\\n    app.get(\'*\', (_req, res) => {\\n      res.sendFile(path.join(distPath, \'index.html\'));\\n    });\\n  }\\n\\n  server.listen(PORT, \'0.0.0.0\', () => {\\n    console.log(`AuraSafe server running on http://0.0.0.0:${PORT}`);\\n  });\\n}\\n\\nstartServer();\\n\", \"Description\":\"Create Express + WebSocket full-stack server bridging Gemini 3.8 Live API real-time voice app control and Gemini 4 Hydrogen text command routing\", \"Overwrite\":true, \"TargetFile\":\"/server.ts\", \"toolAction\":\"Creating Express and Gemini Live server\", \"toolSummary\":\"Create server.ts\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_8419051136860984580"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"export type ActiveScreen = \'login\' | \'signup\' | \'home\';\\n\\nexport type AppPage =\\n  | \'home\'\\n  | \'sos\'\\n  | \'threat\'\\n  | \'travel\'\\n  | \'assistant\'\\n  | \'nearby\'\\n  | \'history\';\\n\\nexport type ActiveModal =\\n  | null\\n  | \'contacts\'\\n  | \'profile\'\\n  | \'settings\'\\n  | \'notifications\'\\n  | \'fakecall\';\\n\\nexport interface SosContact {\\n  id: string;\\n  name: string;\\n  phone: string;\\n  relation: string;\\n  isPrimary?: boolean;\\n}\\n\\nexport interface SafetyPreferences {\\n  travelCheckInReminders: boolean;\\n  guardianUpdates: boolean;\\n  soundAlarmEnabled: boolean;\\n  locationOnlyDuringEmergency: boolean;\\n  maskLockscreenPreviews: boolean;\\n  shakeDetectionEnabled: boolean;\\n  voiceActivationEnabled: boolean;\\n  voiceKeyword: string;\\n  quickDialGuardianOnVoiceSos: boolean;\\n}\\n\\nexport interface UserProfile {\\n  id: string;\\n  fullName: string;\\n  phone: string;\\n  email: string;\\n  age: number;\\n  guardianName: string;\\n  guardianPhone: string;\\n  password: string;\\n  photoDataUrl?: string;\\n  createdAt: string;\\n  sosContacts: SosContact[];\\n  preferences: SafetyPreferences;\\n}\\n\\nexport interface TravelSession {\\n  active: boolean;\\n  startLocation: string;\\n  destination: string;\\n  guardianId: string;\\n  guardianName: string;\\n  guardianPhone: string;\\n  startedAt: string;\\n  lastCheckInAt: string;\\n}\\n\\nexport interface SafetyCheckInSession {\\n  active: boolean;\\n  label: string;\\n  guardianId: string;\\n  guardianName: string;\\n  guardianPhone: string;\\n  durationSeconds: number;\\n  startedAt: string;\\n  dueAt: string;\\n  status: \'active\' | \'confirmed\' | \'missed\';\\n}\\n\\nexport interface LiveLocationShareSession {\\n  active: boolean;\\n  startedAt: string;\\n  durationMinutes: number;\\n  sharedWithNames: string[];\\n  lastLatitude: number | null;\\n  lastLongitude: number | null;\\n  lastUpdatedAt: string;\\n}\\n\\nexport type AlertDeliveryStatus =\\n  | \'standby\'\\n  | \'initiated\'\\n  | \'delivered_demo\'\\n  | \'queued_offline\'\\n  | \'failed\';\\n\\nexport interface SosAlertRecord {\\n  id: string;\\n  activatedAt: string;\\n  triggerSource: string;\\n  status: AlertDeliveryStatus;\\n  latitude: number | null;\\n  longitude: number | null;\\n  recipients: Array<{\\n    name: string;\\n    phone: string;\\n    status: \'initiated\' | \'delivered_demo\' | \'queued_offline\' | \'failed\';\\n  }>;\\n  note?: string;\\n}\\n\\nexport interface ThreatSessionState {\\n  active: boolean;\\n  sessionId: string;\\n  activatedAt: string;\\n  lastHeartbeatAt: string;\\n  lastLatitude: number | null;\\n  lastLongitude: number | null;\\n  batteryPercent: number | null;\\n  isOnline: boolean;\\n  recordingMode: \'none\' | \'audio\' | \'video\';\\n  guardianNotificationStatus: AlertDeliveryStatus;\\n  interruptedUnexpectedly?: boolean;\\n}\\n\\nexport type EmergencyHistoryCategory =\\n  | \'sos\'\\n  | \'threat\'\\n  | \'location\'\\n  | \'recording\'\\n  | \'connectivity\'\\n  | \'guardian\'\\n  | \'checkin\';\\n\\nexport interface EmergencyHistoryEntry {\\n  id: string;\\n  timestamp: string;\\n  category: EmergencyHistoryCategory;\\n  title: string;\\n  detail: string;\\n  statusLabel?: string;\\n  locationCoords?: string;\\n  recordingId?: string;\\n  recordingKind?: \'audio\' | \'video\';\\n}\\n\\nexport interface StoredRecordingMeta {\\n  id: string;\\n  userId: string;\\n  kind: \'audio\' | \'video\';\\n  mimeType: string;\\n  createdAt: string;\\n  durationSec: number;\\n  sizeBytes: number;\\n  sessionId?: string;\\n  locationCoords?: string;\\n  sharedWithGuardians?: boolean;\\n}\\n\\nexport interface AppNotification {\\n  id: string;\\n  title: string;\\n  detail: string;\\n  timestamp: string;\\n  category: \'travel\' | \'sos\' | \'account\' | \'safety\';\\n  read: boolean;\\n}\\n\\nexport interface UserReviewItem {\\n  id: string;\\n  author: string;\\n  role: string;\\n  rating: number;\\n  comment: string;\\n  createdAt: string;\\n  isSample: boolean;\\n}\\n\\nexport interface TeamInfoConfig {\\n  founderName: string;\\n  founderIntro: string;\\n  teamMembers: string;\\n  vision: string;\\n  mission: string;\\n}\\n\\nexport interface GeoLocationState {\\n  status: \'idle\' | \'loading\' | \'granted\' | \'denied\' | \'unsupported\';\\n  latitude: number | null;\\n  longitude: number | null;\\n  accuracy: number | null;\\n  errorMessage?: string;\\n  updatedAt?: string;\\n}\\n\\nexport interface VoiceCommandAction {\\n  id: string;\\n  name: string;\\n  args: Record<string, unknown>;\\n}\\n\", \"Description\":\"Expand safety TypeScript types for dedicated pages, Threat Mode sessions, SOS status tracking, Evidence History, Recordings, Check-Ins, Reviews, and Team Info\", \"Overwrite\":true, \"TargetFile\":\"/src/types/safety.ts\", \"toolAction\":\"Updating safety TypeScript types\", \"toolSummary\":\"Update safety.ts types\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_8419051136860986055"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { StoredRecordingMeta } from \'../types/safety\';\\n\\nconst DB_NAME = \'aurasafe_evidence_db_v1\';\\nconst STORE_NAME = \'recordings\';\\nconst DB_VERSION = 1;\\n\\nexport interface StoredRecordingRecord extends StoredRecordingMeta {\\n  blob: Blob;\\n}\\n\\nfunction openDb(): Promise<IDBDatabase> {\\n  return new Promise((resolve, reject) => {\\n    if (typeof indexedDB === \'undefined\') {\\n      reject(new Error(\'IndexedDB is not supported in this browser.\'));\\n      return;\\n    }\\n    const req = indexedDB.open(DB_NAME, DB_VERSION);\\n    req.onupgradeneeded = () => {\\n      const db = req.result;\\n      if (!db.objectStoreNames.contains(STORE_NAME)) {\\n        const store = db.createObjectStore(STORE_NAME, { keyPath: \'id\' });\\n        store.createIndex(\'userId\', \'userId\', { unique: false });\\n      }\\n    };\\n    req.onsuccess = () => resolve(req.result);\\n    req.onerror = () => reject(req.error ?? new Error(\'Failed to open evidence database.\'));\\n  });\\n}\\n\\nexport async function saveRecordingToDb(\\n  record: StoredRecordingRecord\\n): Promise<void> {\\n  const db = await openDb();\\n  return new Promise((resolve, reject) => {\\n    const tx = db.transaction(STORE_NAME, \'readwrite\');\\n    tx.objectStore(STORE_NAME).put(record);\\n    tx.oncomplete = () => {\\n      db.close();\\n      resolve();\\n    };\\n    tx.onerror = () => {\\n      db.close();\\n      reject(tx.error ?? new Error(\'Failed to store recording.\'));\\n    };\\n  });\\n}\\n\\nexport async function listUserRecordings(\\n  userId: string\\n): Promise<StoredRecordingRecord[]> {\\n  const db = await openDb();\\n  return new Promise((resolve, reject) => {\\n    const tx = db.transaction(STORE_NAME, \'readonly\');\\n    const index = tx.objectStore(STORE_NAME).index(\'userId\');\\n    const req = index.getAll(userId);\\n    req.onsuccess = () => {\\n      db.close();\\n      const items = (req.result as StoredRecordingRecord[]) ?? [];\\n      items.sort(\\n        (a, b) =>\\n          new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime()\\n      );\\n      resolve(items);\\n    };\\n    req.onerror = () => {\\n      db.close();\\n      reject(req.error ?? new Error(\'Failed to read recordings.\'));\\n    };\\n  });\\n}\\n\\nexport async function updateRecordingSharedFlag(\\n  id: string,\\n  sharedWithGuardians: boolean\\n): Promise<void> {\\n  const db = await openDb();\\n  return new Promise((resolve, reject) => {\\n    const tx = db.transaction(STORE_NAME, \'readwrite\');\\n    const store = tx.objectStore(STORE_NAME);\\n    const getReq = store.get(id);\\n    getReq.onsuccess = () => {\\n      const existing = getReq.result as StoredRecordingRecord | undefined;\\n      if (existing) {\\n        store.put({ ...existing, sharedWithGuardians });\\n      }\\n    };\\n    tx.oncomplete = () => {\\n      db.close();\\n      resolve();\\n    };\\n    tx.onerror = () => {\\n      db.close();\\n      reject(tx.error ?? new Error(\'Failed to update recording.\'));\\n    };\\n  });\\n}\\n\\nexport async function deleteRecordingFromDb(id: string): Promise<void> {\\n  const db = await openDb();\\n  return new Promise((resolve, reject) => {\\n    const tx = db.transaction(STORE_NAME, \'readwrite\');\\n    tx.objectStore(STORE_NAME).delete(id);\\n    tx.oncomplete = () => {\\n      db.close();\\n      resolve();\\n    };\\n    tx.onerror = () => {\\n      db.close();\\n      reject(tx.error ?? new Error(\'Failed to delete recording.\'));\\n    };\\n  });\\n}\\n\\nexport async function clearUserRecordings(userId: string): Promise<void> {\\n  const records = await listUserRecordings(userId);\\n  await Promise.all(records.map((r) => deleteRecordingFromDb(r.id)));\\n}\\n\", \"Description\":\"Create IndexedDB helper for storing, playing, sharing, and deleting local Threat Mode audio/video evidence recordings offline\", \"Overwrite\":true, \"TargetFile\":\"/src/utils/evidenceDb.ts\", \"toolAction\":\"Creating IndexedDB evidence storage utility\", \"toolSummary\":\"Create evidenceDb.ts\"}"
      original_name: "write_to_file"
    }
