    content: "import React, { useState } from \'react\';\nimport {\n  Building2,\n  ExternalLink,\n  LocateFixed,\n  MapPin,\n  Navigation,\n  Shield,\n} from \'lucide-react\';\nimport { GeoLocationState } from \'../../types/safety\';\n\ninterface NearbyLocationsSectionProps {\n  geoLocation: GeoLocationState;\n  onRequestLocation: () => void;\n  initialCategory?: \'police\' | \'restrooms\';\n}\n\ntype NearbyCategory = \'police\' | \'restrooms\';\n\nexport const NearbyLocationsSection: React.FC<NearbyLocationsSectionProps> = ({\n  geoLocation,\n  onRequestLocation,\n  initialCategory = \'police\',\n}) => {\n  const [category, setCategory] = useState<NearbyCategory>(initialCategory);\n\n  React.useEffect(() => {\n    setCategory(initialCategory);\n  }, [initialCategory]);\n\n  const hasCoords =\n    geoLocation.status === \'granted\' &&\n    geoLocation.latitude !== null &&\n    geoLocation.longitude !== null;\n\n  const queryTerm =\n    category === \'police\' ? \'police station\' : \'public restroom\';\n\n  const mapsSearchUrl = hasCoords\n    ? `https://www.google.com/maps/search/${encodeURIComponent(queryTerm)}/@${geoLocation.latitude},${geoLocation.longitude},15z`\n    : `https://www.google.com/maps/search/${encodeURIComponent(queryTerm + \' near me\')}`;\n\n  return (\n    <section className=\"bg-white rounded-3xl border border-violet-200/80 p-5 sm:p-6 shadow-sm shadow-violet-950/[0.02]\">\n      <div className=\"flex flex-wrap items-start justify-between gap-3 mb-5\">\n        <div>\n          <p className=\"text-xs font-semibold text-violet-700\">\n            Nearby Safe Places \302\267 Maps API Placeholder\n          </p>\n          <h3 className=\"mt-1 text-lg sm:text-xl font-bold text-[#1A132B]\">\n            Nearby Police Stations &amp; Restrooms\n          </h3>\n        </div>\n\n        {/* Category Filter Buttons */}\n        <div\n          role=\"tablist\"\n          aria-label=\"Nearby place type\"\n          className=\"inline-flex items-center gap-1 p-1 rounded-xl bg-[#F4F0FF] border border-violet-200/70\"\n        >\n          <button\n            type=\"button\"\n            role=\"tab\"\n            aria-selected={category === \'police\'}\n            onClick={() => setCategory(\'police\')}\n            className={`min-h-[38px] px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n              category === \'police\'\n                ? \'bg-white text-violet-900 shadow-sm\'\n                : \'text-[#574E6B] hover:text-[#1A132B]\'\n            }`}\n          >\n            <Shield className=\"w-3.5 h-3.5\" />\n            <span>Police Stations</span>\n          </button>\n\n          <button\n            type=\"button\"\n            role=\"tab\"\n            aria-selected={category === \'restrooms\'}\n            onClick={() => setCategory(\'restrooms\')}\n            className={`min-h-[38px] px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-colors whitespace-nowrap shrink-0 cursor-pointer ${\n              category === \'restrooms\'\n                ? \'bg-white text-violet-900 shadow-sm\'\n                : \'text-[#574E6B] hover:text-[#1A132B]\'\n            }`}\n          >\n            <Building2 className=\"w-3.5 h-3.5\" />\n            <span>Restrooms</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Map Integration Placeholder Visual */}\n      <div className=\"relative rounded-2xl overflow-hidden border border-violet-200/80 bg-[#F4F0FF] min-h-[210px] flex items-center justify-center\">\n        <img\n          src=\"/src/assets/images/map_grid_backdrop_1795271545558.jpg\"\n          alt=\"Minimal architectural city street grid backdrop for maps integration\"\n          referrerPolicy=\"no-referrer\"\n          className=\"absolute inset-0 w-full h-full object-cover opacity-85\"\n        />\n        <div className=\"absolute inset-0 bg-gradient-to-t from-white/95 via-white/80 to-white/65\" />\n\n        <div className=\"relative z-10 p-5 sm:p-6 text-center max-w-lg space-y-3\">\n          <div className=\"w-11 h-11 rounded-2xl bg-violet-700 text-white flex items-center justify-center mx-auto shadow-sm\">\n            <MapPin className=\"w-5 h-5\" />\n          </div>\n\n          <div>\n            <p className=\"text-sm font-bold text-[#1A132B]\">\n              {category === \'police\'\n                ? \'Find Nearby Police Stations\'\n                : \'Find Nearby Public Restrooms\'}\n            </p>\n            <p className=\"mt-1 text-xs text-[#4A4063] leading-relaxed\">\n              Live embedded place results require a configured Maps/Places API key. To avoid showing fabricated addresses or distances, no mock places are listed here.\n            </p>\n          </div>\n\n          {hasCoords ? (\n            <p className=\"text-xs font-mono tabular-nums text-violet-900 font-semibold\">\n              Your GPS: {geoLocation.latitude!.toFixed(5)},{\' \'}\n              {geoLocation.longitude!.toFixed(5)}\n            </p>\n          ) : (\n            <p className=\"text-xs text-[#6B6182]\">\n              {geoLocation.status === \'loading\'\n                ? \'Reading browser location...\'\n                : \'Enable browser location to center your external map search accurately.\'}\n            </p>\n          )}\n\n          <div className=\"flex flex-wrap items-center justify-center gap-2.5 pt-1\">\n            <button\n              type=\"button\"\n              onClick={onRequestLocation}\n              className=\"min-h-[42px] px-4 py-2 rounded-xl bg-white hover:bg-[#FAF8FF] border border-violet-200 text-[#1A132B] text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer whitespace-nowrap\"\n            >\n              <LocateFixed className=\"w-3.5 h-3.5 text-violet-700\" />\n              <span>{hasCoords ? \'Refresh GPS\' : \'Use My Location\'}</span>\n            </button>\n\n            <a\n              href={mapsSearchUrl}\n              target=\"_blank\"\n              rel=\"noopener noreferrer\"\n              className=\"min-h-[42px] px-4 py-2 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-xs font-semibold flex items-center gap-1.5 transition-colors whitespace-nowrap\"\n            >\n              <Navigation className=\"w-3.5 h-3.5\" />\n              <span>\n                Search {category === \'police\' ? \'Police Stations\' : \'Restrooms\'} on Maps\n              </span>\n              <ExternalLink className=\"w-3.5 h-3.5\" />\n            </a>\n          </div>\n        </div>\n      </div>\n\n      {/* Honest Structured Card Preview Explaining Expected API Data */}\n      <div className=\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3\">\n        <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-4 flex flex-col justify-between gap-3\">\n          <div>\n            <p className=\"text-sm font-bold text-[#1A132B]\">\n              {category === \'police\'\n                ? \'Nearest Police Station (API Pending)\'\n                : \'Nearest Public Restroom (API Pending)\'}\n            </p>\n            <p className=\"mt-1 text-xs text-[#6B6182]\">\n              Distance: Available once Places API is connected\n            </p>\n            <p className=\"mt-0.5 text-xs text-[#6B6182]\">\n              Address: Live verified street address will appear here\n            </p>\n          </div>\n          <a\n            href={mapsSearchUrl}\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"min-h-[40px] px-3.5 py-2 rounded-xl bg-white hover:bg-violet-50 border border-violet-200 text-violet-800 text-xs font-semibold inline-flex items-center justify-center gap-1.5 transition-colors\"\n          >\n            <Navigation className=\"w-3.5 h-3.5\" />\n            <span>Open Directions in Maps</span>\n          </a>\n        </div>\n\n        <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-4 flex flex-col justify-between gap-3\">\n          <div>\n            <p className=\"text-sm font-bold text-[#1A132B]\">\n              {category === \'police\'\n                ? \'24/7 Women Help Desk Lookup\'\n                : \'Safe Transit Hub Facilities\'}\n            </p>\n            <p className=\"mt-1 text-xs text-[#6B6182]\">\n              Distance: {hasCoords ? \'Centered on your live GPS\' : \'Based on Maps region\'}\n            </p>\n            <p className=\"mt-0.5 text-xs text-[#6B6182]\">\n              Opens real-time verified listings directly in Maps\n            </p>\n          </div>\n          <a\n            href={\n              hasCoords\n                ? `https://www.google.com/maps/search/${encodeURIComponent(\n                    category === \'police\' ? \'women police station\' : \'public toilet\'\n                  )}/@${geoLocation.latitude},${geoLocation.longitude},14z`\n                : `https://www.google.com/maps/search/${encodeURIComponent(\n                    category === \'police\'\n                      ? \'women police station near me\'\n                      : \'public toilet near me\'\n                  )}`\n            }\n            target=\"_blank\"\n            rel=\"noopener noreferrer\"\n            className=\"min-h-[40px] px-3.5 py-2 rounded-xl bg-white hover:bg-violet-50 border border-violet-200 text-violet-800 text-xs font-semibold inline-flex items-center justify-center gap-1.5 transition-colors\"\n          >\n            <ExternalLink className=\"w-3.5 h-3.5\" />\n            <span>Find Verified Locations</span>\n          </a>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    num_lines: 223
    num_bytes: 9301
    line_range_bytes: 9301
  }
}
