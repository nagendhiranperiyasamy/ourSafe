  view_file {
    absolute_path_uri: "file:///src/components/EmergencyLockScreenShield.tsx"
    end_line: 498
    content: "import React, { useEffect, useState } from \'react\';\nimport {\n  Camera,\n  CheckCircle2,\n  Compass,\n  Globe,\n  Hand,\n  Home,\n  Image as ImageIcon,\n  Lock,\n  MessageSquare,\n  Mic,\n  MicOff,\n  Phone,\n  Radio,\n  ShieldAlert,\n  ShieldCheck,\n  Smartphone,\n  Unlock,\n  Volume2,\n} from \'lucide-react\';\nimport { EmergencyQuickTriggersState } from \'../hooks/useEmergencyQuickTriggers\';\nimport { SafetyPreferences } from \'../types/safety\';\nimport {\n  NativeShieldStatus,\n  getNativeShieldStatus,\n  openNativeAccessibilitySettings,\n  requestNativeOverlayPermission,\n} from \'../utils/nativeShieldBridge\';\nimport { PWAInstallButton } from \'./PWAInstallButton\';\n\ninterface EmergencyLockScreenShieldProps {\n  preferences: SafetyPreferences;\n  guardianName?: string;\n  guardianPhone?: string;\n  triggers: EmergencyQuickTriggersState;\n  initialSurface?: \'lock_screen\' | \'home_screen\';\n  onQuickWidgetSos?: () => void;\n  onExit: () => void;\n}\n\nexport const EmergencyLockScreenShield: React.FC<\n  EmergencyLockScreenShieldProps\n> = ({\n  preferences,\n  guardianName,\n  guardianPhone,\n  triggers,\n  initialSurface = \'lock_screen\',\n  onQuickWidgetSos,\n  onExit,\n}) => {\n  const [surface, setSurface] = useState<\'lock_screen\' | \'home_screen\'>(\n    initialSurface\n  );\n  const [now, setNow] = useState<Date>(() => new Date());\n  const [voiceTestMessage, setVoiceTestMessage] = useState(\'\');\n  const [nativeStatus, setNativeStatus] = useState<NativeShieldStatus | null>(\n    null\n  );\n\n  useEffect(() => {\n    const timer = window.setInterval(() => setNow(new Date()), 1000);\n    return () => window.clearInterval(timer);\n  }, []);\n\n  useEffect(() => {\n    void triggers.requestWakeLock();\n    void getNativeShieldStatus().then(setNativeStatus);\n    return () => {\n      void triggers.releaseWakeLock();\n    };\n    // eslint-disable-next-line react-hooks/exhaustive-deps\n  }, []);\n\n  const timeString = now.toLocaleTimeString([], {\n    hour: \'2-digit\',\n    minute: \'2-digit\',\n    hour12: false,\n  });\n\n  const dateString = now.toLocaleDateString([], {\n    weekday: \'long\',\n    month: \'long\',\n    day: \'numeric\',\n  });\n\n  const secretCode = preferences.voiceKeyword.trim() || \'Red Rose\';\n  const requiredTaps = preferences.screenTapCount === 2 ? 2 : 3;\n\n  const sampleHomeApps = [\n    { name: \'Phone\', icon: Phone, bg: \'bg-emerald-600\' },\n    { name: \'Messages\', icon: MessageSquare, bg: \'bg-sky-600\' },\n    { name: \'Camera\', icon: Camera, bg: \'bg-stone-700\' },\n    { name: \'Maps\', icon: Compass, bg: \'bg-amber-600\' },\n    { name: \'Browser\', icon: Globe, bg: \'bg-indigo-600\' },\n    { name: \'Photos\', icon: ImageIcon, bg: \'bg-rose-600\' },\n  ];\n\n  return (\n    <div\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label=\"OurSafe Phone Lock Screen and Home Screen Shield\"\n      className={`fixed inset-0 z-[60] flex flex-col justify-between select-none overflow-y-auto transition-colors ${\n        surface === \'lock_screen\'\n          ? \'bg-[#0B100A] text-[#F5F9F2]\'\n          : \'bg-gradient-to-b from-[#1D2B19] via-[#273921] to-[#131C11] text-[#F5F9F2]\'\n      }`}\n    >\n      {/* Top Phone Status Bar & Surface Switcher */}\n      <div\n        data-ignore-sos-tap=\"true\"\n        className=\"w-full max-w-xl mx-auto px-4 pt-4 pb-2 space-y-3\"\n      >\n        <div className=\"flex items-center justify-between gap-2 text-xs text-[#B6C9AB]\">\n          <div className=\"flex items-center gap-2 font-semibold text-[#E4F0DC]\">\n            {surface === \'lock_screen\' ? (\n              <Lock className=\"w-3.5 h-3.5 text-[#9BBF82]\" />\n            ) : (\n              <Home className=\"w-3.5 h-3.5 text-[#9BBF82]\" />\n            )}\n            <span>\n              {surface === \'lock_screen\'\n                ? \'Phone Main Lock Screen\'\n                : \'Phone Home Screen\'}\n            </span>\n          </div>\n          <div className=\"flex items-center gap-2 font-mono text-[11px]\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n            <span>\n              {nativeStatus?.isNativeAndroid\n                ? \'Android OS Shield Active\'\n                : triggers.wakeLockActive\n                  ? \'Wake Lock Active\'\n                  : \'Shield Armed\'}\n            </span>\n          </div>\n        </div>\n\n        {/* Toggle between Phone Main Lock Screen & Phone Home Screen */}\n        <div className=\"grid grid-cols-2 gap-2 p-1 rounded-2xl bg-black/35 border border-white/10\">\n          <button\n            type=\"button\"\n            onClick={() => setSurface(\'lock_screen\')}\n            className={`min-h-[38px] px-3 py-1.5 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n              surface === \'lock_screen\'\n                ? \'bg-[#2F4526] text-white shadow-sm\'\n                : \'text-[#B6C9AB] hover:text-white\'\n            }`}\n          >\n            <Lock className=\"w-3.5 h-3.5\" />\n            <span>Phone Lock Screen</span>\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setSurface(\'home_screen\')}\n            className={`min-h-[38px] px-3 py-1.5 rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer ${\n              surface === \'home_screen\'\n                ? \'bg-[#2F4526] text-white shadow-sm\'\n                : \'text-[#B6C9AB] hover:text-white\'\n            }`}\n          >\n            <Home className=\"w-3.5 h-3.5\" />\n            <span>Phone Home Screen</span>\n          </button>\n        </div>\n      </div>\n\n      {/* CENTER INTERACTIVE SURFACE: Either Main Lock Screen OR Phone Home Screen */}\n      {surface === \'lock_screen\' ? (\n        <div className=\"flex-1 flex flex-col items-center justify-center px-6 py-5 text-center\">\n          <div className=\"space-y-1.5 pointer-events-none\">\n            <p className=\"text-xs sm:text-sm font-medium text-[#A7B99D] tracking-wide\">\n              {dateString}\n            </p>\n            <p className=\"text-6xl sm:text-7xl font-semibold tracking-tight font-mono tabular-nums text-[#FAFDF7]\">\n              {timeString}\n            </p>\n          </div>\n\n          {/* Lock-Screen Persistent Notification Preview */}\n          <div className=\"mt-6 w-full max-w-sm rounded-2xl bg-white/8 border border-white/15 p-3.5 text-left space-y-1 pointer-events-none\">\n            <div className=\"flex items-center justify-between text-[11px] font-bold text-emerald-300\">\n              <span className=\"flex items-center gap-1.5\">\n                <ShieldCheck className=\"w-3.5 h-3.5\" />\n                <span>OurSafe Lock-Screen Shield</span>\n              </span>\n              <span className=\"font-mono text-[#B6C9AB]\">ARMED</span>\n            </div>\n            <p className=\"text-xs text-[#DCE6D5] leading-snug\">\n              {preferences.screenTapSosEnabled\n                ? `${requiredTaps === 2 ? \'Double-tap\' : \'Triple-tap\'} anywhere on this lock screen`\n                : \'Tap off\'}\n              {preferences.shakeDetectionEnabled ? \' \302\267 Shake 3x\' : \'\'}\n              {preferences.voiceActivationEnabled\n                ? ` \302\267 Say \"${secretCode}\"`\n                : \'\'}\n            </p>\n          </div>\n\n          {/* Live Tap / Shake Progress */}\n          <div className=\"mt-4 min-h-[48px] flex items-center justify-center pointer-events-none\">\n            {preferences.screenTapSosEnabled && triggers.tapCount > 0 ? (\n              <div className=\"px-4 py-2 rounded-2xl bg-red-600/30 border border-red-400/60 text-red-100 text-xs font-bold flex items-center gap-2\">\n                <Hand className=\"w-4 h-4 text-red-300\" />\n                <span>\n                  Lock-Screen Tap {triggers.tapCount} / {requiredTaps} \342\200\224 Keep tapping for SOS!\n                </span>\n              </div>\n            ) : preferences.shakeDetectionEnabled && triggers.shakeCount > 0 ? (\n              <div className=\"px-4 py-2 rounded-2xl bg-red-600/30 border border-red-400/60 text-red-100 text-xs font-bold flex items-center gap-2\">\n                <Smartphone className=\"w-4 h-4 text-red-300\" />\n                <span>\n                  Phone Shake {triggers.shakeCount} / 3 \342\200\224 Shake again for SOS!\n                </span>\n              </div>\n            ) : (\n              <p className=\"text-xs text-[#9BB092]\">\n                Auto-SOS Target:{\' \'}\n                <strong className=\"text-white\">\n                  {guardianName\n                    ? `${guardianName} (${guardianPhone})`\n                    : \'Police (100 / 112)\'}\n                </strong>\n              </p>\n            )}\n          </div>\n        </div>\n      ) : (\n        /* PHONE HOME SCREEN SURFACE (Widget + Floating Overlay + App Grid) */\n        <div className=\"flex-1 w-full max-w-md mx-auto px-5 py-4 flex flex-col justify-center gap-5\">\n          {/* Floating Overlay Pill (Simulates Android TYPE_APPLICATION_OVERLAY over Home Screen) */}\n          <div className=\"flex items-center justify-between gap-2\">\n            <div className=\"text-left pointer-events-none\">\n              <p className=\"text-2xl font-mono font-semibold text-white tabular-nums\">\n                {timeString}\n              </p>\n              <p className=\"text-xs text-[#C2D4B7]\">{dateString}</p>\n            </div>\n\n            <div className=\"px-3 py-2 rounded-2xl bg-[#11190F]/90 border border-emerald-400/40 shadow-lg flex items-center gap-2 pointer-events-none\">\n              <span className=\"w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse\" />\n              <div className=\"text-left\">\n                <p className=\"text-[11px] font-bold text-white leading-none\">\n                  OurSafe Overlay\n                </p>\n                <p className=\"text-[10px] text-[#A8BF9B] mt-0.5\">\n                  {requiredTaps}x Tap \302\267 3x Shake \302\267 Voice\n                </p>\n              </div>\n            </div>\n          </div>\n\n          {/* Native-Style OurSafe Home Screen SOS Widget */}\n          <div className=\"rounded-3xl bg-[#FCFDF9]/95 text-[#182215] p-4 shadow-xl border border-[#B8C6A8] space-y-3\">\n            <div className=\"flex items-center justify-between gap-2\">\n              <div className=\"flex items-center gap-2\">\n                <div className=\"w-8 h-8 rounded-xl bg-[#2F4526] text-white flex items-center justify-center shrink-0\">\n                  <ShieldCheck className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <p className=\"text-xs font-bold text-[#182215]\">\n                    OurSafe Home Screen Widget\n                  </p>\n                  <p className=\"text-[11px] text-[#4B5844]\">\n                    Guardian: {guardianName || \'Police 100\'} \302\267 Armed\n                  </p>\n                </div>\n              </div>\n              <button\n                type=\"button\"\n                data-ignore-sos-tap=\"true\"\n                onClick={onQuickWidgetSos}\n                className=\"min-h-[38px] px-3.5 py-1.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-extrabold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap shadow-sm\"\n              >\n                <ShieldAlert className=\"w-3.5 h-3.5\" />\n                <span>SOS Call</span>\n              </button>\n            </div>\n            <p className=\"text-[11px] text-[#465340] pointer-events-none\">\n              Or tap anywhere on your Home Screen wallpaper{\' \'}\n              <strong>{requiredTaps}x</strong>, shake <strong>3x</strong>, or say{\' \'}\n              <strong>&ldquo;{secretCode}&rdquo;</strong> without opening the app.\n            </p>\n          </div>\n\n          {/* Live Tap/Shake Indicator on Home Screen */}\n          {(triggers.tapCount > 0 || triggers.shakeCount > 0) && (\n            <div className=\"px-4 py-2 rounded-2xl bg-red-600/35 border border-red-400/60 text-red-100 text-xs font-bold text-center pointer-events-none\">\n              {triggers.tapCount > 0\n                ? `Home Screen Tap ${triggers.tapCount} / ${requiredTaps} \342\200\224 Keep tapping for SOS!`\n                : `Phone Shake ${triggers.shakeCount} / 3 \342\200\224 Shake again for SOS!`}\n            </div>\n          )}\n\n          {/* Everyday Phone Home Screen App Grid (Background surface still catches 2x/3x tap!) */}\n          <div className=\"grid grid-cols-3 gap-4 pt-1 pointer-events-none\">\n            {sampleHomeApps.map((app) => {\n              const Icon = app.icon;\n              return (\n                <div\n                  key={app.name}\n                  className=\"flex flex-col items-center gap-1.5\"\n                >\n                  <div\n                    className={`w-13 h-13 rounded-2xl ${app.bg} text-white flex items-center justify-center shadow-md opacity-90`}\n                  >\n                    <Icon className=\"w-6 h-6\" />\n                  </div>\n                  <span className=\"text-[11px] font-medium text-[#E4F0DC]\">\n                    {app.name}\n                  </span>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      )}\n\n      {/* Bottom Controls & Live Trigger Bar */}\n      <div\n        data-ignore-sos-tap=\"true\"\n        className=\"w-full max-w-xl mx-auto px-4 pb-5 pt-2 space-y-3\"\n      >\n        <div className=\"rounded-3xl bg-[#141C12]/95 border border-[#2C3B27] p-4 space-y-3\">\n          <div className=\"flex flex-wrap items-center justify-between gap-2 text-[11px] font-semibold text-[#A7B99D]\">\n            <span>Live Triggers on {surface === \'lock_screen\' ? \'Lock Screen\' : \'Home Screen\'}</span>\n            <span className=\"font-mono text-emerald-400\">\n              {[\n                preferences.shakeDetectionEnabled,\n                preferences.voiceActivationEnabled,\n                preferences.screenTapSosEnabled,\n              ].filter(Boolean).length}\n              /3 Armed\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2.5\">\n            {/* 1. Shake */}\n            <div className=\"rounded-2xl bg-[#1C2719] border border-[#30422A] p-3 flex flex-col justify-between gap-2\">\n              <div className=\"flex items-center justify-between gap-1\">\n                <span className=\"text-xs font-bold text-white flex items-center gap-1.5\">\n                  <Smartphone className=\"w-3.5 h-3.5 text-[#9BBF82]\" />\n                  <span>3x Shake</span>\n                </span>\n                <span className=\"text-[11px] font-mono text-[#9BBF82]\">\n                  {triggers.shakeCount}/3\n                </span>\n              </div>\n              {triggers.motionPermissionState === \'prompt\' ? (\n                <button\n                  type=\"button\"\n                  onClick={() => void triggers.requestMotionPermission()}\n                  className=\"w-full min-h-[36px] px-2.5 py-1.5 rounded-xl bg-[#2F4526] hover:bg-[#3B5730] text-[11px] font-semibold text-white cursor-pointer\"\n                >\n                  Allow Motion Sensor\n                </button>\n              ) : (\n                <button\n                  type=\"button\"\n                  disabled={!preferences.shakeDetectionEnabled}\n                  onClick={triggers.simulateShakeImpulse}\n                  className=\"w-full min-h-[36px] px-2.5 py-1.5 rounded-xl bg-[#2F4526] hover:bg-[#3B5730] disabled:opacity-40 text-[11px] font-semibold text-white cursor-pointer\"\n                >\n                  Shake Phone ({triggers.shakeCount}/3)\n                </button>\n              )}\n            </div>\n\n            {/* 2. Voice Secret Code */}\n            <div className=\"rounded-2xl bg-[#1C2719] border border-[#30422A] p-3 flex flex-col justify-between gap-2\">\n              <div className=\"flex items-center justify-between gap-1\">\n                <span className=\"text-xs font-bold text-white flex items-center gap-1.5 truncate\">\n                  {triggers.voiceListening ? (\n                    <Mic className=\"w-3.5 h-3.5 text-emerald-400 animate-pulse shrink-0\" />\n                  ) : (\n                    <MicOff className=\"w-3.5 h-3.5 text-[#9BBF82] shrink-0\" />\n                  )}\n                  <span className=\"truncate\">&ldquo;{secretCode}&rdquo;</span>\n                </span>\n                {triggers.voiceListening && (\n                  <Radio className=\"w-3.5 h-3.5 text-emerald-400 shrink-0\" />\n                )}\n              </div>\n\n              <div className=\"flex items-center gap-1.5\">\n                <button\n                  type=\"button\"\n                  disabled={!preferences.voiceActivationEnabled}\n                  onClick={triggers.toggleVoiceWakeListener}\n                  className={`flex-1 min-h-[36px] px-2 py-1.5 rounded-xl text-[11px] font-semibold cursor-pointer disabled:opacity-40 ${\n                    triggers.voiceListening\n                      ? \'bg-emerald-600 hover:bg-emerald-700 text-white\'\n                      : \'bg-[#2F4526] hover:bg-[#3B5730] text-white\'\n                  }`}\n                >\n                  {triggers.voiceListening ? \'Listening\' : \'Arm Mic\'}\n                </button>\n                <button\n                  type=\"button\"\n                  disabled={!preferences.voiceActivationEnabled}\n                  onClick={() => {\n                    const res = triggers.testSecretVoicePhrase(secretCode);\n                    setVoiceTestMessage(\n                      res.matched\n                        ? `Matched \"${secretCode}\"!`\n                        : \'Secret voice trigger is disabled.\'\n                    );\n                  }}\n                  title={`Test speaking \"${secretCode}\"`}\n                  className=\"min-h-[36px] px-2.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-[11px] font-semibold text-[#E5F0DC] cursor-pointer disabled:opacity-40\"\n                >\n                  <Volume2 className=\"w-3.5 h-3.5\" />\n                </button>\n              </div>\n            </div>\n\n            {/* 3. Screen Tap */}\n            <div className=\"rounded-2xl bg-[#1C2719] border border-[#30422A] p-3 flex flex-col justify-between gap-2\">\n              <div className=\"flex items-center justify-between gap-1\">\n                <span className=\"text-xs font-bold text-white flex items-center gap-1.5\">\n                  <Hand className=\"w-3.5 h-3.5 text-[#9BBF82]\" />\n                  <span>{requiredTaps === 2 ? \'Double Tap\' : \'Triple Tap\'}</span>\n                </span>\n                <span className=\"text-[11px] font-mono text-[#9BBF82]\">\n                  {triggers.tapCount}/{requiredTaps}\n                </span>\n              </div>\n              <p className=\"text-[11px] text-[#A7B99D] leading-snug\">\n                Tap screen above {requiredTaps}x fast for SOS\n              </p>\n            </div>\n          </div>\n\n          {/* Native Android System Lock/Home Screen Permissions (shown when inside Android APK) */}\n          {nativeStatus?.isNativeAndroid ? (\n            <div className=\"pt-2 border-t border-white/10 flex flex-wrap items-center justify-between gap-2 text-[11px]\">\n              <span className=\"text-emerald-300 flex items-center gap-1.5 font-semibold\">\n                <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                <span>Android System Lock &amp; Home Shield Ready</span>\n              </span>\n              <div className=\"flex items-center gap-1.5\">\n                {!nativeStatus.overlayPermissionGranted && (\n                  <button\n                    type=\"button\"\n                    onClick={() => void requestNativeOverlayPermission()}\n                    className=\"px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-200 font-semibold cursor-pointer\"\n                  >\n                    Allow Overlay\n                  </button>\n                )}\n                {!nativeStatus.accessibilityPermissionGranted && (\n                  <button\n                    type=\"button\"\n                    onClick={() => void openNativeAccessibilitySettings()}\n                    className=\"px-2.5 py-1 rounded-lg bg-amber-500/20 text-amber-200 font-semibold cursor-pointer\"\n                  >\n                    Allow Tap Service\n                  </button>\n                )}\n              </div>\n            </div>\n          ) : (\n            <div className=\"pt-2 border-t border-white/10 flex flex-wrap items-center justify-between gap-2 text-[11px] text-[#A7B99D]\">\n              <span>\n                Web Mode: Keep Shield open, or build the bundled Android APK for OS-level locked screen &amp; home screen triggers.\n              </span>\n              <PWAInstallButton compact />\n            </div>\n          )}\n\n          {(triggers.lastHeardTranscript ||\n            triggers.voiceError ||\n            voiceTestMessage) && (\n            <p className=\"text-[11px] text-[#B8C9AE] px-1 truncate\">\n              {triggers.voiceError\n                ? triggers.voiceError\n                : triggers.lastHeardTranscript\n                  ? `Heard: \"${triggers.lastHeardTranscript}\"`\n                  : voiceTestMessage}\n            </p>\n          )}\n        </div>\n\n        {/* Exit Shield */}\n        <button\n          type=\"button\"\n          onClick={onExit}\n          className=\"w-full min-h-[48px] px-5 py-3 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/15 text-sm font-semibold text-[#F5F9F2] flex items-center justify-center gap-2 transition-colors cursor-pointer\"\n        >\n          <Unlock className=\"w-4 h-4 text-[#B8D0A8]\" />\n          <span>Unlock &amp; Return to OurSafe</span>\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 499
    num_bytes: 21397
    line_range_bytes: 21397
  }
}
