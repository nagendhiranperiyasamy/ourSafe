      thinking_signature: "\022\322\027\n\317\027\001i\024}\023F\233\311RAC\315\243WAm\257\337[3\226\005\337\275\211\342\277n\240$M\257\026\034\035\030\335>n~\272,%N\333\225\373:\334\260\325<\2417\341\177M\242\225\005\263\023\235:\264u_J\374\363(\026\\&\f\227T\236\021;\364\265\242\270\350\347,q\200\300}\r@\037\226\325>\005\264uM?\270\374!A\357\003\255\244\353\330o:\252\257\001\375\231\t*^x\017\370g\265}@9F\n\215\3730\263\2271\320\315H\177\303\367p\002\370\311\267\221s\302\021\351\260=\377\352u\3317%\3205\250\002-`D\327\314.\325d\350\234\203\b\343\330\335\344FQ#\253\370xVq-\247\364\341\306\vXW\242\212G\377\201\354\004!\332\005\3044t\0203\327O\n\256K\320o\034\006\211\200\372\356I\030\214)\017\303\017\2206\353\243\356X\346\311\263\366\037\342\333\340s\237RT\202\224eY\035#\027\350\037u(^T\360\b\177\350|\257]\262O\022\a\223\236g\347+\231MC\246\202n\250\017\364\0212E\022\365d\246\324\375p~\201\341\343\340R\372\3175\311\232\306\227\311\344q] \000\231\a\341\375}\237\332\375\244\020x\227{J>\213@\202Z\206\256\314\222\274g\375\200\376\201(\231\267#\342X\365\020\217r>\005/\226\332my\316\221\363/%:\230!\017\246\035\345\301=\351\r\323q\363\021\264vX\n\3037\240\360\302\372\2642\v3)\344M@\036\227\377\032a\374\203\t\274\363B{s\360k\257\345\030?e\276\324\340\247N\035\336\244:\2541l\266_y\262F\234\341\360\277\031O\016\245\3412\020\3032\002\247]\245\242\266\212t5M\020l\376\376n\361?\266\311iDAM\265\323;\2026n5\242\257B\236\306\260\261|\274\314<8\311/@V\212-\213\035\0248\3205h\373tkkT\027\207\215@\326W\373\177\n\376^\322\v\307u\375\376tD\357A\335n\262\243U\337\330\266\256\220\017+>\243\002\260\000\262hxQ\232}\243\\\362\310\027+\215\002}q\3113<3\323\025\325~g\313\274\301\334;}V\253K\322\021j\376\233wcn+\000w\fT\372\353>\004\353\0228\346\263f\213J\230~\\\345zp\344v\302\213\234xU\232\"\024\250_}`\217\204w\271\263g7\252<\333A]\343\203\356\235\302H\004Cw\034@\342\033\220\330\210\350\215\262u/\202\3001\356\265\201\246@\237\254\025\244\233>\205?\321<\366(\246,Y|\311\260A\203f#\002(V\307\317\26