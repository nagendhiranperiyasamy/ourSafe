      thinking_signature: "\022\375\006\n\372\006\001i\024}\023\273IZ\263_W\241\316\276\357\0065\n\373E\305+<\327|\017?\257x\215\254\n\222\334\237\201\215\242\216j\267\311\353d\314\215\r\n\242\261*\002\362\307\v\2107\353\362\330\334\354W|o\356V\313\2151!Y\272A\245\v\357\312z\031 \307\222\355w\305:\235=6\262\366\315\227\025m\371@\241\220\270\231\352\256\307\321\365\306>\332U\222\337\353PMZ\f\214\3356\340\225C\305\023\243\225T\034\347\314B\032\no0\332\336\216\256Dw(\347I\235\205\350\024\215\220\003\277 \242\f\225\376S\017A\034\376v-*\344a\347\344\370\332M\273<\t\036\352$\234\277\367.\2225\325\026\362\005*\256\021E\250\23168\227\214\211\035.\376\033\356\313w\273\027\230~\2564\377\253\231].|\377\330\363Q\275\270\377\235\274\355\005\321\300\274\2763\366$\003\212\337\035\036.\3005\266\263%C\321]Z\333\030\263\333\020g\033\022\\6\346\245\321\224\333,;\240C\271\251\305\274y\326\313\373\3463m\t\344\020\033j\2261\\\345\245\263\352\323\3542\355Y\302\023`(\236\314V\250UZ\236\300\253\277\177\325~v\243\245v6\035\327\327B\3571v\314k\327\303\352-\\\a\237\251\356]\373\b\231ri\t\224\324\312\271\315\034\353\230\350\237P2\303\24208\027\336\251\307]\372\315\356\277\214*A\275\3422\031A\030)\"\270\353\232\363f\001j\210\2652fpy\365\2235vnh7wV=\032kwD<0\303\025\325\210\334\270\272s\271y\207\332.\004\r\3149\250\276\2426\324\366\247\360=\265\265;\211\363\026\005i\35735%\223#\303\237\2625\205\310\307\242Z\255\320\006>=\035\352\277\231\v\177\315\v\f\2015tn\022\023\317\257\207\210#\233\306C\027\v\245\325\273`(\233\220\306\n\a\023\024\221\243\275~yb\356\337\337\271\203h\001G\305\356\365~\3761C\330\276<F\221\177M\204x\v(wX\0015\337\377\211\372*\"&\021\321\335\341\336\263\245\345\253\236\301\307\023\"K\a\317d\223\343\215\321\250Qd\202y\324(\314\rn#\370\037\262\216.(P\250\025UX\001\2367\347\367\t\345\2268@\214J`\351k\026(\346\214\347,2\017fS\332\302+\312\217\353K$d\337\270\006\261E\276\277\352\257\227\227c\202f\255kDO\026+\352\355\3555\355a\tw5\026\263L\316\373\227\354\177\201\327a\331\250Wcsh\313\30