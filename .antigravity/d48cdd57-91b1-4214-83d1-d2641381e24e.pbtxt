      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport {\\n  CheckCircle2,\\n  Hand,\\n  MapPin,\\n  Mic,\\n  Phone,\\n  Send,\\n  Shield,\\n  ShieldAlert,\\n  Smartphone,\\n  X,\\n} from \'lucide-react\';\\nimport {\\n  GeoLocationState,\\n  QuickTriggerEvent,\\n  SosContact,\\n} from \'../types/safety\';\\nimport { formatPhoneForTel } from \'../utils/storage\';\\n\\ninterface EmergencyTriggerOverlayProps {\\n  event: QuickTriggerEvent;\\n  userName: string;\\n  contacts: SosContact[];\\n  geoLocation: GeoLocationState;\\n  nearestPolicePhone?: string;\\n  nearestPoliceName?: string;\\n  countdownSeconds: 0 | 3;\\n  autoDialOnTrigger: boolean;\\n  onDispatchSos: (event: QuickTriggerEvent) => void;\\n  onOpenFullSosPage?: () => void;\\n  onClose: () => void;\\n}\\n\\nexport const EmergencyTriggerOverlay: React.FC<EmergencyTriggerOverlayProps> = ({\\n  event,\\n  userName,\\n  contacts,\\n  geoLocation,\\n  nearestPolicePhone,\\n  nearestPoliceName,\\n  countdownSeconds,\\n  autoDialOnTrigger,\\n  onDispatchSos,\\n  onOpenFullSosPage,\\n  onClose,\\n}) => {\\n  const [secondsLeft, setSecondsLeft] = useState<number>(countdownSeconds);\\n  const [dispatched, setDispatched] = useState<boolean>(countdownSeconds === 0);\\n  const [autoDialAttempted, setAutoDialAttempted] = useState<boolean>(false);\\n  const dispatchedRef = useRef<boolean>(false);\\n\\n  const primaryGuardian = contacts.find((c) => c.isPrimary) ?? contacts[0];\\n  const policeNumber = nearestPolicePhone?.trim() || \'100\';\\n  const policeLabel = nearestPoliceName?.trim() || \'Police Control Room\';\\n\\n  const hasCoords =\\n    geoLocation.status === \'granted\' &&\\n    geoLocation.latitude !== null &&\\n    geoLocation.longitude !== null;\\n\\n  const triggerDialer = (phone: string) => {\\n    const clean = formatPhoneForTel(phone);\\n    if (!clean) return;\\n    try {\\n      const link = document.createElement(\'a\');\\n      link.href = `tel:${clean}`;\\n      link.style.display = \'none\';\\n      document.body.appendChild(link);\\n      link.click();\\n      document.body.removeChild(link);\\n    } catch {\\n      // Fallback ignored if browser blocks non-gesture tel: navigation\\n    }\\n  };\\n\\n  const executeDispatchNow = () => {\\n    if (dispatchedRef.current) return;\\n    dispatchedRef.current = true;\\n    setDispatched(true);\\n    setSecondsLeft(0);\\n    onDispatchSos(event);\\n\\n    if (autoDialOnTrigger) {\\n      const targetPhone = primaryGuardian?.phone || policeNumber;\\n      setAutoDialAttempted(true);\\n      triggerDialer(targetPhone);\\n    }\\n  };\\n\\n  useEffect(() => {\\n    if (countdownSeconds === 0) {\\n      executeDispatchNow();\\n      return;\\n    }\\n\\n    const interval = window.setInterval(() => {\\n      setSecondsLeft((prev) => {\\n        if (prev <= 1) {\\n          window.clearInterval(interval);\\n          executeDispatchNow();\\n          return 0;\\n        }\\n        return prev - 1;\\n      });\\n    }, 1000);\\n\\n    return () => window.clearInterval(interval);\\n    // eslint-disable-next-line react-hooks/exhaustive-deps\\n  }, [event.id]);\\n\\n  const smsBody = encodeURIComponent(\\n    `EMERGENCY SOS from ${userName} via OurSafe (${event.label})! Please call me immediately.${\\n      hasCoords\\n        ? ` Live GPS: https://maps.google.com/?q=${geoLocation.latitude!.toFixed(\\n            6\\n          )},${geoLocation.longitude!.toFixed(6)}`\\n        : \'\'\\n    }`\\n  );\\n\\n  const TriggerIcon =\\n    event.kind === \'shake\'\\n      ? Smartphone\\n      : event.kind === \'voice_code\'\\n        ? Mic\\n        : Hand;\\n\\n  return (\\n    <div\\n      data-ignore-sos-tap=\\\"true\\\"\\n      role=\\\"alertdialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-labelledby=\\\"quick-sos-overlay-title\\\"\\n      className=\\\"fixed inset-0 z-[70] bg-[#160707]/95 backdrop-blur-md flex items-center justify-center p-4 overflow-y-auto\\\"\\n    >\\n      <div className=\\\"w-full max-w-xl rounded-3xl bg-[#FCFDF9] border-2 border-red-600 shadow-2xl overflow-hidden my-auto\\\">\\n        {/* Urgent Red Header */}\\n        <div className=\\\"bg-red-600 text-white px-6 py-5 flex items-start justify-between gap-4\\\">\\n          <div className=\\\"space-y-1.5\\\">\\n            <div className=\\\"inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-red-100\\\">\\n              <TriggerIcon className=\\\"w-4 h-4 shrink-0\\\" />\\n              <span>{event.label}</span>\\n              {event.fromLockScreen && (\\n                <>\\n                  <span aria-hidden=\\\"true\\\">\302\267</span>\\n                  <span>From Lock-Screen Shield</span>\\n                </>\\n              )}\\n            </div>\\n            <h2\\n              id=\\\"quick-sos-overlay-title\\\"\\n              className=\\\"text-2xl sm:text-3xl font-bold tracking-tight\\\"\\n            >\\n              {dispatched\\n                ? \'SOS Emergency Dispatched\'\\n                : `Calling SOS in ${secondsLeft}s...`}\\n            </h2>\\n            <p className=\\\"text-xs sm:text-sm text-red-50/90 leading-relaxed\\\">\\n              {event.detail}\\n            </p>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onClose}\\n            aria-label=\\\"Close SOS alert overlay\\\"\\n            className=\\\"min-w-[40px] min-h-[40px] rounded-xl bg-white/15 hover:bg-white/25 text-white flex items-center justify-center cursor-pointer shrink-0\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Body */}\\n        <div className=\\\"p-6 space-y-5\\\">\\n          {!dispatched ? (\\n            <div className=\\\"space-y-5 text-center py-2\\\">\\n              <div className=\\\"mx-auto w-24 h-24 rounded-full bg-red-100 border-4 border-red-600 flex items-center justify-center\\\">\\n                <span className=\\\"text-4xl font-extrabold font-mono tabular-nums text-red-700\\\">\\n                  {secondsLeft}\\n                </span>\\n              </div>\\n\\n              <div className=\\\"space-y-1\\\">\\n                <p className=\\\"text-sm font-bold text-[#182215]\\\">\\n                  Preparing Emergency Call &amp; GPS Alert\\n                </p>\\n                <p className=\\\"text-xs text-[#54634D]\\\">\\n                  Target: {primaryGuardian ? `${primaryGuardian.name} (${primaryGuardian.phone})` : `Police (${policeNumber})`} + Police Dispatch\\n                </p>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onClose}\\n                  className=\\\"min-h-[52px] px-5 py-3 rounded-2xl bg-[#EAF0E2] hover:bg-[#DCE7D2] border border-[#B8C6A8] text-[#182215] text-sm font-bold cursor-pointer\\\"\\n                >\\n                  Cancel (False Alarm)\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={executeDispatchNow}\\n                  className=\\\"min-h-[52px] px-5 py-3 rounded-2xl bg-red-600 hover:bg-red-700 text-white text-sm font-extrabold flex items-center justify-center gap-2 cursor-pointer\\\"\\n                >\\n                  <Phone className=\\\"w-4 h-4\\\" />\\n                  <span>Call Immediately Now</span>\\n                </button>\\n              </div>\\n            </div>\\n          ) : (\\n            <div className=\\\"space-y-4\\\">\\n              {/* Live Dispatch Confirmation */}\\n              <div className=\\\"rounded-2xl bg-emerald-50 border border-emerald-200 p-4 flex items-start gap-3\\\">\\n                <CheckCircle2 className=\\\"w-5 h-5 text-emerald-700 shrink-0 mt-0.5\\\" />\\n                <div className=\\\"text-xs space-y-1\\\">\\n                  <p className=\\\"font-bold text-emerald-950\\\">\\n                    SOS Alert &amp; Emergency History Logged Automatically\\n                  </p>\\n                  <p className=\\\"text-emerald-900/90 leading-relaxed\\\">\\n                    {autoDialAttempted\\n                      ? `Phone dialer call triggered for ${\\n                          primaryGuardian\\n                            ? `${primaryGuardian.name} (${primaryGuardian.phone})`\\n                            : `Police (${policeNumber})`\\n                        }. Tap either emergency button below anytime to redial or call Police.`\\n                      : \'Tap either emergency button below to place direct calls to your guardian and police.\'}\\n                  </p>\\n                </div>\\n              </div>\\n\\n              {/* Live GPS Coordinates */}\\n              <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] px-4 py-3 flex items-center justify-between gap-3 text-xs\\\">\\n                <div className=\\\"flex items-center gap-2 text-[#182215] font-semibold\\\">\\n                  <MapPin className=\\\"w-4 h-4 text-[#2F4526] shrink-0\\\" />\\n                  <span className=\\\"font-mono tabular-nums\\\">\\n                    {hasCoords\\n                      ? `${geoLocation.latitude!.toFixed(5)}, ${geoLocation.longitude!.toFixed(5)}`\\n                      : \'Requesting live GPS coordinates...\'}\\n                  </span>\\n                </div>\\n                <span className=\\\"text-[11px] font-semibold text-[#3E5632]\\\">\\n                  {contacts.length} Guardian(s)\\n                </span>\\n              </div>\\n\\n              {/* Dual Call Action Cards */}\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n                {primaryGuardian ? (\\n                  <a\\n                    href={`tel:${formatPhoneForTel(primaryGuardian.phone)}`}\\n                    className=\\\"min-h-[60px] px-4 py-3 rounded-2xl bg-red-600 hover:bg-red-700 text-white flex flex-col items-center justify-center gap-0.5 transition-colors shadow-sm\\\"\\n                  >\\n                    <span className=\\\"text-sm font-extrabold flex items-center gap-2\\\">\\n                      <Phone className=\\\"w-4 h-4\\\" />\\n                      <span>Call {primaryGuardian.name}</span>\\n                    </span>\\n                    <span className=\\\"text-[11px] font-mono text-red-100\\\">\\n                      {primaryGuardian.phone}\\n                    </span>\\n                  </a>\\n                ) : (\\n                  <a\\n                    href=\\\"tel:112\\\"\\n                    className=\\\"min-h-[60px] px-4 py-3 rounded-2xl bg-red-600 hover:bg-red-700 text-white flex flex-col items-center justify-center gap-0.5 transition-colors shadow-sm\\\"\\n                  >\\n                    <span className=\\\"text-sm font-extrabold flex items-center gap-2\\\">\\n                      <Phone className=\\\"w-4 h-4\\\" />\\n                      <span>Call National SOS (112)</span>\\n                    </span>\\n                    <span className=\\\"text-[11px] text-red-100\\\">\\n                      24/7 Emergency Helpline\\n                    </span>\\n                  </a>\\n                )}\\n\\n                <a\\n                  href={`tel:${formatPhoneForTel(policeNumber)}`}\\n                  className=\\\"min-h-[60px] px-4 py-3 rounded-2xl bg-[#182215] hover:bg-[#24371D] text-white flex flex-col items-center justify-center gap-0.5 transition-colors shadow-sm\\\"\\n                >\\n                  <span className=\\\"text-sm font-extrabold flex items-center gap-2\\\">\\n                    <Shield className=\\\"w-4 h-4\\\" />\\n                    <span>Call Police ({policeNumber})</span>\\n                  </span>\\n                  <span className=\\\"text-[11px] text-[#CDD7C1] truncate max-w-full px-2\\\">\\n                    {policeLabel}\\n                  </span>\\n                </a>\\n              </div>\\n\\n              {/* Quick SMS + 112 Row */}\\n              <div className=\\\"flex flex-wrap items-center gap-2.5\\\">\\n                {primaryGuardian && (\\n                  <a\\n                    href={`sms:${formatPhoneForTel(primaryGuardian.phone)}?body=${smsBody}`}\\n                    className=\\\"flex-1 min-h-[46px] px-4 py-2.5 rounded-xl bg-[#2F4526] hover:bg-[#23351C] text-white text-xs font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n                  >\\n                    <Send className=\\\"w-4 h-4\\\" />\\n                    <span>Send Live GPS SMS to {primaryGuardian.name}</span>\\n                  </a>\\n                )}\\n                <a\\n                  href=\\\"tel:112\\\"\\n                  className=\\\"min-h-[46px] px-4 py-2.5 rounded-xl bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 text-xs font-extrabold flex items-center justify-center gap-1.5 whitespace-nowrap\\\"\\n                >\\n                  <ShieldAlert className=\\\"w-4 h-4\\\" />\\n                  <span>Dial 112</span>\\n                </a>\\n              </div>\\n\\n              {/* Footer Actions */}\\n              <div className=\\\"pt-2 border-t border-[#DCE5D1] flex flex-wrap items-center justify-between gap-2.5\\\">\\n                {onOpenFullSosPage ? (\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      onOpenFullSosPage();\\n                      onClose();\\n                    }}\\n                    className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] text-[#24371D] text-xs font-semibold cursor-pointer\\\"\\n                  >\\n                    Open Full SOS Dashboard\\n                  </button>\\n                ) : (\\n                  <span className=\\\"text-xs text-[#54634D]\\\">\\n                    Triggered without logging into dashboard\\n                  </span>\\n                )}\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onClose}\\n                  className=\\\"min-h-[42px] px-4 py-2 rounded-xl border border-[#C5D2B7] hover:bg-[#F4F7EF] text-[#182215] text-xs font-semibold cursor-pointer\\\"\\n                >\\n                  I&apos;m Safe \302\267 Close\\n                </button>\\n              </div>\\n            </div>\\n          )}\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create full-screen EmergencyTriggerOverlay that handles countdown, instant auto-dial, GPS SMS, and Guardian + Police calling when triggered by 3x Shake, Secret Voice Code, or Screen Tap\", \"Overwrite\":true, \"TargetFile\":\"/src/components/EmergencyTriggerOverlay.tsx\", \"toolAction\":\"Creating EmergencyTriggerOverlay component\", \"toolSummary\":\"Create EmergencyTriggerOverlay.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_8543166534767213372"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useState } from \'react\';\\nimport {\\n  Hand,\\n  Lock,\\n  Mic,\\n  MicOff,\\n  Radio,\\n  ShieldCheck,\\n  Smartphone,\\n  Unlock,\\n  Volume2,\\n} from \'lucide-react\';\\nimport { EmergencyQuickTriggersState } from \'../hooks/useEmergencyQuickTriggers\';\\nimport { SafetyPreferences } from \'../types/safety\';\\n\\ninterface EmergencyLockScreenShieldProps {\\n  preferences: SafetyPreferences;\\n  guardianName?: string;\\n  guardianPhone?: string;\\n  triggers: EmergencyQuickTriggersState;\\n  onExit: () => void;\\n}\\n\\nexport const EmergencyLockScreenShield: React.FC<EmergencyLockScreenShieldProps> = ({\\n  preferences,\\n  guardianName,\\n  guardianPhone,\\n  triggers,\\n  onExit,\\n}) => {\\n  const [now, setNow] = useState<Date>(() => new Date());\\n  const [voiceTestMessage, setVoiceTestMessage] = useState(\'\');\\n\\n  useEffect(() => {\\n    const timer = window.setInterval(() => setNow(new Date()), 1000);\\n    return () => window.clearInterval(timer);\\n  }, []);\\n\\n  // Keep screen awake in standby shield mode so Shake, Voice Code, and Screen Taps work reliably\\n  useEffect(() => {\\n    void triggers.requestWakeLock();\\n    return () => {\\n      void triggers.releaseWakeLock();\\n    };\\n    // eslint-disable-next-line react-hooks/exhaustive-deps\\n  }, []);\\n\\n  const timeString = now.toLocaleTimeString([], {\\n    hour: \'2-digit\',\\n    minute: \'2-digit\',\\n    hour12: false,\\n  });\\n\\n  const dateString = now.toLocaleDateString([], {\\n    weekday: \'long\',\\n    month: \'long\',\\n    day: \'numeric\',\\n  });\\n\\n  const secretCode = preferences.voiceKeyword.trim() || \'Red Rose\';\\n  const requiredTaps = preferences.screenTapCount === 2 ? 2 : 3;\\n\\n  return (\\n    <div\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-label=\\\"OurSafe Lock-Screen Standby Shield\\\"\\n      className=\\\"fixed inset-0 z-[60] bg-[#0B100A] text-[#F5F9F2] flex flex-col justify-between select-none overflow-y-auto\\\"\\n    >\\n      {/* Top Phone Status Strip */}\\n      <div\\n        data-ignore-sos-tap=\\\"true\\\"\\n        className=\\\"w-full max-w-lg mx-auto px-5 pt-5 pb-2 flex items-center justify-between gap-3 text-xs text-[#A7B99D]\\\"\\n      >\\n        <div className=\\\"flex items-center gap-2 font-semibold text-[#D6E3CC]\\\">\\n          <Lock className=\\\"w-3.5 h-3.5 text-[#9BBF82]\\\" />\\n          <span>OurSafe Standby Shield</span>\\n        </div>\\n        <div className=\\\"flex items-center gap-2 font-mono text-[11px]\\\">\\n          <span className=\\\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\\\" />\\n          <span>\\n            {triggers.wakeLockActive ? \'Screen Wake Lock ON\' : \'Standby Armed\'}\\n          </span>\\n        </div>\\n      </div>\\n\\n      {/* Center Lock-Screen Clock & Tap-Anywhere Emergency Surface */}\\n      <div className=\\\"flex-1 flex flex-col items-center justify-center px-6 py-6 text-center\\\">\\n        <div className=\\\"space-y-1.5 pointer-events-none\\\">\\n          <p className=\\\"text-xs sm:text-sm font-medium text-[#A7B99D] tracking-wide\\\">\\n            {dateString}\\n          </p>\\n          <p className=\\\"text-6xl sm:text-7xl font-semibold tracking-tight font-mono tabular-nums text-[#FAFDF7]\\\">\\n            {timeString}\\n          </p>\\n        </div>\\n\\n        {/* Live Tap / Shake Feedback Indicator */}\\n        <div className=\\\"mt-6 min-h-[64px] flex flex-col items-center justify-center gap-2 pointer-events-none\\\">\\n          {preferences.screenTapSosEnabled && triggers.tapCount > 0 ? (\\n            <div className=\\\"px-4 py-2 rounded-2xl bg-red-600/25 border border-red-400/50 text-red-100 text-xs font-bold flex items-center gap-2.5\\\">\\n              <Hand className=\\\"w-4 h-4 text-red-300\\\" />\\n              <span>\\n                Screen Tap {triggers.tapCount} / {requiredTaps} \342\200\224 Keep tapping to call SOS!\\n              </span>\\n            </div>\\n          ) : preferences.shakeDetectionEnabled && triggers.shakeCount > 0 ? (\\n            <div className=\\\"px-4 py-2 rounded-2xl bg-red-600/25 border border-red-400/50 text-red-100 text-xs font-bold flex items-center gap-2.5\\\">\\n              <Smartphone className=\\\"w-4 h-4 text-red-300\\\" />\\n              <span>\\n                Phone Shake {triggers.shakeCount} / 3 \342\200\224 Shake again to call SOS!\\n              </span>\\n            </div>\\n          ) : (\\n            <div className=\\\"max-w-sm space-y-1.5\\\">\\n              <p className=\\\"text-xs sm:text-sm font-semibold text-[#D6E3CC]\\\">\\n                Emergency Triggers Active Without Opening the App\\n              </p>\\n              <p className=\\\"text-xs text-[#8FA286] leading-relaxed\\\">\\n                {preferences.screenTapSosEnabled\\n                  ? `${requiredTaps === 2 ? \'Double-tap\' : \'Triple-tap\'} anywhere on this screen`\\n                  : \'Tap disabled\'}\\n                {preferences.shakeDetectionEnabled ? \' \302\267 Shake phone 3 times\' : \'\'}\\n                {preferences.voiceActivationEnabled\\n                  ? ` \302\267 Say \\\"${secretCode}\\\"`\\n                  : \'\'}\\n              </p>\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Live Guardian Readiness Line */}\\n        <div className=\\\"mt-4 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-white/5 border border-white/10 text-[11px] text-[#C5D5BC] pointer-events-none\\\">\\n          <ShieldCheck className=\\\"w-3.5 h-3.5 text-emerald-400 shrink-0\\\" />\\n          <span>\\n            Auto-SOS Target:{\' \'}\\n            {guardianName\\n              ? `${guardianName} (${guardianPhone})`\\n              : \'Police Emergency (100 / 112)\'}\\n          </span>\\n        </div>\\n      </div>\\n\\n      {/* Bottom Interactive Lock-Screen Trigger Controls & Live Demo Deck */}\\n      <div\\n        data-ignore-sos-tap=\\\"true\\\"\\n        className=\\\"w-full max-w-xl mx-auto px-4 pb-6 pt-2 space-y-3\\\"\\n      >\\n        <div className=\\\"rounded-3xl bg-[#151D13] border border-[#2C3B27] p-4 space-y-3\\\">\\n          <div className=\\\"flex items-center justify-between gap-2 text-[11px] font-semibold text-[#A7B99D]\\\">\\n            <span>Active Outside-App Triggers (Live Controls)</span>\\n            <span className=\\\"font-mono text-emerald-400\\\">\\n              {[\\n                preferences.shakeDetectionEnabled,\\n                preferences.voiceActivationEnabled,\\n                preferences.screenTapSosEnabled,\\n              ].filter(Boolean).length}\\n              /3 Armed\\n            </span>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-2.5\\\">\\n            {/* 1. Shake Card */}\\n            <div className=\\\"rounded-2xl bg-[#1C2719] border border-[#30422A] p-3 flex flex-col justify-between gap-2\\\">\\n              <div className=\\\"flex items-center justify-between gap-1\\\">\\n                <span className=\\\"text-xs font-bold text-white flex items-center gap-1.5\\\">\\n                  <Smartphone className=\\\"w-3.5 h-3.5 text-[#9BBF82]\\\" />\\n                  <span>3x Shake</span>\\n                </span>\\n                <span className=\\\"text-[11px] font-mono text-[#9BBF82]\\\">\\n                  {triggers.shakeCount}/3\\n                </span>\\n              </div>\\n              {triggers.motionPermissionState === \'prompt\' ? (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => void triggers.requestMotionPermission()}\\n                  className=\\\"w-full min-h-[36px] px-2.5 py-1.5 rounded-xl bg-[#2F4526] hover:bg-[#3B5730] text-[11px] font-semibold text-white cursor-pointer\\\"\\n                >\\n                  Allow Motion Sensor\\n                </button>\\n              ) : (\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={!preferences.shakeDetectionEnabled}\\n                  onClick={triggers.simulateShakeImpulse}\\n                  className=\\\"w-full min-h-[36px] px-2.5 py-1.5 rounded-xl bg-[#2F4526] hover:bg-[#3B5730] disabled:opacity-40 text-[11px] font-semibold text-white cursor-pointer\\\"\\n                >\\n                  Shake Phone ({triggers.shakeCount}/3)\\n                </button>\\n              )}\\n            </div>\\n\\n            {/* 2. Secret Code Voice Card */}\\n            <div className=\\\"rounded-2xl bg-[#1C2719] border border-[#30422A] p-3 flex flex-col justify-between gap-2\\\">\\n              <div className=\\\"flex items-center justify-between gap-1\\\">\\n                <span className=\\\"text-xs font-bold text-white flex items-center gap-1.5 truncate\\\">\\n                  {triggers.voiceListening ? (\\n                    <Mic className=\\\"w-3.5 h-3.5 text-emerald-400 animate-pulse shrink-0\\\" />\\n                  ) : (\\n                    <MicOff className=\\\"w-3.5 h-3.5 text-[#9BBF82] shrink-0\\\" />\\n                  )}\\n                  <span className=\\\"truncate\\\">&ldquo;{secretCode}&rdquo;</span>\\n                </span>\\n                {triggers.voiceListening && (\\n                  <Radio className=\\\"w-3.5 h-3.5 text-emerald-400 shrink-0\\\" />\\n                )}\\n              </div>\\n\\n              <div className=\\\"flex items-center gap-1.5\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={!preferences.voiceActivationEnabled}\\n                  onClick={triggers.toggleVoiceWakeListener}\\n                  className={`flex-1 min-h-[36px] px-2 py-1.5 rounded-xl text-[11px] font-semibold cursor-pointer disabled:opacity-40 ${\\n                    triggers.voiceListening\\n                      ? \'bg-emerald-600 hover:bg-emerald-700 text-white\'\\n                      : \'bg-[#2F4526] hover:bg-[#3B5730] text-white\'\\n                  }`}\\n                >\\n                  {triggers.voiceListening ? \'Listening\' : \'Arm Mic\'}\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  disabled={!preferences.voiceActivationEnabled}\\n                  onClick={() => {\\n                    const res = triggers.testSecretVoicePhrase(secretCode);\\n                    setVoiceTestMessage(\\n                      res.matched\\n                        ? `Matched \\\"${secretCode}\\\"!`\\n                        : \'Secret voice trigger is disabled.\'\\n                    );\\n                  }}\\n                  title={`Simulate speaking \\\"${secretCode}\\\"`}\\n                  className=\\\"min-h-[36px] px-2.5 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-[11px] font-semibold text-[#E5F0DC] cursor-pointer disabled:opacity-40\\\"\\n                >\\n                  <Volume2 className=\\\"w-3.5 h-3.5\\\" />\\n                </button>\\n              </div>\\n            </div>\\n\\n            {/* 3. Double/Triple Screen Tap Card */}\\n            <div className=\\\"rounded-2xl bg-[#1C2719] border border-[#30422A] p-3 flex flex-col justify-between gap-2\\\">\\n              <div className=\\\"flex items-center justify-between gap-1\\\">\\n                <span className=\\\"text-xs font-bold text-white flex items-center gap-1.5\\\">\\n                  <Hand className=\\\"w-3.5 h-3.5 text-[#9BBF82]\\\" />\\n                  <span>{requiredTaps === 2 ? \'Double Tap\' : \'Triple Tap\'}</span>\\n                </span>\\n                <span className=\\\"text-[11px] font-mono text-[#9BBF82]\\\">\\n                  {triggers.tapCount}/{requiredTaps}\\n                </span>\\n              </div>\\n              <p className=\\\"text-[11px] text-[#A7B99D] leading-snug\\\">\\n                Tap clock area above {requiredTaps}x fast for SOS\\n              </p>\\n            </div>\\n          </div>\\n\\n          {(triggers.lastHeardTranscript || triggers.voiceError || voiceTestMessage) && (\\n            <p className=\\\"text-[11px] text-[#B8C9AE] px-1 truncate\\\">\\n              {triggers.voiceError\\n                ? triggers.voiceError\\n                : triggers.lastHeardTranscript\\n                  ? `Heard: \\\"${triggers.lastHeardTranscript}\\\"`\\n                  : voiceTestMessage}\\n            </p>\\n          )}\\n        </div>\\n\\n        {/* Unlock & Exit Shield Button */}\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onExit}\\n          className=\\\"w-full min-h-[48px] px-5 py-3 rounded-2xl bg-white/10 hover:bg-white/15 border border-white/15 text-sm font-semibold text-[#F5F9F2] flex items-center justify-center gap-2 transition-colors cursor-pointer\\\"\\n        >\\n          <Unlock className=\\\"w-4 h-4 text-[#B8D0A8]\\\" />\\n          <span>Unlock &amp; Return to OurSafe</span>\\n        </button>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create EmergencyLockScreenShield full-screen OLED standby mode so users can trigger SOS via 3x Shake, Secret Voice Code, or Double/Triple Screen Tap without entering the app dashboard\", \"Overwrite\":true, \"TargetFile\":\"/src/components/EmergencyLockScreenShield.tsx\", \"toolAction\":\"Creating EmergencyLockScreenShield component\", \"toolSummary\":\"Create EmergencyLockScreenShield.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_8543166534767212735"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  CheckCircle2,\\n  Hand,\\n  Lock,\\n  Mic,\\n  MicOff,\\n  PhoneCall,\\n  Radio,\\n  ShieldAlert,\\n  Smartphone,\\n  Volume2,\\n} from \'lucide-react\';\\nimport { EmergencyQuickTriggersState } from \'../../hooks/useEmergencyQuickTriggers\';\\nimport { SafetyPreferences } from \'../../types/safety\';\\n\\ninterface QuickSosTriggersCardProps {\\n  preferences: SafetyPreferences;\\n  triggers: EmergencyQuickTriggersState;\\n  onUpdatePreferences: (partial: Partial<SafetyPreferences>) => void;\\n  onOpenLockScreenShield: () => void;\\n}\\n\\nconst SECRET_CODE_PRESETS = [\'Red Rose\', \'Code 999\', \'Help Me Now\', \'Save Me\'];\\n\\nexport const QuickSosTriggersCard: React.FC<QuickSosTriggersCardProps> = ({\\n  preferences,\\n  triggers,\\n  onUpdatePreferences,\\n  onOpenLockScreenShield,\\n}) => {\\n  const [codeDraft, setCodeDraft] = useState(preferences.voiceKeyword || \'Red Rose\');\\n  const [codeSavedFeedback, setCodeSavedFeedback] = useState(false);\\n  const [voiceTestInput, setVoiceTestInput] = useState(\'\');\\n  const [voiceTestStatus, setVoiceTestStatus] = useState(\'\');\\n\\n  const handleSaveSecretCode = (value?: string) => {\\n    const finalCode = (value ?? codeDraft).trim() || \'Red Rose\';\\n    setCodeDraft(finalCode);\\n    onUpdatePreferences({ voiceKeyword: finalCode });\\n    setCodeSavedFeedback(true);\\n    window.setTimeout(() => setCodeSavedFeedback(false), 2000);\\n  };\\n\\n  const handleTestVoicePhraseSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const phrase = voiceTestInput.trim() || preferences.voiceKeyword || \'Red Rose\';\\n    const res = triggers.testSecretVoicePhrase(phrase);\\n    if (res.matched) {\\n      setVoiceTestStatus(`Matched secret code \\\"${preferences.voiceKeyword}\\\" \342\200\224 launching SOS!`);\\n      setVoiceTestInput(\'\');\\n    } else {\\n      setVoiceTestStatus(\\n        `Phrase \\\"${phrase}\\\" did not match your secret code \\\"${preferences.voiceKeyword}\\\".`\\n      );\\n    }\\n  };\\n\\n  const requiredTaps = preferences.screenTapCount === 2 ? 2 : 3;\\n\\n  return (\\n    <section\\n      aria-label=\\\"Hands-Free & Outside-App Emergency SOS Triggers\\\"\\n      className=\\\"bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 sm:p-7 space-y-6 shadow-sm\\\"\\n    >\\n      {/* Header Row */}\\n      <div className=\\\"flex flex-wrap items-start justify-between gap-4\\\">\\n        <div className=\\\"space-y-1.5 max-w-2xl\\\">\\n          <div className=\\\"flex items-center gap-2 text-xs font-semibold text-[#3E5632]\\\">\\n            <ShieldAlert className=\\\"w-4 h-4 text-red-600 shrink-0\\\" />\\n            <span>Zero-Navigation Emergency Protection</span>\\n          </div>\\n          <h2 className=\\\"text-xl sm:text-2xl font-semibold text-[#182215] tracking-tight\\\">\\n            Instant SOS Without Entering the App\\n          </h2>\\n          <p className=\\\"text-xs sm:text-sm text-[#4B5844] leading-relaxed\\\">\\n            Trigger an emergency call to your Guardian &amp; Police instantly using{\' \'}\\n            <strong className=\\\"text-[#182215]\\\">3x Phone Shake</strong>, your{\' \'}\\n            <strong className=\\\"text-[#182215]\\\">Secret Voice Code</strong> (like &ldquo;Hey Google&rdquo;), or{\' \'}\\n            <strong className=\\\"text-[#182215]\\\">Double/Triple Screen Tap</strong> \342\200\224 active across the Login screen, Lock-Screen Shield, and every screen.\\n          </p>\\n        </div>\\n\\n        <button\\n          type=\\\"button\\\"\\n          onClick={onOpenLockScreenShield}\\n          className=\\\"min-h-[48px] px-5 py-2.5 rounded-2xl bg-[#182215] hover:bg-[#24371D] text-[#F6F9F2] text-sm font-semibold flex items-center gap-2 transition-colors shadow-sm cursor-pointer whitespace-nowrap shrink-0\\\"\\n        >\\n          <Lock className=\\\"w-4 h-4 text-[#B8D0A8]\\\" />\\n          <span>Launch Lock-Screen Shield</span>\\n        </button>\\n      </div>\\n\\n      {/* 3 Trigger Cards Grid */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-3 gap-5\\\">\\n        {/* 1. TRIPLE SHAKE SOS */}\\n        <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] p-5 flex flex-col justify-between gap-4\\\">\\n          <div className=\\\"space-y-3\\\">\\n            <div className=\\\"flex items-start justify-between gap-3\\\">\\n              <div className=\\\"flex items-center gap-2.5\\\">\\n                <div className=\\\"w-10 h-10 rounded-xl bg-[#2F4526] text-white flex items-center justify-center shrink-0\\\">\\n                  <Smartphone className=\\\"w-5 h-5\\\" />\\n                </div>\\n                <div>\\n                  <p className=\\\"text-[11px] font-bold uppercase tracking-wider text-[#3E5632]\\\">\\n                    Option 1\\n                  </p>\\n                  <h3 className=\\\"text-base font-bold text-[#182215]\\\">\\n                    3x Phone Shake SOS\\n                  </h3>\\n                </div>\\n              </div>\\n\\n              <button\\n                type=\\\"button\\\"\\n                role=\\\"switch\\\"\\n                aria-label=\\\"Toggle 3x Phone Shake SOS\\\"\\n                aria-checked={preferences.shakeDetectionEnabled}\\n                onClick={() =>\\n                  onUpdatePreferences({\\n                    shakeDetectionEnabled: !preferences.shakeDetectionEnabled,\\n                  })\\n                }\\n                className={`w-11 h-6 rounded-full p-0.5 transition-colors shrink-0 cursor-pointer flex items-center ${\\n                  preferences.shakeDetectionEnabled\\n                    ? \'bg-[#2F4526] justify-end\'\\n                    : \'bg-[#C4D1B6] justify-start\'\\n                }`}\\n              >\\n                <span className=\\\"w-5 h-5 rounded-full bg-white shadow-sm block\\\" />\\n              </button>\\n            </div>\\n\\n            <p className=\\\"text-xs text-[#465340] leading-relaxed\\\">\\n              Shake your phone firmly <strong>3 times within 2.5 seconds</strong> to automatically launch the SOS emergency call &amp; live GPS alert.\\n            </p>\\n\\n            {/* Live Shake Meter */}\\n            <div className=\\\"rounded-xl bg-white border border-[#D4DFC8] p-3 space-y-2\\\">\\n              <div className=\\\"flex items-center justify-between text-xs\\\">\\n                <span className=\\\"font-semibold text-[#182215]\\\">Live Shake Meter</span>\\n                <span className=\\\"font-mono font-bold text-[#2F4526]\\\">\\n                  {triggers.shakeCount} / 3\\n                </span>\\n              </div>\\n              <div className=\\\"grid grid-cols-3 gap-2\\\">\\n                {[1, 2, 3].map((step) => (\\n                  <div\\n                    key={step}\\n                    className={`h-2 rounded-full transition-colors ${\\n                      triggers.shakeCount >= step ? \'bg-red-600\' : \'bg-[#DCE5D1]\'\\n                    }`}\\n                  />\\n                ))}\\n              </div>\\n              <p className=\\\"text-[11px] text-[#54634D]\\\">\\n                {!preferences.shakeDetectionEnabled\\n                  ? \'Shake trigger is paused.\'\\n                  : triggers.motionPermissionState === \'granted\'\\n                    ? \'Accelerometer armed \342\200\224 shake your phone 3x now.\'\\n                    : triggers.motionPermissionState === \'prompt\'\\n                      ? \'Tap below to grant iOS/mobile motion sensor permission.\'\\n                      : \'Use the test button below on desktop devices.\'}\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"space-y-2\\\">\\n            {triggers.motionPermissionState === \'prompt\' && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => void triggers.requestMotionPermission()}\\n                className=\\\"w-full min-h-[40px] px-3.5 py-2 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-950 text-xs font-bold cursor-pointer\\\"\\n              >\\n                Enable Phone Motion Sensor\\n              </button>\\n            )}\\n            <button\\n              type=\\\"button\\\"\\n              disabled={!preferences.shakeDetectionEnabled}\\n              onClick={triggers.simulateShakeImpulse}\\n              className=\\\"w-full min-h-[42px] px-4 py-2 rounded-xl bg-[#2F4526] hover:bg-[#23351C] disabled:opacity-45 text-white text-xs font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer\\\"\\n            >\\n              <Smartphone className=\\\"w-4 h-4\\\" />\\n              <span>Test Shake (Click 3x \302\267 {triggers.shakeCount}/3)</span>\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* 2. SECRET CODE VOICE TRIGGER (HEY GOOGLE STYLE) */}\\n        <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] p-5 flex flex-col justify-between gap-4\\\">\\n          <div className=\\\"space-y-3\\\">\\n            <div className=\\\"flex items-start justify-between gap-3\\\">\\n              <div className=\\\"flex items-center gap-2.5\\\">\\n                <div className=\\\"w-10 h-10 rounded-xl bg-[#2F4526] text-white flex items-center justify-center shrink-0\\\">\\n                  <Mic className=\\\"w-5 h-5\\\" />\\n                </div>\\n                <div>\\n                  <p className=\\\"text-[11px] font-bold uppercase tracking-wider text-[#3E5632]\\\">\\n                    Option 2\\n                  </p>\\n                  <h3 className=\\\"text-base font-bold text-[#182215]\\\">\\n                    Secret Voice Code SOS\\n                  </h3>\\n                </div>\\n              </div>\\n\\n              <button\\n                type=\\\"button\\\"\\n                role=\\\"switch\\\"\\n                aria-label=\\\"Toggle Secret Voice Code SOS\\\"\\n                aria-checked={preferences.voiceActivationEnabled}\\n                onClick={() =>\\n                  onUpdatePreferences({\\n                    voiceActivationEnabled: !preferences.voiceActivationEnabled,\\n                  })\\n                }\\n                className={`w-11 h-6 rounded-full p-0.5 transition-colors shrink-0 cursor-pointer flex items-center ${\\n                  preferences.voiceActivationEnabled\\n                    ? \'bg-[#2F4526] justify-end\'\\n                    : \'bg-[#C4D1B6] justify-start\'\\n                }`}\\n              >\\n                <span className=\\\"w-5 h-5 rounded-full bg-white shadow-sm block\\\" />\\n              </button>\\n            </div>\\n\\n            <p className=\\\"text-xs text-[#465340] leading-relaxed\\\">\\n              Just like &ldquo;Hey Google&rdquo;, say your private secret code hands-free to instantly trigger SOS without touching your phone.\\n            </p>\\n\\n            {/* Secret Code Input + Presets */}\\n            <div className=\\\"space-y-2\\\">\\n              <label\\n                htmlFor=\\\"secret-voice-code-input\\\"\\n                className=\\\"block text-[11px] font-bold text-[#182215]\\\"\\n              >\\n                Your Secret Code Phrase\\n              </label>\\n              <div className=\\\"flex items-center gap-1.5\\\">\\n                <input\\n                  id=\\\"secret-voice-code-input\\\"\\n                  type=\\\"text\\\"\\n                  value={codeDraft}\\n                  onChange={(e) => setCodeDraft(e.target.value)}\\n                  placeholder=\\\"e.g. Red Rose or Code 999\\\"\\n                  className=\\\"flex-1 min-h-[38px] px-3 py-1.5 rounded-xl bg-white border border-[#C5D2B7] text-xs font-semibold text-[#182215] focus:border-[#2F4526] focus:outline-none\\\"\\n                />\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => handleSaveSecretCode()}\\n                  className=\\\"min-h-[38px] px-3 py-1.5 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] border border-[#B8C6A8] text-[#24371D] text-xs font-bold cursor-pointer\\\"\\n                >\\n                  Save\\n                </button>\\n              </div>\\n\\n              {codeSavedFeedback && (\\n                <p className=\\\"text-[11px] font-semibold text-emerald-700 flex items-center gap-1\\\">\\n                  <CheckCircle2 className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>Secret code updated to &ldquo;{preferences.voiceKeyword}&rdquo;</span>\\n                </p>\\n              )}\\n\\n              <div className=\\\"flex flex-wrap gap-1.5\\\">\\n                {SECRET_CODE_PRESETS.map((preset) => (\\n                  <button\\n                    key={preset}\\n                    type=\\\"button\\\"\\n                    onClick={() => handleSaveSecretCode(preset)}\\n                    className={`px-2 py-1 rounded-lg text-[11px] font-semibold cursor-pointer transition-colors ${\\n                      preferences.voiceKeyword.toLowerCase() === preset.toLowerCase()\\n                        ? \'bg-[#2F4526] text-white\'\\n                        : \'bg-white border border-[#CFD9C3] text-[#3E4C37] hover:bg-[#EAF0E2]\'\\n                    }`}\\n                  >\\n                    {preset}\\n                  </button>\\n                ))}\\n              </div>\\n\\n              <div className=\\\"flex items-center justify-between gap-2 pt-1\\\">\\n                <label\\n                  htmlFor=\\\"voice-code-lang\\\"\\n                  className=\\\"text-[11px] font-semibold text-[#4B5844]\\\"\\n                >\\n                  Voice Language\\n                </label>\\n                <select\\n                  id=\\\"voice-code-lang\\\"\\n                  value={preferences.voiceLanguage}\\n                  onChange={(e) =>\\n                    onUpdatePreferences({\\n                      voiceLanguage: e.target.value as \'en-IN\' | \'en-US\' | \'ta-IN\',\\n                    })\\n                  }\\n                  className=\\\"px-2.5 py-1 rounded-lg bg-white border border-[#C5D2B7] text-[11px] font-semibold text-[#182215] focus:outline-none\\\"\\n                >\\n                  <option value=\\\"en-IN\\\">English (India)</option>\\n                  <option value=\\\"en-US\\\">English (US)</option>\\n                  <option value=\\\"ta-IN\\\">Tamil (\340\256\244\340\256\256\340\256\277\340\256\264\340\257\215)</option>\\n                </select>\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Live Mic Arming & Instant Phrase Tester */}\\n          <div className=\\\"space-y-2\\\">\\n            <button\\n              type=\\\"button\\\"\\n              disabled={!preferences.voiceActivationEnabled}\\n              onClick={triggers.toggleVoiceWakeListener}\\n              className={`w-full min-h-[42px] px-4 py-2 rounded-xl text-xs font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer disabled:opacity-45 ${\\n                triggers.voiceListening\\n                  ? \'bg-emerald-600 hover:bg-emerald-700 text-white\'\\n                  : \'bg-[#2F4526] hover:bg-[#23351C] text-white\'\\n              }`}\\n            >\\n              {triggers.voiceListening ? (\\n                <>\\n                  <Radio className=\\\"w-4 h-4 animate-pulse\\\" />\\n                  <span>Listening for &ldquo;{preferences.voiceKeyword}&rdquo; (Stop)</span>\\n                </>\\n              ) : (\\n                <>\\n                  <MicOff className=\\\"w-4 h-4\\\" />\\n                  <span>Arm Always-On Voice Mic</span>\\n                </>\\n              )}\\n            </button>\\n\\n            <form onSubmit={handleTestVoicePhraseSubmit} className=\\\"flex items-center gap-1.5\\\">\\n              <input\\n                type=\\\"text\\\"\\n                value={voiceTestInput}\\n                onChange={(e) => setVoiceTestInput(e.target.value)}\\n                placeholder={`Type \\\"${preferences.voiceKeyword}\\\" to test`}\\n                className=\\\"flex-1 min-h-[36px] px-2.5 py-1 rounded-xl bg-white border border-[#C5D2B7] text-[11px] text-[#182215] focus:border-[#2F4526] focus:outline-none\\\"\\n              />\\n              <button\\n                type=\\\"submit\\\"\\n                disabled={!preferences.voiceActivationEnabled}\\n                className=\\\"min-h-[36px] px-3 py-1 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] border border-[#B8C6A8] text-[#24371D] text-[11px] font-bold inline-flex items-center gap-1 cursor-pointer disabled:opacity-45 whitespace-nowrap\\\"\\n              >\\n                <Volume2 className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Speak Test</span>\\n              </button>\\n            </form>\\n\\n            {(triggers.voiceError || triggers.lastHeardTranscript || voiceTestStatus) && (\\n              <p className=\\\"text-[11px] text-[#465340] leading-snug\\\">\\n                {triggers.voiceError ||\\n                  (triggers.lastHeardTranscript\\n                    ? `Live mic heard: \\\"${triggers.lastHeardTranscript}\\\"`\\n                    : voiceTestStatus)}\\n              </p>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* 3. DOUBLE-TAP OR TRIPLE-TAP SCREEN SOS */}\\n        <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] p-5 flex flex-col justify-between gap-4\\\">\\n          <div className=\\\"space-y-3\\\">\\n            <div className=\\\"flex items-start justify-between gap-3\\\">\\n              <div className=\\\"flex items-center gap-2.5\\\">\\n                <div className=\\\"w-10 h-10 rounded-xl bg-[#2F4526] text-white flex items-center justify-center shrink-0\\\">\\n                  <Hand className=\\\"w-5 h-5\\\" />\\n                </div>\\n                <div>\\n                  <p className=\\\"text-[11px] font-bold uppercase tracking-wider text-[#3E5632]\\\">\\n                    Option 3\\n                  </p>\\n                  <h3 className=\\\"text-base font-bold text-[#182215]\\\">\\n                    Screen {requiredTaps === 2 ? \'Double-Tap\' : \'Triple-Tap\'} SOS\\n                  </h3>\\n                </div>\\n              </div>\\n\\n              <button\\n                type=\\\"button\\\"\\n                role=\\\"switch\\\"\\n                aria-label=\\\"Toggle Double or Triple Screen Tap SOS\\\"\\n                aria-checked={preferences.screenTapSosEnabled}\\n                onClick={() =>\\n                  onUpdatePreferences({\\n                    screenTapSosEnabled: !preferences.screenTapSosEnabled,\\n                  })\\n                }\\n                className={`w-11 h-6 rounded-full p-0.5 transition-colors shrink-0 cursor-pointer flex items-center ${\\n                  preferences.screenTapSosEnabled\\n                    ? \'bg-[#2F4526] justify-end\'\\n                    : \'bg-[#C4D1B6] justify-start\'\\n                }`}\\n              >\\n                <span className=\\\"w-5 h-5 rounded-full bg-white shadow-sm block\\\" />\\n              </button>\\n            </div>\\n\\n            <p className=\\\"text-xs text-[#465340] leading-relaxed\\\">\\n              Rapidly tap <strong>{requiredTaps} times</strong> on the Lock-Screen Shield, Login screen, or any open area of the screen to call SOS immediately.\\n            </p>\\n\\n            {/* Double vs Triple Tap Selector */}\\n            <div className=\\\"grid grid-cols-2 gap-2\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onUpdatePreferences({ screenTapCount: 2 })}\\n                className={`min-h-[40px] px-3 py-2 rounded-xl text-xs font-bold transition-colors cursor-pointer ${\\n                  preferences.screenTapCount === 2\\n                    ? \'bg-[#2F4526] text-white\'\\n                    : \'bg-white border border-[#C5D2B7] text-[#24371D] hover:bg-[#EAF0E2]\'\\n                }`}\\n              >\\n                Double Tap (2x)\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onUpdatePreferences({ screenTapCount: 3 })}\\n                className={`min-h-[40px] px-3 py-2 rounded-xl text-xs font-bold transition-colors cursor-pointer ${\\n                  preferences.screenTapCount === 3\\n                    ? \'bg-[#2F4526] text-white\'\\n                    : \'bg-white border border-[#C5D2B7] text-[#24371D] hover:bg-[#EAF0E2]\'\\n                }`}\\n              >\\n                Triple Tap (3x)\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Interactive Rapid-Tap Test Pad (uses real global pointerdown listener!) */}\\n          <div className=\\\"rounded-2xl border-2 border-dashed border-[#9DB08C] bg-white p-4 text-center space-y-2 select-none cursor-pointer\\\">\\n            <div className=\\\"flex items-center justify-center gap-2\\\">\\n              {Array.from({ length: requiredTaps }).map((_, idx) => (\\n                <span\\n                  key={idx}\\n                  className={`w-3.5 h-3.5 rounded-full transition-colors ${\\n                    triggers.tapCount > idx ? \'bg-red-600 scale-110\' : \'bg-[#DCE5D1]\'\\n                  }`}\\n                />\\n              ))}\\n            </div>\\n            <p className=\\\"text-xs font-bold text-[#182215]\\\">\\n              {preferences.screenTapSosEnabled\\n                ? `Tap Here Rapidly ${requiredTaps} Times to Test Live`\\n                : \'Enable Screen Tap SOS above to test\'}\\n            </p>\\n            <p className=\\\"text-[11px] text-[#54634D]\\\">\\n              Live taps detected: <span className=\\\"font-mono font-bold\\\">{triggers.tapCount}/{requiredTaps}</span>\\n            </p>\\n          </div>\\n        </div>\\n      </div>\\n\\n      {/* Bottom Dispatch Behavior Bar */}\\n      <div className=\\\"pt-4 border-t border-[#DCE5D1] flex flex-wrap items-center justify-between gap-4 text-xs\\\">\\n        <div className=\\\"flex flex-wrap items-center gap-4\\\">\\n          <label className=\\\"inline-flex items-center gap-2 font-semibold text-[#182215] cursor-pointer\\\">\\n            <input\\n              type=\\\"checkbox\\\"\\n              checked={preferences.autoDialOnTrigger}\\n              onChange={(e) =>\\n                onUpdatePreferences({ autoDialOnTrigger: e.target.checked })\\n              }\\n              className=\\\"w-4 h-4 accent-[#2F4526] rounded cursor-pointer\\\"\\n            />\\n            <PhoneCall className=\\\"w-3.5 h-3.5 text-[#2F4526]\\\" />\\n            <span>Auto-launch Emergency Call immediately on trigger</span>\\n          </label>\\n\\n          <div className=\\\"flex items-center gap-1.5\\\">\\n            <span className=\\\"text-[#54634D] font-medium\\\">Dispatch Delay:</span>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onUpdatePreferences({ quickTriggerCountdownSec: 3 })}\\n              className={`px-2.5 py-1 rounded-lg font-semibold cursor-pointer ${\\n                preferences.quickTriggerCountdownSec === 3\\n                  ? \'bg-[#2F4526] text-white\'\\n                  : \'bg-[#EAF0E2] text-[#24371D]\'\\n              }`}\\n            >\\n              3s Cancel Window\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onUpdatePreferences({ quickTriggerCountdownSec: 0 })}\\n              className={`px-2.5 py-1 rounded-lg font-semibold cursor-pointer ${\\n                preferences.quickTriggerCountdownSec === 0\\n                  ? \'bg-red-600 text-white\'\\n                  : \'bg-[#EAF0E2] text-[#24371D]\'\\n              }`}\\n            >\\n              0s Instant Call\\n            </button>\\n          </div>\\n        </div>\\n\\n        <p className=\\\"text-[11px] text-[#54634D]\\\">\\n          Keep Lock-Screen Shield open in your pocket for continuous Web Wake-Lock protection without entering the dashboard.\\n        </p>\\n      </div>\\n    </section>\\n  );\\n};\\n\", \"Description\":\"Create QuickSosTriggersCard component for configuring and live-testing 3x Phone Shake, Secret Voice Code, and Double/Triple Screen Tap SOS triggers\", \"Overwrite\":true, \"TargetFile\":\"/src/components/dashboard/QuickSosTriggersCard.tsx\", \"toolAction\":\"Creating QuickSosTriggersCard component\", \"toolSummary\":\"Create QuickSosTriggersCard.tsx\"}"
      original_name: "write_to_file"
    }
