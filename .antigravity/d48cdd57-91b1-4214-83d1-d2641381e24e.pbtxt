          target_content: "import React, { useState } from \'react\';\nimport {\n  AlertTriangle,\n  ArrowRight,\n  CheckCircle2,\n  Compass,\n  History,\n  MapPin,\n  Mic,\n  Pencil,\n  Phone,\n  ShieldAlert,\n  ShieldCheck,\n  Star,\n  Users,\n} from \'lucide-react\';\nimport { AppPage, TeamInfoConfig, UserReviewItem } from \'../../types/safety\';\nimport {\n  formatTimeShort,\n  getReviews,\n  getTeamInfo,\n  saveReviews,\n  saveTeamInfo,\n} from \'../../utils/storage\';\n\ninterface HomeAboutPageProps {\n  userName: string;\n  onNavigatePage: (page: AppPage) => void;\n  onOpenContacts: () => void;\n}"
          replacement_content: "import React, { useState } from \'react\';\nimport {\n  AlertTriangle,\n  ArrowRight,\n  CheckCircle2,\n  Compass,\n  Hand,\n  History,\n  Lock,\n  MapPin,\n  Mic,\n  Pencil,\n  Phone,\n  Settings,\n  ShieldAlert,\n  ShieldCheck,\n  Smartphone,\n  Star,\n  Users,\n} from \'lucide-react\';\nimport {\n  AppPage,\n  SafetyPreferences,\n  TeamInfoConfig,\n  UserReviewItem,\n} from \'../../types/safety\';\nimport {\n  formatTimeShort,\n  getReviews,\n  getTeamInfo,\n  saveReviews,\n  saveTeamInfo,\n} from \'../../utils/storage\';\n\ninterface HomeAboutPageProps {\n  userName: string;\n  preferences?: SafetyPreferences;\n  voiceListening?: boolean;\n  liveVoiceActive?: boolean;\n  onNavigatePage: (page: AppPage) => void;\n  onOpenContacts: () => void;\n  onOpenSettings?: () => void;\n  onOpenLockShield?: () => void;\n  onWakeVoice?: () => void;\n}"
          start_line: 1
