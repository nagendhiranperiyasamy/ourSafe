    tool_calls {
      id: "call_17223966292749354096"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useRef, useState } from \'react\';\\nimport {\\n  APIProvider,\\n  AdvancedMarker,\\n  Map as GoogleMap,\\n  Pin,\\n  useMap,\\n  useMapsLibrary,\\n} from \'@vis.gl/react-google-maps\';\\nimport {\\n  AlertTriangle,\\n  CheckCircle2,\\n  Compass,\\n  Navigation,\\n  Phone,\\n  Radio,\\n  ShieldAlert,\\n  Volume2,\\n  VolumeX,\\n} from \'lucide-react\';\\nimport { GeoLocationState } from \'../../types/safety\';\\n\\ninterface LatLngPoint {\\n  lat: number;\\n  lng: number;\\n}\\n\\ninterface TravelRouteMapProps {\\n  startLocation: string;\\n  destination: string;\\n  isJourneyActive: boolean;\\n  geoLocation: GeoLocationState;\\n  guardianName?: string;\\n  guardianPhone?: string;\\n  vehicleNumber?: string;\\n  soundAllowed?: boolean;\\n  onRouteComputed?: (summary: {\\n    distanceKm: number;\\n    durationMin: number;\\n  }) => void;\\n  onOffRouteDetected?: (info: {\\n    distanceMeters: number;\\n    currentLat: number;\\n    currentLng: number;\\n    simulated: boolean;\\n  }) => void;\\n  onEscalateToSos?: (reason: string) => void;\\n}\\n\\nconst DEFAULT_CENTER: LatLngPoint = { lat: 13.0827, lng: 80.2707 };\\nconst OFF_ROUTE_THRESHOLD_METERS = 200;\\n\\nfunction parseGpsString(input: string): LatLngPoint | string {\\n  const cleaned = input.replace(/^gps\\\\s*/i, \'\').trim();\\n  const match = /^(-?\\\\d+(?:\\\\.\\\\d+)?)\\\\s*,\\\\s*(-?\\\\d+(?:\\\\.\\\\d+)?)$/.exec(cleaned);\\n  if (match) {\\n    const lat = Number(match[1]);\\n    const lng = Number(match[2]);\\n    if (\\n      !Number.isNaN(lat) &&\\n      !Number.isNaN(lng) &&\\n      lat >= -90 &&\\n      lat <= 90 &&\\n      lng >= -180 &&\\n      lng <= 180\\n    ) {\\n      return { lat, lng };\\n    }\\n  }\\n  return input.trim();\\n}\\n\\nfunction haversineMeters(a: LatLngPoint, b: LatLngPoint): number {\\n  const R = 6371000;\\n  const toRad = (deg: number) => (deg * Math.PI) / 180;\\n  const dLat = toRad(b.lat - a.lat);\\n  const dLng = toRad(b.lng - a.lng);\\n  const sinDLat = Math.sin(dLat / 2);\\n  const sinDLng = Math.sin(dLng / 2);\\n  const h =\\n    sinDLat * sinDLat +\\n    Math.cos(toRad(a.lat)) * Math.cos(toRad(b.lat)) * sinDLng * sinDLng;\\n  return 2 * R * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));\\n}\\n\\nfunction pointToSegmentDistanceMeters(\\n  p: LatLngPoint,\\n  a: LatLngPoint,\\n  b: LatLngPoint\\n): number {\\n  const latRad = (p.lat * Math.PI) / 180;\\n  const kx = 111320 * Math.cos(latRad);\\n  const ky = 110540;\\n\\n  const px = p.lng * kx;\\n  const py = p.lat * ky;\\n  const ax = a.lng * kx;\\n  const ay = a.lat * ky;\\n  const bx = b.lng * kx;\\n  const by = b.lat * ky;\\n\\n  const dx = bx - ax;\\n  const dy = by - ay;\\n  const lenSq = dx * dx + dy * dy;\\n  if (lenSq === 0) {\\n    return haversineMeters(p, a);\\n  }\\n  const t = Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / lenSq));\\n  const proj: LatLngPoint = {\\n    lat: a.lat + t * (b.lat - a.lat),\\n    lng: a.lng + t * (b.lng - a.lng),\\n  };\\n  return haversineMeters(p, proj);\\n}\\n\\nfunction minDistanceToPolylineMeters(\\n  point: LatLngPoint,\\n  path: LatLngPoint[]\\n): number {\\n  if (path.length === 0) return 0;\\n  if (path.length === 1) return haversineMeters(point, path[0]);\\n  let minMeters = Infinity;\\n  for (let i = 0; i < path.length - 1; i += 1) {\\n    const dist = pointToSegmentDistanceMeters(point, path[i], path[i + 1]);\\n    if (dist < minMeters) minMeters = dist;\\n  }\\n  return minMeters;\\n}\\n\\ninterface RouteOverlayProps {\\n  origin: string;\\n  destination: string;\\n  liveVehiclePos: LatLngPoint | null;\\n  isOffRoute: boolean;\\n  onRouteReady: (data: {\\n    path: LatLngPoint[];\\n    startPoint: LatLngPoint | null;\\n    endPoint: LatLngPoint | null;\\n    distanceKm: number;\\n    durationMin: number;\\n  }) => void;\\n  onRouteError: (msg: string) => void;\\n  onRouteLoading: (loading: boolean) => void;\\n}\\n\\nconst ModernRoutesLayer: React.FC<RouteOverlayProps> = ({\\n  origin,\\n  destination,\\n  liveVehiclePos,\\n  isOffRoute,\\n  onRouteReady,\\n  onRouteError,\\n  onRouteLoading,\\n}) => {\\n  const map = useMap();\\n  const routesLib = useMapsLibrary(\'routes\');\\n  const polylinesRef = useRef<google.maps.Polyline[]>([]);\\n  const [startMarkerPos, setStartMarkerPos] = useState<LatLngPoint | null>(null);\\n  const [endMarkerPos, setEndMarkerPos] = useState<LatLngPoint | null>(null);\\n\\n  const onRouteReadyRef = useRef(onRouteReady);\\n  const onRouteErrorRef = useRef(onRouteError);\\n  const onRouteLoadingRef = useRef(onRouteLoading);\\n\\n  useEffect(() => {\\n    onRouteReadyRef.current = onRouteReady;\\n    onRouteErrorRef.current = onRouteError;\\n    onRouteLoadingRef.current = onRouteLoading;\\n  }, [onRouteReady, onRouteError, onRouteLoading]);\\n\\n  useEffect(() => {\\n    if (!routesLib || !map || !origin.trim() || !destination.trim()) return;\\n\\n    let cancelled = false;\\n\\n    polylinesRef.current.forEach((p) => p.setMap(null));\\n    polylinesRef.current = [];\\n    onRouteErrorRef.current(\'\');\\n    onRouteLoadingRef.current(true);\\n\\n    const request = {\\n      origin: parseGpsString(origin),\\n      destination: parseGpsString(destination),\\n      travelMode: \'DRIVING\',\\n      fields: [\'path\', \'distanceMeters\', \'durationMillis\', \'viewport\', \'legs\'],\\n    };\\n\\n    const routeClass = (\\n      routesLib as unknown as {\\n        Route?: {\\n          computeRoutes?: (req: Record<string, unknown>) => Promise<{\\n            routes?: Array<{\\n              path?: Array<google.maps.LatLng | LatLngPoint>;\\n              distanceMeters?: number;\\n              durationMillis?: number;\\n              viewport?: google.maps.LatLngBounds;\\n              legs?: Array<{\\n                startLocation?: { latLng?: google.maps.LatLng };\\n                endLocation?: { latLng?: google.maps.LatLng };\\n              }>;\\n              createPolylines?: () => google.maps.Polyline[];\\n            }>;\\n          }>;\\n        };\\n      }\\n    ).Route;\\n\\n    if (!routeClass || typeof routeClass.computeRoutes !== \'function\') {\\n      onRouteLoadingRef.current(false);\\n      onRouteErrorRef.current(\\n        \'Google Maps Routes library is initializing. Retry in a moment.\'\\n      );\\n      return;\\n    }\\n\\n    routeClass\\n      .computeRoutes(request)\\n      .then((response) => {\\n        if (cancelled) return;\\n        onRouteLoadingRef.current(false);\\n\\n        const primaryRoute = response?.routes?.[0];\\n        if (!primaryRoute) {\\n          onRouteErrorRef.current(\\n            \'Could not find a driving route between those two locations. Try adding the city name.\'\\n          );\\n          return;\\n        }\\n\\n        const extractedPath: LatLngPoint[] = [];\\n\\n        if (typeof primaryRoute.createPolylines === \'function\') {\\n          const created = primaryRoute.createPolylines();\\n          created.forEach((poly) => {\\n            poly.setOptions({\\n              strokeColor: \'#2F4526\',\\n              strokeOpacity: 0.92,\\n              strokeWeight: 6,\\n            });\\n            poly.setMap(map);\\n            const pathArr = poly.getPath()?.getArray() ?? [];\\n            pathArr.forEach((pt) => {\\n              extractedPath.push({ lat: pt.lat(), lng: pt.lng() });\\n            });\\n          });\\n          polylinesRef.current = created;\\n        } else if (Array.isArray(primaryRoute.path)) {\\n          primaryRoute.path.forEach((pt) => {\\n            if (typeof (pt as google.maps.LatLng).lat === \'function\') {\\n              extractedPath.push({\\n                lat: (pt as google.maps.LatLng).lat(),\\n                lng: (pt as google.maps.LatLng).lng(),\\n              });\\n            } else {\\n              const lit = pt as LatLngPoint;\\n              extractedPath.push({ lat: lit.lat, lng: lit.lng });\\n            }\\n          });\\n          if (extractedPath.length > 0 && window.google?.maps?.Polyline) {\\n            const poly = new window.google.maps.Polyline({\\n              path: extractedPath,\\n              geodesic: true,\\n              strokeColor: \'#2F4526\',\\n              strokeOpacity: 0.92,\\n              strokeWeight: 6,\\n              map,\\n            });\\n            polylinesRef.current = [poly];\\n          }\\n        }\\n\\n        const startPoint =\\n          extractedPath[0] ??\\n          (primaryRoute.legs?.[0]?.startLocation?.latLng\\n            ? {\\n                lat: primaryRoute.legs[0].startLocation.latLng.lat(),\\n                lng: primaryRoute.legs[0].startLocation.latLng.lng(),\\n              }\\n            : null);\\n\\n        const endPoint =\\n          extractedPath[extractedPath.length - 1] ??\\n          (primaryRoute.legs?.[0]?.endLocation?.latLng\\n            ? {\\n                lat: primaryRoute.legs[0].endLocation.latLng.lat(),\\n                lng: primaryRoute.legs[0].endLocation.latLng.lng(),\\n              }\\n            : null);\\n\\n        setStartMarkerPos(startPoint);\\n        setEndMarkerPos(endPoint);\\n\\n        if (primaryRoute.viewport) {\\n          map.fitBounds(primaryRoute.viewport, 48);\\n        } else if (startPoint && endPoint && window.google?.maps?.LatLngBounds) {\\n          const bounds = new window.google.maps.LatLngBounds();\\n          bounds.extend(startPoint);\\n          bounds.extend(endPoint);\\n          map.fitBounds(bounds, 48);\\n        }\\n\\n        const distanceKm = Number(\\n          ((primaryRoute.distanceMeters ?? 0) / 1000).toFixed(2)\\n        );\\n        const durationMin = Math.max(\\n          1,\\n          Math.round((primaryRoute.durationMillis ?? 0) / 60000)\\n        );\\n\\n        onRouteReadyRef.current({\\n          path: extractedPath,\\n          startPoint,\\n          endPoint,\\n          distanceKm,\\n          durationMin,\\n        });\\n      })\\n      .catch((err: unknown) => {\\n        if (cancelled) return;\\n        onRouteLoadingRef.current(false);\\n        const msg = err instanceof Error ? err.message : String(err);\\n        if (\\n          msg.includes(\'RESOURCE_EXHAUSTED\') ||\\n          msg.includes(\'OVER_QUERY_LIMIT\') ||\\n          msg.includes(\'OverQuota\') ||\\n          msg.includes(\'429\')\\n        ) {\\n          window.dispatchEvent(new CustomEvent(\'gmp-quota-exceeded\'));\\n        }\\n        onRouteErrorRef.current(\\n          \'Unable to plot route for those addresses. Enter clearer street/city names or check connectivity.\'\\n        );\\n      });\\n\\n    return () => {\\n      cancelled = true;\\n      polylinesRef.current.forEach((p) => p.setMap(null));\\n      polylinesRef.current = [];\\n    };\\n  }, [routesLib, map, origin, destination]);\\n\\n  return (\\n    <>\\n      {startMarkerPos && (\\n        <AdvancedMarker position={startMarkerPos} title=\\\"Start Location\\\">\\n          <Pin\\n            background=\\\"#2F4526\\\"\\n            borderColor=\\\"#FFFFFF\\\"\\n            glyphColor=\\\"#FFFFFF\\\"\\n            glyph=\\\"A\\\"\\n          />\\n        </AdvancedMarker>\\n      )}\\n      {endMarkerPos && (\\n        <AdvancedMarker position={endMarkerPos} title=\\\"Destination\\\">\\n          <Pin\\n            background=\\\"#DC2626\\\"\\n            borderColor=\\\"#FFFFFF\\\"\\n            glyphColor=\\\"#FFFFFF\\\"\\n            glyph=\\\"B\\\"\\n          />\\n        </AdvancedMarker>\\n      )}\\n      {liveVehiclePos && (\\n        <AdvancedMarker\\n          position={liveVehiclePos}\\n          title={isOffRoute ? \'OFF-ROUTE VEHICLE ALERT\' : \'Your Live Vehicle GPS\'}\\n        >\\n          <div className=\\\"relative flex items-center justify-center\\\">\\n            <span\\n              className={`absolute w-10 h-10 rounded-full animate-ping opacity-70 ${\\n                isOffRoute ? \'bg-red-500\' : \'bg-emerald-500\'\\n              }`}\\n            />\\n            <span\\n              className={`relative w-6 h-6 rounded-full border-2 border-white shadow-lg flex items-center justify-center text-[10px] font-extrabold text-white ${\\n                isOffRoute ? \'bg-red-600\' : \'bg-emerald-600\'\\n              }`}\\n            >\\n              {isOffRoute ? \'!\' : \'\342\227\217\'}\\n            </span>\\n          </div>\\n        </AdvancedMarker>\\n      )}\\n    </>\\n  );\\n};\\n\\nexport const TravelRouteMap: React.FC<TravelRouteMapProps> = ({\\n  startLocation,\\n  destination,\\n  isJourneyActive,\\n  geoLocation,\\n  guardianName,\\n  guardianPhone,\\n  vehicleNumber,\\n  soundAllowed = true,\\n  onRouteComputed,\\n  onOffRouteDetected,\\n  onEscalateToSos,\\n}) => {\\n  const apiKey = import.meta.env.VITE_GOOGLE_MAPS_API_KEY as string | undefined;\\n\\n  const [routePath, setRoutePath] = useState<LatLngPoint[]>([]);\\n  const [routeSummary, setRouteSummary] = useState<{\\n    distanceKm: number;\\n    durationMin: number;\\n  } | null>(null);\\n  const [routeLoading, setRouteLoading] = useState(false);\\n  const [routeError, setRouteError] = useState(\'\');\\n\\n  const [liveVehiclePos, setLiveVehiclePos] = useState<LatLngPoint | null>(\\n    geoLocation.latitude !== null && geoLocation.longitude !== null\\n      ? { lat: geoLocation.latitude, lng: geoLocation.longitude }\\n      : null\\n  );\\n  const [deviationMeters, setDeviationMeters] = useState<number>(0);\\n  const [isOffRoute, setIsOffRoute] = useState<boolean>(false);\\n  const [isSimulatedOffRoute, setIsSimulatedOffRoute] = useState<boolean>(false);\\n  const [alarmMuted, setAlarmMuted] = useState<boolean>(false);\\n\\n  const lastAlertTimestampRef = useRef<number>(0);\\n  const audioCtxRef = useRef<AudioContext | null>(null);\\n  const sirenTimerRef = useRef<number | null>(null);\\n\\n  const stopDeviationTone = useCallback(() => {\\n    if (sirenTimerRef.current !== null) {\\n      window.clearInterval(sirenTimerRef.current);\\n      sirenTimerRef.current = null;\\n    }\\n    if (audioCtxRef.current) {\\n      audioCtxRef.current.close().catch(() => {});\\n      audioCtxRef.current = null;\\n    }\\n  }, []);\\n\\n  const startDeviationTone = useCallback(() => {\\n    if (!soundAllowed || alarmMuted || sirenTimerRef.current !== null) return;\\n    try {\\n      const Ctor =\\n        window.AudioContext ||\\n        (window as unknown as { webkitAudioContext: typeof AudioContext })\\n          .webkitAudioContext;\\n      const ctx = new Ctor();\\n      audioCtxRef.current = ctx;\\n\\n      const beep = (freq: number) => {\\n        if (!audioCtxRef.current) return;\\n        const osc = ctx.createOscillator();\\n        const gain = ctx.createGain();\\n        osc.type = \'sawtooth\';\\n        osc.frequency.setValueAtTime(freq, ctx.currentTime);\\n        gain.gain.setValueAtTime(0.001, ctx.currentTime);\\n        gain.gain.exponentialRampToValueAtTime(0.14, ctx.currentTime + 0.04);\\n        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);\\n        osc.connect(gain);\\n        gain.connect(ctx.destination);\\n        osc.start();\\n        osc.stop(ctx.currentTime + 0.38);\\n      };\\n\\n      let high = true;\\n      beep(920);\\n      sirenTimerRef.current = window.setInterval(() => {\\n        high = !high;\\n        beep(high ? 920 : 680);\\n      }, 650);\\n    } catch {\\n      // Audio playback blocked before gesture\\n    }\\n  }, [soundAllowed, alarmMuted]);\\n\\n  useEffect(() => {\\n    return () => stopDeviationTone();\\n  }, [stopDeviationTone]);\\n\\n  useEffect(() => {\\n    if (isOffRoute && !alarmMuted) {\\n      startDeviationTone();\\n      if (\'vibrate\' in navigator) {\\n        try {\\n          navigator.vibrate([300, 150, 300, 150, 400]);\\n        } catch {\\n          // ignore\\n        }\\n      }\\n    } else {\\n      stopDeviationTone();\\n    }\\n  }, [isOffRoute, alarmMuted, startDeviationTone, stopDeviationTone]);\\n\\n  // Real-time GPS watchPosition during active Travel Mode\\n  useEffect(() => {\\n    if (!isJourneyActive || isSimulatedOffRoute || !(\'geolocation\' in navigator)) {\\n      return;\\n    }\\n\\n    const watchId = navigator.geolocation.watchPosition(\\n      (pos) => {\\n        const pt: LatLngPoint = {\\n          lat: pos.coords.latitude,\\n          lng: pos.coords.longitude,\\n        };\\n        setLiveVehiclePos(pt);\\n\\n        if (routePath.length >= 2) {\\n          const dist = Math.round(minDistanceToPolylineMeters(pt, routePath));\\n          setDeviationMeters(dist);\\n          if (dist > OFF_ROUTE_THRESHOLD_METERS) {\\n            setIsOffRoute(true);\\n            const now = Date.now();\\n            if (now - lastAlertTimestampRef.current > 20_000) {\\n              lastAlertTimestampRef.current = now;\\n              onOffRouteDetected?.({\\n                distanceMeters: dist,\\n                currentLat: pt.lat,\\n                currentLng: pt.lng,\\n                simulated: false,\\n              });\\n            }\\n          } else {\\n            setIsOffRoute(false);\\n          }\\n        }\\n      },\\n      () => {\\n        // Keep last known position if GPS temporarily fluctuates\\n      },\\n      { enableHighAccuracy: true, maximumAge: 4000, timeout: 10000 }\\n    );\\n\\n    return () => navigator.geolocation.clearWatch(watchId);\\n  }, [isJourneyActive, isSimulatedOffRoute, routePath, onOffRouteDetected]);\\n\\n  const handleRouteReady = useCallback(\\n    (data: {\\n      path: LatLngPoint[];\\n      startPoint: LatLngPoint | null;\\n      endPoint: LatLngPoint | null;\\n      distanceKm: number;\\n      durationMin: number;\\n    }) => {\\n      setRoutePath(data.path);\\n      setRouteSummary({\\n        distanceKm: data.distanceKm,\\n        durationMin: data.durationMin,\\n      });\\n      if (data.startPoint && !liveVehiclePos) {\\n        setLiveVehiclePos(data.startPoint);\\n      }\\n      onRouteComputed?.({\\n        distanceKm: data.distanceKm,\\n        durationMin: data.durationMin,\\n      });\\n    },\\n    [liveVehiclePos, onRouteComputed]\\n  );\\n\\n  const handleSimulateDeviation = () => {\\n    const midIdx = Math.floor(routePath.length / 2);\\n    const anchor = routePath[midIdx] ??\\n      liveVehiclePos ??\\n      (geoLocation.latitude !== null && geoLocation.longitude !== null\\n        ? { lat: geoLocation.latitude, lng: geoLocation.longitude }\\n        : DEFAULT_CENTER);\\n\\n    // Offset ~460 meters perpendicular to the route corridor\\n    const deviatedPt: LatLngPoint = {\\n      lat: anchor.lat + 0.0042,\\n      lng: anchor.lng + 0.0021,\\n    };\\n\\n    const dist =\\n      routePath.length >= 2\\n        ? Math.round(minDistanceToPolylineMeters(deviatedPt, routePath))\\n        : 480;\\n\\n    setIsSimulatedOffRoute(true);\\n    setLiveVehiclePos(deviatedPt);\\n    setDeviationMeters(dist);\\n    setAlarmMuted(false);\\n    setIsOffRoute(true);\\n    onOffRouteDetected?.({\\n      distanceMeters: dist,\\n      currentLat: deviatedPt.lat,\\n      currentLng: deviatedPt.lng,\\n      simulated: true,\\n    });\\n  };\\n\\n  const handleResetDeviation = () => {\\n    setIsSimulatedOffRoute(false);\\n    setIsOffRoute(false);\\n    setDeviationMeters(0);\\n    stopDeviationTone();\\n    if (routePath.length > 0) {\\n      setLiveVehiclePos(routePath[0]);\\n    }\\n  };\\n\\n  const defaultCenter: LatLngPoint =\\n    geoLocation.latitude !== null && geoLocation.longitude !== null\\n      ? { lat: geoLocation.latitude, lng: geoLocation.longitude }\\n      : DEFAULT_CENTER;\\n\\n  const hasBothLocations = Boolean(startLocation.trim() && destination.trim());\\n\\n  const offRouteSmsBody = encodeURIComponent(\\n    `ROUTE DEVIATION ALERT from OurSafe! Vehicle moved ${deviationMeters}m OFF my Google Maps route (${startLocation} -> ${destination}).${\\n      vehicleNumber ? ` Vehicle: ${vehicleNumber}.` : \'\'\\n    }${\\n      liveVehiclePos\\n        ? ` Current GPS: https://maps.google.com/?q=${liveVehiclePos.lat.toFixed(\\n            6\\n          )},${liveVehiclePos.lng.toFixed(6)}`\\n        : \'\'\\n    }`\\n  );\\n\\n  return (\\n    <section className=\\\"bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-5 sm:p-6 shadow-sm space-y-4\\\">\\n      <div className=\\\"flex flex-wrap items-start justify-between gap-3\\\">\\n        <div>\\n          <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n            Google Maps Live Route Guard \302\267 Off-Route Deviation Monitor\\n          </p>\\n          <h3 className=\\\"mt-1 text-lg sm:text-xl font-semibold text-[#182215]\\\">\\n            Live Route &amp; Deviation Protection\\n          </h3>\\n          <p className=\\\"mt-0.5 text-xs text-[#4B5844]\\\">\\n            Continuously compares your live GPS against the official Google Maps route. Alerts you and your guardian immediately if the vehicle moves more than {OFF_ROUTE_THRESHOLD_METERS}m off-route.\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n          {routeSummary && (\\n            <div className=\\\"px-3 py-1.5 rounded-xl bg-[#EAF0E2] border border-[#C5D2B7] text-xs font-semibold text-[#24371D] font-mono tabular-nums\\\">\\n              {routeSummary.distanceKm} km \302\267 ~{routeSummary.durationMin} min\\n            </div>\\n          )}\\n\\n          {hasBothLocations && !isOffRoute && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleSimulateDeviation}\\n              className=\\\"min-h-[38px] px-3 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 border border-amber-300 text-amber-900 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n            >\\n              <AlertTriangle className=\\\"w-3.5 h-3.5 text-amber-700\\\" />\\n              <span>Test Off-Route Alert</span>\\n            </button>\\n          )}\\n        </div>\\n      </div>\\n\\n      {/* Urgent Off-Route Deviation Alert Banner */}\\n      {isOffRoute && (\\n        <div\\n          role=\\\"alert\\\"\\n          className=\\\"rounded-2xl bg-red-600 text-white p-4 sm:p-5 space-y-3.5 shadow-md\\\"\\n        >\\n          <div className=\\\"flex flex-wrap items-start justify-between gap-3\\\">\\n            <div className=\\\"flex items-start gap-3\\\">\\n              <AlertTriangle className=\\\"w-6 h-6 shrink-0 mt-0.5 animate-pulse\\\" />\\n              <div>\\n                <p className=\\\"text-xs font-bold uppercase tracking-wider text-red-100\\\">\\n                  Off-Route Deviation Alert \302\267 Vehicle Left Planned Route\\n                </p>\\n                <h4 className=\\\"text-lg font-extrabold mt-0.5\\\">\\n                  Vehicle is {deviationMeters}m away from Google Maps route!\\n                </h4>\\n                <p className=\\\"text-xs text-red-50/95 mt-1 leading-relaxed\\\">\\n                  {vehicleNumber ? `Logged Vehicle: ${vehicleNumber} \302\267 ` : \'\'}\\n                  Route guard detected an unexpected detour away from your{\' \'}\\n                  <strong>{destination}</strong> corridor.\\n                </p>\\n              </div>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setAlarmMuted((m) => !m)}\\n              className=\\\"min-h-[38px] px-3 py-1.5 rounded-xl bg-white/15 hover:bg-white/25 text-white text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer\\\"\\n            >\\n              {alarmMuted ? (\\n                <>\\n                  <VolumeX className=\\\"w-4 h-4\\\" />\\n                  <span>Unmute</span>\\n                </>\\n              ) : (\\n                <>\\n                  <Volume2 className=\\\"w-4 h-4\\\" />\\n                  <span>Mute Alarm</span>\\n                </>\\n              )}\\n            </button>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2.5\\\">\\n            {onEscalateToSos && (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() =>\\n                  onEscalateToSos(\\n                    `Off-Route Deviation (${deviationMeters}m off route to ${destination}${\\n                      vehicleNumber ? `, Vehicle ${vehicleNumber}` : \'\'\\n                    })`\\n                  )\\n                }\\n                className=\\\"min-h-[44px] px-4 py-2 rounded-xl bg-white hover:bg-red-50 text-red-700 text-xs font-extrabold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n              >\\n                <ShieldAlert className=\\\"w-4 h-4\\\" />\\n                <span>Escalate to SOS (Call Guardian + Police)</span>\\n              </button>\\n            )}\\n\\n            {guardianPhone && (\\n              <a\\n                href={`sms:${guardianPhone.replace(/[^\\\\d+]/g, \'\')}?body=${offRouteSmsBody}`}\\n                className=\\\"min-h-[44px] px-4 py-2 rounded-xl bg-red-800 hover:bg-red-900 text-white text-xs font-bold inline-flex items-center gap-1.5 whitespace-nowrap\\\"\\n              >\\n                <Phone className=\\\"w-4 h-4\\\" />\\n                <span>SMS {guardianName || \'Guardian\'} Live Location</span>\\n              </a>\\n            )}\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={handleResetDeviation}\\n              className=\\\"min-h-[44px] px-3.5 py-2 rounded-xl bg-white/15 hover:bg-white/25 text-white text-xs font-semibold cursor-pointer whitespace-nowrap\\\"\\n            >\\n              I&apos;m Safe \302\267 Back on Route\\n            </button>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Route Status Bar */}\\n      <div className=\\\"flex flex-wrap items-center justify-between gap-2 text-xs rounded-2xl bg-[#F4F7EF] border border-[#D4DFC8] px-4 py-2.5\\\">\\n        <div className=\\\"flex items-center gap-2 font-semibold text-[#182215]\\\">\\n          {isOffRoute ? (\\n            <>\\n              <AlertTriangle className=\\\"w-4 h-4 text-red-600 shrink-0\\\" />\\n              <span className=\\\"text-red-700\\\">\\n                Off-Route Deviation Detected ({deviationMeters}m from corridor)\\n              </span>\\n            </>\\n          ) : isJourneyActive ? (\\n            <>\\n              <Radio className=\\\"w-4 h-4 text-emerald-600 animate-pulse shrink-0\\\" />\\n              <span className=\\\"text-emerald-800\\\">\\n                Live GPS Corridor Monitoring Active \302\267 On Planned Route\\n                {deviationMeters > 0 ? ` (${deviationMeters}m variance)` : \'\'}\\n              </span>\\n            </>\\n          ) : hasBothLocations ? (\\n            <>\\n              <CheckCircle2 className=\\\"w-4 h-4 text-[#2F4526] shrink-0\\\" />\\n              <span>\\n                Route plotted: {startLocation} \342\206\222 {destination}\\n              </span>\\n            </>\\n          ) : (\\n            <>\\n              <Compass className=\\\"w-4 h-4 text-[#2F4526] shrink-0\\\" />\\n              <span>\\n                Enter Starting Location and Destination above to preview your live Google Maps route.\\n              </span>\\n            </>\\n          )}\\n        </div>\\n\\n        {routeLoading && (\\n          <span className=\\\"text-[#3E5632] font-semibold\\\">\\n            Computing Google Maps route...\\n          </span>\\n        )}\\n      </div>\\n\\n      {routeError && (\\n        <p className=\\\"rounded-xl bg-amber-50 border border-amber-200 px-3.5 py-2.5 text-xs font-medium text-amber-900\\\">\\n          {routeError}\\n        </p>\\n      )}\\n\\n      {/* Interactive Google Map Container (explicit height required by CF2) */}\\n      {apiKey ? (\\n        <div className=\\\"w-full h-[360px] sm:h-[420px] rounded-2xl overflow-hidden border border-[#B8C6A8] bg-[#E7EFE0]\\\">\\n          <APIProvider apiKey={apiKey} language=\\\"en\\\" region=\\\"IN\\\">\\n            <GoogleMap\\n              defaultCenter={defaultCenter}\\n              defaultZoom={13}\\n              mapId=\\\"DEMO_MAP_ID\\\"\\n              gestureHandling=\\\"greedy\\\"\\n              streetViewControl={false}\\n              mapTypeControl={false}\\n              internalUsageAttributionIds={[\'gmp_mcp_codeassist_v1_aistudio\']}\\n              style={{ width: \'100%\', height: \'100%\' }}\\n            >\\n              {hasBothLocations && (\\n                <ModernRoutesLayer\\n                  origin={startLocation}\\n                  destination={destination}\\n                  liveVehiclePos={liveVehiclePos}\\n                  isOffRoute={isOffRoute}\\n                  onRouteReady={handleRouteReady}\\n                  onRouteError={setRouteError}\\n                  onRouteLoading={setRouteLoading}\\n                />\\n              )}\\n\\n              {!hasBothLocations && liveVehiclePos && (\\n                <AdvancedMarker\\n                  position={liveVehiclePos}\\n                  title=\\\"Your Current GPS Location\\\"\\n                >\\n                  <Pin\\n                    background=\\\"#2F4526\\\"\\n                    borderColor=\\\"#FFFFFF\\\"\\n                    glyphColor=\\\"#FFFFFF\\\"\\n                  />\\n                </AdvancedMarker>\\n              )}\\n            </GoogleMap>\\n          </APIProvider>\\n        </div>\\n      ) : (\\n        <div className=\\\"w-full h-[260px] rounded-2xl border border-[#C5D2B7] bg-[#F4F7EF] flex flex-col items-center justify-center p-6 text-center space-y-2.5\\\">\\n          <Navigation className=\\\"w-8 h-8 text-[#2F4526]\\\" />\\n          <p className=\\\"text-sm font-bold text-[#182215]\\\">\\n            Google Maps API Key Pending Reload\\n          </p>\\n          <p className=\\\"text-xs text-[#4B5844] max-w-md\\\">\\n            Your Google Maps key is provisioned via environment secrets. Restart or refresh the app preview once secrets sync to display the live interactive Google Maps corridor.\\n          </p>\\n        </div>\\n      )}\\n    </section>\\n  );\\n};\\n\", \"Description\":\"Create live Google Maps TravelRouteMap with modern Route.computeRoutes(), AdvancedMarker, and real-time off-route deviation alert engine\", \"Overwrite\":true, \"TargetFile\":\"/src/components/dashboard/TravelRouteMap.tsx\", \"toolAction\":\"Creating TravelRouteMap with Google Maps and off-route alerts\", \"toolSummary\":\"Create TravelRouteMap.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_17223966292749353665"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useRef, useState } from \'react\';\\nimport {\\n  AlertTriangle,\\n  Camera,\\n  Car,\\n  CheckCircle2,\\n  FileSearch,\\n  ShieldCheck,\\n  Trash2,\\n  Upload,\\n} from \'lucide-react\';\\nimport { VehicleVerificationRecord } from \'../../types/safety\';\\nimport { formatTimeShort } from \'../../utils/storage\';\\n\\ninterface VehicleVerificationCardProps {\\n  verifiedVehicle?: VehicleVerificationRecord | null;\\n  onVehicleVerified: (record: VehicleVerificationRecord) => void;\\n  onClearVehicle?: () => void;\\n}\\n\\nexport const VehicleVerificationCard: React.FC<VehicleVerificationCardProps> = ({\\n  verifiedVehicle,\\n  onVehicleVerified,\\n  onClearVehicle,\\n}) => {\\n  const [plateInput, setPlateInput] = useState(\\n    verifiedVehicle?.normalizedNumber ?? \'\'\\n  );\\n  const [photoPreview, setPhotoPreview] = useState<string>(\\n    verifiedVehicle?.photoDataUrl ?? \'\'\\n  );\\n  const [photoMime, setPhotoMime] = useState<string>(\'image/jpeg\');\\n  const [busy, setBusy] = useState(false);\\n  const [error, setError] = useState(\'\');\\n  const [result, setResult] = useState<VehicleVerificationRecord | null>(\\n    verifiedVehicle ?? null\\n  );\\n\\n  const fileInputRef = useRef<HTMLInputElement | null>(null);\\n\\n  const handlePhotoChange = (e: React.ChangeEvent<HTMLInputElement>) => {\\n    const file = e.target.files?.[0];\\n    if (!file) return;\\n    setError(\'\');\\n    if (!file.type.startsWith(\'image/\')) {\\n      setError(\'Please capture or upload an image file (JPG, PNG, or WebP).\');\\n      return;\\n    }\\n    if (file.size > 4 * 1024 * 1024) {\\n      setError(\'Photo is too large (max 4 MB). Capture a closer plate photo.\');\\n      return;\\n    }\\n    setPhotoMime(file.type || \'image/jpeg\');\\n    const reader = new FileReader();\\n    reader.onload = () => {\\n      if (typeof reader.result === \'string\') {\\n        setPhotoPreview(reader.result);\\n      }\\n    };\\n    reader.readAsDataURL(file);\\n  };\\n\\n  const handleVerifySubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(\'\');\\n\\n    if (!plateInput.trim() && !photoPreview) {\\n      setError(\\n        \'Enter an auto / cab registration number (e.g., TN 09 AB 1234) or capture a plate photo.\'\\n      );\\n      return;\\n    }\\n\\n    setBusy(true);\\n    try {\\n      const res = await fetch(\'/api/travel/verify-vehicle\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          vehicleNumber: plateInput.trim() || undefined,\\n          photoBase64: photoPreview || undefined,\\n          mimeType: photoMime,\\n        }),\\n      });\\n\\n      const data = (await res.json()) as VehicleVerificationRecord & {\\n        error?: string;\\n      };\\n\\n      if (!res.ok) {\\n        throw new Error(data.error || \'Could not verify vehicle number.\');\\n      }\\n\\n      const fullRecord: VehicleVerificationRecord = {\\n        ...data,\\n        photoDataUrl: photoPreview || undefined,\\n      };\\n\\n      setResult(fullRecord);\\n      if (fullRecord.normalizedNumber) {\\n        setPlateInput(fullRecord.normalizedNumber);\\n      }\\n      onVehicleVerified(fullRecord);\\n    } catch (err) {\\n      setError(\\n        err instanceof Error\\n          ? err.message\\n          : \'Vehicle verification failed. Double-check the number plate manually.\'\\n      );\\n    } finally {\\n      setBusy(false);\\n    }\\n  };\\n\\n  const handleReset = () => {\\n    setPlateInput(\'\');\\n    setPhotoPreview(\'\');\\n    setResult(null);\\n    setError(\'\');\\n    if (fileInputRef.current) fileInputRef.current.value = \'\';\\n    onClearVehicle?.();\\n  };\\n\\n  const isSuspicious = result?.authenticityStatus === \'suspicious_or_invalid\';\\n  const isVerified = result?.authenticityStatus === \'format_verified\';\\n\\n  return (\\n    <section className=\\\"bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-5 sm:p-6 shadow-sm space-y-4\\\">\\n      <div className=\\\"flex flex-wrap items-start justify-between gap-3\\\">\\n        <div>\\n          <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n            Pre-Ride Safety Audit \302\267 Auto / Cab Plate Verification &amp; Photo Log\\n          </p>\\n          <h2 className=\\\"mt-1 text-lg sm:text-xl font-semibold text-[#182215]\\\">\\n            Verify Auto / Vehicle Number &amp; Capture Photo\\n          </h2>\\n          <p className=\\\"mt-1 text-xs text-[#4B5844] max-w-2xl leading-relaxed\\\">\\n            Before boarding an auto-rickshaw, cab, or bike taxi, enter the registration number or snap a photo of the number plate. OurSafe reads the plate with AI, checks official Indian RTO state &amp; district codes for fake/tampered patterns, and automatically attaches the vehicle details to your guardian alerts &amp; SOS messages.\\n          </p>\\n        </div>\\n\\n        {(result || photoPreview) && (\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleReset}\\n            className=\\\"min-h-[38px] px-3 py-1.5 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] text-[#24371D] text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n          >\\n            <Trash2 className=\\\"w-3.5 h-3.5\\\" />\\n            <span>Clear Vehicle</span>\\n          </button>\\n        )}\\n      </div>\\n\\n      <form onSubmit={handleVerifySubmit} className=\\\"space-y-4\\\">\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-3.5 items-end\\\">\\n          <div className=\\\"lg:col-span-5\\\">\\n            <label\\n              htmlFor=\\\"vehicle-plate-input\\\"\\n              className=\\\"block text-xs font-semibold text-[#182215] mb-1.5\\\"\\n            >\\n              Auto / Cab Registration Number\\n            </label>\\n            <div className=\\\"relative\\\">\\n              <Car className=\\\"w-4 h-4 text-[#5D6C55] absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\\\" />\\n              <input\\n                id=\\\"vehicle-plate-input\\\"\\n                type=\\\"text\\\"\\n                value={plateInput}\\n                onChange={(e) => setPlateInput(e.target.value.toUpperCase())}\\n                placeholder=\\\"e.g. TN 09 AB 1234 or KA 01 MJ 4521\\\"\\n                className=\\\"w-full min-h-[46px] pl-9 pr-3 py-2 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm font-mono font-bold tracking-wider uppercase text-[#182215] placeholder:font-sans placeholder:font-normal placeholder:tracking-normal placeholder:normal-case placeholder:text-[#75856D] focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-4\\\">\\n            <label className=\\\"block text-xs font-semibold text-[#182215] mb-1.5\\\">\\n              Number Plate / Auto Photo (AI OCR)\\n            </label>\\n            <input\\n              ref={fileInputRef}\\n              type=\\\"file\\\"\\n              accept=\\\"image/*\\\"\\n              capture=\\\"environment\\\"\\n              onChange={handlePhotoChange}\\n              className=\\\"hidden\\\"\\n              id=\\\"vehicle-photo-upload\\\"\\n            />\\n            <div className=\\\"flex gap-2\\\">\\n              <label\\n                htmlFor=\\\"vehicle-photo-upload\\\"\\n                className=\\\"flex-1 min-h-[46px] px-3.5 py-2 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] border border-[#C5D2B7] text-[#24371D] text-xs font-semibold inline-flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n              >\\n                <Camera className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n                <span>{photoPreview ? \'Retake Plate Photo\' : \'Snap / Upload Photo\'}</span>\\n              </label>\\n              {photoPreview && (\\n                <img\\n                  src={photoPreview}\\n                  alt=\\\"Captured vehicle plate\\\"\\n                  className=\\\"w-12 h-[46px] rounded-xl object-cover border border-[#B8C6A8] shrink-0\\\"\\n                />\\n              )}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-3\\\">\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={busy}\\n              className=\\\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#2F4526] hover:bg-[#23351C] disabled:opacity-60 text-[#F6F9F2] text-sm font-semibold inline-flex items-center justify-center gap-2 cursor-pointer whitespace-nowrap\\\"\\n            >\\n              <FileSearch className=\\\"w-4 h-4\\\" />\\n              <span>{busy ? \'Verifying...\' : \'Verify Vehicle\'}</span>\\n            </button>\\n          </div>\\n        </div>\\n\\n        {error && (\\n          <p className=\\\"rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs font-medium text-red-700\\\">\\n            {error}\\n          </p>\\n        )}\\n      </form>\\n\\n      {/* Verification Audit Result */}\\n      {result && (\\n        <div\\n          className={`rounded-2xl border p-4 sm:p-5 space-y-3 ${\\n            isSuspicious\\n              ? \'bg-red-50 border-red-300\'\\n              : isVerified\\n                ? \'bg-emerald-50/80 border-emerald-300\'\\n                : \'bg-amber-50 border-amber-300\'\\n          }`}\\n        >\\n          <div className=\\\"flex flex-wrap items-start justify-between gap-3\\\">\\n            <div className=\\\"flex items-start gap-2.5\\\">\\n              {isSuspicious ? (\\n                <AlertTriangle className=\\\"w-5 h-5 text-red-600 shrink-0 mt-0.5\\\" />\\n              ) : isVerified ? (\\n                <ShieldCheck className=\\\"w-5 h-5 text-emerald-700 shrink-0 mt-0.5\\\" />\\n              ) : (\\n                <Upload className=\\\"w-5 h-5 text-amber-700 shrink-0 mt-0.5\\\" />\\n              )}\\n              <div>\\n                <p\\n                  className={`text-xs font-bold uppercase tracking-wider ${\\n                    isSuspicious\\n                      ? \'text-red-700\'\\n                      : isVerified\\n                        ? \'text-emerald-800\'\\n                        : \'text-amber-800\'\\n                  }`}\\n                >\\n                  {isSuspicious\\n                    ? \'Warning \302\267 Suspicious or Invalid Plate Format\'\\n                    : isVerified\\n                      ? \'RTO Registration Format Verified\'\\n                      : \'Unrecognized Plate Format \342\200\224 Verify Manually\'}\\n                  {result.extractedFromPhoto ? \' \302\267 Extracted via AI Photo OCR\' : \'\'}\\n                </p>\\n                <p className=\\\"mt-1 text-xl font-extrabold font-mono tracking-wider text-[#182215]\\\">\\n                  {result.normalizedNumber}\\n                </p>\\n              </div>\\n            </div>\\n\\n            <span className=\\\"text-[11px] font-mono tabular-nums text-[#4B5844]\\\">\\n              Checked {formatTimeShort(result.verifiedAt)}\\n            </span>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5 text-xs\\\">\\n            <div className=\\\"rounded-xl bg-white/80 border border-[#D4DFC8] px-3 py-2\\\">\\n              <span className=\\\"text-[#54634D]\\\">RTO State / Region: </span>\\n              <strong className=\\\"text-[#182215]\\\">{result.stateRegion}</strong>\\n            </div>\\n            <div className=\\\"rounded-xl bg-white/80 border border-[#D4DFC8] px-3 py-2\\\">\\n              <span className=\\\"text-[#54634D]\\\">Vehicle Type: </span>\\n              <strong className=\\\"text-[#182215]\\\">{result.vehicleType}</strong>\\n            </div>\\n          </div>\\n\\n          <p className=\\\"text-xs text-[#2D3B27] leading-relaxed\\\">\\n            {result.summary}\\n          </p>\\n\\n          {result.riskWarnings.length > 0 && (\\n            <div className=\\\"rounded-xl bg-red-100/80 border border-red-200 p-3 space-y-1\\\">\\n              {result.riskWarnings.map((warn, i) => (\\n                <p\\n                  key={i}\\n                  className=\\\"text-xs font-semibold text-red-900 flex items-start gap-1.5\\\"\\n                >\\n                  <AlertTriangle className=\\\"w-3.5 h-3.5 shrink-0 mt-0.5 text-red-700\\\" />\\n                  <span>{warn}</span>\\n                </p>\\n              ))}\\n            </div>\\n          )}\\n\\n          {isVerified && (\\n            <div className=\\\"flex items-center gap-1.5 text-xs font-semibold text-emerald-800\\\">\\n              <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600 shrink-0\\\" />\\n              <span>\\n                Attached to Travel Mode &amp; automatically included in Guardian SMS and SOS emergency alerts.\\n              </span>\\n            </div>\\n          )}\\n        </div>\\n      )}\\n    </section>\\n  );\\n};\\n\", \"Description\":\"Create VehicleVerificationCard for Auto/Cab plate verification and AI photo plate OCR inside Travel Mode\", \"Overwrite\":true, \"TargetFile\":\"/src/components/dashboard/VehicleVerificationCard.tsx\", \"toolAction\":\"Creating VehicleVerificationCard for Travel Mode\", \"toolSummary\":\"Create VehicleVerificationCard.tsx\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
