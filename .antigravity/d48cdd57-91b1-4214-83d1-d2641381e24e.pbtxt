      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add perfectly positioned viewport-anchored botanical canvas background and dark lock-screen wallpaper classes\", \"EndLine\":40, \"Instruction\":\"Add .oursafe-canvas-bg and .oursafe-lock-wallpaper utility styles to src/index.css\", \"ReplacementContent\":\".tabular-nums {\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n/* Perfectly placed, calm botanical ambient canvas anchored to the viewport */\\n.oursafe-canvas-bg {\\n  background-color: #C7D3BA;\\n  background-image:\\n    radial-gradient(ellipse 80% 55% at 12% 0%, rgba(246, 250, 241, 0.72) 0%, rgba(246, 250, 241, 0) 62%),\\n    radial-gradient(ellipse 70% 60% at 92% 8%, rgba(215, 228, 200, 0.85) 0%, rgba(215, 228, 200, 0) 65%),\\n    radial-gradient(ellipse 85% 65% at 50% 100%, rgba(167, 187, 149, 0.58) 0%, rgba(167, 187, 149, 0) 70%),\\n    radial-gradient(rgba(47, 69, 38, 0.055) 1px, transparent 1px);\\n  background-size: 100% 100%, 100% 100%, 100% 100%, 24px 24px;\\n  background-attachment: fixed;\\n  background-position: center top, right top, center bottom, 0 0;\\n}\\n\\n/* Minimal, authentic phone lock-screen twilight wallpaper (non-intrusive backdrop) */\\n.oursafe-lock-wallpaper {\\n  background-color: #090E09;\\n  background-image:\\n    radial-gradient(ellipse 75% 50% at 50% 18%, rgba(56, 86, 46, 0.42) 0%, rgba(12, 20, 11, 0) 70%),\\n    radial-gradient(ellipse 70% 55% at 85% 92%, rgba(35, 58, 30, 0.35) 0%, rgba(9, 14, 9, 0) 68%),\\n    linear-gradient(180deg, #0D150C 0%, #090E08 55%, #060906 100%);\\n  background-size: cover;\\n  background-position: center;\\n}\\n\\n@media (prefers-reduced-motion: reduce) {\\n  *, *::before, *::after {\\n    animation-duration: 0.01ms !important;\\n    animation-iteration-count: 1 !important;\\n    transition-duration: 0.01ms !important;\\n    scroll-behavior: auto !important;\\n  }\\n}\", \"StartLine\":28, \"TargetContent\":\".tabular-nums {\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n@media 