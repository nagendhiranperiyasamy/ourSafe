    end_line: 453
    content: "import React, { useCallback, useEffect, useState } from \'react\';\nimport {\n  CheckCircle2,\n  Download,\n  FileAudio,\n  FileVideo,\n  Lock,\n  Share2,\n  ShieldCheck,\n  Trash2,\n  Unlock,\n} from \'lucide-react\';\nimport {\n  EmergencyHistoryCategory,\n  EmergencyHistoryEntry,\n  UserProfile,\n} from \'../../types/safety\';\nimport {\n  clearUserRecordings,\n  deleteRecordingFromDb,\n  listUserRecordings,\n  StoredRecordingRecord,\n  updateRecordingSharedFlag,\n} from \'../../utils/evidenceDb\';\nimport { formatDateTimeShort } from \'../../utils/storage\';\n\ninterface EvidenceHistoryPageProps {\n  user: UserProfile;\n  entries: EmergencyHistoryEntry[];\n  onClearHistory: () => void;\n  onLogGuardianShare: (recordingId: string, kind: \'audio\' | \'video\') => void;\n}\n\nconst FILTER_OPTIONS: Array<{\n  id: \'all\' | EmergencyHistoryCategory;\n  label: string;\n}> = [\n  { id: \'all\', label: \'All Events\' },\n  { id: \'sos\', label: \'SOS\' },\n  { id: \'threat\', label: \'Threat Mode\' },\n  { id: \'recording\', label: \'Recordings\' },\n  { id: \'location\', label: \'Location\' },\n  { id: \'connectivity\', label: \'Connectivity\' },\n  { id: \'guardian\', label: \'Guardian\' },\n];\n\nfunction formatBytes(bytes: number): string {\n  if (bytes < 1024) return `${bytes} B`;\n  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;\n  return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;\n}\n\nexport const EvidenceHistoryPage: React.FC<EvidenceHistoryPageProps> = ({\n  user,\n  entries,\n  onClearHistory,\n  onLogGuardianShare,\n}) => {\n  const [unlocked, setUnlocked] = useState(false);\n  const [passwordInput, setPasswordInput] = useState(\'\');\n  const [unlockError, setUnlockError] = useState(\'\');\n\n  const [filter, setFilter] = useState<\'all\' | EmergencyHistoryCategory>(\'all\');\n  const [recordings, setRecordings] = useState<\n    Array<StoredRecordingRecord & { objectUrl: string }>\n  >([]);\n  const [loadingRecs, setLoadingRecs] = useState(false);\n  const [statusMessage, setStatusMessage] = useState(\'\');\n\n  const loadRecordings = useCallback(async () => {\n    setLoadingRecs(true);\n    try {\n      const items = await listUserRecordings(user.id);\n      setRecordings((prev) => {\n        prev.forEach((p) => URL.revokeObjectURL(p.objectUrl));\n        return items.map((item) => ({\n          ...item,\n          objectUrl: URL.createObjectURL(item.blob),\n        }));\n      });\n    } catch {\n      // IndexedDB unavailable\n    } finally {\n      setLoadingRecs(false);\n    }\n  }, [user.id]);\n\n  useEffect(() => {\n    if (unlocked) {\n      loadRecordings();\n    }\n    return () => {\n      setRecordings((prev) => {\n        prev.forEach((p) => URL.revokeObjectURL(p.objectUrl));\n        return [];\n      });\n    };\n  }, [unlocked, loadRecordings]);\n\n  const handleUnlock = (e: React.FormEvent) => {\n    e.preventDefault();\n    setUnlockError(\'\');\n    if (passwordInput !== user.password) {\n      setUnlockError(\n        \'Incorrect account password. Access to recordings and emergency history is restricted to the authorized account holder.\'\n      );\n      return;\n    }\n    setUnlocked(true);\n    setPasswordInput(\'\');\n  };\n\n  const handleDeleteRecording = async (id: string) => {\n    try {\n      await deleteRecordingFromDb(id);\n      setRecordings((prev) => {\n        const target = prev.find((p) => p.id === id);\n        if (target) URL.revokeObjectURL(target.objectUrl);\n        return prev.filter((p) => p.id !== id);\n      });\n      setStatusMessage(\'Recording permanently deleted from local device storage.\');\n      window.setTimeout(() => setStatusMessage(\'\'), 3000);\n    } catch {\n      setStatusMessage(\'Unable to delete recording.\');\n    }\n  };\n\n  const handleShareRecording = async (\n    rec: StoredRecordingRecord & { objectUrl: string }\n  ) => {\n    await updateRecordingSharedFlag(rec.id, true);\n    setRecordings((prev) =>\n      prev.map((item) =>\n        item.id === rec.id ? { ...item, sharedWithGuardians: true } : item\n      )\n    );\n    onLogGuardianShare(rec.id, rec.kind);\n    setStatusMessage(\n      `Prepared guardian evidence package for ${user.sosContacts.length} authorized contact(s).`\n    );\n    window.setTimeout(() => setStatusMessage(\'\'), 3500);\n  };\n\n  const handleClearAllData = async () => {\n    await clearUserRecordings(user.id).catch(() => {});\n    recordings.forEach((r) => URL.revokeObjectURL(r.objectUrl));\n    setRecordings([]);\n    onClearHistory();\n    setStatusMessage(\'All local emergency history and recordings have been erased.\');\n    window.setTimeout(() => setStatusMessage(\'\'), 3500);\n  };\n\n  const handleExportTimeline = () => {\n    const payload = {\n      exportedAt: new Date().toISOString(),\n      accountHolder: user.fullName,\n      guardians: user.sosContacts.map((c) => ({\n        name: c.name,\n        phone: c.phone,\n        relation: c.relation,\n      })),\n      recordingsCount: recordings.length,\n      timeline: entries,\n    };\n    const blob = new Blob([JSON.stringify(payload, null, 2)], {\n      type: \'application/json\',\n    });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.download = `aurasafe-emergency-history-${new Date().toISOString().slice(0, 10)}.json`;\n    link.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const filteredEntries =\n    filter === \'all\' ? entries : entries.filter((e) => e.category === filter);\n\n  if (!unlocked) {\n    return (\n      <section className=\"max-w-lg mx-auto bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-8 shadow-sm space-y-5\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-12 h-12 rounded-2xl bg-[#F4F0FF] text-violet-700 flex items-center justify-center shrink-0\">\n            <Lock className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Privacy &amp; Access Protection\n            </p>\n            <h1 className=\"text-xl font-bold text-[#1A132B]\">\n              Emergency Evidence History Locked\n            </h1>\n          </div>\n        </div>\n\n        <p className=\"text-sm text-[#4A4063] leading-relaxed\">\n          To protect your privacy, access to audio/video recordings, GPS timelines, and emergency alerts requires your account password before viewing.\n        </p>\n\n        {unlockError && (\n          <p className=\"rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs font-medium text-red-700\">\n            {unlockError}\n          </p>\n        )}\n\n        <form onSubmit={handleUnlock} className=\"space-y-3.5\">\n          <div>\n            <label\n              htmlFor=\"history-unlock-password\"\n              className=\"block text-xs font-semibold text-[#1A132B] mb-1\"\n            >\n              Account Password\n            </label>\n            <input\n              id=\"history-unlock-password\"\n              type=\"password\"\n              value={passwordInput}\n              onChange={(e) => setPasswordInput(e.target.value)}\n              placeholder=\"Enter your AuraSafe password\"\n              className=\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n            />\n          </div>\n\n          <button\n            type=\"submit\"\n            className=\"w-full min-h-[46px] px-5 py-2.5 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold inline-flex items-center justify-center gap-2 cursor-pointer\"\n          >\n            <Unlock className=\"w-4 h-4\" />\n            <span>Unlock Evidence History</span>\n          </button>\n        </form>\n      </section>\n    );\n  }\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header & Data Management Bar */}\n      <section className=\"bg-white rounded-3xl border border-violet-200/80 p-6 flex flex-wrap items-start justify-between gap-4\">\n        <div>\n          <p className=\"text-xs font-semibold text-violet-700\">\n            Authorized Access Unlocked \302\267 Local Encrypted-Access Prototype\n          </p>\n          <h1 className=\"mt-1 text-2xl font-bold text-[#1A132B]\">\n            Emergency Evidence &amp; Timeline History\n          </h1>\n          <p className=\"mt-1 text-xs text-[#574E6B]\">\n            Review Threat Mode activations, SOS alerts, GPS snapshots, connectivity events, and saved audio/video recordings.\n          </p>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={handleExportTimeline}\n            className=\"min-h-[40px] px-3.5 py-2 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\"\n          >\n            <Download className=\"w-3.5 h-3.5\" />\n            <span>Export Report</span>\n          </button>\n          <button\n            type=\"button\"\n            onClick={handleClearAllData}\n            className=\"min-h-[40px] px-3.5 py-2 rounded-xl bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\"\n          >\n            <Trash2 className=\"w-3.5 h-3.5\" />\n            <span>Erase All Data</span>\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setUnlocked(false)}\n            className=\"min-h-[40px] px-3.5 py-2 rounded-xl bg-white hover:bg-[#FAF8FF] border border-violet-200 text-[#1A132B] text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\"\n          >\n            <Lock className=\"w-3.5 h-3.5\" />\n            <span>Lock</span>\n          </button>\n        </div>\n      </section>\n\n      {statusMessage && (\n        <div className=\"rounded-2xl bg-emerald-50 border border-emerald-200 px-4 py-3 text-xs font-medium text-emerald-800 flex items-center gap-2\">\n          <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n          <span>{statusMessage}</span>\n        </div>\n      )}\n\n      {/* Recorded Audio / Video Evidence Vault */}\n      <section className=\"bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\">\n        <div className=\"flex items-center justify-between gap-3\">\n          <div>\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Local Media Vault ({recordings.length})\n            </p>\n            <h2 className=\"mt-0.5 text-lg font-bold text-[#1A132B]\">\n              Threat Mode Audio &amp; Video Recordings\n            </h2>\n          </div>\n        </div>\n\n        {loadingRecs ? (\n          <p className=\"text-xs text-[#6B6182]\">Loading local recordings...</p>\n        ) : recordings.length === 0 ? (\n          <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-5 text-xs text-[#6B6182]\">\n            No audio or video recordings saved yet. Start a recording inside Threat Mode to capture local evidence.\n          </div>\n        ) : (\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n            {recordings.map((rec) => (\n              <div\n                key={rec.id}\n                className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/80 p-4 space-y-3\"\n              >\n                <div className=\"flex items-start justify-between gap-2\">\n                  <div className=\"flex items-center gap-2 text-sm font-bold text-[#1A132B]\">\n                    {rec.kind === \'video\' ? (\n                      <FileVideo className=\"w-4 h-4 text-violet-700 shrink-0\" />\n                    ) : (\n                      <FileAudio className=\"w-4 h-4 text-violet-700 shrink-0\" />\n                    )}\n                    <span>\n                      {rec.kind === \'video\' ? \'Video Evidence\' : \'Audio Evidence\'}\n                    </span>\n                  </div>\n                  <span className=\"text-[11px] font-mono tabular-nums text-[#6B6182]\">\n                    {rec.durationSec}s \302\267 {formatBytes(rec.sizeBytes)}\n                  </span>\n                </div>\n\n                <p className=\"text-xs text-[#574E6B] tabular-nums\">\n                  Captured {formatDateTimeShort(rec.createdAt)}\n                  {rec.locationCoords ? ` \302\267 GPS ${rec.locationCoords}` : \'\'}\n                </p>\n\n                {rec.kind === \'video\' ? (\n                  <video\n                    src={rec.objectUrl}\n                    controls\n                    className=\"w-full rounded-xl bg-black max-h-48\"\n                  />\n                ) : (\n                  <audio src={rec.objectUrl} controls className=\"w-full\" />\n                )}\n\n                <div className=\"flex flex-wrap items-center justify-between gap-2 pt-1\">\n                  <button\n                    type=\"button\"\n                    onClick={() => handleShareRecording(rec)}\n                    className=\"min-h-[38px] px-3 py-1.5 rounded-xl bg-white hover:bg-violet-50 border border-violet-200 text-violet-900 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer\"\n                  >\n                    <Share2 className=\"w-3.5 h-3.5\" />\n                    <span>\n                      {rec.sharedWithGuardians\n                        ? \'Shared with Guardians (Demo)\'\n                        : \'Share with Guardians\'}\n                    </span>\n                  </button>\n\n                  <div className=\"flex items-center gap-1.5\">\n                    <a\n                      href={rec.objectUrl}\n                      download={`aurasafe-${rec.kind}-${rec.id}.webm`}\n                      className=\"min-h-[38px] px-3 py-1.5 rounded-xl bg-white hover:bg-violet-50 border border-violet-200 text-[#1A132B] text-xs font-semibold inline-flex items-center gap-1\"\n                    >\n                      <Download className=\"w-3.5 h-3.5\" />\n                      <span>Save</span>\n                    </a>\n                    <button\n                      type=\"button\"\n                      onClick={() => handleDeleteRecording(rec.id)}\n                      aria-label=\"Delete recording permanently\"\n                      className=\"min-h-[38px] px-3 py-1.5 rounded-xl bg-red-50 hover:bg-red-100 text-red-700 text-xs font-semibold inline-flex items-center gap-1 cursor-pointer\"\n                    >\n                      <Trash2 className=\"w-3.5 h-3.5\" />\n                      <span>Delete</span>\n                    </button>\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </section>\n\n      {/* Complete Emergency Event Timeline */}\n      <section className=\"bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\">\n        <div className=\"flex flex-wrap items-center justify-between gap-3\">\n          <div>\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Chronological Event Log ({filteredEntries.length})\n            </p>\n            <h2 className=\"mt-0.5 text-lg font-bold text-[#1A132B]\">\n              Emergency Activity Timeline\n            </h2>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-1 p-1 rounded-xl bg-[#F4F0FF] border border-violet-200/70\">\n            {FILTER_OPTIONS.map((opt) => (\n              <button\n                key={opt.id}\n                type=\"button\"\n                onClick={() => setFilter(opt.id)}\n                className={`min-h-[34px] px-2.5 py-1 rounded-lg text-xs font-semibold transition-colors cursor-pointer whitespace-nowrap ${\n                  filter === opt.id\n                    ? \'bg-white text-violet-900 shadow-sm\'\n                    : \'text-[#574E6B] hover:text-[#1A132B]\'\n                }`}\n              >\n                {opt.label}\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {filteredEntries.length === 0 ? (\n          <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-6 text-center text-xs text-[#6B6182]\">\n            No events recorded for this filter yet. Activating Threat Mode, triggering SOS, or running a Safety Check-In logs full timestamps and status updates here.\n          </div>\n        ) : (\n          <div className=\"divide-y divide-violet-100 border border-violet-200/70 rounded-2xl overflow-hidden\">\n            {filteredEntries.map((item) => (\n              <div key={item.id} className=\"p-4 bg-white space-y-1.5\">\n                <div className=\"flex flex-wrap items-baseline justify-between gap-2\">\n                  <div className=\"flex flex-wrap items-center gap-2\">\n                    <ShieldCheck className=\"w-4 h-4 text-violet-700 shrink-0\" />\n                    <span className=\"text-sm font-bold text-[#1A132B]\">\n                      {item.title}\n                    </span>\n                    {item.statusLabel && (\n                      <span className=\"text-xs font-semibold text-violet-700\">\n                        \302\267 {item.statusLabel}\n                      </span>\n                    )}\n                  </div>\n                  <span className=\"text-xs font-mono tabular-nums text-[#6B6182]\">\n                    {formatDateTimeShort(item.timestamp)}\n                  </span>\n                </div>\n                <p className=\"text-xs text-[#4A4063] leading-relaxed\">\n                  {item.detail}\n                </p>\n                {item.locationCoords && (\n                  <p className=\"text-[11px] font-mono tabular-nums text-[#6B6182]\">\n                    Location snapshot: {item.locationCoords}\n                  </p>\n                )}\n              </div>\n            ))}\n          </div>\n        )}\n      </section>\n    </div>\n  );\n};\n"
    num_lines: 454
    num_bytes: 17531
    line_range_bytes: 17531
  }
}
