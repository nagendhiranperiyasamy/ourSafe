          target_content: "import { useEmergencyQuickTriggers } from \'../hooks/useEmergencyQuickTriggers\';\nimport {\n  getEmergencyHistory,\n  getNotifications,\n  getSafetyCheckIn,\n  getThreatSession,\n  getTravelSession,\n  saveEmergencyHistory,\n  saveNotifications,\n  saveSafetyCheckIn,\n  saveThreatSession,\n  saveTravelSession,\n} from \'../utils/storage\';\nimport { BrandLogo } from \'./BrandLogo\';\nimport { EmergencyLockScreenShield } from \'./EmergencyLockScreenShield\';\nimport { EmergencyTriggerOverlay } from \'./EmergencyTriggerOverlay\';"
          replacement_content: "import { useEmergencyQuickTriggers } from \'../hooks/useEmergencyQuickTriggers\';\nimport {\n  buildNativeSyncPayload,\n  isRunningInNativeAndroidApp,\n  startNativeLockAndHomeShield,\n  subscribeNativeSosTriggers,\n  syncNativeLockAndHomeShield,\n} from \'../utils/nativeShieldBridge\';\nimport {\n  getEmergencyHistory,\n  getNotifications,\n  getSafetyCheckIn,\n  getThreatSession,\n  getTravelSession,\n  saveEmergencyHistory,\n  saveNotifications,\n  saveSafetyCheckIn,\n  saveThreatSession,\n  saveTravelSession,\n} from \'../utils/storage\';\nimport { BrandLogo } from \'./BrandLogo\';\nimport { EmergencyLockScreenShield } from \'./EmergencyLockScreenShield\';\nimport { EmergencyTriggerOverlay } from \'./EmergencyTriggerOverlay\';\nimport { PWAInstallButton } from \'./PWAInstallButton\';"
