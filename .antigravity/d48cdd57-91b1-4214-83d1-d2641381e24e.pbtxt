    tool_calls {
      id: "call_4683307059967637973"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  AlertTriangle,\\n  ArrowRight,\\n  CheckCircle2,\\n  Compass,\\n  History,\\n  MapPin,\\n  Mic,\\n  Pencil,\\n  Phone,\\n  ShieldAlert,\\n  ShieldCheck,\\n  Star,\\n  Users,\\n} from \'lucide-react\';\\nimport { AppPage, TeamInfoConfig, UserReviewItem } from \'../../types/safety\';\\nimport {\\n  formatTimeShort,\\n  getReviews,\\n  getTeamInfo,\\n  saveReviews,\\n  saveTeamInfo,\\n} from \'../../utils/storage\';\\n\\ninterface HomeAboutPageProps {\\n  userName: string;\\n  onNavigatePage: (page: AppPage) => void;\\n  onOpenContacts: () => void;\\n}\\n\\nconst EMERGENCY_HELP_NUMBERS = [\\n  {\\n    number: \'112\',\\n    label: \'Emergency Response\',\\n    detail: \'All-in-one national emergency helpline (Police, Fire, Medical)\',\\n  },\\n  {\\n    number: \'181\',\\n    label: \'Women Helpline\',\\n    detail: \'24/7 support and emergency intervention for women in distress\',\\n  },\\n  {\\n    number: \'100\',\\n    label: \'Police\',\\n    detail: \'Direct police control room dispatch\',\\n  },\\n  {\\n    number: \'108\',\\n    label: \'Ambulance\',\\n    detail: \'Emergency medical response and ambulance service\',\\n  },\\n  {\\n    number: \'1098\',\\n    label: \'Child Helpline\',\\n    detail: \'24/7 emergency assistance for children in need of care and protection\',\\n  },\\n];\\n\\nconst FEATURE_OVERVIEW: Array<{\\n  title: string;\\n  description: string;\\n  page: AppPage;\\n  icon: React.ReactNode;\\n}> = [\\n  {\\n    title: \'AI Voice App Controller\',\\n    description:\\n      \'Speak naturally in real time to open SOS, activate Threat Mode, call guardians, share live location, or locate nearby police stations.\',\\n    page: \'assistant\',\\n    icon: <Mic className=\\\"w-5 h-5\\\" />,\\n  },\\n  {\\n    title: \'SOS Emergency Workflow\',\\n    description:\\n      \'One-tap or voice-triggered emergency interface with guardian calling, location alert dispatch, nearest police options, and delivery status tracking.\',\\n    page: \'sos\',\\n    icon: <ShieldAlert className=\\\"w-5 h-5\\\" />,\\n  },\\n  {\\n    title: \'Intelligent Threat Mode\',\\n    description:\\n      \'Discreet protection with audio/video evidence recording, instant guardian notifications, and connectivity/battery continuity snapshots.\',\\n    page: \'threat\',\\n    icon: <AlertTriangle className=\\\"w-5 h-5\\\" />,\\n  },\\n  {\\n    title: \'Travel Mode & Safety Check-In\',\\n    description:\\n      \'Log your journey route, set timed safety check-ins that alert guardians if missed, and trigger a realistic Fake Call when needed.\',\\n    page: \'travel\',\\n    icon: <Compass className=\\\"w-5 h-5\\\" />,\\n  },\\n  {\\n    title: \'Nearby Police & Safe Places\',\\n    description:\\n      \'Locate verified nearby police stations and public restrooms using live browser GPS coordinates without fabricated mock pins.\',\\n    page: \'nearby\',\\n    icon: <MapPin className=\\\"w-5 h-5\\\" />,\\n  },\\n  {\\n    title: \'Emergency Evidence History\',\\n    description:\\n      \'Access-protected timeline storing Threat Mode activations, SOS alerts, GPS snapshots, connectivity events, and local recordings.\',\\n    page: \'history\',\\n    icon: <History className=\\\"w-5 h-5\\\" />,\\n  },\\n];\\n\\nconst WORKFLOW_STEPS = [\\n  {\\n    step: \'01\',\\n    title: \'Register & Verify Profile\',\\n    detail:\\n      \'Create your local safety profile with personal details and primary guardian contact information.\',\\n  },\\n  {\\n    step: \'02\',\\n    title: \'Build Your Trusted Guardian Network\',\\n    detail:\\n      \'Add multiple family members or close friends to your SOS contacts list\342\200\224cached locally so numbers stay reachable offline.\',\\n  },\\n  {\\n    step: \'03\',\\n    title: \'Activate Travel Mode or Safety Check-In\',\\n    detail:\\n      \'Before commuting or walking alone, record your destination, assign a guardian, and set an automatic check-in countdown.\',\\n  },\\n  {\\n    step: \'04\',\\n    title: \'Engage Threat Mode Early\',\\n    detail:\\n      \'If a situation feels unsafe, activate Threat Mode to notify guardians, record audio/video evidence locally, and preserve last-known GPS snapshots.\',\\n  },\\n  {\\n    step: \'05\',\\n    title: \'Trigger SOS by Voice or Tap\',\\n    detail:\\n      \'Say \\\"Open SOS\\\" to the AI Voice Assistant or press SOS directly to initiate guardian alerts, dial trusted contacts, and reach police quickly.\',\\n  },\\n];\\n\\nexport const HomeAboutPage: React.FC<HomeAboutPageProps> = ({\\n  userName,\\n  onNavigatePage,\\n  onOpenContacts,\\n}) => {\\n  const [reviews, setReviews] = useState<UserReviewItem[]>(() => getReviews());\\n  const [reviewAuthor, setReviewAuthor] = useState(userName);\\n  const [reviewRole, setReviewRole] = useState(\'\');\\n  const [reviewRating, setReviewRating] = useState(5);\\n  const [reviewComment, setReviewComment] = useState(\'\');\\n  const [reviewFeedback, setReviewFeedback] = useState(\'\');\\n\\n  const [teamInfo, setTeamInfo] = useState<TeamInfoConfig>(() => getTeamInfo());\\n  const [editingTeam, setEditingTeam] = useState(false);\\n  const [teamDraft, setTeamDraft] = useState<TeamInfoConfig>(teamInfo);\\n\\n  const averageRating =\\n    reviews.length > 0\\n      ? (\\n          reviews.reduce((sum, r) => sum + r.rating, 0) / reviews.length\\n        ).toFixed(1)\\n      : \'0.0\';\\n\\n  const handleReviewSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!reviewAuthor.trim() || !reviewComment.trim()) return;\\n    const nextItem: UserReviewItem = {\\n      id: `user-rev-${Date.now()}`,\\n      author: reviewAuthor.trim(),\\n      role: reviewRole.trim() || \'App User Feedback\',\\n      rating: reviewRating,\\n      comment: reviewComment.trim(),\\n      createdAt: new Date().toISOString(),\\n      isSample: false,\\n    };\\n    const next = [nextItem, ...reviews];\\n    setReviews(next);\\n    saveReviews(next);\\n    setReviewComment(\'\');\\n    setReviewRole(\'\');\\n    setReviewFeedback(\'Thank you. Your feedback has been saved locally.\');\\n    window.setTimeout(() => setReviewFeedback(\'\'), 3500);\\n  };\\n\\n  const handleSaveTeam = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setTeamInfo(teamDraft);\\n    saveTeamInfo(teamDraft);\\n    setEditingTeam(false);\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-8\\\">\\n      {/* Section 1: About the Application Hero */}\\n      <section className=\\\"bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-8 lg:p-10 shadow-sm shadow-violet-950/[0.02]\\\">\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\\\">\\n          <div className=\\\"lg:col-span-7 space-y-4\\\">\\n            <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n              About AuraSafe \302\267 Prevention, Protection &amp; Rapid Response\\n            </p>\\n            <h1 className=\\\"text-3xl sm:text-4xl font-bold text-[#1A132B] leading-[1.15] tracking-tight\\\">\\n              Intelligent personal safety designed around calm, fast action.\\n            </h1>\\n            <p className=\\\"text-sm sm:text-base text-[#4A4063] leading-relaxed\\\">\\n              AuraSafe is an AI-powered women&apos;s safety companion built to reduce friction during stressful moments. Whether you are commuting late, walking through an unfamiliar neighborhood, or facing an urgent threat, AuraSafe keeps voice-activated controls, trusted guardians, and emergency evidence tools immediately accessible.\\n            </p>\\n\\n            <div className=\\\"pt-2 flex flex-wrap items-center gap-3\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigatePage(\'assistant\')}\\n                className=\\\"min-h-[46px] px-5 py-2.5 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold inline-flex items-center gap-2 transition-colors whitespace-nowrap cursor-pointer\\\"\\n              >\\n                <Mic className=\\\"w-4 h-4\\\" />\\n                <span>Open AI Voice Controller</span>\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onNavigatePage(\'sos\')}\\n                className=\\\"min-h-[46px] px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-semibold inline-flex items-center gap-2 transition-colors whitespace-nowrap cursor-pointer\\\"\\n              >\\n                <ShieldAlert className=\\\"w-4 h-4\\\" />\\n                <span>Open SOS Emergency</span>\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onOpenContacts}\\n                className=\\\"min-h-[46px] px-5 py-2.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-sm font-semibold inline-flex items-center gap-2 transition-colors whitespace-nowrap cursor-pointer\\\"\\n              >\\n                <Users className=\\\"w-4 h-4 text-violet-700\\\" />\\n                <span>Trusted Guardians</span>\\n              </button>\\n            </div>\\n          </div>\\n\\n          {/* Problems Solved & Safety Pillars */}\\n          <div className=\\\"lg:col-span-5 rounded-2xl bg-[#FAF8FF] border border-violet-200/80 p-5 sm:p-6 space-y-4\\\">\\n            <h2 className=\\\"text-base font-bold text-[#1A132B]\\\">\\n              Problems AuraSafe Solves\\n            </h2>\\n            <ul className=\\\"space-y-3 text-sm text-[#4A4063]\\\">\\n              <li className=\\\"space-y-0.5\\\">\\n                <p className=\\\"font-semibold text-[#1A132B]\\\">\\n                  1. Prevention before escalation\\n                </p>\\n                <p className=\\\"text-xs leading-relaxed\\\">\\n                  Travel Mode, timed Safety Check-Ins, and the discreet Fake Call tool help women exit uncomfortable situations before they turn dangerous.\\n                </p>\\n              </li>\\n              <li className=\\\"space-y-0.5 pt-2 border-t border-violet-100\\\">\\n                <p className=\\\"font-semibold text-[#1A132B]\\\">\\n                  2. Hands-free protection under stress\\n                </p>\\n                <p className=\\\"text-xs leading-relaxed\\\">\\n                  Navigating small menus during panic is difficult. Real-time AI voice commands let users trigger SOS, Threat Mode, or live location sharing by speaking naturally.\\n                </p>\\n              </li>\\n              <li className=\\\"space-y-0.5 pt-2 border-t border-violet-100\\\">\\n                <p className=\\\"font-semibold text-[#1A132B]\\\">\\n                  3. Preserved response &amp; evidence timeline\\n                </p>\\n                <p className=\\\"text-xs leading-relaxed\\\">\\n                  Threat Mode captures local audio/video recordings, tracks connectivity and last known GPS coordinates, and preserves an organized timeline for guardians.\\n                </p>\\n              </li>\\n            </ul>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Section 2: Application Features Overview */}\\n      <section className=\\\"space-y-4\\\">\\n        <div className=\\\"flex flex-wrap items-end justify-between gap-3\\\">\\n          <div>\\n            <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n              Dedicated Safety Modules\\n            </p>\\n            <h2 className=\\\"mt-1 text-2xl font-bold text-[#1A132B]\\\">\\n              Application Features\\n            </h2>\\n          </div>\\n          <p className=\\\"text-xs text-[#6B6182]\\\">\\n            Select any module to open its dedicated page\\n          </p>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\\\">\\n          {FEATURE_OVERVIEW.map((feat) => (\\n            <button\\n              key={feat.title}\\n              type=\\\"button\\\"\\n              onClick={() => onNavigatePage(feat.page)}\\n              className=\\\"group text-left bg-white hover:bg-[#FAF8FF] rounded-2xl border border-violet-200/80 p-5 flex flex-col justify-between gap-4 transition-colors cursor-pointer\\\"\\n            >\\n              <div className=\\\"space-y-3\\\">\\n                <div className=\\\"w-10 h-10 rounded-xl bg-[#F4F0FF] text-violet-700 flex items-center justify-center\\\">\\n                  {feat.icon}\\n                </div>\\n                <div>\\n                  <h3 className=\\\"text-base font-bold text-[#1A132B] group-hover:text-violet-800 transition-colors\\\">\\n                    {feat.title}\\n                  </h3>\\n                  <p className=\\\"mt-1.5 text-xs text-[#574E6B] leading-relaxed\\\">\\n                    {feat.description}\\n                  </p>\\n                </div>\\n              </div>\\n              <span className=\\\"inline-flex items-center gap-1.5 text-xs font-semibold text-violet-700\\\">\\n                <span>Open Module</span>\\n                <ArrowRight className=\\\"w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5\\\" />\\n              </span>\\n            </button>\\n          ))}\\n        </div>\\n      </section>\\n\\n      {/* Section 3: How It Works (Step-by-step) */}\\n      <section className=\\\"bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-8 shadow-sm shadow-violet-950/[0.02]\\\">\\n        <div className=\\\"mb-6\\\">\\n          <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n            Step-by-Step Safety Workflow\\n          </p>\\n          <h2 className=\\\"mt-1 text-2xl font-bold text-[#1A132B]\\\">\\n            How AuraSafe Works\\n          </h2>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-5 gap-4\\\">\\n          {WORKFLOW_STEPS.map((item) => (\\n            <div\\n              key={item.step}\\n              className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-4 flex flex-col gap-2\\\"\\n            >\\n              <span className=\\\"text-xs font-mono font-bold text-violet-700 tabular-nums\\\">\\n                {item.step}.\\n              </span>\\n              <h3 className=\\\"text-sm font-bold text-[#1A132B] leading-snug\\\">\\n                {item.title}\\n              </h3>\\n              <p className=\\\"text-xs text-[#574E6B] leading-relaxed\\\">\\n                {item.detail}\\n              </p>\\n            </div>\\n          ))}\\n        </div>\\n      </section>\\n\\n      {/* Section 4: Emergency Help Numbers (112, 181, 100, 108, 1098) */}\\n      <section className=\\\"bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-8 shadow-sm shadow-violet-950/[0.02]\\\">\\n        <div className=\\\"flex flex-wrap items-start justify-between gap-4 mb-5\\\">\\n          <div>\\n            <p className=\\\"text-xs font-semibold text-red-700\\\">\\n              Direct Emergency Assistance \302\267 Works Offline via Device Dialer\\n            </p>\\n            <h2 className=\\\"mt-1 text-2xl font-bold text-[#1A132B]\\\">\\n              Emergency Help Numbers\\n            </h2>\\n          </div>\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => onNavigatePage(\'sos\')}\\n            className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n          >\\n            <ShieldAlert className=\\\"w-4 h-4\\\" />\\n            <span>Go to SOS Page</span>\\n          </button>\\n        </div>\\n\\n        <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5\\\">\\n          {EMERGENCY_HELP_NUMBERS.map((item) => (\\n            <div\\n              key={item.number}\\n              className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/80 p-4 flex flex-col justify-between gap-4\\\"\\n            >\\n              <div>\\n                <p className=\\\"text-2xl font-bold font-mono tabular-nums text-[#1A132B]\\\">\\n                  {item.number}\\n                </p>\\n                <p className=\\\"mt-1 text-sm font-bold text-violet-900\\\">\\n                  {item.label}\\n                </p>\\n                <p className=\\\"mt-1 text-xs text-[#574E6B] leading-relaxed\\\">\\n                  {item.detail}\\n                </p>\\n              </div>\\n\\n              <a\\n                href={`tel:${item.number}`}\\n                className=\\\"w-full min-h-[42px] px-3 py-2 rounded-xl bg-white hover:bg-red-600 hover:text-white hover:border-red-600 border border-violet-200 text-[#1A132B] text-xs font-semibold inline-flex items-center justify-center gap-1.5 transition-colors whitespace-nowrap\\\"\\n              >\\n                <Phone className=\\\"w-3.5 h-3.5\\\" />\\n                <span>Call {item.number}</span>\\n              </a>\\n            </div>\\n          ))}\\n        </div>\\n      </section>\\n\\n      {/* Section 5: User Reviews & Feedback */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n        <div className=\\\"lg:col-span-7 bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-7 space-y-5\\\">\\n          <div className=\\\"flex flex-wrap items-baseline justify-between gap-2\\\">\\n            <div>\\n              <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n                Community Feedback \302\267 Includes Clearly Labelled Sample Reviews\\n              </p>\\n              <h2 className=\\\"mt-1 text-2xl font-bold text-[#1A132B]\\\">\\n                User Reviews &amp; Ratings\\n              </h2>\\n            </div>\\n            <div className=\\\"text-sm font-bold text-[#1A132B] tabular-nums flex items-center gap-1.5\\\">\\n              <Star className=\\\"w-4 h-4 fill-amber-400 text-amber-500\\\" />\\n              <span>{averageRating} / 5.0</span>\\n              <span className=\\\"text-xs font-normal text-[#6B6182]\\\">\\n                ({reviews.length} reviews)\\n              </span>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"divide-y divide-violet-100\\\">\\n            {reviews.map((rev) => (\\n              <article key={rev.id} className=\\\"py-4 first:pt-0 last:pb-0 space-y-2\\\">\\n                <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                  <div>\\n                    <p className=\\\"text-sm font-bold text-[#1A132B]\\\">\\n                      {rev.author}\\n                    </p>\\n                    <p className=\\\"text-xs text-[#6B6182]\\\">\\n                      {rev.role}\\n                      {rev.isSample ? \' \302\267 Sample Prototype Entry\' : \' \302\267 Submitted Locally\'}\\n                      {\' \302\267 \'}\\n                      {formatTimeShort(rev.createdAt)}\\n                    </p>\\n                  </div>\\n                  <div\\n                    aria-label={`${rev.rating} out of 5 stars`}\\n                    className=\\\"flex items-center gap-0.5 text-amber-500\\\"\\n                  >\\n                    {Array.from({ length: 5 }).map((_, idx) => (\\n                      <Star\\n                        key={idx}\\n                        className={`w-3.5 h-3.5 ${\\n                          idx < rev.rating ? \'fill-amber-400 text-amber-500\' : \'text-violet-200\'\\n                        }`}\\n                      />\\n                    ))}\\n                  </div>\\n                </div>\\n                <p className=\\\"text-sm text-[#4A4063] leading-relaxed\\\">\\n                  &ldquo;{rev.comment}&rdquo;\\n                </p>\\n              </article>\\n            ))}\\n          </div>\\n        </div>\\n\\n        {/* Submit Feedback Form */}\\n        <div className=\\\"lg:col-span-5 bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-7 space-y-4\\\">\\n          <div>\\n            <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n              Share Your Experience\\n            </p>\\n            <h3 className=\\\"mt-1 text-xl font-bold text-[#1A132B]\\\">\\n              Submit Prototype Feedback\\n            </h3>\\n          </div>\\n\\n          {reviewFeedback && (\\n            <div className=\\\"rounded-xl bg-emerald-50 border border-emerald-200 px-3.5 py-2.5 text-xs font-medium text-emerald-800 flex items-center gap-2\\\">\\n              <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600 shrink-0\\\" />\\n              <span>{reviewFeedback}</span>\\n            </div>\\n          )}\\n\\n          <form onSubmit={handleReviewSubmit} className=\\\"space-y-3.5\\\">\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-[#1A132B] mb-1\\\">\\n                Your Name\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                required\\n                value={reviewAuthor}\\n                onChange={(e) => setReviewAuthor(e.target.value)}\\n                placeholder=\\\"Enter your name\\\"\\n                className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-[#1A132B] mb-1\\\">\\n                Role or Context (Optional)\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={reviewRole}\\n                onChange={(e) => setReviewRole(e.target.value)}\\n                placeholder=\\\"e.g. Daily Commuter, Parent, Student\\\"\\n                className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <span className=\\\"block text-xs font-semibold text-[#1A132B] mb-1.5\\\">\\n                Rating\\n              </span>\\n              <div className=\\\"flex items-center gap-1.5\\\">\\n                {[1, 2, 3, 4, 5].map((star) => (\\n                  <button\\n                    key={star}\\n                    type=\\\"button\\\"\\n                    onClick={() => setReviewRating(star)}\\n                    aria-label={`Rate ${star} stars`}\\n                    className=\\\"min-w-[40px] min-h-[40px] rounded-xl bg-[#FAF8FF] border border-violet-200 flex items-center justify-center hover:bg-violet-50 cursor-pointer\\\"\\n                  >\\n                    <Star\\n                      className={`w-4 h-4 ${\\n                        star <= reviewRating\\n                          ? \'fill-amber-400 text-amber-500\'\\n                          : \'text-violet-300\'\\n                      }`}\\n                    />\\n                  </button>\\n                ))}\\n              </div>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block text-xs font-semibold text-[#1A132B] mb-1\\\">\\n                Feedback Comment\\n              </label>\\n              <textarea\\n                rows={3}\\n                required\\n                value={reviewComment}\\n                onChange={(e) => setReviewComment(e.target.value)}\\n                placeholder=\\\"Tell us what worked well or what safety capability you want next...\\\"\\n                className=\\\"w-full px-3.5 py-2.5 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none resize-none\\\"\\n              />\\n            </div>\\n\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold transition-colors cursor-pointer\\\"\\n            >\\n              Post Feedback\\n            </button>\\n          </form>\\n        </div>\\n      </section>\\n\\n      {/* Section 6: Founder & Team Details (Editable Placeholders) */}\\n      <section className=\\\"bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-8 shadow-sm shadow-violet-950/[0.02]\\\">\\n        <div className=\\\"flex flex-wrap items-start justify-between gap-4 mb-5\\\">\\n          <div>\\n            <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n              Founder, Team &amp; Mission \302\267 Editable Placeholders\\n            </p>\\n            <h2 className=\\\"mt-1 text-2xl font-bold text-[#1A132B]\\\">\\n              Founder &amp; Project Team\\n            </h2>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => {\\n              setTeamDraft(teamInfo);\\n              setEditingTeam((prev) => !prev);\\n            }}\\n            className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n          >\\n            <Pencil className=\\\"w-3.5 h-3.5\\\" />\\n            <span>{editingTeam ? \'Cancel Editing\' : \'Edit Team Details\'}</span>\\n          </button>\\n        </div>\\n\\n        {editingTeam ? (\\n          <form onSubmit={handleSaveTeam} className=\\\"space-y-4\\\">\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#1A132B] mb-1\\\">\\n                  Founder Name\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={teamDraft.founderName}\\n                  onChange={(e) =>\\n                    setTeamDraft((p) => ({ ...p, founderName: e.target.value }))\\n                  }\\n                  className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#1A132B] mb-1\\\">\\n                  Project Team Details\\n                </label>\\n                <input\\n                  type=\\\"text\\\"\\n                  value={teamDraft.teamMembers}\\n                  onChange={(e) =>\\n                    setTeamDraft((p) => ({ ...p, teamMembers: e.target.value }))\\n                  }\\n                  className=\\\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\\\"\\n                />\\n              </div>\\n              <div className=\\\"md:col-span-2\\\">\\n                <label className=\\\"block text-xs font-semibold text-[#1A132B] mb-1\\\">\\n                  Founder Introduction\\n                </label>\\n                <textarea\\n                  rows={2}\\n                  value={teamDraft.founderIntro}\\n                  onChange={(e) =>\\n                    setTeamDraft((p) => ({ ...p, founderIntro: e.target.value }))\\n                  }\\n                  className=\\\"w-full px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#1A132B] mb-1\\\">\\n                  Project Vision\\n                </label>\\n                <textarea\\n                  rows={2}\\n                  value={teamDraft.vision}\\n                  onChange={(e) =>\\n                    setTeamDraft((p) => ({ ...p, vision: e.target.value }))\\n                  }\\n                  className=\\\"w-full px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\\\"\\n                />\\n              </div>\\n              <div>\\n                <label className=\\\"block text-xs font-semibold text-[#1A132B] mb-1\\\">\\n                  Project Mission\\n                </label>\\n                <textarea\\n                  rows={2}\\n                  value={teamDraft.mission}\\n                  onChange={(e) =>\\n                    setTeamDraft((p) => ({ ...p, mission: e.target.value }))\\n                  }\\n                  className=\\\"w-full px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\\\"\\n                />\\n              </div>\\n            </div>\\n            <div className=\\\"flex justify-end\\\">\\n              <button\\n                type=\\\"submit\\\"\\n                className=\\\"min-h-[44px] px-5 py-2 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold cursor-pointer\\\"\\n              >\\n                Save Team Details\\n              </button>\\n            </div>\\n          </form>\\n        ) : (\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\">\\n            <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-5 space-y-2\\\">\\n              <div className=\\\"flex items-center gap-2 text-xs font-semibold text-violet-700\\\">\\n                <ShieldCheck className=\\\"w-4 h-4\\\" />\\n                <span>Founder</span>\\n              </div>\\n              <h3 className=\\\"text-base font-bold text-[#1A132B]\\\">\\n                {teamInfo.founderName}\\n              </h3>\\n              <p className=\\\"text-xs text-[#4A4063] leading-relaxed\\\">\\n                {teamInfo.founderIntro}\\n              </p>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-5 space-y-2\\\">\\n              <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n                Project Team\\n              </p>\\n              <p className=\\\"text-sm font-semibold text-[#1A132B] leading-relaxed\\\">\\n                {teamInfo.teamMembers}\\n              </p>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-5 space-y-3\\\">\\n              <div>\\n                <p className=\\\"text-xs font-semibold text-violet-700\\\">Vision</p>\\n                <p className=\\\"mt-1 text-xs text-[#4A4063] leading-relaxed\\\">\\n                  {teamInfo.vision}\\n                </p>\\n              </div>\\n              <div className=\\\"pt-2.5 border-t border-violet-200/60\\\">\\n                <p className=\\\"text-xs font-semibold text-violet-700\\\">Mission</p>\\n                <p className=\\\"mt-1 text-xs text-[#4A4063] leading-relaxed\\\">\\n                  {teamInfo.mission}\\n                </p>\\n              </div>\\n            </div>\\n          </div>\\n        )}\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create dedicated Home About page containing About AuraSafe, Features overview, How It Works, Sample Reviews + Feedback submission, Editable Founder/Team info, and Emergency Help Numbers (112, 181, 100, 108, 1098)\", \"Overwrite\":true, \"TargetFile\":\"/src/components/pages/HomeAboutPage.tsx\", \"toolAction\":\"Creating HomeAboutPage component\", \"toolSummary\":\"Create HomeAboutPage component\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_4683307059967637698"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect } from \'react\';\\nimport {\\n  CheckCircle2,\\n  Clock,\\n  LocateFixed,\\n  MapPin,\\n  Phone,\\n  Radio,\\n  Send,\\n  Shield,\\n  ShieldAlert,\\n  Users,\\n  Wifi,\\n  WifiOff,\\n} from \'lucide-react\';\\nimport {\\n  AlertDeliveryStatus,\\n  GeoLocationState,\\n  LiveLocationShareSession,\\n  SosAlertRecord,\\n  SosContact,\\n} from \'../../types/safety\';\\nimport { formatDateTimeShort, formatPhoneForTel } from \'../../utils/storage\';\\n\\ninterface SosPageProps {\\n  userName: string;\\n  contacts: SosContact[];\\n  geoLocation: GeoLocationState;\\n  isOnline: boolean;\\n  latestSosAlert: SosAlertRecord | null;\\n  liveLocationShare: LiveLocationShareSession | null;\\n  quickDialEnabled: boolean;\\n  onRequestLocation: () => void;\\n  onTriggerSosAlert: (triggerSource: string, note?: string) => void;\\n  onClearSosStatus: () => void;\\n  onToggleLiveLocationShare: (active: boolean, durationMinutes?: number) => void;\\n  onToggleQuickDial: () => void;\\n  onOpenContacts: () => void;\\n  onOpenNearbyPolice: () => void;\\n}\\n\\nconst STATUS_LABELS: Record<AlertDeliveryStatus, { text: string; tone: string }> = {\\n  standby: { text: \'Standby \342\200\224 Ready\', tone: \'text-[#574E6B]\' },\\n  initiated: { text: \'Initiated \342\200\224 Preparing Dispatch\', tone: \'text-amber-700\' },\\n  delivered_demo: {\\n    text: \'Alert Logged (Prototype Demo \342\200\224 No Real SMS Sent)\',\\n    tone: \'text-emerald-700\',\\n  },\\n  queued_offline: {\\n    text: \'Offline \342\200\224 Preserved Locally (Will Queue Until Online)\',\\n    tone: \'text-amber-800\',\\n  },\\n  failed: { text: \'Delivery Failed \342\200\224 No Contacts Configured\', tone: \'text-red-700\' },\\n};\\n\\nexport const SosPage: React.FC<SosPageProps> = ({\\n  userName,\\n  contacts,\\n  geoLocation,\\n  isOnline,\\n  latestSosAlert,\\n  liveLocationShare,\\n  quickDialEnabled,\\n  onRequestLocation,\\n  onTriggerSosAlert,\\n  onClearSosStatus,\\n  onToggleLiveLocationShare,\\n  onToggleQuickDial,\\n  onOpenContacts,\\n  onOpenNearbyPolice,\\n}) => {\\n  const primaryGuardian = contacts.find((c) => c.isPrimary) ?? contacts[0];\\n  const hasCoords =\\n    geoLocation.status === \'granted\' &&\\n    geoLocation.latitude !== null &&\\n    geoLocation.longitude !== null;\\n\\n  useEffect(() => {\\n    if (geoLocation.status === \'idle\') {\\n      onRequestLocation();\\n    }\\n  }, [geoLocation.status, onRequestLocation]);\\n\\n  const currentStatus: AlertDeliveryStatus = latestSosAlert?.status ?? \'standby\';\\n  const statusMeta = STATUS_LABELS[currentStatus];\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Top Emergency Hero Banner */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\\\">\\n        <div className=\\\"lg:col-span-7 rounded-3xl bg-red-600 text-white p-6 sm:p-8 flex flex-col justify-between gap-6 shadow-md shadow-red-900/15\\\">\\n          <div className=\\\"space-y-2\\\">\\n            <div className=\\\"flex flex-wrap items-center gap-2 text-xs font-semibold text-red-100\\\">\\n              <span>SOS Emergency Controller</span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>{isOnline ? \'Online\' : \'Offline Mode Active\'}</span>\\n            </div>\\n            <h1 className=\\\"text-2xl sm:text-3xl font-bold tracking-tight\\\">\\n              Immediate Emergency Assistance\\n            </h1>\\n            <p className=\\\"text-sm text-red-50/90 leading-relaxed max-w-xl\\\">\\n              Trigger SOS manually or by saying &ldquo;Open SOS&rdquo; to the AI Voice Assistant. This workflow captures your live GPS location, prepares guardian alerts, and surfaces one-tap emergency dialing.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onTriggerSosAlert(\'Manual SOS Page Button\')}\\n              className=\\\"flex-1 min-w-[210px] min-h-[54px] px-6 py-3 rounded-2xl bg-white hover:bg-red-50 active:scale-[0.99] text-red-700 text-base font-extrabold flex items-center justify-center gap-2 transition-all shadow-sm cursor-pointer whitespace-nowrap\\\"\\n            >\\n              <ShieldAlert className=\\\"w-5 h-5\\\" />\\n              <span>Send SOS Emergency Alert</span>\\n            </button>\\n\\n            {primaryGuardian && (\\n              <a\\n                href={`tel:${formatPhoneForTel(primaryGuardian.phone)}`}\\n                className=\\\"min-h-[54px] px-5 py-3 rounded-2xl bg-red-800/75 hover:bg-red-900 border border-white/25 text-white text-sm font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n              >\\n                <Phone className=\\\"w-4 h-4\\\" />\\n                <span>Call {primaryGuardian.name}</span>\\n              </a>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Emergency Status Tracker */}\\n        <div className=\\\"lg:col-span-5 bg-white rounded-3xl border border-violet-200/80 p-6 flex flex-col justify-between gap-4 shadow-sm\\\">\\n          <div className=\\\"space-y-3\\\">\\n            <div className=\\\"flex items-center justify-between gap-2\\\">\\n              <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n                Emergency Status Tracker\\n              </p>\\n              {latestSosAlert && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onClearSosStatus}\\n                  className=\\\"text-xs font-semibold text-[#574E6B] hover:text-[#1A132B] cursor-pointer\\\"\\n                >\\n                  Reset Status\\n                </button>\\n              )}\\n            </div>\\n\\n            <div>\\n              <p className={`text-base font-bold ${statusMeta.tone}`}>\\n                {statusMeta.text}\\n              </p>\\n              {latestSosAlert ? (\\n                <p className=\\\"mt-1 text-xs text-[#6B6182] flex items-center gap-1.5 tabular-nums\\\">\\n                  <Clock className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>\\n                    Activated {formatDateTimeShort(latestSosAlert.activatedAt)} via{\' \'}\\n                    {latestSosAlert.triggerSource}\\n                  </span>\\n                </p>\\n              ) : (\\n                <p className=\\\"mt-1 text-xs text-[#6B6182]\\\">\\n                  No active SOS dispatch. Press the red SOS button or use voice command &ldquo;Open SOS&rdquo;.\\n                </p>\\n              )}\\n            </div>\\n\\n            {latestSosAlert && (\\n              <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-3.5 space-y-2 text-xs\\\">\\n                <p className=\\\"font-semibold text-[#1A132B]\\\">\\n                  Alert Payload Prepared for {latestSosAlert.recipients.length} Contact(s)\\n                </p>\\n                <p className=\\\"font-mono text-[11px] text-[#4A4063] leading-relaxed\\\">\\n                  &ldquo;SOS from {userName}. Need immediate assistance. GPS:{\' \'}\\n                  {latestSosAlert.latitude !== null && latestSosAlert.longitude !== null\\n                    ? `${latestSosAlert.latitude.toFixed(5)}, ${latestSosAlert.longitude.toFixed(5)}`\\n                    : \'Location unavailable\'}\\n                  .&rdquo;\\n                </p>\\n                {latestSosAlert.recipients.length > 0 && (\\n                  <div className=\\\"pt-2 border-t border-violet-100 space-y-1\\\">\\n                    {latestSosAlert.recipients.map((r, i) => (\\n                      <div\\n                        key={`${r.phone}-${i}`}\\n                        className=\\\"flex items-center justify-between gap-2 text-[11px]\\\"\\n                      >\\n                        <span className=\\\"font-semibold text-[#1A132B]\\\">\\n                          {r.name}\\n                        </span>\\n                        <span className=\\\"text-[#574E6B] capitalize\\\">\\n                          {r.status.replace(\'_\', \' \')}\\n                        </span>\\n                      </div>\\n                    ))}\\n                  </div>\\n                )}\\n              </div>\\n            )}\\n          </div>\\n\\n          <div className=\\\"pt-3 border-t border-violet-100 flex items-center justify-between gap-3\\\">\\n            <div className=\\\"text-xs text-[#4A4063]\\\">\\n              <p className=\\\"font-semibold text-[#1A132B]\\\">\\n                Voice SOS Call Prompt Preference\\n              </p>\\n              <p className=\\\"text-[11px] text-[#6B6182]\\\">\\n                Highlight direct guardian dialer immediately when voice triggers SOS\\n              </p>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              role=\\\"switch\\\"\\n              aria-checked={quickDialEnabled}\\n              onClick={onToggleQuickDial}\\n              className={`w-11 h-6 rounded-full p-0.5 transition-colors shrink-0 cursor-pointer flex items-center ${\\n                quickDialEnabled\\n                  ? \'bg-violet-700 justify-end\'\\n                  : \'bg-violet-200 justify-start\'\\n              }`}\\n            >\\n              <span className=\\\"w-5 h-5 rounded-full bg-white shadow-sm block\\\" />\\n            </button>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Live Location Sharing + Nearest Police Station */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n        <div className=\\\"lg:col-span-6 bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\\\">\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n            <div>\\n              <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n                Live Location Sharing\\n              </p>\\n              <h2 className=\\\"text-lg font-bold text-[#1A132B] mt-0.5\\\">\\n                Current GPS Coordinates\\n              </h2>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onRequestLocation}\\n              className=\\\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-800 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n            >\\n              <LocateFixed className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Refresh GPS</span>\\n            </button>\\n          </div>\\n\\n          <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-4 space-y-2\\\">\\n            <div className=\\\"flex items-center gap-2 text-sm font-semibold text-[#1A132B]\\\">\\n              <MapPin className=\\\"w-4 h-4 text-violet-700\\\" />\\n              <span>\\n                {hasCoords\\n                  ? `${geoLocation.latitude!.toFixed(6)}, ${geoLocation.longitude!.toFixed(6)}`\\n                  : geoLocation.status === \'loading\'\\n                    ? \'Locating device...\'\\n                    : \'Location permission needed\'}\\n              </span>\\n            </div>\\n            <p className=\\\"text-xs text-[#6B6182]\\\">\\n              {hasCoords\\n                ? `Accuracy \302\261${Math.round(geoLocation.accuracy ?? 0)}m \302\267 Ready to attach to emergency alerts`\\n                : geoLocation.errorMessage ||\\n                  \'Grant browser location permission to share exact coordinates with guardians.\'}\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-3 pt-1\\\">\\n            <div className=\\\"text-xs text-[#4A4063]\\\">\\n              <p className=\\\"font-semibold text-[#1A132B] flex items-center gap-1.5\\\">\\n                <Radio className=\\\"w-4 h-4 text-violet-700\\\" />\\n                <span>\\n                  {liveLocationShare?.active\\n                    ? `Sharing Active (${liveLocationShare.sharedWithNames.length} contact(s))`\\n                    : \'Live Location Sharing Standby\'}\\n                </span>\\n              </p>\\n              <p className=\\\"text-[11px] text-[#6B6182] mt-0.5\\\">\\n                {liveLocationShare?.active\\n                  ? `Started ${formatDateTimeShort(liveLocationShare.startedAt)} \302\267 Local session tracking`\\n                  : \'Starts a local live-location session linked to your trusted guardians.\'}\\n              </p>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() =>\\n                onToggleLiveLocationShare(!liveLocationShare?.active, 30)\\n              }\\n              className={`min-h-[42px] px-4 py-2 rounded-xl text-xs font-semibold transition-colors whitespace-nowrap cursor-pointer ${\\n                liveLocationShare?.active\\n                  ? \'bg-red-50 hover:bg-red-100 border border-red-200 text-red-700\'\\n                  : \'bg-violet-700 hover:bg-violet-800 text-white\'\\n              }`}\\n            >\\n              {liveLocationShare?.active\\n                ? \'Stop Location Share\'\\n                : \'Share Live Location\'}\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Nearest Police Station & Authorities */}\\n        <div className=\\\"lg:col-span-6 bg-white rounded-3xl border border-violet-200/80 p-6 flex flex-col justify-between gap-4\\\">\\n          <div className=\\\"space-y-2\\\">\\n            <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n              Immediate Law Enforcement Access\\n            </p>\\n            <h2 className=\\\"text-lg font-bold text-[#1A132B]\\\">\\n              Contact Nearest Police Station\\n            </h2>\\n            <p className=\\\"text-xs text-[#574E6B] leading-relaxed\\\">\\n              Reach official emergency dispatch immediately via your phone dialer, or open the Nearby Police Stations lookup centered on your live GPS coordinates.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n            <a\\n              href=\\\"tel:100\\\"\\n              className=\\\"min-h-[48px] px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n            >\\n              <Phone className=\\\"w-4 h-4\\\" />\\n              <span>Call Police (100)</span>\\n            </a>\\n            <a\\n              href=\\\"tel:112\\\"\\n              className=\\\"min-h-[48px] px-4 py-2.5 rounded-xl bg-red-50 hover:bg-red-100 border border-red-200 text-red-800 text-sm font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n            >\\n              <Shield className=\\\"w-4 h-4\\\" />\\n              <span>Emergency (112)</span>\\n            </a>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onOpenNearbyPolice}\\n            className=\\\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-sm font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer\\\"\\n          >\\n            <MapPin className=\\\"w-4 h-4 text-violet-700\\\" />\\n            <span>Open Nearby Police Stations</span>\\n          </button>\\n        </div>\\n      </section>\\n\\n      {/* Trusted Guardian Network & Offline Support Notice */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n        <div className=\\\"lg:col-span-7 bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\\\">\\n          <div className=\\\"flex items-center justify-between gap-3\\\">\\n            <div>\\n              <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n                Trusted Guardian Network ({contacts.length})\\n              </p>\\n              <h2 className=\\\"text-lg font-bold text-[#1A132B] mt-0.5\\\">\\n                Registered Emergency Contacts\\n              </h2>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenContacts}\\n              className=\\\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-800 text-xs font-semibold flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n            >\\n              <Users className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Manage Network</span>\\n            </button>\\n          </div>\\n\\n          {contacts.length === 0 ? (\\n            <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-5 text-center space-y-3\\\">\\n              <p className=\\\"text-sm text-[#574E6B]\\\">\\n                No emergency contacts registered yet.\\n              </p>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onOpenContacts}\\n                className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-violet-700 text-white text-xs font-semibold cursor-pointer\\\"\\n              >\\n                Add Trusted Guardian\\n              </button>\\n            </div>\\n          ) : (\\n            <div className=\\\"divide-y divide-violet-100 border border-violet-200/70 rounded-2xl overflow-hidden\\\">\\n              {contacts.map((c) => (\\n                <div\\n                  key={c.id}\\n                  className=\\\"p-4 bg-white flex flex-wrap items-center justify-between gap-3\\\"\\n                >\\n                  <div className=\\\"min-w-0\\\">\\n                    <p className=\\\"text-sm font-bold text-[#1A132B]\\\">\\n                      {c.name}\\n                      {c.isPrimary ? \' \302\267 Primary Guardian\' : \'\'}\\n                    </p>\\n                    <p className=\\\"text-xs text-[#6B6182] font-mono tabular-nums mt-0.5\\\">\\n                      {c.phone} \302\267 {c.relation || \'Emergency Contact\'}\\n                    </p>\\n                  </div>\\n\\n                  <div className=\\\"flex items-center gap-2\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() =>\\n                        onTriggerSosAlert(`Direct Alert to ${c.name}`)\\n                      }\\n                      className=\\\"min-h-[40px] px-3 py-1.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n                    >\\n                      <Send className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Alert</span>\\n                    </button>\\n                    <a\\n                      href={`tel:${formatPhoneForTel(c.phone)}`}\\n                      className=\\\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-semibold inline-flex items-center gap-1.5 whitespace-nowrap\\\"\\n                    >\\n                      <Phone className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Call</span>\\n                    </a>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Emergency Offline Support Card */}\\n        <div className=\\\"lg:col-span-5 bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\\\">\\n          <div className=\\\"flex items-center justify-between gap-2\\\">\\n            <div>\\n              <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n                Emergency Offline Support\\n              </p>\\n              <h2 className=\\\"text-lg font-bold text-[#1A132B] mt-0.5\\\">\\n                Connectivity &amp; Offline Readiness\\n              </h2>\\n            </div>\\n            <div className=\\\"flex items-center gap-1.5 text-xs font-bold text-[#1A132B]\\\">\\n              {isOnline ? (\\n                <>\\n                  <Wifi className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                  <span className=\\\"text-emerald-700\\\">Online</span>\\n                </>\\n              ) : (\\n                <>\\n                  <WifiOff className=\\\"w-4 h-4 text-amber-600\\\" />\\n                  <span className=\\\"text-amber-700\\\">Offline</span>\\n                </>\\n              )}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"space-y-3 text-xs\\\">\\n            <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-4 space-y-1.5\\\">\\n              <p className=\\\"font-bold text-emerald-800 flex items-center gap-1.5\\\">\\n                <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600 shrink-0\\\" />\\n                <span>Available Offline (Cached Locally)</span>\\n              </p>\\n              <p className=\\\"text-[#4A4063] leading-relaxed\\\">\\n                Saved guardian numbers, direct <code className=\\\"font-mono\\\">tel:</code> emergency calling (112, 181, 100, 108, 1098), Threat Mode audio/video recording, local Evidence History, and Fake Call.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-4 space-y-1.5\\\">\\n              <p className=\\\"font-bold text-[#1A132B]\\\">\\n                Requires Internet Connection\\n              </p>\\n              <p className=\\\"text-[#574E6B] leading-relaxed\\\">\\n                Real-time Gemini Live Voice AI conversations, online Maps searches, and future cloud SMS/WhatsApp alert delivery to guardians.\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create dedicated SOS Emergency page with SOS workflow, live emergency status tracking, live location sharing, trusted guardian network, nearest police actions, and offline readiness breakdown\", \"Overwrite\":true, \"TargetFile\":\"/src/components/pages/SosPage.tsx\", \"toolAction\":\"Creating SosPage component\", \"toolSummary\":\"Create SosPage component\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_4683307059967637423"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport {\\n  AlertTriangle,\\n  Battery,\\n  CheckCircle2,\\n  Clock,\\n  History,\\n  Mic,\\n  Phone,\\n  ShieldAlert,\\n  Square,\\n  Video,\\n  Volume2,\\n  VolumeX,\\n  Wifi,\\n  WifiOff,\\n} from \'lucide-react\';\\nimport {\\n  GeoLocationState,\\n  SosContact,\\n  ThreatSessionState,\\n} from \'../../types/safety\';\\nimport { saveRecordingToDb } from \'../../utils/evidenceDb\';\\nimport { formatDateTimeShort, formatPhoneForTel } from \'../../utils/storage\';\\n\\ninterface ThreatModePageProps {\\n  userId: string;\\n  contacts: SosContact[];\\n  threatSession: ThreatSessionState | null;\\n  recoveredInterruption: ThreatSessionState | null;\\n  geoLocation: GeoLocationState;\\n  isOnline: boolean;\\n  soundAllowed: boolean;\\n  onActivateThreatMode: (source?: string) => void;\\n  onDeactivateThreatMode: (note?: string) => void;\\n  onUpdateThreatSnapshot: (partial: Partial<ThreatSessionState>) => void;\\n  onRecordingSaved: (meta: {\\n    id: string;\\n    kind: \'audio\' | \'video\';\\n    durationSec: number;\\n    locationCoords?: string;\\n  }) => void;\\n  onSimulateConnectivityDrop: () => void;\\n  onDismissRecoveryBanner: () => void;\\n  onEscalateToSos: () => void;\\n  onOpenHistory: () => void;\\n}\\n\\nexport const ThreatModePage: React.FC<ThreatModePageProps> = ({\\n  userId,\\n  contacts,\\n  threatSession,\\n  recoveredInterruption,\\n  geoLocation,\\n  isOnline,\\n  soundAllowed,\\n  onActivateThreatMode,\\n  onDeactivateThreatMode,\\n  onUpdateThreatSnapshot,\\n  onRecordingSaved,\\n  onSimulateConnectivityDrop,\\n  onDismissRecoveryBanner,\\n  onEscalateToSos,\\n  onOpenHistory,\\n}) => {\\n  const [elapsedText, setElapsedText] = useState(\'00:00\');\\n  const [recordingMode, setRecordingMode] = useState<\'none\' | \'audio\' | \'video\'>(\\n    \'none\'\\n  );\\n  const [recordingSeconds, setRecordingSeconds] = useState(0);\\n  const [recordingError, setRecordingError] = useState(\'\');\\n  const [recordingSavedNotice, setRecordingSavedNotice] = useState(\'\');\\n  const [batteryPercent, setBatteryPercent] = useState<number | null>(null);\\n  const [alarmPlaying, setAlarmPlaying] = useState(false);\\n\\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\\n  const mediaStreamRef = useRef<MediaStream | null>(null);\\n  const chunksRef = useRef<Blob[]>([]);\\n  const recordStartTimeRef = useRef<number>(0);\\n  const videoPreviewRef = useRef<HTMLVideoElement | null>(null);\\n\\n  const audioCtxRef = useRef<AudioContext | null>(null);\\n  const sirenTimerRef = useRef<number | null>(null);\\n\\n  const primaryGuardian = contacts.find((c) => c.isPrimary) ?? contacts[0];\\n  const isActive = Boolean(threatSession?.active);\\n\\n  // Read device battery status when supported by browser\\n  useEffect(() => {\\n    const navWithBattery = navigator as Navigator & {\\n      getBattery?: () => Promise<{\\n        level: number;\\n        addEventListener: (ev: string, cb: () => void) => void;\\n      }>;\\n    };\\n    if (!navWithBattery.getBattery) return;\\n    let mounted = true;\\n    navWithBattery\\n      .getBattery()\\n      .then((battery) => {\\n        if (!mounted) return;\\n        const pct = Math.round(battery.level * 100);\\n        setBatteryPercent(pct);\\n        if (isActive) {\\n          onUpdateThreatSnapshot({ batteryPercent: pct });\\n        }\\n        battery.addEventListener(\'levelchange\', () => {\\n          if (!mounted) return;\\n          const nextPct = Math.round(battery.level * 100);\\n          setBatteryPercent(nextPct);\\n        });\\n      })\\n      .catch(() => {});\\n    return () => {\\n      mounted = false;\\n    };\\n  }, [isActive, onUpdateThreatSnapshot]);\\n\\n  // Active Threat Mode elapsed timer\\n  useEffect(() => {\\n    if (!threatSession?.active) {\\n      setElapsedText(\'00:00\');\\n      return;\\n    }\\n    const update = () => {\\n      const diff = Math.max(\\n        0,\\n        Math.floor(\\n          (Date.now() - new Date(threatSession.activatedAt).getTime()) / 1000\\n        )\\n      );\\n      const mins = Math.floor(diff / 60);\\n      const secs = diff % 60;\\n      setElapsedText(\\n        `${String(mins).padStart(2, \'0\')}:${String(secs).padStart(2, \'0\')}`\\n      );\\n    };\\n    update();\\n    const id = window.setInterval(update, 1000);\\n    return () => window.clearInterval(id);\\n  }, [threatSession]);\\n\\n  // Recording elapsed timer\\n  useEffect(() => {\\n    if (recordingMode === \'none\') {\\n      setRecordingSeconds(0);\\n      return;\\n    }\\n    const id = window.setInterval(() => {\\n      setRecordingSeconds(\\n        Math.max(1, Math.floor((Date.now() - recordStartTimeRef.current) / 1000))\\n      );\\n    }, 1000);\\n    return () => window.clearInterval(id);\\n  }, [recordingMode]);\\n\\n  const stopAttentionTone = () => {\\n    if (sirenTimerRef.current !== null) {\\n      window.clearInterval(sirenTimerRef.current);\\n      sirenTimerRef.current = null;\\n    }\\n    if (audioCtxRef.current) {\\n      audioCtxRef.current.close().catch(() => {});\\n      audioCtxRef.current = null;\\n    }\\n    setAlarmPlaying(false);\\n  };\\n\\n  const toggleAttentionTone = () => {\\n    if (alarmPlaying) {\\n      stopAttentionTone();\\n      return;\\n    }\\n    try {\\n      const Ctor =\\n        window.AudioContext ||\\n        (window as unknown as { webkitAudioContext: typeof AudioContext })\\n          .webkitAudioContext;\\n      const ctx = new Ctor();\\n      audioCtxRef.current = ctx;\\n      const pulse = (freq: number) => {\\n        if (!audioCtxRef.current) return;\\n        const osc = ctx.createOscillator();\\n        const gain = ctx.createGain();\\n        osc.type = \'triangle\';\\n        osc.frequency.setValueAtTime(freq, ctx.currentTime);\\n        gain.gain.setValueAtTime(0.001, ctx.currentTime);\\n        gain.gain.exponentialRampToValueAtTime(0.18, ctx.currentTime + 0.05);\\n        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.45);\\n        osc.connect(gain);\\n        gain.connect(ctx.destination);\\n        osc.start();\\n        osc.stop(ctx.currentTime + 0.48);\\n      };\\n      let high = true;\\n      pulse(880);\\n      sirenTimerRef.current = window.setInterval(() => {\\n        high = !high;\\n        pulse(high ? 880 : 660);\\n      }, 520);\\n      setAlarmPlaying(true);\\n    } catch {\\n      setAlarmPlaying(false);\\n    }\\n  };\\n\\n  const stopRecording = () => {\\n    if (\\n      mediaRecorderRef.current &&\\n      mediaRecorderRef.current.state !== \'inactive\'\\n    ) {\\n      mediaRecorderRef.current.stop();\\n    }\\n    if (mediaStreamRef.current) {\\n      mediaStreamRef.current.getTracks().forEach((t) => t.stop());\\n      mediaStreamRef.current = null;\\n    }\\n    if (videoPreviewRef.current) {\\n      videoPreviewRef.current.srcObject = null;\\n    }\\n  };\\n\\n  // Cleanup media & audio on unmount\\n  useEffect(() => {\\n    return () => {\\n      stopAttentionTone();\\n      stopRecording();\\n    };\\n  }, []);\\n\\n  const startRecording = async (kind: \'audio\' | \'video\') => {\\n    setRecordingError(\'\');\\n    setRecordingSavedNotice(\'\');\\n\\n    if (typeof MediaRecorder === \'undefined\' || !navigator.mediaDevices?.getUserMedia) {\\n      setRecordingError(\\n        \'Media recording is not supported in this browser environment.\'\\n      );\\n      return;\\n    }\\n\\n    if (!isActive) {\\n      onActivateThreatMode(`Threat Mode ${kind} recording`);\\n    }\\n\\n    stopRecording();\\n\\n    try {\\n      const stream = await navigator.mediaDevices.getUserMedia(\\n        kind === \'video\'\\n          ? { audio: true, video: { facingMode: \'environment\' } }\\n          : { audio: true }\\n      );\\n      mediaStreamRef.current = stream;\\n\\n      if (kind === \'video\') {\\n        window.setTimeout(() => {\\n          if (videoPreviewRef.current) {\\n            videoPreviewRef.current.srcObject = stream;\\n            videoPreviewRef.current.play().catch(() => {});\\n          }\\n        }, 50);\\n      }\\n\\n      const preferredMime =\\n        kind === \'video\'\\n          ? MediaRecorder.isTypeSupported(\'video/webm;codecs=vp8,opus\')\\n            ? \'video/webm;codecs=vp8,opus\'\\n            : \'video/webm\'\\n          : MediaRecorder.isTypeSupported(\'audio/webm;codecs=opus\')\\n            ? \'audio/webm;codecs=opus\'\\n            : \'audio/webm\';\\n\\n      const recorder = new MediaRecorder(\\n        stream,\\n        MediaRecorder.isTypeSupported(preferredMime)\\n          ? { mimeType: preferredMime }\\n          : undefined\\n      );\\n      chunksRef.current = [];\\n      recordStartTimeRef.current = Date.now();\\n\\n      recorder.ondataavailable = (ev) => {\\n        if (ev.data && ev.data.size > 0) {\\n          chunksRef.current.push(ev.data);\\n        }\\n      };\\n\\n      recorder.onstop = async () => {\\n        const durationSec = Math.max(\\n          1,\\n          Math.round((Date.now() - recordStartTimeRef.current) / 1000)\\n        );\\n        const blob = new Blob(chunksRef.current, {\\n          type: recorder.mimeType || (kind === \'video\' ? \'video/webm\' : \'audio/webm\'),\\n        });\\n        const recId = `rec-${Date.now()}`;\\n        const coords =\\n          geoLocation.status === \'granted\' &&\\n          geoLocation.latitude !== null &&\\n          geoLocation.longitude !== null\\n            ? `${geoLocation.latitude.toFixed(5)}, ${geoLocation.longitude.toFixed(5)}`\\n            : undefined;\\n\\n        try {\\n          await saveRecordingToDb({\\n            id: recId,\\n            userId,\\n            kind,\\n            mimeType: blob.type,\\n            createdAt: new Date().toISOString(),\\n            durationSec,\\n            sizeBytes: blob.size,\\n            sessionId: threatSession?.sessionId,\\n            locationCoords: coords,\\n            sharedWithGuardians: false,\\n            blob,\\n          });\\n          onRecordingSaved({\\n            id: recId,\\n            kind,\\n            durationSec,\\n            locationCoords: coords,\\n          });\\n          setRecordingSavedNotice(\\n            `${kind === \'video\' ? \'Video\' : \'Audio\'} evidence (${durationSec}s) saved securely to local Evidence History.`\\n          );\\n        } catch {\\n          setRecordingError(\\n            \'Recording finished, but local IndexedDB storage was unavailable in this browser.\'\\n          );\\n        }\\n        setRecordingMode(\'none\');\\n        onUpdateThreatSnapshot({ recordingMode: \'none\' });\\n      };\\n\\n      mediaRecorderRef.current = recorder;\\n      recorder.start(1000);\\n      setRecordingMode(kind);\\n      onUpdateThreatSnapshot({ recordingMode: kind });\\n    } catch {\\n      setRecordingError(\\n        `Permission for ${kind === \'video\' ? \'camera/microphone\' : \'microphone\'} was denied or device is unavailable.`\\n      );\\n    }\\n  };\\n\\n  const handleDeactivate = () => {\\n    stopRecording();\\n    stopAttentionTone();\\n    onDeactivateThreatMode(\'Deactivated safely by user\');\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Recovered Unexpected Interruption Alert */}\\n      {recoveredInterruption && (\\n        <section\\n          role=\\\"alert\\\"\\n          className=\\\"rounded-3xl bg-amber-50 border border-amber-300 p-5 flex flex-wrap items-start justify-between gap-4\\\"\\n        >\\n          <div className=\\\"space-y-1 max-w-2xl\\\">\\n            <p className=\\\"text-xs font-bold text-amber-900\\\">\\n              Preserved Emergency Snapshot \302\267 Previous Threat Mode Interrupted Unexpectedly\\n            </p>\\n            <p className=\\\"text-sm text-amber-950 leading-relaxed\\\">\\n              Your previous Threat Mode session (started{\' \'}\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {formatDateTimeShort(recoveredInterruption.activatedAt)}\\n              </span>\\n              ) stopped communicating after{\' \'}\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {formatDateTimeShort(recoveredInterruption.lastHeartbeatAt)}\\n              </span>\\n              . Last preserved GPS:{\' \'}\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {recoveredInterruption.lastLatitude !== null &&\\n                recoveredInterruption.lastLongitude !== null\\n                  ? `${recoveredInterruption.lastLatitude.toFixed(5)}, ${recoveredInterruption.lastLongitude.toFixed(5)}`\\n                  : \'Unavailable\'}\\n              </span>\\n              . The event has been preserved in Emergency History.\\n            </p>\\n          </div>\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenHistory}\\n              className=\\\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-amber-900 text-white text-xs font-semibold cursor-pointer whitespace-nowrap\\\"\\n            >\\n              View History\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onDismissRecoveryBanner}\\n              className=\\\"min-h-[40px] px-3 py-1.5 rounded-xl bg-white border border-amber-300 text-amber-900 text-xs font-semibold cursor-pointer\\\"\\n            >\\n              Dismiss\\n            </button>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* Main Threat Mode Control Header */}\\n      <section\\n        className={`rounded-3xl border p-6 sm:p-8 shadow-sm transition-colors ${\\n          isActive\\n            ? \'bg-red-50/70 border-red-300\'\\n            : \'bg-white border-violet-200/80\'\\n        }`}\\n      >\\n        <div className=\\\"flex flex-wrap items-start justify-between gap-6\\\">\\n          <div className=\\\"space-y-2 max-w-2xl\\\">\\n            <div className=\\\"flex flex-wrap items-center gap-2 text-xs font-semibold\\\">\\n              <span className={isActive ? \'text-red-700\' : \'text-violet-700\'}>\\n                Intelligent Threat Mode\\n              </span>\\n              <span aria-hidden=\\\"true\\\" className=\\\"text-[#8E84A6]\\\">\\n                \302\267\\n              </span>\\n              <span className={isActive ? \'text-red-800\' : \'text-[#6B6182]\'}>\\n                {isActive ? `ACTIVE (${elapsedText})` : \'Standby\'}\\n              </span>\\n            </div>\\n            <h1 className=\\\"text-2xl sm:text-3xl font-bold text-[#1A132B] tracking-tight\\\">\\n              {isActive\\n                ? \'Threat Protection Active\'\\n                : \'Proactive Protection When You Feel Unsafe\'}\\n            </h1>\\n            <p className=\\\"text-sm text-[#4A4063] leading-relaxed\\\">\\n              Activating Threat Mode notifies your registered guardian network with your available location and timestamp, unlocks local audio/video evidence recording, and continuously preserves your last known coordinates in case of sudden disconnect.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n            {isActive ? (\\n              <>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onEscalateToSos}\\n                  className=\\\"min-h-[48px] px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold inline-flex items-center gap-2 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <ShieldAlert className=\\\"w-4 h-4\\\" />\\n                  <span>Escalate to SOS</span>\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleDeactivate}\\n                  className=\\\"min-h-[48px] px-5 py-2.5 rounded-xl bg-white hover:bg-emerald-50 border border-emerald-300 text-emerald-800 text-sm font-semibold inline-flex items-center gap-2 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                  <span>I&apos;m Safe \342\200\224 Deactivate</span>\\n                </button>\\n              </>\\n            ) : (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onActivateThreatMode(\'Threat Mode Page\')}\\n                className=\\\"min-h-[50px] px-6 py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold inline-flex items-center gap-2 shadow-sm cursor-pointer whitespace-nowrap\\\"\\n              >\\n                <AlertTriangle className=\\\"w-5 h-5\\\" />\\n                <span>Activate Threat Mode</span>\\n              </button>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Active Session Metadata Row */}\\n        {isActive && threatSession && (\\n          <div className=\\\"mt-6 pt-5 border-t border-red-200/80 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs\\\">\\n            <div className=\\\"rounded-2xl bg-white border border-red-200/70 p-3.5\\\">\\n              <p className=\\\"text-[#6B6182]\\\">Activated At</p>\\n              <p className=\\\"mt-1 font-mono font-bold text-[#1A132B] tabular-nums\\\">\\n                {formatDateTimeShort(threatSession.activatedAt)}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl bg-white border border-red-200/70 p-3.5\\\">\\n              <p className=\\\"text-[#6B6182]\\\">Guardian Notification</p>\\n              <p className=\\\"mt-1 font-bold text-[#1A132B]\\\">\\n                {threatSession.guardianNotificationStatus === \'queued_offline\'\\n                  ? \'Queued (Offline)\'\\n                  : `Notified ${contacts.length} Guardian(s) (Demo)`}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl bg-white border border-red-200/70 p-3.5\\\">\\n              <p className=\\\"text-[#6B6182]\\\">Last Preserved GPS</p>\\n              <p className=\\\"mt-1 font-mono font-bold text-[#1A132B] tabular-nums\\\">\\n                {threatSession.lastLatitude !== null &&\\n                threatSession.lastLongitude !== null\\n                  ? `${threatSession.lastLatitude.toFixed(5)}, ${threatSession.lastLongitude.toFixed(5)}`\\n                  : \'Waiting for GPS\'}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl bg-white border border-red-200/70 p-3.5 flex items-center justify-between gap-2\\\">\\n              <div>\\n                <p className=\\\"text-[#6B6182]\\\">Quick Deterrent</p>\\n                <p className=\\\"mt-1 font-bold text-[#1A132B]\\\">\\n                  {alarmPlaying ? \'Tone Active\' : \'Muted\'}\\n                </p>\\n              </div>\\n              {soundAllowed && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={toggleAttentionTone}\\n                  className={`min-h-[38px] px-3 py-1.5 rounded-xl text-xs font-semibold inline-flex items-center gap-1 cursor-pointer ${\\n                    alarmPlaying\\n                      ? \'bg-red-600 text-white\'\\n                      : \'bg-red-50 text-red-700 border border-red-200\'\\n                  }`}\\n                >\\n                  {alarmPlaying ? (\\n                    <>\\n                      <VolumeX className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Stop</span>\\n                    </>\\n                  ) : (\\n                    <>\\n                      <Volume2 className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Siren</span>\\n                    </>\\n                  )}\\n                </button>\\n              )}\\n            </div>\\n          </div>\\n        )}\\n      </section>\\n\\n      {/* A. Emergency Audio & Video Recording + B. Device Continuity Protection */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n        {/* Emergency Evidence Recording */}\\n        <div className=\\\"lg:col-span-7 bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\\\">\\n          <div className=\\\"flex flex-wrap items-start justify-between gap-3\\\">\\n            <div>\\n              <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n                Emergency Evidence Capture \302\267 Local Browser Storage\\n              </p>\\n              <h2 className=\\\"mt-1 text-lg sm:text-xl font-bold text-[#1A132B]\\\">\\n                Audio &amp; Video Recording\\n              </h2>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenHistory}\\n              className=\\\"min-h-[38px] px-3 py-1.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-800 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n            >\\n              <History className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Evidence History</span>\\n            </button>\\n          </div>\\n\\n          <p className=\\\"text-xs text-[#574E6B] leading-relaxed\\\">\\n            Recordings require explicit browser microphone/camera permission, stay stored privately on your device (IndexedDB), and can be played back, shared as an evidence report with guardians, or permanently deleted anytime from Evidence History. Always follow local privacy and consent laws.\\n          </p>\\n\\n          {recordingError && (\\n            <p className=\\\"rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs font-medium text-red-700\\\">\\n              {recordingError}\\n            </p>\\n          )}\\n\\n          {recordingSavedNotice && (\\n            <div className=\\\"rounded-xl bg-emerald-50 border border-emerald-200 px-3.5 py-2.5 text-xs font-medium text-emerald-800 flex items-center justify-between gap-2\\\">\\n              <span>{recordingSavedNotice}</span>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onOpenHistory}\\n                className=\\\"font-bold underline shrink-0 cursor-pointer\\\"\\n              >\\n                Review\\n              </button>\\n            </div>\\n          )}\\n\\n          <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n            {recordingMode === \'none\' ? (\\n              <>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => startRecording(\'audio\')}\\n                  className=\\\"flex-1 min-w-[160px] min-h-[48px] px-4 py-2.5 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <Mic className=\\\"w-4 h-4\\\" />\\n                  <span>Start Audio Recording</span>\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => startRecording(\'video\')}\\n                  className=\\\"flex-1 min-w-[160px] min-h-[48px] px-4 py-2.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 border border-violet-200 text-violet-900 text-sm font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <Video className=\\\"w-4 h-4 text-violet-700\\\" />\\n                  <span>Start Video Recording</span>\\n                </button>\\n              </>\\n            ) : (\\n              <div className=\\\"w-full rounded-2xl bg-red-50 border border-red-200 p-4 flex flex-wrap items-center justify-between gap-3\\\">\\n                <div className=\\\"flex items-center gap-2.5\\\">\\n                  <Clock className=\\\"w-4 h-4 text-red-600\\\" />\\n                  <div>\\n                    <p className=\\\"text-sm font-bold text-red-800\\\">\\n                      Recording {recordingMode === \'video\' ? \'Video + Audio\' : \'Audio\'}{\' \'}\\n                      \302\267{\' \'}\\n                      <span className=\\\"font-mono tabular-nums\\\">\\n                        {String(Math.floor(recordingSeconds / 60)).padStart(2, \'0\')}:\\n                        {String(recordingSeconds % 60).padStart(2, \'0\')}\\n                      </span>\\n                    </p>\\n                    <p className=\\\"text-xs text-red-700\\\">\\n                      Captured securely in memory until stopped\\n                    </p>\\n                  </div>\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={stopRecording}\\n                  className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <Square className=\\\"w-3.5 h-3.5 fill-current\\\" />\\n                  <span>Stop &amp; Save Evidence</span>\\n                </button>\\n              </div>\\n            )}\\n          </div>\\n\\n          {recordingMode === \'video\' && (\\n            <div className=\\\"rounded-2xl overflow-hidden bg-[#1A132B] border border-violet-200 aspect-video\\\">\\n              <video\\n                ref={videoPreviewRef}\\n                autoPlay\\n                playsInline\\n                muted\\n                className=\\\"w-full h-full object-cover\\\"\\n              />\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Device Continuity & Connectivity Preservation */}\\n        <div className=\\\"lg:col-span-5 bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\\\">\\n          <div>\\n            <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n              Device Continuity &amp; Disconnect Preservation\\n            </p>\\n            <h2 className=\\\"mt-1 text-lg font-bold text-[#1A132B]\\\">\\n              Connectivity &amp; Sudden Drop Protection\\n            </h2>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-3 text-xs\\\">\\n            <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-3.5\\\">\\n              <p className=\\\"text-[#6B6182] flex items-center gap-1.5\\\">\\n                {isOnline ? (\\n                  <Wifi className=\\\"w-3.5 h-3.5 text-emerald-600\\\" />\\n                ) : (\\n                  <WifiOff className=\\\"w-3.5 h-3.5 text-amber-600\\\" />\\n                )}\\n                <span>Network State</span>\\n              </p>\\n              <p className=\\\"mt-1 font-bold text-[#1A132B]\\\">\\n                {isOnline ? \'Connected\' : \'Offline \342\200\224 Local Queue\'}\\n              </p>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-3.5\\\">\\n              <p className=\\\"text-[#6B6182] flex items-center gap-1.5\\\">\\n                <Battery className=\\\"w-3.5 h-3.5 text-violet-700\\\" />\\n                <span>Device Battery</span>\\n              </p>\\n              <p className=\\\"mt-1 font-bold font-mono tabular-nums text-[#1A132B]\\\">\\n                {batteryPercent !== null ? `${batteryPercent}%` : \'Browser Restricted\'}\\n              </p>\\n            </div>\\n          </div>\\n\\n          <p className=\\\"text-xs text-[#4A4063] leading-relaxed\\\">\\n            While Threat Mode is active, AuraSafe saves a heartbeat snapshot (last GPS coordinates, battery level, and connectivity state) every 10 seconds. If the connection drops or the session closes unexpectedly, the last known emergency snapshot is preserved in Emergency History and queued for guardian review once connectivity returns.\\n          </p>\\n\\n          <p className=\\\"text-[11px] text-[#6B6182] leading-relaxed rounded-xl bg-[#FAF8FF] border border-violet-200/70 p-3\\\">\\n            <strong>Honest technical limitation:</strong> Software cannot detect every type of physical phone damage or continue recording after complete power loss. Snapshot preservation ensures whatever data existed prior to interruption is never lost.\\n          </p>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2.5 pt-1\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onSimulateConnectivityDrop}\\n              className=\\\"flex-1 min-h-[42px] px-4 py-2 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-xs font-semibold cursor-pointer whitespace-nowrap\\\"\\n            >\\n              Simulate Sudden Disconnect Event\\n            </button>\\n\\n            {primaryGuardian && (\\n              <a\\n                href={`tel:${formatPhoneForTel(primaryGuardian.phone)}`}\\n                className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-white hover:bg-[#FAF8FF] border border-violet-200 text-[#1A132B] text-xs font-semibold inline-flex items-center gap-1.5 whitespace-nowrap\\\"\\n              >\\n                <Phone className=\\\"w-3.5 h-3.5 text-violet-700\\\" />\\n                <span>Call Guardian</span>\\n              </a>\\n            )}\\n          </div>\\n        </div>\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create dedicated ThreatModePage with MediaRecorder audio/video recording, IndexedDB saving, guardian activation logs, battery/network heartbeat continuity preservation, and honest physical damage disclaimer\", \"Overwrite\":true, \"TargetFile\":\"/src/components/pages/ThreatModePage.tsx\", \"toolAction\":\"Creating ThreatModePage component\", \"toolSummary\":\"Create ThreatModePage component\"}"
      original_name: "write_to_file"
    }
