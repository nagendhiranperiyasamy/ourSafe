      id: "call_3924338514678655887"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport {\\n  AlertCircle,\\n  ArrowLeft,\\n  ArrowRight,\\n  CheckCircle2,\\n  Eye,\\n  EyeOff,\\n  Info,\\n  ShieldCheck,\\n  Smartphone,\\n  UserCheck,\\n  X,\\n} from \'lucide-react\';\\nimport { UserProfile } from \'../types/safety\';\\nimport {\\n  DEFAULT_PREFERENCES,\\n  generateDemoOtp,\\n  isValidEmail,\\n  isValidPhoneNumber,\\n  normalizePhone,\\n  registerUser,\\n} from \'../utils/storage\';\\nimport { BrandLogo } from \'./BrandLogo\';\\n\\ninterface SignupScreenProps {\\n  onSignupComplete: (user: UserProfile) => void;\\n  onNavigateLogin: () => void;\\n}\\n\\ninterface OtpState {\\n  generatedCode: string | null;\\n  enteredCode: string;\\n  verified: boolean;\\n  verifiedForPhone: string | null;\\n  feedback: string;\\n  error: string;\\n}\\n\\nconst INITIAL_OTP: OtpState = {\\n  generatedCode: null,\\n  enteredCode: \'\',\\n  verified: false,\\n  verifiedForPhone: null,\\n  feedback: \'\',\\n  error: \'\',\\n};\\n\\nexport const SignupScreen: React.FC<SignupScreenProps> = ({\\n  onSignupComplete,\\n  onNavigateLogin,\\n}) => {\\n  const [fullName, setFullName] = useState(\'\');\\n  const [phone, setPhone] = useState(\'\');\\n  const [email, setEmail] = useState(\'\');\\n  const [age, setAge] = useState(\'\');\\n  const [guardianName, setGuardianName] = useState(\'\');\\n  const [guardianPhone, setGuardianPhone] = useState(\'\');\\n  const [password, setPassword] = useState(\'\');\\n  const [confirmPassword, setConfirmPassword] = useState(\'\');\\n\\n  const [showPassword, setShowPassword] = useState(false);\\n  const [showConfirmPassword, setShowConfirmPassword] = useState(false);\\n\\n  const [userOtp, setUserOtp] = useState<OtpState>(INITIAL_OTP);\\n  const [guardianOtp, setGuardianOtp] = useState<OtpState>(INITIAL_OTP);\\n\\n  const [errors, setErrors] = useState<Record<string, string>>({});\\n  const [submitError, setSubmitError] = useState(\'\');\\n  const [createdUser, setCreatedUser] = useState<UserProfile | null>(null);\\n  const [showGoogleNotice, setShowGoogleNotice] = useState(false);\\n\\n  const handlePhoneChange = (value: string) => {\\n    setPhone(value);\\n    if (\\n      userOtp.verifiedForPhone &&\\n      normalizePhone(value) !== normalizePhone(userOtp.verifiedForPhone)\\n    ) {\\n      setUserOtp(INITIAL_OTP);\\n    }\\n    if (errors.phone) setErrors((p) => ({ ...p, phone: \'\' }));\\n  };\\n\\n  const handleGuardianPhoneChange = (value: string) => {\\n    setGuardianPhone(value);\\n    if (\\n      guardianOtp.verifiedForPhone &&\\n      normalizePhone(value) !== normalizePhone(guardianOtp.verifiedForPhone)\\n    ) {\\n      setGuardianOtp(INITIAL_OTP);\\n    }\\n    if (errors.guardianPhone) setErrors((p) => ({ ...p, guardianPhone: \'\' }));\\n  };\\n\\n  const handleSendOtp = (target: \'user\' | \'guardian\') => {\\n    const numberToVerify = target === \'user\' ? phone : guardianPhone;\\n    const setter = target === \'user\' ? setUserOtp : setGuardianOtp;\\n\\n    if (!isValidPhoneNumber(numberToVerify)) {\\n      setter((prev) => ({\\n        ...prev,\\n        error: \'Enter a valid 10 to 15 digit phone number before requesting a demo OTP.\',\\n        feedback: \'\',\\n      }));\\n      return;\\n    }\\n\\n    if (\\n      target === \'guardian\' &&\\n      isValidPhoneNumber(phone) &&\\n      normalizePhone(phone) === normalizePhone(guardianPhone)\\n    ) {\\n      setter((prev) => ({\\n        ...prev,\\n        error: \'Guardian phone number should be different from your own phone number.\',\\n        feedback: \'\',\\n      }));\\n      return;\\n    }\\n\\n    const code = generateDemoOtp();\\n    setter({\\n      generatedCode: code,\\n      enteredCode: \'\',\\n      verified: false,\\n      verifiedForPhone: null,\\n      error: \'\',\\n      feedback: `Demo OTP generated for ${numberToVerify.trim()}. No real SMS is sent.`,\\n    });\\n  };\\n\\n  const handleVerifyOtp = (target: \'user\' | \'guardian\') => {\\n    const state = target === \'user\' ? userOtp : guardianOtp;\\n    const numberToVerify = target === \'user\' ? phone : guardianPhone;\\n    const setter = target === \'user\' ? setUserOtp : setGuardianOtp;\\n\\n    if (!state.generatedCode) {\\n      setter((prev) => ({\\n        ...prev,\\n        error: \'Click \\\"Send Demo OTP\\\" first to generate a prototype verification code.\',\\n      }));\\n      return;\\n    }\\n\\n    if (state.enteredCode.trim() !== state.generatedCode) {\\n      setter((prev) => ({\\n        ...prev,\\n        error: \'Code does not match the displayed demo OTP. Check the 6-digit number and try again.\',\\n      }));\\n      return;\\n    }\\n\\n    setter((prev) => ({\\n      ...prev,\\n      verified: true,\\n      verifiedForPhone: numberToVerify.trim(),\\n      error: \'\',\\n      feedback: \'Demo verification complete.\',\\n    }));\\n    setErrors((prev) => ({\\n      ...prev,\\n      [target === \'user\' ? \'userOtp\' : \'guardianOtp\']: \'\',\\n    }));\\n  };\\n\\n  const handleSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setSubmitError(\'\');\\n    const nextErrors: Record<string, string> = {};\\n\\n    if (!fullName.trim() || fullName.trim().length < 2) {\\n      nextErrors.fullName = \'Enter your full name (at least 2 characters).\';\\n    }\\n    if (!isValidPhoneNumber(phone)) {\\n      nextErrors.phone = \'Enter a valid phone number (10 to 15 digits).\';\\n    }\\n    if (!isValidEmail(email)) {\\n      nextErrors.email = \'Enter a valid email address.\';\\n    }\\n    const numericAge = Number(age);\\n    if (!age || Number.isNaN(numericAge) || numericAge < 13 || numericAge > 120) {\\n      nextErrors.age = \'Enter a valid age between 13 and 120.\';\\n    }\\n    if (!guardianName.trim() || guardianName.trim().length < 2) {\\n      nextErrors.guardianName = \'Enter your primary guardian name.\';\\n    }\\n    if (!isValidPhoneNumber(guardianPhone)) {\\n      nextErrors.guardianPhone = \'Enter a valid guardian phone number (10 to 15 digits).\';\\n    } else if (\\n      isValidPhoneNumber(phone) &&\\n      normalizePhone(phone) === normalizePhone(guardianPhone)\\n    ) {\\n      nextErrors.guardianPhone =\\n        \'Guardian phone number must be different from your phone number.\';\\n    }\\n    if (password.length < 6) {\\n      nextErrors.password = \'Password must be at least 6 characters.\';\\n    }\\n    if (confirmPassword !== password) {\\n      nextErrors.confirmPassword = \'Passwords do not match.\';\\n    }\\n    if (!userOtp.verified) {\\n      nextErrors.userOtp = \'Complete the demo OTP check for your phone number.\';\\n    }\\n    if (!guardianOtp.verified) {\\n      nextErrors.guardianOtp = \'Complete the demo OTP check for your guardian phone number.\';\\n    }\\n\\n    setErrors(nextErrors);\\n    if (Object.keys(nextErrors).length > 0) {\\n      setSubmitError(\'Please review the highlighted fields and complete both demo OTP checks.\');\\n      return;\\n    }\\n\\n    const profile: UserProfile = {\\n      id: `user-${Date.now()}`,\\n      fullName: fullName.trim(),\\n      phone: phone.trim(),\\n      email: email.trim(),\\n      age: numericAge,\\n      guardianName: guardianName.trim(),\\n      guardianPhone: guardianPhone.trim(),\\n      password,\\n      createdAt: new Date().toISOString(),\\n      sosContacts: [\\n        {\\n          id: `contact-${Date.now()}`,\\n          name: guardianName.trim(),\\n          phone: guardianPhone.trim(),\\n          relation: \'Primary Guardian\',\\n          isPrimary: true,\\n        },\\n      ],\\n      preferences: { ...DEFAULT_PREFERENCES },\\n    };\\n\\n    const result = registerUser(profile);\\n    if (!result.ok) {\\n      setSubmitError(result.error ?? \'Could not complete registration.\');\\n      return;\\n    }\\n\\n    setCreatedUser(profile);\\n  };\\n\\n  if (createdUser) {\\n    return (\\n      <div className=\\\"min-h-screen bg-[#FAF8FF] flex flex-col\\\">\\n        <header className=\\\"w-full border-b border-violet-200/70 bg-white/90 backdrop-blur-md\\\">\\n          <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between\\\">\\n            <BrandLogo />\\n          </div>\\n        </header>\\n        <main className=\\\"flex-1 flex items-center justify-center p-4 sm:p-6\\\">\\n          <div className=\\\"w-full max-w-lg bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-10 shadow-sm text-center\\\">\\n            <div className=\\\"w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center mx-auto mb-5\\\">\\n              <CheckCircle2 className=\\\"w-7 h-7\\\" />\\n            </div>\\n            <p className=\\\"text-xs font-semibold text-emerald-700\\\">\\n              Registration Complete \302\267 Local Prototype Profile Saved\\n            </p>\\n            <h1 className=\\\"mt-2 text-2xl sm:text-3xl font-bold text-[#1A132B]\\\">\\n              Welcome to AuraSafe, {createdUser.fullName}\\n            </h1>\\n            <p className=\\\"mt-3 text-sm text-[#574E6B] leading-relaxed\\\">\\n              Your profile and primary guardian ({createdUser.guardianName}) have been saved to this browser so you can sign back in anytime.\\n            </p>\\n\\n            <div className=\\\"mt-6 rounded-2xl bg-[#F4F0FF] border border-violet-200/70 p-4 text-left space-y-2 text-sm\\\">\\n              <div className=\\\"flex items-center justify-between gap-4\\\">\\n                <span className=\\\"text-[#574E6B]\\\">Your Phone</span>\\n                <span className=\\\"font-mono tabular-nums font-semibold text-[#1A132B]\\\">\\n                  {createdUser.phone}\\n                </span>\\n              </div>\\n              <div className=\\\"flex items-center justify-between gap-4\\\">\\n                <span className=\\\"text-[#574E6B]\\\">Primary Guardian</span>\\n                <span className=\\\"font-semibold text-[#1A132B]\\\">\\n                  {createdUser.guardianName}\\n                </span>\\n              </div>\\n              <div className=\\\"flex items-center justify-between gap-4\\\">\\n                <span className=\\\"text-[#574E6B]\\\">Guardian Phone</span>\\n                <span className=\\\"font-mono tabular-nums font-semibold text-[#1A132B]\\\">\\n                  {createdUser.guardianPhone}\\n                </span>\\n              </div>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onSignupComplete(createdUser)}\\n              className=\\\"mt-7 w-full min-h-[48px] px-5 py-3 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer\\\"\\n            >\\n              <span>Continue to Home Dashboard</span>\\n              <ArrowRight className=\\\"w-4 h-4\\\" />\\n            </button>\\n          </div>\\n        </main>\\n      </div>\\n    );\\n  }\\n\\n  return (\\n    <div className=\\\"min-h-screen bg-[#FAF8FF] flex flex-col\\\">\\n      {/* Top Bar */}\\n      <header className=\\\"w-full border-b border-violet-200/70 bg-white/90 backdrop-blur-md sticky top-0 z-20\\\">\\n        <div className=\\\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4\\\">\\n          <BrandLogo />\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onNavigateLogin}\\n            className=\\\"min-h-[44px] px-4 py-2 text-sm font-semibold text-violet-700 hover:bg-violet-50 rounded-xl flex items-center gap-1.5 transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n          >\\n            <ArrowLeft className=\\\"w-4 h-4\\\" />\\n            <span>Back to Sign In</span>\\n          </button>\\n        </div>\\n      </header>\\n\\n      <main className=\\\"flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-10\\\">\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\\\">\\n          {/* Left Context Summary */}\\n          <aside className=\\\"lg:col-span-4 space-y-6 lg:sticky lg:top-24\\\">\\n            <div>\\n              <p className=\\\"text-xs font-semibold text-violet-700\\\">\\n                Profile Setup \302\267 Round 1 Prototype\\n              </p>\\n              <h1 className=\\\"mt-2 text-2xl sm:text-3xl font-bold text-[#1A132B] leading-tight\\\">\\n                Create your personal safety profile\\n              </h1>\\n              <p className=\\\"mt-3 text-sm text-[#574E6B] leading-relaxed\\\">\\n                Register your details and link a trusted primary guardian so Travel Mode, Threat Mode, and SOS confirmation are ready from day one.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl bg-[#F4F0FF] border border-violet-200/70 p-5 space-y-3\\\">\\n              <div className=\\\"flex items-center gap-2 text-sm font-semibold text-[#1A132B]\\\">\\n                <ShieldCheck className=\\\"w-4 h-4 text-violet-700 shrink-0\\\" />\\n                <span>Prototype Transparency</span>\\n              </div>\\n              <p className=\\\"text-xs text-[#4A4063] leading-relaxed\\\">\\n                Your account and contacts are stored locally in this browser via LocalStorage. OTP checks below run a clearly labelled frontend demo flow\342\200\224no real SMS messages are sent.\\n              </p>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => setShowGoogleNotice(true)}\\n              className=\\\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-white hover:bg-[#FAF8FF] border border-violet-200 text-[#1A132B] text-sm font-semibold flex items-center justify-center gap-2.5 transition-colors cursor-pointer\\\"\\n            >\\n              <svg className=\\\"w-4 h-4 shrink-0\\\" viewBox=\\\"0 0 24 24\\\" aria-hidden=\\\"true\\\">\\n                <path\\n                  fill=\\\"#4285F4\\\"\\n                  d=\\\"M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z\\\"\\n                />\\n                <path\\n                  fill=\\\"#34A853\\\"\\n                  d=\\\"M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z\\\"\\n                />\\n                <path\\n                  fill=\\\"#FBBC05\\\"\\n                  d=\\\"M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z\\\"\\n                />\\n                <path\\n                  fill=\\\"#EA4335\\\"\\n                  d=\\\"M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z\\\"\\n                />\\n              </svg>\\n              <span>Continue with Google</span>\\n            </button>\\n          </aside>\\n\\n          {/* Right Full Registration Form */}\\n          <section className=\\\"lg:col-span-8 bg-white rounded-3xl border border-violet-200/80 p-6 sm:p-8 shadow-sm shadow-violet-950/[0.03]\\\">\\n            {submitError && (\\n              <div\\n                role=\\\"alert\\\"\\n                className=\\\"mb-6 rounded-2xl bg-red-50 border border-red-200 p-4 flex items-start gap-2.5 text-sm text-red-800\\\"\\n              >\\n                <AlertCircle className=\\\"w-4 h-4 text-red-600 shrink-0 mt-0.5\\\" />\\n                <span>{submitError}</span>\\n              </div>\\n            )}\\n\\n            <form onSubmit={handleSubmit} noValidate className=\\\"space-y-8\\\">\\n              {/* Section 1: Personal Details */}\\n              <div>\\n                <h2 className=\\\"text-lg font-bold text-[#1A132B]\\\">\\n                  1. Personal Details\\n                </h2>\\n                <p className=\\\"text-xs text-[#6B6182] mt-0.5\\\">\\n                  Used for your dashboard profile and emergency identification\\n                </p>\\n\\n                <div className=\\\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div className=\\\"sm:col-span-2\\\">\\n                    <label\\n                      htmlFor=\\\"reg-fullname\\\"\\n                      className=\\\"block text-sm font-semibold text-[#1A132B] mb-1.5\\\"\\n                    >\\n                      Full Name\\n                    </label>\\n                    <input\\n                      id=\\\"reg-fullname\\\"\\n                      type=\\\"text\\\"\\n                      value={fullName}\\n                      onChange={(e) => {\\n                        setFullName(e.target.value);\\n                        if (errors.fullName) setErrors((p) => ({ ...p, fullName: \'\' }));\\n                      }}\\n                      placeholder=\\\"Enter your full name\\\"\\n                      className={`w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#FAF8FF] border text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-600/20 ${\\n                        errors.fullName ? \'border-red-400\' : \'border-violet-200 focus:border-violet-600\'\\n                      }`}\\n                    />\\n                    {errors.fullName && (\\n                      <p className=\\\"mt-1 text-xs text-red-600 font-medium\\\">{errors.fullName}</p>\\n                    )}\\n                  </div>\\n\\n                  <div>\\n                    <label\\n                      htmlFor=\\\"reg-phone\\\"\\n                      className=\\\"block text-sm font-semibold text-[#1A132B] mb-1.5\\\"\\n                    >\\n                      Phone Number\\n                    </label>\\n                    <input\\n                      id=\\\"reg-phone\\\"\\n                      type=\\\"tel\\\"\\n                      value={phone}\\n                      onChange={(e) => handlePhoneChange(e.target.value)}\\n                      placeholder=\\\"e.g. 9876543210\\\"\\n                      className={`w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#FAF8FF] border text-sm font-mono tabular-nums focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-600/20 ${\\n                        errors.phone ? \'border-red-400\' : \'border-violet-200 focus:border-violet-600\'\\n                      }`}\\n                    />\\n                    {errors.phone && (\\n                      <p className=\\\"mt-1 text-xs text-red-600 font-medium\\\">{errors.phone}</p>\\n                    )}\\n                  </div>\\n\\n                  <div>\\n                    <label\\n                      htmlFor=\\\"reg-age\\\"\\n                      className=\\\"block text-sm font-semibold text-[#1A132B] mb-1.5\\\"\\n                    >\\n                      Age\\n                    </label>\\n                    <input\\n                      id=\\\"reg-age\\\"\\n                      type=\\\"number\\\"\\n                      min={13}\\n                      max={120}\\n                      value={age}\\n                      onChange={(e) => {\\n                        setAge(e.target.value);\\n                        if (errors.age) setErrors((p) => ({ ...p, age: \'\' }));\\n                      }}\\n                      placeholder=\\\"e.g. 24\\\"\\n                      className={`w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#FAF8FF] border text-sm tabular-nums focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-600/20 ${\\n                        errors.age ? \'border-red-400\' : \'border-violet-200 focus:border-violet-600\'\\n                      }`}\\n                    />\\n                    {errors.age && (\\n                      <p className=\\\"mt-1 text-xs text-red-600 font-medium\\\">{errors.age}</p>\\n                    )}\\n                  </div>\\n\\n                  <div className=\\\"sm:col-span-2\\\">\\n                    <label\\n                      htmlFor=\\\"reg-email\\\"\\n                      className=\\\"block text-sm font-semibold text-[#1A132B] mb-1.5\\\"\\n                    >\\n                      Email Address\\n                    </label>\\n                    <input\\n                      id=\\\"reg-email\\\"\\n                      type=\\\"email\\\"\\n                      value={email}\\n                      onChange={(e) => {\\n                        setEmail(e.target.value);\\n                        if (errors.email) setErrors((p) => ({ ...p, email: \'\' }));\\n                      }}\\n                      placeholder=\\\"you@example.com\\\"\\n                      className={`w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#FAF8FF] border text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-600/20 ${\\n                        errors.email ? \'border-red-400\' : \'border-violet-200 focus:border-violet-600\'\\n                      }`}\\n                    />\\n                    {errors.email && (\\n                      <p className=\\\"mt-1 text-xs text-red-600 font-medium\\\">{errors.email}</p>\\n                    )}\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <hr className=\\\"border-violet-100\\\" />\\n\\n              {/* Section 2: Primary Guardian Details */}\\n              <div>\\n                <h2 className=\\\"text-lg font-bold text-[#1A132B]\\\">\\n                  2. Primary Guardian Information\\n                </h2>\\n                <p className=\\\"text-xs text-[#6B6182] mt-0.5\\\">\\n                  Automatically added as your primary SOS and Travel Mode emergency contact\\n                </p>\\n\\n                <div className=\\\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div>\\n                    <label\\n                      htmlFor=\\\"reg-guardian-name\\\"\\n                      className=\\\"block text-sm font-semibold text-[#1A132B] mb-1.5\\\"\\n                    >\\n                      Guardian Name\\n                    </label>\\n                    <input\\n                      id=\\\"reg-guardian-name\\\"\\n                      type=\\\"text\\\"\\n                      value={guardianName}\\n                      onChange={(e) => {\\n                        setGuardianName(e.target.value);\\n                        if (errors.guardianName)\\n                          setErrors((p) => ({ ...p, guardianName: \'\' }));\\n                      }}\\n                      placeholder=\\\"Trusted family member or friend\\\"\\n                      className={`w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#FAF8FF] border text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-600/20 ${\\n                        errors.guardianName\\n                          ? \'border-red-400\'\\n                          : \'border-violet-200 focus:border-violet-600\'\\n                      }`}\\n                    />\\n                    {errors.guardianName && (\\n                      <p className=\\\"mt-1 text-xs text-red-600 font-medium\\\">\\n                        {errors.guardianName}\\n                      </p>\\n                    )}\\n                  </div>\\n\\n                  <div>\\n                    <label\\n                      htmlFor=\\\"reg-guardian-phone\\\"\\n                      className=\\\"block text-sm font-semibold text-[#1A132B] mb-1.5\\\"\\n                    >\\n                      Guardian Phone Number\\n                    </label>\\n                    <input\\n                      id=\\\"reg-guardian-phone\\\"\\n                      type=\\\"tel\\\"\\n                      value={guardianPhone}\\n                      onChange={(e) => handleGuardianPhoneChange(e.target.value)}\\n                      placeholder=\\\"e.g. 9820112233\\\"\\n                      className={`w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#FAF8FF] border text-sm font-mono tabular-nums focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-600/20 ${\\n                        errors.guardianPhone\\n                          ? \'border-red-400\'\\n                          : \'border-violet-200 focus:border-violet-600\'\\n                      }`}\\n                    />\\n                    {errors.guardianPhone && (\\n                      <p className=\\\"mt-1 text-xs text-red-600 font-medium\\\">\\n                        {errors.guardianPhone}\\n                      </p>\\n                    )}\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <hr className=\\\"border-violet-100\\\" />\\n\\n              {/* Section 3: Separate Demo OTP Verifications */}\\n              <div>\\n                <div className=\\\"flex flex-wrap items-baseline justify-between gap-2\\\">\\n                  <h2 className=\\\"text-lg font-bold text-[#1A132B]\\\">\\n                    3. Demo OTP Verification\\n                  </h2>\\n                  <span className=\\\"text-xs font-medium text-violet-700\\\">\\n                    Frontend Simulation \302\267 No real SMS sent\\n                  </span>\\n                </div>\\n                <p className=\\\"text-xs text-[#6B6182] mt-1\\\">\\n                  Verify both your phone number and your guardian&apos;s phone number using the simulated prototype codes below.\\n                </p>\\n\\n                <div className=\\\"mt-4 grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n                  {/* User Phone OTP */}\\n                  <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/80 p-4 flex flex-col justify-between space-y-3\\\">\\n                    <div>\\n                      <div className=\\\"flex items-center justify-between gap-2\\\">\\n                        <span className=\\\"text-sm font-bold text-[#1A132B] flex items-center gap-1.5\\\">\\n                          <Smartphone className=\\\"w-4 h-4 text-violet-700 shrink-0\\\" />\\n                          <span>User Phone OTP</span>\\n                        </span>\\n                        <span\\n                          className={`text-xs font-semibold ${\\n                            userOtp.verified ? \'text-emerald-700\' : \'text-[#6B6182]\'\\n                          }`}\\n                        >\\n                          {userOtp.verified ? \'Verified\' : \'Not verified\'}\\n                        </span>\\n                      </div>\\n\\n                      <p className=\\\"text-xs text-[#574E6B] mt-1 font-mono tabular-nums\\\">\\n                        {phone.trim() || \'Enter your phone number above\'}\\n                      </p>\\n\\n                      {userOtp.generatedCode && !userOtp.verified && (\\n                        <div className=\\\"mt-2.5 rounded-xl bg-[#F3EEFF] border border-violet-200 px-3 py-2 text-xs text-violet-950\\\">\\n                          Demo Mode Code:{\' \'}\\n                          <span className=\\\"font-mono font-bold tracking-wider tabular-nums\\\">\\n                            {userOtp.generatedCode}\\n                          </span>\\n                        </div>\\n                      )}\\n                    </div>\\n\\n                    <div className=\\\"space-y-2.5\\\">\\n                      <div className=\\\"flex gap-2\\\">\\n                        <input\\n                          type=\\\"text\\\"\\n                          inputMode=\\\"numeric\\\"\\n                          maxLength={6}\\n                          disabled={userOtp.verified}\\n                          value={userOtp.enteredCode}\\n                          onChange={(e) =>\\n                            setUserOtp((prev) => ({\\n                              ...prev,\\n                              enteredCode: e.target.value.replace(/\\\\D/g, \'\'),\\n                              error: \'\',\\n                            }))\\n                          }\\n                          placeholder=\\\"6-digit OTP\\\"\\n                          aria-label=\\\"User phone demo OTP\\\"\\n                          className=\\\"w-full min-h-[44px] px-3 py-2 rounded-xl bg-white border border-violet-200 text-sm font-mono tabular-nums focus:border-violet-600 focus:outline-none disabled:bg-violet-50/50 disabled:text-[#73698A]\\\"\\n                        />\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => handleSendOtp(\'user\')}\\n                          disabled={userOtp.verified}\\n                          className=\\\"min-h-[44px] px-3.5 py-2 rounded-xl bg-[#F3EEFF] hover:bg-violet-100 text-violet-800 text-xs font-semibold whitespace-nowrap shrink-0 transition-colors disabled:opacity-50 cursor-pointer\\\"\\n                        >\\n                          {userOtp.generatedCode ? \'Resend OTP\' : \'Send OTP\'}\\n                        </button>\\n                      </div>\\n\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => handleVerifyOtp(\'user\')}\\n                        disabled={userOtp.verified}\\n                        className=\\\"w-full min-h-[44px] px-4 py-2 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-xs font-semibold transition-colors disabled:bg-emerald-600 disabled:cursor-default cursor-pointer\\\"\\n                      >\\n                        {userOtp.verified ? \'User Phone Verified (Demo)\' : \'Verify User OTP\'}\\n                      </button>\\n\\n                      {userOtp.error && (\\n                        <p className=\\\"text-xs text-red-600 font-medium\\\">{userOtp.error}</p>\\n                      )}\\n                      {errors.userOtp && !userOtp.error && (\\n                        <p className=\\\"text-xs text-red-600 font-medium\\\">{errors.userOtp}</p>\\n                      )}\\n                      {userOtp.feedback && !userOtp.error && (\\n                        <p className=\\\"text-xs text-emerald-700 font-medium\\\">\\n                          {userOtp.feedback}\\n                        </p>\\n                      )}\\n                    </div>\\n                  </div>\\n\\n                  {/* Guardian Phone OTP */}\\n                  <div className=\\\"rounded-2xl bg-[#FAF8FF] border border-violet-200/80 p-4 flex flex-col justify-between space-y-3\\\">\\n                    <div>\\n                      <div className=\\\"flex items-center justify-between gap-2\\\">\\n                        <span className=\\\"text-sm font-bold text-[#1A132B] flex items-center gap-1.5\\\">\\n                          <UserCheck className=\\\"w-4 h-4 text-violet-700 shrink-0\\\" />\\n                          <span>Guardian Phone OTP</span>\\n                        </span>\\n                        <span\\n                          className={`text-xs font-semibold ${\\n                            guardianOtp.verified ? \'text-emerald-700\' : \'text-[#6B6182]\'\\n                          }`}\\n                        >\\n                          {guardianOtp.verified ? \'Verified\' : \'Not verified\'}\\n                        </span>\\n                      </div>\\n\\n                      <p className=\\\"text-xs text-[#574E6B] mt-1 font-mono tabular-nums\\\">\\n                        {guardianPhone.trim() || \'Enter guardian phone number above\'}\\n                      </p>\\n\\n                      {guardianOtp.generatedCode && !guardianOtp.verified && (\\n                        <div className=\\\"mt-2.5 rounded-xl bg-[#F3EEFF] border border-violet-200 px-3 py-2 text-xs text-violet-950\\\">\\n                          Demo Mode Code:{\' \'}\\n                          <span className=\\\"font-mono font-bold tracking-wider tabular-nums\\\">\\n                            {guardianOtp.generatedCode}\\n                          </span>\\n                        </div>\\n                      )}\\n                    </div>\\n\\n                    <div className=\\\"space-y-2.5\\\">\\n                      <div className=\\\"flex gap-2\\\">\\n                        <input\\n                          type=\\\"text\\\"\\n                          inputMode=\\\"numeric\\\"\\n                          maxLength={6}\\n                          disabled={guardianOtp.verified}\\n                          value={guardianOtp.enteredCode}\\n                          onChange={(e) =>\\n                            setGuardianOtp((prev) => ({\\n                              ...prev,\\n                              enteredCode: e.target.value.replace(/\\\\D/g, \'\'),\\n                              error: \'\',\\n                            }))\\n                          }\\n                          placeholder=\\\"6-digit OTP\\\"\\n                          aria-label=\\\"Guardian phone demo OTP\\\"\\n                          className=\\\"w-full min-h-[44px] px-3 py-2 rounded-xl bg-white border border-violet-200 text-sm font-mono tabular-nums focus:border-violet-600 focus:outline-none disabled:bg-violet-50/50 disabled:text-[#73698A]\\\"\\n                        />\\n                        <button\\n                          type=\\\"button\\\"\\n                          onClick={() => handleSendOtp(\'guardian\')}\\n                          disabled={guardianOtp.verified}\\n                          className=\\\"min-h-[44px] px-3.5 py-2 rounded-xl bg-[#F3EEFF] hover:bg-violet-100 text-violet-800 text-xs font-semibold whitespace-nowrap shrink-0 transition-colors disabled:opacity-50 cursor-pointer\\\"\\n                        >\\n                          {guardianOtp.generatedCode ? \'Resend OTP\' : \'Send OTP\'}\\n                        </button>\\n                      </div>\\n\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => handleVerifyOtp(\'guardian\')}\\n                        disabled={guardianOtp.verified}\\n                        className=\\\"w-full min-h-[44px] px-4 py-2 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-xs font-semibold transition-colors disabled:bg-emerald-600 disabled:cursor-default cursor-pointer\\\"\\n                      >\\n                        {guardianOtp.verified\\n                          ? \'Guardian Phone Verified (Demo)\'\\n                          : \'Verify Guardian OTP\'}\\n                      </button>\\n\\n                      {guardianOtp.error && (\\n                        <p className=\\\"text-xs text-red-600 font-medium\\\">{guardianOtp.error}</p>\\n                      )}\\n                      {errors.guardianOtp && !guardianOtp.error && (\\n                        <p className=\\\"text-xs text-red-600 font-medium\\\">\\n                          {errors.guardianOtp}\\n                        </p>\\n                      )}\\n                      {guardianOtp.feedback && !guardianOtp.error && (\\n                        <p className=\\\"text-xs text-emerald-700 font-medium\\\">\\n                          {guardianOtp.feedback}\\n                        </p>\\n                      )}\\n                    </div>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <hr className=\\\"border-violet-100\\\" />\\n\\n              {/* Section 4: Account Security */}\\n              <div>\\n                <h2 className=\\\"text-lg font-bold text-[#1A132B]\\\">\\n                  4. Account Security\\n                </h2>\\n                <p className=\\\"text-xs text-[#6B6182] mt-0.5\\\">\\n                  Choose a password for signing back into your prototype profile\\n                </p>\\n\\n                <div className=\\\"mt-4 grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                  <div>\\n                    <label\\n                      htmlFor=\\\"reg-password\\\"\\n                      className=\\\"block text-sm font-semibold text-[#1A132B] mb-1.5\\\"\\n                    >\\n                      Password\\n                    </label>\\n                    <div className=\\\"relative\\\">\\n                      <input\\n                        id=\\\"reg-password\\\"\\n                        type={showPassword ? \'text\' : \'password\'}\\n                        value={password}\\n                        onChange={(e) => {\\n                          setPassword(e.target.value);\\n                          if (errors.password) setErrors((p) => ({ ...p, password: \'\' }));\\n                        }}\\n                        placeholder=\\\"At least 6 characters\\\"\\n                        className={`w-full min-h-[46px] pl-4 pr-11 py-2.5 rounded-xl bg-[#FAF8FF] border text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-600/20 ${\\n                          errors.password\\n                            ? \'border-red-400\'\\n                            : \'border-violet-200 focus:border-violet-600\'\\n                        }`}\\n                      />\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => setShowPassword((p) => !p)}\\n                        aria-label={showPassword ? \'Hide password\' : \'Show password\'}\\n                        className=\\\"absolute right-1.5 top-1/2 -translate-y-1/2 min-w-[40px] min-h-[40px] flex items-center justify-center text-[#6C6284] hover:text-violet-700 rounded-lg cursor-pointer\\\"\\n                      >\\n                        {showPassword ? (\\n                          <EyeOff className=\\\"w-4 h-4\\\" />\\n                        ) : (\\n                          <Eye className=\\\"w-4 h-4\\\" />\\n                        )}\\n                      </button>\\n                    </div>\\n                    {errors.password && (\\n                      <p className=\\\"mt-1 text-xs text-red-600 font-medium\\\">\\n                        {errors.password}\\n                      </p>\\n                    )}\\n                  </div>\\n\\n                  <div>\\n                    <label\\n                      htmlFor=\\\"reg-confirm-password\\\"\\n                      className=\\\"block text-sm font-semibold text-[#1A132B] mb-1.5\\\"\\n                    >\\n                      Confirm Password\\n                    </label>\\n                    <div className=\\\"relative\\\">\\n                      <input\\n                        id=\\\"reg-confirm-password\\\"\\n                        type={showConfirmPassword ? \'text\' : \'password\'}\\n                        value={confirmPassword}\\n                        onChange={(e) => {\\n                          setConfirmPassword(e.target.value);\\n                          if (errors.confirmPassword)\\n                            setErrors((p) => ({ ...p, confirmPassword: \'\' }));\\n                        }}\\n                        placeholder=\\\"Re-enter password\\\"\\n                        className={`w-full min-h-[46px] pl-4 pr-11 py-2.5 rounded-xl bg-[#FAF8FF] border text-sm focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-600/20 ${\\n                          errors.confirmPassword\\n                            ? \'border-red-400\'\\n                            : \'border-violet-200 focus:border-violet-600\'\\n                        }`}\\n                      />\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={() => setShowConfirmPassword((p) => !p)}\\n                        aria-label={\\n                          showConfirmPassword ? \'Hide confirm password\' : \'Show confirm password\'\\n                        }\\n                        className=\\\"absolute right-1.5 top-1/2 -translate-y-1/2 min-w-[40px] min-h-[40px] flex items-center justify-center text-[#6C6284] hover:text-violet-700 rounded-lg cursor-pointer\\\"\\n                      >\\n                        {showConfirmPassword ? (\\n                          <EyeOff className=\\\"w-4 h-4\\\" />\\n                        ) : (\\n                          <Eye className=\\\"w-4 h-4\\\" />\\n                        )}\\n                      </button>\\n                    </div>\\n                    {errors.confirmPassword && (\\n                      <p className=\\\"mt-1 text-xs text-red-600 font-medium\\\">\\n                        {errors.confirmPassword}\\n                      </p>\\n                    )}\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"pt-2 flex flex-col sm:flex-row items-center justify-between gap-4\\\">\\n                <p className=\\\"text-xs text-[#6B6182]\\\">\\n                  Already registered?{\' \'}\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={onNavigateLogin}\\n                    className=\\\"font-semibold text-violet-700 hover:underline cursor-pointer\\\"\\n                  >\\n                    Sign in here\\n                  </button>\\n                </p>\\n                <button\\n                  type=\\\"submit\\\"\\n                  className=\\\"w-full sm:w-auto min-h-[48px] px-7 py-3 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold flex items-center justify-center gap-2 transition-colors shadow-sm shadow-violet-900/15 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <span>Create Account</span>\\n                  <ArrowRight className=\\\"w-4 h-4\\\" />\\n                </button>\\n              </div>\\n            </form>\\n          </section>\\n        </div>\\n      </main>\\n\\n      {/* Honest Google OAuth Notice Modal */}\\n      {showGoogleNotice && (\\n        <div\\n          className=\\\"fixed inset-0 z-50 bg-[#1A132B]/50 backdrop-blur-sm flex items-center justify-center p-4\\\"\\n          role=\\\"dialog\\\"\\n          aria-modal=\\\"true\\\"\\n          aria-labelledby=\\\"signup-google-notice\\\"\\n        >\\n          <div className=\\\"w-full max-w-md bg-white rounded-3xl border border-violet-200 p-6 shadow-xl\\\">\\n            <div className=\\\"flex items-start justify-between gap-4 mb-3\\\">\\n              <div className=\\\"flex items-center gap-2.5\\\">\\n                <div className=\\\"w-10 h-10 rounded-xl bg-[#F3EEFF] text-violet-700 flex items-center justify-center shrink-0\\\">\\n                  <Info className=\\\"w-5 h-5\\\" />\\n                </div>\\n                <h3\\n                  id=\\\"signup-google-notice\\\"\\n                  className=\\\"text-lg font-bold text-[#1A132B]\\\"\\n                >\\n                  Google Registration Requires OAuth\\n                </h3>\\n              </div>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowGoogleNotice(false)}\\n                aria-label=\\\"Close modal\\\"\\n                className=\\\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#6B6182] hover:bg-violet-50 cursor-pointer\\\"\\n              >\\n                <X className=\\\"w-5 h-5\\\" />\\n              </button>\\n            </div>\\n\\n            <p className=\\\"text-sm text-[#4A4063] leading-relaxed\\\">\\n              Continuing with Google requires backend OAuth 2.0 integration and verified redirect credentials, which are outside the Round 1 frontend prototype scope.\\n            </p>\\n            <p className=\\\"mt-2.5 text-sm text-[#4A4063] leading-relaxed\\\">\\n              Complete the registration form on this screen to save your prototype profile locally and access the Home Dashboard immediately.\\n            </p>\\n\\n            <div className=\\\"mt-5 flex justify-end\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setShowGoogleNotice(false)}\\n                className=\\\"min-h-[44px] px-5 py-2 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold cursor-pointer\\\"\\n              >\\n                Continue with Form\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Build Screen 2 (Registration / Profile Setup) with all 8 required fields, validation, separate User and Guardian Demo OTP verifications, and honest Google OAuth notice\", \"Overwrite\":true, \"TargetFile\":\"/src/components/SignupScreen.tsx\", \"toolAction\":\"Creating SignupScreen component\", \"toolSummary\":\"Create SignupScreen component\"}"
      original_name: "write_to_file"
    }
