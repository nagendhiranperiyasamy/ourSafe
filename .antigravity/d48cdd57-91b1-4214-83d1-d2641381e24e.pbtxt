    end_line: 358
    content: "import React, { useState } from \'react\';\nimport {\n  Check,\n  Pencil,\n  Phone,\n  Plus,\n  Star,\n  Trash2,\n  UserPlus,\n  X,\n} from \'lucide-react\';\nimport { SosContact } from \'../../types/safety\';\nimport { formatPhoneForTel, isValidPhoneNumber } from \'../../utils/storage\';\n\ninterface SosContactsModalProps {\n  contacts: SosContact[];\n  onSaveContacts: (nextContacts: SosContact[]) => void;\n  onClose: () => void;\n}\n\nexport const SosContactsModal: React.FC<SosContactsModalProps> = ({\n  contacts,\n  onSaveContacts,\n  onClose,\n}) => {\n  const [isAdding, setIsAdding] = useState(contacts.length === 0);\n  const [name, setName] = useState(\'\');\n  const [phone, setPhone] = useState(\'\');\n  const [relation, setRelation] = useState(\'Guardian\');\n  const [formError, setFormError] = useState(\'\');\n\n  const [editingId, setEditingId] = useState<string | null>(null);\n  const [editName, setEditName] = useState(\'\');\n  const [editPhone, setEditPhone] = useState(\'\');\n  const [editRelation, setEditRelation] = useState(\'\');\n  const [editError, setEditError] = useState(\'\');\n\n  const handleAddContact = (e: React.FormEvent) => {\n    e.preventDefault();\n    setFormError(\'\');\n\n    if (!name.trim() || name.trim().length < 2) {\n      setFormError(\'Enter a guardian name (at least 2 characters).\');\n      return;\n    }\n    if (!isValidPhoneNumber(phone)) {\n      setFormError(\'Enter a valid phone number (10 to 15 digits).\');\n      return;\n    }\n\n    const newContact: SosContact = {\n      id: `contact-${Date.now()}`,\n      name: name.trim(),\n      phone: phone.trim(),\n      relation: relation.trim() || \'Emergency Contact\',\n      isPrimary: contacts.length === 0,\n    };\n\n    onSaveContacts([...contacts, newContact]);\n    setName(\'\');\n    setPhone(\'\');\n    setRelation(\'Guardian\');\n    setIsAdding(false);\n  };\n\n  const startEdit = (contact: SosContact) => {\n    setEditingId(contact.id);\n    setEditName(contact.name);\n    setEditPhone(contact.phone);\n    setEditRelation(contact.relation);\n    setEditError(\'\');\n  };\n\n  const saveEdit = (id: string) => {\n    setEditError(\'\');\n    if (!editName.trim() || editName.trim().length < 2) {\n      setEditError(\'Name must be at least 2 characters.\');\n      return;\n    }\n    if (!isValidPhoneNumber(editPhone)) {\n      setEditError(\'Enter a valid phone number (10 to 15 digits).\');\n      return;\n    }\n\n    const next = contacts.map((c) =>\n      c.id === id\n        ? {\n            ...c,\n            name: editName.trim(),\n            phone: editPhone.trim(),\n            relation: editRelation.trim() || \'Emergency Contact\',\n          }\n        : c\n    );\n    onSaveContacts(next);\n    setEditingId(null);\n  };\n\n  const handleDelete = (id: string) => {\n    const remaining = contacts.filter((c) => c.id !== id);\n    if (remaining.length > 0 && !remaining.some((c) => c.isPrimary)) {\n      remaining[0] = { ...remaining[0], isPrimary: true };\n    }\n    onSaveContacts(remaining);\n  };\n\n  const handleMakePrimary = (id: string) => {\n    const next = contacts.map((c) => ({ ...c, isPrimary: c.id === id }));\n    onSaveContacts(next);\n  };\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 bg-[#1A132B]/55 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"sos-contacts-heading\"\n    >\n      <div className=\"w-full max-w-xl bg-white rounded-3xl border border-violet-200 p-6 sm:p-7 shadow-2xl my-auto max-h-[90vh] overflow-y-auto\">\n        <div className=\"flex items-start justify-between gap-4 mb-5\">\n          <div>\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Emergency Circle \302\267 Local Storage\n            </p>\n            <h2\n              id=\"sos-contacts-heading\"\n              className=\"text-xl font-bold text-[#1A132B] mt-0.5\"\n            >\n              Manage SOS Contacts\n            </h2>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onClose}\n            aria-label=\"Close contacts manager\"\n            className=\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#6B6182] hover:bg-violet-50 cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Add SOS Number Trigger / Form */}\n        {!isAdding ? (\n          <button\n            type=\"button\"\n            onClick={() => {\n              setIsAdding(true);\n              setFormError(\'\');\n            }}\n            className=\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold flex items-center justify-center gap-2 transition-colors mb-5 cursor-pointer\"\n          >\n            <Plus className=\"w-4 h-4\" />\n            <span>Add SOS Number</span>\n          </button>\n        ) : (\n          <form\n            onSubmit={handleAddContact}\n            className=\"mb-5 rounded-2xl bg-[#F4F0FF] border border-violet-200 p-4 space-y-3\"\n          >\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-sm font-bold text-[#1A132B] flex items-center gap-1.5\">\n                <UserPlus className=\"w-4 h-4 text-violet-700\" />\n                <span>Add New Emergency Contact</span>\n              </span>\n              {contacts.length > 0 && (\n                <button\n                  type=\"button\"\n                  onClick={() => setIsAdding(false)}\n                  className=\"text-xs font-semibold text-[#574E6B] hover:text-[#1A132B] cursor-pointer\"\n                >\n                  Cancel\n                </button>\n              )}\n            </div>\n\n            {formError && (\n              <p className=\"text-xs font-medium text-red-600\">{formError}</p>\n            )}\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Guardian Name\n                </label>\n                <input\n                  type=\"text\"\n                  value={name}\n                  onChange={(e) => setName(e.target.value)}\n                  placeholder=\"e.g. Meera Nair\"\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-white border border-violet-200 text-sm focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Guardian Phone Number\n                </label>\n                <input\n                  type=\"tel\"\n                  value={phone}\n                  onChange={(e) => setPhone(e.target.value)}\n                  placeholder=\"e.g. 9820112233\"\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-white border border-violet-200 text-sm font-mono tabular-nums focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-12 gap-3 items-end\">\n              <div className=\"sm:col-span-7\">\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Relationship\n                </label>\n                <input\n                  type=\"text\"\n                  value={relation}\n                  onChange={(e) => setRelation(e.target.value)}\n                  placeholder=\"Mother, Sister, Friend, Partner...\"\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-white border border-violet-200 text-sm focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n              <div className=\"sm:col-span-5\">\n                <button\n                  type=\"submit\"\n                  className=\"w-full min-h-[44px] px-4 py-2 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold cursor-pointer\"\n                >\n                  Save Contact\n                </button>\n              </div>\n            </div>\n          </form>\n        )}\n\n        {/* Saved Contacts List */}\n        {contacts.length === 0 ? (\n          <p className=\"text-sm text-[#6B6182] text-center py-6\">\n            No SOS contacts saved yet. Add at least one trusted guardian above.\n          </p>\n        ) : (\n          <div className=\"divide-y divide-violet-100 border border-violet-200/70 rounded-2xl overflow-hidden\">\n            {contacts.map((contact) => {\n              const isEditing = editingId === contact.id;\n              return (\n                <div key={contact.id} className=\"p-4 bg-white\">\n                  {isEditing ? (\n                    <div className=\"space-y-3\">\n                      {editError && (\n                        <p className=\"text-xs font-medium text-red-600\">{editError}</p>\n                      )}\n                      <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2.5\">\n                        <input\n                          type=\"text\"\n                          value={editName}\n                          onChange={(e) => setEditName(e.target.value)}\n                          placeholder=\"Name\"\n                          aria-label=\"Edit guardian name\"\n                          className=\"min-h-[42px] px-3 py-1.5 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                        />\n                        <input\n                          type=\"tel\"\n                          value={editPhone}\n                          onChange={(e) => setEditPhone(e.target.value)}\n                          placeholder=\"Phone\"\n                          aria-label=\"Edit guardian phone\"\n                          className=\"min-h-[42px] px-3 py-1.5 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm font-mono tabular-nums focus:bg-white focus:border-violet-600 focus:outline-none\"\n                        />\n                        <input\n                          type=\"text\"\n                          value={editRelation}\n                          onChange={(e) => setEditRelation(e.target.value)}\n                          placeholder=\"Relation\"\n                          aria-label=\"Edit relation\"\n                          className=\"min-h-[42px] px-3 py-1.5 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                        />\n                      </div>\n                      <div className=\"flex items-center justify-end gap-2\">\n                        <button\n                          type=\"button\"\n                          onClick={() => setEditingId(null)}\n                          className=\"min-h-[38px] px-3 py-1.5 rounded-lg text-xs font-semibold text-[#574E6B] hover:bg-violet-50 cursor-pointer\"\n                        >\n                          Cancel\n                        </button>\n                        <button\n                          type=\"button\"\n                          onClick={() => saveEdit(contact.id)}\n                          className=\"min-h-[38px] px-3.5 py-1.5 rounded-lg bg-violet-700 hover:bg-violet-800 text-white text-xs font-semibold flex items-center gap-1 cursor-pointer\"\n                        >\n                          <Check className=\"w-3.5 h-3.5\" />\n                          <span>Save</span>\n                        </button>\n                      </div>\n                    </div>\n                  ) : (\n                    <div className=\"flex flex-wrap items-center justify-between gap-3\">\n                      <div className=\"min-w-0\">\n                        <div className=\"flex items-center gap-2 text-sm font-bold text-[#1A132B]\">\n                          <span className=\"truncate\">{contact.name}</span>\n                          {contact.isPrimary && (\n                            <span className=\"text-xs font-semibold text-violet-700\">\n                              \302\267 Primary\n                            </span>\n                          )}\n                        </div>\n                        <p className=\"text-xs text-[#6B6182] mt-0.5\">\n                          <span className=\"font-mono tabular-nums\">\n                            {contact.phone}\n                          </span>{\' \'}\n                          \302\267 {contact.relation || \'Emergency Contact\'}\n                        </p>\n                      </div>\n\n                      <div className=\"flex items-center gap-1.5\">\n                        {!contact.isPrimary && (\n                          <button\n                            type=\"button\"\n                            onClick={() => handleMakePrimary(contact.id)}\n                            title=\"Set as Primary Guardian\"\n                            className=\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#6B6182] hover:text-violet-700 hover:bg-violet-50 transition-colors cursor-pointer\"\n                          >\n                            <Star className=\"w-4 h-4\" />\n                          </button>\n                        )}\n                        <a\n                          href={`tel:${formatPhoneForTel(contact.phone)}`}\n                          title={`Call ${contact.name}`}\n                          className=\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-violet-700 hover:bg-violet-50 transition-colors\"\n                        >\n                          <Phone className=\"w-4 h-4\" />\n                        </a>\n                        <button\n                          type=\"button\"\n                          onClick={() => startEdit(contact)}\n                          aria-label={`Edit ${contact.name}`}\n                          className=\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#574E6B] hover:text-violet-700 hover:bg-violet-50 transition-colors cursor-pointer\"\n                        >\n                          <Pencil className=\"w-4 h-4\" />\n                        </button>\n                        <button\n                          type=\"button\"\n                          onClick={() => handleDelete(contact.id)}\n                          aria-label={`Delete ${contact.name}`}\n                          className=\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#574E6B] hover:text-red-600 hover:bg-red-50 transition-colors cursor-pointer\"\n                        >\n                          <Trash2 className=\"w-4 h-4\" />\n                        </button>\n                      </div>\n                    </div>\n                  )}\n                </div>\n              );\n            })}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 359
    num_bytes: 14677
    line_range_bytes: 14677
  }
}
