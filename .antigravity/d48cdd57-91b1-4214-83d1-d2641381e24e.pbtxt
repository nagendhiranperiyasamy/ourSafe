      thinking_signature: "\022\202\005\n\377\004\001i\024}\023\347\037\005\367%<\260\245I\'\343\353&T\361\373\226ax\223\354\307l\224\332T\v\333\363j\347\251~\000Y<\261B]\215\177}\202Yl\305:\005\242\305~V\222Kr\217H\234\027#CH\350\314\025c\033\246\232\240k\023\000\254\206\307d)|\346\271\266=\017\025\363\232\327\256+\273u!6S\3233f\206_\034\331T\230\320\002\304hH\"\352\300RY\332\365\304\267f\251\343f.\2222\023f\313\a:\370\267\025V\343\025\221\365\016\257i\303\245l\036\372\305\340T\377\364\3627x:\260\235\2677\031n\313drr\tU\371Ni\206\374i\202\241\225l\2364\'\'\323\376\327\317\214\r\277L\215\353y\276\344K\337\336\212\233\a\231\031\314\330%\037V\210\325\330S8\310\313i\021\333M\226\365\216\226\207\000!\376\326b\201\312\273\213\322\234\207qiA\266\232\240Y\305\346.\343\356A\321\372\345cp\276\327\034b\036\005\216k\322F\253\310\264\373\214\227\'+\211\322\334h\177,A ]\206:\r\271\206\355>\005\211\t\373 \270\336$S\354\234(\254k~\024\345\314\250\"!\320[\335\363\200\341;\215\\~\311yu\233\357\337R\272\006\236\200\255\000.#\v\306\276\a\231\257m\315\"\246\333\312p\221\332\320\224a\344R\2664\033\320\v!\255\317\361\245\272D\272}w\224\245\350\221\006&\341\377)\301\246\3033\v&\"\305N\244\026g\240\v\243\230-\016[Y\203>\023x\225\226Z\034?\310\352\250\2272:\177\270w\212z;JM\315\320\246A\276^\'[=yn\025c}\254\317\332\247b7hN\256z\250J$3\205\361\310\310L\377\247\260\0230\234\260:\220|\216\020\242\242\245y\335,\253\342\266\370\333\376\251?\350-@(g\227h\271Wz\f\247W\331T\036*!x8\005\311p!\355\0321\245\265\270D\255c\036S\221<\257*\223U_\274\017\251\2511OVC\207\243\210\031\377\363=\220\3735\2752\016\'\016\002\2630\025N0\201/\236\306\234\002#\324Nqm\361\277\023\236\353\323G\354\204,\307\317#|1\347io<f\235\350\350HC\374\370\3375>Q#\345dt\362\362\357!/\220P\264\261\3775\304\033\363\"F\277q\006\025I\026\252h\033\331\035;_\225\243\256d\210\305x1\006"
