      arguments_json: "{\"CodeContent\":\"@import \\\"tailwindcss\\\";\\n\\n@theme {\\n  --font-display: \\\"Plus Jakarta Sans\\\", -apple-system, BlinkMacSystemFont, sans-serif;\\n  --font-sans: \\\"DM Sans\\\", -apple-system, BlinkMacSystemFont, sans-serif;\\n  --font-mono: \\\"JetBrains Mono\\\", ui-monospace, SFMono-Regular, monospace;\\n}\\n\\n@layer base {\\n  html {\\n    font-family: var(--font-sans);\\n    scroll-behavior: smooth;\\n    color: #1A132B;\\n    background-color: #FAF8FF;\\n  }\\n\\n  h1, h2, h3, h4 {\\n    font-family: var(--font-display);\\n    text-wrap: balance;\\n  }\\n\\n  button, a, input, select, textarea {\\n    outline-color: #6D28D9;\\n  }\\n}\\n\\n.tabular-nums {\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n@media (prefers-reduced-motion: reduce) {\\n  *, *::before, *::after {\\n    animation-duration: 0.01ms !important;\\n    animation-iteration-count: 1 !important;\\n    transition-duration: 0.01ms !important;\\n    scroll-behavior: auto !important;\\n  }\\n}\\n\", \"Description\":\"Configure global typography tokens, accessibility defaults, and reduced motion rules in src/index.css\", \"Overwrite\":true, \"TargetFile\":\"/src/index.css\", \"toolAction\":\"Updating global stylesheet\", \"toolSummary\":\"Update index.css\"}"
