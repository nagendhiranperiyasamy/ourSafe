el = Array.from(document.querySelectorAll(\"link\")).find((e) => !outdatedLinkTags.has(e) && cleanUrl(e.href).includes(searchUrl));\t\t\t\tif (!el) return;\t\t\t\tconst browserUrl = moduleUrlToBrowserUrl(`${searchUrl}${searchUrl.includes(\"?\") ? \"&\" : \"?\"}t=${timestamp}`, base);\t\t\t\treturn new Promise((resolve) => {\t\t\t\t\tconst newLinkTag = el.cloneNode();\t\t\t\t\tnewLinkTag.href = new URL(browserUrl, el.href).href;\t\t\t\t\tconst removeOldEl = () => {\t\t\t\t\t\tel.remove();\t\t\t\t\t\tconsole.debug(`[vite] css hot updated: ${searchUrl}`);\t\t\t\t\t\tresolve();\t\t\t\t\t};\t\t\t\t\tnewLinkTag.addEventListener(\"load\", removeOldEl);\t\t\t\t\tnewLinkTag.addEventListener(\"error\", removeOldEl);\t\t\t\t\toutdatedLinkTags.add(el);\t\t\t\t\tel.after(newLinkTag);\t\t\t\t});\t\t\t}));\t\t\tawait activeHmrClient.notifyListeners(\"vite:afterUpdate\", payload);\t\t\tbreak;\t\tcase \"custom\":\t\t\tawait activeHmrClient.notifyListeners(payload.event, payload.data);\t\t\tif (payload.event === \"vite:ws:disconnect\") {\t\t\t\tif (hasDocument && !willUnload) {\t\t\t\t\tconsole.log(`[vite] server connection lost. Polling for restart...`);\t\t\t\t\tconst socket = payload.data.webSocket;\t\t\t\t\tconst url = new URL(socket.url);\t\t\t\t\turl.search = \"\";\t\t\t\t\tawait waitForSuccessfulPing(url.href);\t\t\t\t\tlocation.reload();\t\t\t\t}\t\t\t}\t\t\tbreak;\t\tcase \"full-reload\":\t\t\tif (payload.ifFallback && !globalThis.__vite_is_fallback_page__) break;\t\t\tawait activeHmrClient.notifyListeners(\"vite:beforeFullReload\", payload);\t\t\tif (hasDocument) {\t\t\t\tif (payload.path && payload.path.endsWith(\".html\")) {\t\t\t\t\tconst pagePath = decodeURI(location.pathname);\t\t\t\t\tconst payloadPath = base + payload.path.slice(1);\t\t\t\t\tif (pagePath === payloadPath || payload.path === \"/index.html\" || pagePath.endsWith(\"/\") && pagePath + \"index.html\" === payloadPath) pageReload();\t\t\t\t\treturn;"
