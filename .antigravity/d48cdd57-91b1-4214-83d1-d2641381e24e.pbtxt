  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect } from \'react\';\nimport {\n  CheckCircle2,\n  Clock,\n  LocateFixed,\n  MapPin,\n  Phone,\n  Radio,\n  Send,\n  Shield,\n  ShieldAlert,\n  Users,\n  Wifi,\n  WifiOff,\n} from \'lucide-react\';\nimport {\n  AlertDeliveryStatus,\n  GeoLocationState,\n  LiveLocationShareSession,\n  SosAlertRecord,\n  SosContact,\n} from \'../../types/safety\';\nimport { formatDateTimeShort, formatPhoneForTel } from \'../../utils/storage\';\n\ninterface SosPageProps {\n  userName: string;\n  contacts: SosContact[];\n  geoLocation: GeoLocationState;\n  isOnline: boolean;\n  latestSosAlert: SosAlertRecord | null;\n  liveLocationShare: LiveLocationShareSession | null;\n  quickDialEnabled: boolean;\n  onRequestLocation: () => void;\n  onTriggerSosAlert: (triggerSource: string, note?: string) => void;\n  onClearSosStatus: () => void;\n  onToggleLiveLocationShare: (active: boolean, durationMinutes?: number) => void;\n  onToggleQuickDial: () => void;\n  onOpenContacts: () => void;\n  onOpenNearbyPolice: () => void;\n}\n\nconst STATUS_LABELS: Record<AlertDeliveryStatus, { text: string; tone: string }> = {\n  standby: { text: \'Standby \342\200\224 Ready\', tone: \'text-[#574E6B]\' },\n  initiated: { text: \'Initiated \342\200\224 Preparing Dispatch\', tone: \'text-amber-700\' },\n  delivered_demo: {\n    text: \'Alert Logged (Prototype Demo \342\200\224 No Real SMS Sent)\',\n    tone: \'text-emerald-700\',\n  },\n  queued_offline: {\n    text: \'Offline \342\200\224 Preserved Locally (Will Queue Until Online)\',\n    tone: \'text-amber-800\',\n  },\n  failed: { text: \'Delivery Failed \342\200\224 No Contacts Configured\', tone: \'text-red-700\' },\n};\n\nexport const SosPage: React.FC<SosPageProps> = ({\n  userName,\n  contacts,\n  geoLocation,\n  isOnline,\n  latestSosAlert,\n  liveLocationShare,\n  quickDialEnabled,\n  onRequestLocation,\n  onTriggerSosAlert,\n  onClearSosStatus,\n  onToggleLiveLocationShare,\n  onToggleQuickDial,\n  onOpenContacts,\n  onOpenNearbyPolice,\n}) => {\n  const primaryGuardian = contacts.find((c) => c.isPrimary) ?? contacts[0];\n  const hasCoords =\n    geoLocation.status === \'granted\' &&\n    geoLocation.latitude !== null &&\n    geoLocation.longitude !== null;\n\n  useEffect(() => {\n    if (geoLocation.status === \'idle\') {\n      onRequestLocation();\n    }\n  }, [geoLocation.status, onRequestLocation]);\n\n  const currentStatus: AlertDeliveryStatus = latestSosAlert?.status ?? \'standby\';\n  const statusMeta = STATUS_LABELS[currentStatus];\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Top Emergency Hero Banner */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\">\n        <div className=\"lg:col-span-7 rounded-3xl bg-red-600 text-white p-6 sm:p-8 flex flex-col justify-between gap-6 shadow-md shadow-red-900/15\">\n          <div className=\"space-y-2\">\n            <div className=\"flex flex-wrap items-center gap-2 text-xs font-semibold text-red-100\">\n              <span>SOS Emergency Controller</span>\n              <span aria-hidden=\"true\">\302\267</span>\n              <span>{isOnline ? \'Online\' : \'Offline Mode Active\'}</span>\n            </div>\n            <h1 className=\"text-2xl sm:text-3xl font-bold tracking-tight\">\n              Immediate Emergency Assistance\n            </h1>\n            <p className=\"text-sm text-red-50/90 leading-relaxed max-w-xl\">\n              Trigger SOS manually or by saying &ldquo;Open SOS&rdquo; to the AI Voice Assistant. This workflow captures your live GPS location, prepares guardian alerts, and surfaces one-tap emergency dialing.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-3\">\n            <button\n              type=\"button\"\n              onClick={() => onTriggerSosAlert(\'Manual SOS Page Button\')}\n              className=\"flex-1 min-w-[210px] min-h-[54px] px-6 py-3 rounded-2xl bg-white hover:bg-red-50 active:scale-[0.99] text-red-700 text-base font-extrabold flex items-center justify-center gap-2 transition-all shadow-sm cursor-pointer whitespace-nowrap\"\n            >\n              <ShieldAlert className=\"w-5 h-5\" />\n              <span>Send SOS Emergency Alert</span>\n            </button>\n\n            {primaryGuardian && (\n              <a\n                href={`tel:${formatPhoneForTel(primaryGuardian.phone)}`}\n                className=\"min-h-[54px] px-5 py-3 rounded-2xl bg-red-800/75 hover:bg-red-900 border border-white/25 text-white text-sm font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\"\n              >\n                <Phone className=\"w-4 h-4\" />\n                <span>Call {primaryGuardian.name}</span>\n              </a>\n            )}\n          </div>\n        </div>\n\n        {/* Emergency Status Tracker */}\n        <div className=\"lg:col-span-5 bg-white rounded-3xl border border-violet-200/80 p-6 flex flex-col justify-between gap-4 shadow-sm\">\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center justify-between gap-2\">\n              <p className=\"text-xs font-semibold text-violet-700\">\n                Emergency Status Tracker\n              </p>\n              {latestSosAlert && (\n                <button\n                  type=\"button\"\n                  onClick={onClearSosStatus}\n                  className=\"text-xs font-semibold text-[#574E6B] hover:text-[#1A132B] cursor-pointer\"\n                >\n                  Reset Status\n                </button>\n              )}\n            </div>\n\n            <div>\n              <p className={`text-base font-bold ${statusMeta.tone}`}>\n                {statusMeta.text}\n              </p>\n              {latestSosAlert ? (\n                <p className=\"mt-1 text-xs text-[#6B6182] flex items-center gap-1.5 tabular-nums\">\n                  <Clock className=\"w-3.5 h-3.5\" />\n                  <span>\n                    Activated {formatDateTimeShort(latestSosAlert.activatedAt)} via{\' \'}\n                    {latestSosAlert.triggerSource}\n                  </span>\n                </p>\n              ) : (\n                <p className=\"mt-1 text-xs text-[#6B6182]\">\n                  No active SOS dispatch. Press the red SOS button or use voice command &ldquo;Open SOS&rdquo;.\n                </p>\n              )}\n            </div>\n\n            {latestSosAlert && (\n              <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-3.5 space-y-2 text-xs\">\n                <p className=\"font-semibold text-[#1A132B]\">\n                  Alert Payload Prepared for {latestSosAlert.recipients.length} Contact(s)\n                </p>\n                <p className=\"font-mono text-[11px] text-[#4A4063] leading-relaxed\">\n                  &ldquo;SOS from {userName}. Need immediate assistance. GPS:{\' \'}\n                  {latestSosAlert.latitude !== null && latestSosAlert.longitude !== null\n                    ? `${latestSosAlert.latitude.toFixed(5)}, ${latestSosAlert.longitude.toFixed(5)}`\n                    : \'Location unavailable\'}\n                  .&rdquo;\n                </p>\n                {latestSosAlert.recipients.length > 0 && (\n                  <div className=\"pt-2 border-t border-violet-100 space-y-1\">\n                    {latestSosAlert.recipients.map((r, i) => (\n                      <div\n                        key={`${r.phone}-${i}`}\n                        className=\"flex items-center justify-between gap-2 text-[11px]\"\n                      >\n                        <span className=\"font-semibold text-[#1A132B]\">\n                          {r.name}\n                        </span>\n                        <span className=\"text-[#574E6B] capitalize\">\n                          {r.status.replace(\'_\', \' \')}\n                        </span>\n                      </div>\n                    ))}\n                  </div>\n                )}\n              </div>\n            )}\n          </div>\n\n          <div className=\"pt-3 border-t border-violet-100 flex items-center justify-between gap-3\">\n            <div className=\"text-xs text-[#4A4063]\">\n              <p className=\"font-semibold text-[#1A132B]\">\n                Voice SOS Call Prompt Preference\n              </p>\n              <p className=\"text-[11px] text-[#6B6182]\">\n                Highlight direct guardian dialer immediately when voice triggers SOS\n              </p>\n            </div>\n            <button\n              type=\"button\"\n              role=\"switch\"\n              aria-checked={quickDialEnabled}\n              onClick={onToggleQuickDial}\n              className={`w-11 h-6 rounded-full p-0.5 transition-colors shrink-0 cursor-pointer flex items-center ${\n                quickDialEnabled\n                  ? \'bg-violet-700 justify-end\'\n                  : \'bg-violet-200 justify-start\'\n              }`}\n            >\n              <span className=\"w-5 h-5 rounded-full bg-white shadow-sm block\" />\n            </button>\n          </div>\n        </div>\n      </section>\n\n      {/* Live Location Sharing + Nearest Police Station */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        <div className=\"lg:col-span-6 bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\">\n          <div className=\"flex flex-wrap items-center justify-between gap-2\">\n            <div>\n              <p className=\"text-xs font-semibold text-violet-700\">\n                Live Location Sharing\n              </p>\n              <h2 className=\"text-lg font-bold text-[#1A132B] mt-0.5\">\n                Current GPS Coordinates\n              </h2>\n            </div>\n            <button\n              type=\"button\"\n              onClick={onRequestLocation}\n              className=\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-800 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\"\n            >\n              <LocateFixed className=\"w-3.5 h-3.5\" />\n              <span>Refresh GPS</span>\n            </button>\n          </div>\n\n          <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-4 space-y-2\">\n            <div className=\"flex items-center gap-2 text-sm font-semibold text-[#1A132B]\">\n              <MapPin className=\"w-4 h-4 text-violet-700\" />\n              <span>\n                {hasCoords\n                  ? `${geoLocation.latitude!.toFixed(6)}, ${geoLocation.longitude!.toFixed(6)}`\n                  : geoLocation.status === \'loading\'\n                    ? \'Locating device...\'\n                    : \'Location permission needed\'}\n              </span>\n            </div>\n            <p className=\"text-xs text-[#6B6182]\">\n              {hasCoords\n                ? `Accuracy \302\261${Math.round(geoLocation.accuracy ?? 0)}m \302\267 Ready to attach to emergency alerts`\n                : geoLocation.errorMessage ||\n                  \'Grant browser location permission to share exact coordinates with guardians.\'}\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center justify-between gap-3 pt-1\">\n            <div className=\"text-xs text-[#4A4063]\">\n              <p className=\"font-semibold text-[#1A132B] flex items-center gap-1.5\">\n                <Radio className=\"w-4 h-4 text-violet-700\" />\n                <span>\n                  {liveLocationShare?.active\n                    ? `Sharing Active (${liveLocationShare.sharedWithNames.length} contact(s))`\n                    : \'Live Location Sharing Standby\'}\n                </span>\n              </p>\n              <p className=\"text-[11px] text-[#6B6182] mt-0.5\">\n                {liveLocationShare?.active\n                  ? `Started ${formatDateTimeShort(liveLocationShare.startedAt)} \302\267 Local session tracking`\n                  : \'Starts a local live-location session linked to your trusted guardians.\'}\n              </p>\n            </div>\n\n            <button\n              type=\"button\"\n              onClick={() =>\n                onToggleLiveLocationShare(!liveLocationShare?.active, 30)\n              }\n              className={`min-h-[42px] px-4 py-2 rounded-xl text-xs font-semibold transition-colors whitespace-nowrap cursor-pointer ${\n                liveLocationShare?.active\n                  ? \'bg-red-50 hover:bg-red-100 border border-red-200 text-red-700\'\n                  : \'bg-violet-700 hover:bg-violet-800 text-white\'\n              }`}\n            >\n              {liveLocationShare?.active\n                ? \'Stop Location Share\'\n                : \'Share Live Location\'}\n            </button>\n          </div>\n        </div>\n\n        {/* Nearest Police Station & Authorities */}\n        <div className=\"lg:col-span-6 bg-white rounded-3xl border border-violet-200/80 p-6 flex flex-col justify-between gap-4\">\n          <div className=\"space-y-2\">\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Immediate Law Enforcement Access\n            </p>\n            <h2 className=\"text-lg font-bold text-[#1A132B]\">\n              Contact Nearest Police Station\n            </h2>\n            <p className=\"text-xs text-[#574E6B] leading-relaxed\">\n              Reach official emergency dispatch immediately via your phone dialer, or open the Nearby Police Stations lookup centered on your live GPS coordinates.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <a\n              href=\"tel:100\"\n              className=\"min-h-[48px] px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\"\n            >\n              <Phone className=\"w-4 h-4\" />\n              <span>Call Police (100)</span>\n            </a>\n            <a\n              href=\"tel:112\"\n              className=\"min-h-[48px] px-4 py-2.5 rounded-xl bg-red-50 hover:bg-red-100 border border-red-200 text-red-800 text-sm font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\"\n            >\n              <Shield className=\"w-4 h-4\" />\n              <span>Emergency (112)</span>\n            </a>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onOpenNearbyPolice}\n            className=\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-sm font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer\"\n          >\n            <MapPin className=\"w-4 h-4 text-violet-700\" />\n            <span>Open Nearby Police Stations</span>\n          </button>\n        </div>\n      </section>\n\n      {/* Trusted Guardian Network & Offline Support Notice */}\n      <section className=\"grid grid-cols-1 lg:grid-cols-12 gap-6\">\n        <div className=\"lg:col-span-7 bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\">\n          <div className=\"flex items-center justify-between gap-3\">\n            <div>\n              <p className=\"text-xs font-semibold text-violet-700\">\n                Trusted Guardian Network ({contacts.length})\n              </p>\n              <h2 className=\"text-lg font-bold text-[#1A132B] mt-0.5\">\n                Registered Emergency Contacts\n              </h2>\n            </div>\n            <button\n              type=\"button\"\n              onClick={onOpenContacts}\n              className=\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-800 text-xs font-semibold flex items-center gap-1.5 cursor-pointer whitespace-nowrap\"\n            >\n              <Users className=\"w-3.5 h-3.5\" />\n              <span>Manage Network</span>\n            </button>\n          </div>\n\n          {contacts.length === 0 ? (\n            <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-5 text-center space-y-3\">\n              <p className=\"text-sm text-[#574E6B]\">\n                No emergency contacts registered yet.\n              </p>\n              <button\n                type=\"button\"\n                onClick={onOpenContacts}\n                className=\"min-h-[42px] px-4 py-2 rounded-xl bg-violet-700 text-white text-xs font-semibold cursor-pointer\"\n              >\n                Add Trusted Guardian\n              </button>\n            </div>\n          ) : (\n            <div className=\"divide-y divide-violet-100 border border-violet-200/70 rounded-2xl overflow-hidden\">\n              {contacts.map((c) => (\n                <div\n                  key={c.id}\n                  className=\"p-4 bg-white flex flex-wrap items-center justify-between gap-3\"\n                >\n                  <div className=\"min-w-0\">\n                    <p className=\"text-sm font-bold text-[#1A132B]\">\n                      {c.name}\n                      {c.isPrimary ? \' \302\267 Primary Guardian\' : \'\'}\n                    </p>\n                    <p className=\"text-xs text-[#6B6182] font-mono tabular-nums mt-0.5\">\n                      {c.phone} \302\267 {c.relation || \'Emergency Contact\'}\n                    </p>\n                  </div>\n\n                  <div className=\"flex items-center gap-2\">\n                    <button\n                      type=\"button\"\n                      onClick={() =>\n                        onTriggerSosAlert(`Direct Alert to ${c.name}`)\n                      }\n                      className=\"min-h-[40px] px-3 py-1.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\"\n                    >\n                      <Send className=\"w-3.5 h-3.5\" />\n                      <span>Alert</span>\n                    </button>\n                    <a\n                      href={`tel:${formatPhoneForTel(c.phone)}`}\n                      className=\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-semibold inline-flex items-center gap-1.5 whitespace-nowrap\"\n                    >\n                      <Phone className=\"w-3.5 h-3.5\" />\n                      <span>Call</span>\n                    </a>\n                  </div>\n                </div>\n              ))}\n            </div>\n          )}\n        </div>\n\n        {/* Emergency Offline Support Card */}\n        <div className=\"lg:col-span-5 bg-white rounded-3xl border border-violet-200/80 p-6 space-y-4\">\n          <div className=\"flex items-center justify-between gap-2\">\n            <div>\n              <p className=\"text-xs font-semibold text-violet-700\">\n                Emergency Offline Support\n              </p>\n              <h2 className=\"text-lg font-bold text-[#1A132B] mt-0.5\">\n                Connectivity &amp; Offline Readiness\n              </h2>\n            </div>\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-[#1A132B]\">\n              {isOnline ? (\n                <>\n                  <Wifi className=\"w-4 h-4 text-emerald-600\" />\n                  <span className=\"text-emerald-700\">Online</span>\n                </>\n              ) : (\n                <>\n                  <WifiOff className=\"w-4 h-4 text-amber-600\" />\n                  <span className=\"text-amber-700\">Offline</span>\n                </>\n              )}\n            </div>\n          </div>\n\n          <div className=\"space-y-3 text-xs\">\n            <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-4 space-y-1.5\">\n              <p className=\"font-bold text-emerald-800 flex items-center gap-1.5\">\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n                <span>Available Offline (Cached Locally)</span>\n              </p>\n              <p className=\"text-[#4A4063] leading-relaxed\">\n                Saved guardian numbers, direct <code className=\"font-mono\">tel:</code> emergency calling (112, 181, 100, 108, 1098), Threat Mode audio/video recording, local Evidence History, and Fake Call.\n              </p>\n            </div>\n\n            <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-4 space-y-1.5\">\n              <p className=\"font-bold text-[#1A132B]\">\n                Requires Internet Connection\n              </p>\n              <p className=\"text-[#574E6B] leading-relaxed\">\n                Real-time Gemini Live Voice AI conversations, online Maps searches, and future cloud SMS/WhatsApp alert delivery to guardians.\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/pages/SosPage.tsx"
        }
        overwrite: true
      }
    }
