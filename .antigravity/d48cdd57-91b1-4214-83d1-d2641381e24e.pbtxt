      thinking_signature: "\022\203\006\n\200\006\001i\024}\023q\261\030\005\357o}\366lW\265\305\234\215\347\273\266\357\355\241t8L\203=\232\246\333]wc\322%v];\004\r\362\351\231\307x\360el\327\006\3429Jmf\037\300\216\245\307A\301\340^63th\253\017a\201d\367\233\000lFF\225\325z\367\356k\345\310\220\357V\310\306\247\032I/\\\312\243%Zc^\365\235\330\223\rCK\205)\a\034\377l\250\346\202\237\342\240\375B\032\271#\263\367\203T\326\275 \311p\346\2213\200\323\'q\325\340T\2779\267\036O\274)\202\336\032T\341\032\002{\225\346,\251\032 -\325w-)\252\r\024\270\2679!\030_j\300.F\206u\267\251\'%\024\263\261\020\367\362(\327B\320ca>W\000\222\306\362X\240.\360\f\223\211\353B,I\n\224\256\266\271\020~\224Ya)\230\277\241\261\243\226I\250\374\310\346\335\366\314\346\312\313\244\375\205Y\326\326\033\307\332w\267\375\330\227\270\335\361\243L\215\027\357ff\316L\207\267\370\310R{A\353S\230\306\2201\215\003\035Dm0\3656h\355\224\307\210\021X{\264uMN\307V\364\240\302\377\230\261&^Q\034\\\210!,Y\225\300qpc\332\200c\321Y\031\nR\2638\231\323\224t\222\aF\231hm\204co\016e(u\237\341\237\220\314l\205\354\313\002ht]\205+^\330U\253\207\305\234\025W\346\263\371\034\246\f\234\352y\315\017\006vB\246\334e\214\367\033\351\346\312\226\030\376\312\367b\265\331s\226\307\024\224\307\002u+\303^e\'\223\300\006\335\374\027[\345\321\251\032\362\027{\320\226z\335\031\317\200X\250\271G\275\271\362\233\346;\245I\006\375\313\272\232x\033\331P0\277\225\313\222J`\237\022\2546\332\\\231vmk\340\320z@\234\346\214\242\246\362fn\001\026\2518@\211)\251-\000\327\177\230\223\220\351K\234\223\332\224\000\210O^\206\201\224\'\t)\326\264\215\f[\335?\375ow\251\223-\037\277mpde&\\\321\016\304\337[\303c\336;\355\210j\267?\317\003\255T\036&I@.\222+e\323\377\325\r\315\206\315\252\356\214\awt\363\'\240\327Rs\023\356\224\246\333\0008\300s\242^\360\302\360\002.\253\204G\000\005p\034(\305\027\302\217\002h\253\032d=.\033bq\r\313\306ss\006>\262hI\b\307\241\364\274\370r\232\025Ts\t\211\246\022\356\313\353\v\201\371\340\020\356i`\211y\241h)\340\357\026\222\254JvN^\216\202;xQ \035\032=/{\220\241\254!\207p\250\t\3159\316\310\261\365\v\243\210\275+\356\032\371\260\333L\266r\217\210\274y\225&=\305g;\333\365\221\215\317z\232\332`\315B\357\355\3177]\020\253y\026\212\336\352\367[\267\023\216\"\361M1}^\366eW"
