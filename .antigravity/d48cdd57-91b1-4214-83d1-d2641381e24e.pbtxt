    end_line: 382
    content: "import React, { useRef, useState } from \'react\';\nimport {\n  Camera,\n  CheckCircle2,\n  Mail,\n  Pencil,\n  Phone,\n  User,\n  UserCheck,\n  X,\n} from \'lucide-react\';\nimport { UserProfile } from \'../../types/safety\';\nimport { isValidEmail, isValidPhoneNumber } from \'../../utils/storage\';\n\ninterface ProfileModalProps {\n  user: UserProfile;\n  initialEditing?: boolean;\n  onSaveProfile: (updated: UserProfile) => void;\n  onClose: () => void;\n}\n\nexport const ProfileModal: React.FC<ProfileModalProps> = ({\n  user,\n  initialEditing = false,\n  onSaveProfile,\n  onClose,\n}) => {\n  const [editing, setEditing] = useState(initialEditing);\n  const [fullName, setFullName] = useState(user.fullName);\n  const [phone, setPhone] = useState(user.phone);\n  const [email, setEmail] = useState(user.email);\n  const [age, setAge] = useState(String(user.age));\n  const [guardianName, setGuardianName] = useState(user.guardianName);\n  const [guardianPhone, setGuardianPhone] = useState(user.guardianPhone);\n  const [photoDataUrl, setPhotoDataUrl] = useState(user.photoDataUrl ?? \'\');\n  const [error, setError] = useState(\'\');\n  const [savedNotice, setSavedNotice] = useState(false);\n\n  const fileInputRef = useRef<HTMLInputElement | null>(null);\n\n  const initials = user.fullName\n    .split(\' \')\n    .filter(Boolean)\n    .slice(0, 2)\n    .map((part) => part[0]?.toUpperCase() ?? \'\')\n    .join(\'\');\n\n  const handlePhotoSelect = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n    if (file.size > 1_500_000) {\n      setError(\'Please choose an image smaller than 1.5 MB for local storage.\');\n      return;\n    }\n    const reader = new FileReader();\n    reader.onload = () => {\n      if (typeof reader.result === \'string\') {\n        setPhotoDataUrl(reader.result);\n        setError(\'\');\n        if (!editing) {\n          onSaveProfile({ ...user, photoDataUrl: reader.result });\n          setSavedNotice(true);\n          window.setTimeout(() => setSavedNotice(false), 2500);\n        }\n      }\n    };\n    reader.readAsDataURL(file);\n  };\n\n  const handleSave = (e: React.FormEvent) => {\n    e.preventDefault();\n    setError(\'\');\n\n    if (!fullName.trim() || fullName.trim().length < 2) {\n      setError(\'Full name must be at least 2 characters.\');\n      return;\n    }\n    if (!isValidPhoneNumber(phone)) {\n      setError(\'Enter a valid phone number (10 to 15 digits).\');\n      return;\n    }\n    if (!isValidEmail(email)) {\n      setError(\'Enter a valid email address.\');\n      return;\n    }\n    const numericAge = Number(age);\n    if (!age || Number.isNaN(numericAge) || numericAge < 13 || numericAge > 120) {\n      setError(\'Age must be between 13 and 120.\');\n      return;\n    }\n    if (!guardianName.trim() || guardianName.trim().length < 2) {\n      setError(\'Guardian name must be at least 2 characters.\');\n      return;\n    }\n    if (!isValidPhoneNumber(guardianPhone)) {\n      setError(\'Enter a valid guardian phone number (10 to 15 digits).\');\n      return;\n    }\n\n    const updatedContacts = user.sosContacts.map((c) =>\n      c.isPrimary\n        ? { ...c, name: guardianName.trim(), phone: guardianPhone.trim() }\n        : c\n    );\n\n    onSaveProfile({\n      ...user,\n      fullName: fullName.trim(),\n      phone: phone.trim(),\n      email: email.trim(),\n      age: numericAge,\n      guardianName: guardianName.trim(),\n      guardianPhone: guardianPhone.trim(),\n      photoDataUrl: photoDataUrl || undefined,\n      sosContacts: updatedContacts,\n    });\n    setEditing(false);\n    setSavedNotice(true);\n    window.setTimeout(() => setSavedNotice(false), 2500);\n  };\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 bg-[#1A132B]/55 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"profile-modal-title\"\n    >\n      <div className=\"w-full max-w-lg bg-white rounded-3xl border border-violet-200 p-6 sm:p-7 shadow-2xl my-auto max-h-[92vh] overflow-y-auto\">\n        <div className=\"flex items-start justify-between gap-4 mb-5\">\n          <div>\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Personal Profile \302\267 Local Prototype\n            </p>\n            <h2\n              id=\"profile-modal-title\"\n              className=\"text-xl font-bold text-[#1A132B] mt-0.5\"\n            >\n              {editing ? \'Edit Profile Details\' : \'Your Safety Profile\'}\n            </h2>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onClose}\n            aria-label=\"Close profile\"\n            className=\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#6B6182] hover:bg-violet-50 cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Profile Photo Placeholder + Upload */}\n        <div className=\"flex items-center gap-4 pb-5 border-b border-violet-100\">\n          <div className=\"relative shrink-0\">\n            {photoDataUrl ? (\n              <img\n                src={photoDataUrl}\n                alt={`${user.fullName} profile`}\n                className=\"w-16 h-16 rounded-2xl object-cover border border-violet-200\"\n              />\n            ) : (\n              <div className=\"w-16 h-16 rounded-2xl bg-[#F3EEFF] border border-violet-200 text-violet-800 font-bold text-xl flex items-center justify-center\">\n                {initials || <User className=\"w-7 h-7\" />}\n              </div>\n            )}\n            <button\n              type=\"button\"\n              onClick={() => fileInputRef.current?.click()}\n              aria-label=\"Upload profile photo\"\n              className=\"absolute -bottom-1.5 -right-1.5 w-7 h-7 rounded-lg bg-violet-700 hover:bg-violet-800 text-white flex items-center justify-center shadow-sm cursor-pointer\"\n            >\n              <Camera className=\"w-3.5 h-3.5\" />\n            </button>\n            <input\n              ref={fileInputRef}\n              type=\"file\"\n              accept=\"image/*\"\n              onChange={handlePhotoSelect}\n              className=\"hidden\"\n            />\n          </div>\n\n          <div className=\"min-w-0 flex-1\">\n            <h3 className=\"text-lg font-bold text-[#1A132B] truncate\">\n              {user.fullName}\n            </h3>\n            <p className=\"text-xs text-[#6B6182] mt-0.5\">\n              Age {user.age} \302\267 {user.email}\n            </p>\n          </div>\n\n          {!editing && (\n            <button\n              type=\"button\"\n              onClick={() => {\n                setEditing(true);\n                setError(\'\');\n              }}\n              className=\"min-h-[40px] px-3.5 py-2 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-800 text-xs font-semibold flex items-center gap-1.5 whitespace-nowrap shrink-0 cursor-pointer\"\n            >\n              <Pencil className=\"w-3.5 h-3.5\" />\n              <span>Edit Profile</span>\n            </button>\n          )}\n        </div>\n\n        {savedNotice && (\n          <div className=\"mt-4 rounded-xl bg-emerald-50 border border-emerald-200 px-3.5 py-2.5 text-xs font-medium text-emerald-800 flex items-center gap-2\">\n            <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n            <span>Profile changes saved locally.</span>\n          </div>\n        )}\n\n        {error && (\n          <p className=\"mt-4 rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs font-medium text-red-700\">\n            {error}\n          </p>\n        )}\n\n        {editing ? (\n          <form onSubmit={handleSave} className=\"mt-5 space-y-4\">\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3.5\">\n              <div className=\"sm:col-span-2\">\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Full Name\n                </label>\n                <input\n                  type=\"text\"\n                  value={fullName}\n                  onChange={(e) => setFullName(e.target.value)}\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Phone Number\n                </label>\n                <input\n                  type=\"tel\"\n                  value={phone}\n                  onChange={(e) => setPhone(e.target.value)}\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm font-mono tabular-nums focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Age\n                </label>\n                <input\n                  type=\"number\"\n                  min={13}\n                  max={120}\n                  value={age}\n                  onChange={(e) => setAge(e.target.value)}\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm tabular-nums focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n\n              <div className=\"sm:col-span-2\">\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Email Address\n                </label>\n                <input\n                  type=\"email\"\n                  value={email}\n                  onChange={(e) => setEmail(e.target.value)}\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Primary Guardian Name\n                </label>\n                <input\n                  type=\"text\"\n                  value={guardianName}\n                  onChange={(e) => setGuardianName(e.target.value)}\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-xs font-semibold text-[#1A132B] mb-1\">\n                  Guardian Phone Number\n                </label>\n                <input\n                  type=\"tel\"\n                  value={guardianPhone}\n                  onChange={(e) => setGuardianPhone(e.target.value)}\n                  className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm font-mono tabular-nums focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            <div className=\"pt-2 flex items-center justify-end gap-2.5\">\n              <button\n                type=\"button\"\n                onClick={() => {\n                  setEditing(false);\n                  setFullName(user.fullName);\n                  setPhone(user.phone);\n                  setEmail(user.email);\n                  setAge(String(user.age));\n                  setGuardianName(user.guardianName);\n                  setGuardianPhone(user.guardianPhone);\n                  setError(\'\');\n                }}\n                className=\"min-h-[44px] px-4 py-2 rounded-xl text-sm font-semibold text-[#574E6B] hover:bg-violet-50 cursor-pointer\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"min-h-[44px] px-5 py-2 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold cursor-pointer\"\n              >\n                Save Changes\n              </button>\n            </div>\n          </form>\n        ) : (\n          <div className=\"mt-5 space-y-3\">\n            <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 divide-y divide-violet-100\">\n              <div className=\"p-3.5 flex items-center justify-between gap-4 text-sm\">\n                <span className=\"text-[#6B6182] flex items-center gap-2\">\n                  <Phone className=\"w-4 h-4 text-violet-700\" />\n                  <span>Phone Number</span>\n                </span>\n                <span className=\"font-mono tabular-nums font-semibold text-[#1A132B]\">\n                  {user.phone}\n                </span>\n              </div>\n\n              <div className=\"p-3.5 flex items-center justify-between gap-4 text-sm\">\n                <span className=\"text-[#6B6182] flex items-center gap-2\">\n                  <Mail className=\"w-4 h-4 text-violet-700\" />\n                  <span>Email</span>\n                </span>\n                <span className=\"font-semibold text-[#1A132B] truncate\">\n                  {user.email}\n                </span>\n              </div>\n\n              <div className=\"p-3.5 flex items-center justify-between gap-4 text-sm\">\n                <span className=\"text-[#6B6182] flex items-center gap-2\">\n                  <User className=\"w-4 h-4 text-violet-700\" />\n                  <span>Age</span>\n                </span>\n                <span className=\"font-semibold tabular-nums text-[#1A132B]\">\n                  {user.age} years\n                </span>\n              </div>\n\n              <div className=\"p-3.5 flex items-center justify-between gap-4 text-sm\">\n                <span className=\"text-[#6B6182] flex items-center gap-2\">\n                  <UserCheck className=\"w-4 h-4 text-violet-700\" />\n                  <span>Guardian Name</span>\n                </span>\n                <span className=\"font-semibold text-[#1A132B]\">\n                  {user.guardianName}\n                </span>\n              </div>\n\n              <div className=\"p-3.5 flex items-center justify-between gap-4 text-sm\">\n                <span className=\"text-[#6B6182] flex items-center gap-2\">\n                  <Phone className=\"w-4 h-4 text-violet-700\" />\n                  <span>Guardian Phone</span>\n                </span>\n                <span className=\"font-mono tabular-nums font-semibold text-[#1A132B]\">\n                  {user.guardianPhone}\n                </span>\n              </div>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 383
    num_bytes: 14524
    line_range_bytes: 14524
  }
}
