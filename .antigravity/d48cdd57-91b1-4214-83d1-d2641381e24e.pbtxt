    tool_calls {
      id: "call_2941438183797955913"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect, useRef, useState } from \'react\';\\nimport {\\n  AlertTriangle,\\n  Battery,\\n  CheckCircle2,\\n  Clock,\\n  ExternalLink,\\n  History,\\n  LocateFixed,\\n  MapPin,\\n  Mic,\\n  Phone,\\n  Search,\\n  Shield,\\n  ShieldAlert,\\n  Square,\\n  Video,\\n  Volume2,\\n  VolumeX,\\n  Wifi,\\n  WifiOff,\\n} from \'lucide-react\';\\nimport {\\n  GeoLocationState,\\n  NearbyPoliceAiResult,\\n  SosContact,\\n  ThreatSessionState,\\n} from \'../../types/safety\';\\nimport { saveRecordingToDb } from \'../../utils/evidenceDb\';\\nimport { formatDateTimeShort, formatPhoneForTel } from \'../../utils/storage\';\\n\\ninterface ThreatModePageProps {\\n  userId: string;\\n  contacts: SosContact[];\\n  threatSession: ThreatSessionState | null;\\n  recoveredInterruption: ThreatSessionState | null;\\n  geoLocation: GeoLocationState;\\n  isOnline: boolean;\\n  soundAllowed: boolean;\\n  nearbyPoliceResult: NearbyPoliceAiResult | null;\\n  nearbyPoliceLoading: boolean;\\n  nearbyPoliceError: string;\\n  onFetchNearbyPoliceAi: (areaQuery?: string) => void;\\n  onRequestLocation: () => void;\\n  onActivateThreatMode: (source?: string) => void;\\n  onDeactivateThreatMode: (note?: string) => void;\\n  onUpdateThreatSnapshot: (partial: Partial<ThreatSessionState>) => void;\\n  onRecordingSaved: (meta: {\\n    id: string;\\n    kind: \'audio\' | \'video\';\\n    durationSec: number;\\n    locationCoords?: string;\\n  }) => void;\\n  onSimulateConnectivityDrop: () => void;\\n  onDismissRecoveryBanner: () => void;\\n  onEscalateToSos: () => void;\\n  onOpenHistory: () => void;\\n}\\n\\nexport const ThreatModePage: React.FC<ThreatModePageProps> = ({\\n  userId,\\n  contacts,\\n  threatSession,\\n  recoveredInterruption,\\n  geoLocation,\\n  isOnline,\\n  soundAllowed,\\n  nearbyPoliceResult,\\n  nearbyPoliceLoading,\\n  nearbyPoliceError,\\n  onFetchNearbyPoliceAi,\\n  onRequestLocation,\\n  onActivateThreatMode,\\n  onDeactivateThreatMode,\\n  onUpdateThreatSnapshot,\\n  onRecordingSaved,\\n  onSimulateConnectivityDrop,\\n  onDismissRecoveryBanner,\\n  onEscalateToSos,\\n  onOpenHistory,\\n}) => {\\n  const [elapsedText, setElapsedText] = useState(\'00:00\');\\n  const [recordingMode, setRecordingMode] = useState<\'none\' | \'audio\' | \'video\'>(\\n    \'none\'\\n  );\\n  const [recordingSeconds, setRecordingSeconds] = useState(0);\\n  const [recordingError, setRecordingError] = useState(\'\');\\n  const [recordingSavedNotice, setRecordingSavedNotice] = useState(\'\');\\n  const [batteryPercent, setBatteryPercent] = useState<number | null>(null);\\n  const [alarmPlaying, setAlarmPlaying] = useState(false);\\n  const [manualAreaInput, setManualAreaInput] = useState(\'\');\\n\\n  const mediaRecorderRef = useRef<MediaRecorder | null>(null);\\n  const mediaStreamRef = useRef<MediaStream | null>(null);\\n  const chunksRef = useRef<Blob[]>([]);\\n  const recordStartTimeRef = useRef<number>(0);\\n  const videoPreviewRef = useRef<HTMLVideoElement | null>(null);\\n\\n  const audioCtxRef = useRef<AudioContext | null>(null);\\n  const sirenTimerRef = useRef<number | null>(null);\\n\\n  const primaryGuardian = contacts.find((c) => c.isPrimary) ?? contacts[0];\\n  const isActive = Boolean(threatSession?.active);\\n\\n  // Read device battery status when supported\\n  useEffect(() => {\\n    const navWithBattery = navigator as Navigator & {\\n      getBattery?: () => Promise<{\\n        level: number;\\n        addEventListener: (ev: string, cb: () => void) => void;\\n      }>;\\n    };\\n    if (!navWithBattery.getBattery) return;\\n    let mounted = true;\\n    navWithBattery\\n      .getBattery()\\n      .then((battery) => {\\n        if (!mounted) return;\\n        const pct = Math.round(battery.level * 100);\\n        setBatteryPercent(pct);\\n        if (isActive) {\\n          onUpdateThreatSnapshot({ batteryPercent: pct });\\n        }\\n        battery.addEventListener(\'levelchange\', () => {\\n          if (!mounted) return;\\n          const nextPct = Math.round(battery.level * 100);\\n          setBatteryPercent(nextPct);\\n        });\\n      })\\n      .catch(() => {});\\n    return () => {\\n      mounted = false;\\n    };\\n  }, [isActive, onUpdateThreatSnapshot]);\\n\\n  // Active Threat Mode elapsed timer\\n  useEffect(() => {\\n    if (!threatSession?.active) {\\n      setElapsedText(\'00:00\');\\n      return;\\n    }\\n    const update = () => {\\n      const diff = Math.max(\\n        0,\\n        Math.floor(\\n          (Date.now() - new Date(threatSession.activatedAt).getTime()) / 1000\\n        )\\n      );\\n      const mins = Math.floor(diff / 60);\\n      const secs = diff % 60;\\n      setElapsedText(\\n        `${String(mins).padStart(2, \'0\')}:${String(secs).padStart(2, \'0\')}`\\n      );\\n    };\\n    update();\\n    const id = window.setInterval(update, 1000);\\n    return () => window.clearInterval(id);\\n  }, [threatSession]);\\n\\n  // Recording elapsed timer\\n  useEffect(() => {\\n    if (recordingMode === \'none\') {\\n      setRecordingSeconds(0);\\n      return;\\n    }\\n    const id = window.setInterval(() => {\\n      setRecordingSeconds(\\n        Math.max(1, Math.floor((Date.now() - recordStartTimeRef.current) / 1000))\\n      );\\n    }, 1000);\\n    return () => window.clearInterval(id);\\n  }, [recordingMode]);\\n\\n  const stopAttentionTone = () => {\\n    if (sirenTimerRef.current !== null) {\\n      window.clearInterval(sirenTimerRef.current);\\n      sirenTimerRef.current = null;\\n    }\\n    if (audioCtxRef.current) {\\n      audioCtxRef.current.close().catch(() => {});\\n      audioCtxRef.current = null;\\n    }\\n    setAlarmPlaying(false);\\n  };\\n\\n  const toggleAttentionTone = () => {\\n    if (alarmPlaying) {\\n      stopAttentionTone();\\n      return;\\n    }\\n    try {\\n      const Ctor =\\n        window.AudioContext ||\\n        (window as unknown as { webkitAudioContext: typeof AudioContext })\\n          .webkitAudioContext;\\n      const ctx = new Ctor();\\n      audioCtxRef.current = ctx;\\n      const pulse = (freq: number) => {\\n        if (!audioCtxRef.current) return;\\n        const osc = ctx.createOscillator();\\n        const gain = ctx.createGain();\\n        osc.type = \'triangle\';\\n        osc.frequency.setValueAtTime(freq, ctx.currentTime);\\n        gain.gain.setValueAtTime(0.001, ctx.currentTime);\\n        gain.gain.exponentialRampToValueAtTime(0.18, ctx.currentTime + 0.05);\\n        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.45);\\n        osc.connect(gain);\\n        gain.connect(ctx.destination);\\n        osc.start();\\n        osc.stop(ctx.currentTime + 0.48);\\n      };\\n      let high = true;\\n      pulse(880);\\n      sirenTimerRef.current = window.setInterval(() => {\\n        high = !high;\\n        pulse(high ? 880 : 660);\\n      }, 520);\\n      setAlarmPlaying(true);\\n    } catch {\\n      setAlarmPlaying(false);\\n    }\\n  };\\n\\n  const stopRecording = () => {\\n    if (\\n      mediaRecorderRef.current &&\\n      mediaRecorderRef.current.state !== \'inactive\'\\n    ) {\\n      mediaRecorderRef.current.stop();\\n    }\\n    if (mediaStreamRef.current) {\\n      mediaStreamRef.current.getTracks().forEach((t) => t.stop());\\n      mediaStreamRef.current = null;\\n    }\\n    if (videoPreviewRef.current) {\\n      videoPreviewRef.current.srcObject = null;\\n    }\\n  };\\n\\n  useEffect(() => {\\n    return () => {\\n      stopAttentionTone();\\n      stopRecording();\\n    };\\n  }, []);\\n\\n  const startRecording = async (kind: \'audio\' | \'video\') => {\\n    setRecordingError(\'\');\\n    setRecordingSavedNotice(\'\');\\n\\n    if (typeof MediaRecorder === \'undefined\' || !navigator.mediaDevices?.getUserMedia) {\\n      setRecordingError(\\n        \'Media recording is not supported in this browser environment.\'\\n      );\\n      return;\\n    }\\n\\n    if (!isActive) {\\n      onActivateThreatMode(`Threat Mode ${kind} recording`);\\n    }\\n\\n    stopRecording();\\n\\n    try {\\n      const stream = await navigator.mediaDevices.getUserMedia(\\n        kind === \'video\'\\n          ? { audio: true, video: { facingMode: \'environment\' } }\\n          : { audio: true }\\n      );\\n      mediaStreamRef.current = stream;\\n\\n      if (kind === \'video\') {\\n        window.setTimeout(() => {\\n          if (videoPreviewRef.current) {\\n            videoPreviewRef.current.srcObject = stream;\\n            videoPreviewRef.current.play().catch(() => {});\\n          }\\n        }, 50);\\n      }\\n\\n      const preferredMime =\\n        kind === \'video\'\\n          ? MediaRecorder.isTypeSupported(\'video/webm;codecs=vp8,opus\')\\n            ? \'video/webm;codecs=vp8,opus\'\\n            : \'video/webm\'\\n          : MediaRecorder.isTypeSupported(\'audio/webm;codecs=opus\')\\n            ? \'audio/webm;codecs=opus\'\\n            : \'audio/webm\';\\n\\n      const recorder = new MediaRecorder(\\n        stream,\\n        MediaRecorder.isTypeSupported(preferredMime)\\n          ? { mimeType: preferredMime }\\n          : undefined\\n      );\\n      chunksRef.current = [];\\n      recordStartTimeRef.current = Date.now();\\n\\n      recorder.ondataavailable = (ev) => {\\n        if (ev.data && ev.data.size > 0) {\\n          chunksRef.current.push(ev.data);\\n        }\\n      };\\n\\n      recorder.onstop = async () => {\\n        const durationSec = Math.max(\\n          1,\\n          Math.round((Date.now() - recordStartTimeRef.current) / 1000)\\n        );\\n        const blob = new Blob(chunksRef.current, {\\n          type:\\n            recorder.mimeType ||\\n            (kind === \'video\' ? \'video/webm\' : \'audio/webm\'),\\n        });\\n        const recId = `rec-${Date.now()}`;\\n        const coords =\\n          geoLocation.status === \'granted\' &&\\n          geoLocation.latitude !== null &&\\n          geoLocation.longitude !== null\\n            ? `${geoLocation.latitude.toFixed(5)}, ${geoLocation.longitude.toFixed(5)}`\\n            : undefined;\\n\\n        try {\\n          await saveRecordingToDb({\\n            id: recId,\\n            userId,\\n            kind,\\n            mimeType: blob.type,\\n            createdAt: new Date().toISOString(),\\n            durationSec,\\n            sizeBytes: blob.size,\\n            sessionId: threatSession?.sessionId,\\n            locationCoords: coords,\\n            sharedWithGuardians: false,\\n            blob,\\n          });\\n          onRecordingSaved({\\n            id: recId,\\n            kind,\\n            durationSec,\\n            locationCoords: coords,\\n          });\\n          setRecordingSavedNotice(\\n            `${kind === \'video\' ? \'Video\' : \'Audio\'} evidence (${durationSec}s) saved securely to local Evidence History.`\\n          );\\n        } catch {\\n          setRecordingError(\\n            \'Recording finished, but local IndexedDB storage was unavailable in this browser.\'\\n          );\\n        }\\n        setRecordingMode(\'none\');\\n        onUpdateThreatSnapshot({ recordingMode: \'none\' });\\n      };\\n\\n      mediaRecorderRef.current = recorder;\\n      recorder.start(1000);\\n      setRecordingMode(kind);\\n      onUpdateThreatSnapshot({ recordingMode: kind });\\n    } catch {\\n      setRecordingError(\\n        `Permission for ${kind === \'video\' ? \'camera/microphone\' : \'microphone\'} was denied or device is unavailable.`\\n      );\\n    }\\n  };\\n\\n  const handleDeactivate = () => {\\n    stopRecording();\\n    stopAttentionTone();\\n    onDeactivateThreatMode(\'Deactivated safely by user\');\\n  };\\n\\n  const handleAreaSearchSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    onFetchNearbyPoliceAi(manualAreaInput.trim() || undefined);\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Recovered Unexpected Interruption Alert */}\\n      {recoveredInterruption && (\\n        <section\\n          role=\\\"alert\\\"\\n          className=\\\"rounded-3xl bg-amber-50 border border-amber-300 p-5 flex flex-wrap items-start justify-between gap-4\\\"\\n        >\\n          <div className=\\\"space-y-1 max-w-2xl\\\">\\n            <p className=\\\"text-xs font-bold text-amber-900\\\">\\n              Preserved Emergency Snapshot \302\267 Previous Threat Mode Interrupted Unexpectedly\\n            </p>\\n            <p className=\\\"text-sm text-amber-950 leading-relaxed\\\">\\n              Your previous Threat Mode session (started{\' \'}\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {formatDateTimeShort(recoveredInterruption.activatedAt)}\\n              </span>\\n              ) stopped communicating after{\' \'}\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {formatDateTimeShort(recoveredInterruption.lastHeartbeatAt)}\\n              </span>\\n              . Last preserved GPS:{\' \'}\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {recoveredInterruption.lastLatitude !== null &&\\n                recoveredInterruption.lastLongitude !== null\\n                  ? `${recoveredInterruption.lastLatitude.toFixed(5)}, ${recoveredInterruption.lastLongitude.toFixed(5)}`\\n                  : \'Unavailable\'}\\n              </span>\\n              .\\n            </p>\\n          </div>\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenHistory}\\n              className=\\\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-amber-900 text-white text-xs font-semibold cursor-pointer whitespace-nowrap\\\"\\n            >\\n              View History\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onDismissRecoveryBanner}\\n              className=\\\"min-h-[40px] px-3 py-1.5 rounded-xl bg-white border border-amber-300 text-amber-900 text-xs font-semibold cursor-pointer\\\"\\n            >\\n              Dismiss\\n            </button>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* Main Threat Mode Control Header */}\\n      <section\\n        className={`rounded-3xl border p-6 sm:p-8 shadow-sm transition-colors ${\\n          isActive\\n            ? \'bg-red-50 border-red-300\'\\n            : \'bg-[#FCFDF9] border-[#B8C6A8]\'\\n        }`}\\n      >\\n        <div className=\\\"flex flex-wrap items-start justify-between gap-6\\\">\\n          <div className=\\\"space-y-2 max-w-2xl\\\">\\n            <div className=\\\"flex flex-wrap items-center gap-2 text-xs font-semibold\\\">\\n              <span className={isActive ? \'text-red-700\' : \'text-[#3E5632]\'}>\\n                Intelligent Threat Mode\\n              </span>\\n              <span aria-hidden=\\\"true\\\" className=\\\"text-[#78886F]\\\">\\n                \302\267\\n              </span>\\n              <span className={isActive ? \'text-red-800\' : \'text-[#54634D]\'}>\\n                {isActive ? `ACTIVE (${elapsedText})` : \'Standby\'}\\n              </span>\\n            </div>\\n            <h1 className=\\\"text-2xl sm:text-3xl font-semibold text-[#182215] tracking-tight\\\">\\n              {isActive\\n                ? \'Threat Protection Active\'\\n                : \'Proactive Protection & AI Police Numbers\'}\\n            </h1>\\n            <p className=\\\"text-sm text-[#465340] leading-relaxed\\\">\\n              Activating Threat Mode notifies your guardian network, automatically queries AI for nearby police station numbers around your location, enables local audio/video recording, and preserves GPS heartbeat snapshots.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n            {isActive ? (\\n              <>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onEscalateToSos}\\n                  className=\\\"min-h-[48px] px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold inline-flex items-center gap-2 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <ShieldAlert className=\\\"w-4 h-4\\\" />\\n                  <span>Escalate to SOS</span>\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={handleDeactivate}\\n                  className=\\\"min-h-[48px] px-5 py-2.5 rounded-xl bg-white hover:bg-emerald-50 border border-emerald-300 text-emerald-800 text-sm font-semibold inline-flex items-center gap-2 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                  <span>I&apos;m Safe \342\200\224 Deactivate</span>\\n                </button>\\n              </>\\n            ) : (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => onActivateThreatMode(\'Threat Mode Page\')}\\n                className=\\\"min-h-[50px] px-6 py-3 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold inline-flex items-center gap-2 shadow-sm cursor-pointer whitespace-nowrap\\\"\\n              >\\n                <AlertTriangle className=\\\"w-5 h-5\\\" />\\n                <span>Activate Threat Mode</span>\\n              </button>\\n            )}\\n          </div>\\n        </div>\\n\\n        {/* Active Session Metadata Row */}\\n        {isActive && threatSession && (\\n          <div className=\\\"mt-6 pt-5 border-t border-red-200/80 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-xs\\\">\\n            <div className=\\\"rounded-2xl bg-white border border-red-200/70 p-3.5\\\">\\n              <p className=\\\"text-[#54634D]\\\">Activated At</p>\\n              <p className=\\\"mt-1 font-mono font-bold text-[#182215] tabular-nums\\\">\\n                {formatDateTimeShort(threatSession.activatedAt)}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl bg-white border border-red-200/70 p-3.5\\\">\\n              <p className=\\\"text-[#54634D]\\\">Guardian Notification</p>\\n              <p className=\\\"mt-1 font-bold text-[#182215]\\\">\\n                {threatSession.guardianNotificationStatus === \'queued_offline\'\\n                  ? \'Queued (Offline)\'\\n                  : `Notified ${contacts.length} Guardian(s) (Demo)`}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl bg-white border border-red-200/70 p-3.5\\\">\\n              <p className=\\\"text-[#54634D]\\\">Last Preserved GPS</p>\\n              <p className=\\\"mt-1 font-mono font-bold text-[#182215] tabular-nums\\\">\\n                {threatSession.lastLatitude !== null &&\\n                threatSession.lastLongitude !== null\\n                  ? `${threatSession.lastLatitude.toFixed(5)}, ${threatSession.lastLongitude.toFixed(5)}`\\n                  : \'Waiting for GPS\'}\\n              </p>\\n            </div>\\n            <div className=\\\"rounded-2xl bg-white border border-red-200/70 p-3.5 flex items-center justify-between gap-2\\\">\\n              <div>\\n                <p className=\\\"text-[#54634D]\\\">Quick Deterrent</p>\\n                <p className=\\\"mt-1 font-bold text-[#182215]\\\">\\n                  {alarmPlaying ? \'Tone Active\' : \'Muted\'}\\n                </p>\\n              </div>\\n              {soundAllowed && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={toggleAttentionTone}\\n                  className={`min-h-[38px] px-3 py-1.5 rounded-xl text-xs font-semibold inline-flex items-center gap-1 cursor-pointer ${\\n                    alarmPlaying\\n                      ? \'bg-red-600 text-white\'\\n                      : \'bg-red-50 text-red-700 border border-red-200\'\\n                  }`}\\n                >\\n                  {alarmPlaying ? (\\n                    <>\\n                      <VolumeX className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Stop</span>\\n                    </>\\n                  ) : (\\n                    <>\\n                      <Volume2 className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Siren</span>\\n                    </>\\n                  )}\\n                </button>\\n              )}\\n            </div>\\n          </div>\\n        )}\\n      </section>\\n\\n      {/* AI Nearby Police Stations & Verified Numbers (Threat Mode AI Grounding) */}\\n      <section className=\\\"bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 space-y-5 shadow-sm shadow-[#182215]/[0.03]\\\">\\n        <div className=\\\"flex flex-wrap items-start justify-between gap-4\\\">\\n          <div>\\n            <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n              AI Maps Grounding \302\267 Live Police Station Lookup\\n            </p>\\n            <h2 className=\\\"mt-1 text-xl font-semibold text-[#182215]\\\">\\n              Nearby Police Station Numbers (AI)\\n            </h2>\\n            <p className=\\\"mt-1 text-xs text-[#4B5844] max-w-2xl\\\">\\n              Uses Gemini with Google Maps grounding to find real nearby police stations and publicly listed contact numbers based on your GPS or entered area. Universal police emergency numbers are always available offline below.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n            <a\\n              href=\\\"tel:100\\\"\\n              className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold inline-flex items-center gap-1.5 whitespace-nowrap\\\"\\n            >\\n              <Phone className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Police (100)</span>\\n            </a>\\n            <a\\n              href=\\\"tel:112\\\"\\n              className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-red-50 hover:bg-red-100 border border-red-200 text-red-800 text-xs font-bold inline-flex items-center gap-1.5 whitespace-nowrap\\\"\\n            >\\n              <Shield className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Emergency (112)</span>\\n            </a>\\n          </div>\\n        </div>\\n\\n        {/* GPS Lookup + Area Input Form */}\\n        <form\\n          onSubmit={handleAreaSearchSubmit}\\n          className=\\\"flex flex-col sm:flex-row items-stretch sm:items-center gap-2.5\\\"\\n        >\\n          <div className=\\\"relative flex-1\\\">\\n            <MapPin className=\\\"w-4 h-4 text-[#54634D] absolute left-3.5 top-1/2 -translate-y-1/2 pointer-events-none\\\" />\\n            <input\\n              type=\\\"text\\\"\\n              value={manualAreaInput}\\n              onChange={(e) => setManualAreaInput(e.target.value)}\\n              placeholder={\\n                geoLocation.status === \'granted\' && geoLocation.latitude !== null\\n                  ? `Using GPS (${geoLocation.latitude.toFixed(4)}, ${geoLocation.longitude?.toFixed(4)}) \342\200\224 or type a city/area`\\n                  : \'Enter your city or neighborhood (or grant GPS permission)\'\\n              }\\n              aria-label=\\\"City or neighborhood for nearby police lookup\\\"\\n              className=\\\"w-full min-h-[44px] pl-10 pr-4 py-2 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm text-[#182215] placeholder:text-[#6B7A63] focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n            />\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onRequestLocation}\\n            className=\\\"min-h-[44px] px-3.5 py-2 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] text-[#24371D] text-xs font-semibold inline-flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n          >\\n            <LocateFixed className=\\\"w-4 h-4\\\" />\\n            <span>Use GPS</span>\\n          </button>\\n\\n          <button\\n            type=\\\"submit\\\"\\n            disabled={nearbyPoliceLoading || !isOnline}\\n            className=\\\"min-h-[44px] px-5 py-2 rounded-xl bg-[#2F4526] hover:bg-[#23351C] disabled:opacity-50 text-[#F6F9F2] text-xs font-semibold inline-flex items-center justify-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n          >\\n            <Search className=\\\"w-4 h-4\\\" />\\n            <span>\\n              {nearbyPoliceLoading ? \'Searching Police...\' : \'Find Police Numbers (AI)\'}\\n            </span>\\n          </button>\\n        </form>\\n\\n        {!isOnline && (\\n          <p className=\\\"text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-xl px-3.5 py-2.5\\\">\\n            AI station lookup needs an internet connection. Offline police emergency numbers (100, 112, 181) remain ready to dial above.\\n          </p>\\n        )}\\n\\n        {nearbyPoliceError && (\\n          <p className=\\\"text-xs text-red-700 bg-red-50 border border-red-200 rounded-xl px-3.5 py-2.5 font-medium\\\">\\n            {nearbyPoliceError}\\n          </p>\\n        )}\\n\\n        {nearbyPoliceResult && (\\n          <div className=\\\"space-y-4\\\">\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2 text-xs text-[#4B5844]\\\">\\n              <span>\\n                Grounded results for{\' \'}\\n                <strong className=\\\"text-[#182215]\\\">\\n                  {nearbyPoliceResult.locationLabel}\\n                </strong>\\n              </span>\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                Updated {formatDateTimeShort(nearbyPoliceResult.queriedAt)}\\n              </span>\\n            </div>\\n\\n            {nearbyPoliceResult.stations.length > 0 && (\\n              <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-3.5\\\">\\n                {nearbyPoliceResult.stations.map((st, idx) => {\\n                  const dialTarget = st.phone\\n                    ? formatPhoneForTel(st.phone)\\n                    : \'100\';\\n                  return (\\n                    <div\\n                      key={`${st.name}-${idx}`}\\n                      className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] p-4 flex flex-col justify-between gap-3\\\"\\n                    >\\n                      <div className=\\\"space-y-1\\\">\\n                        <p className=\\\"text-sm font-bold text-[#182215]\\\">\\n                          {st.name}\\n                        </p>\\n                        <p className=\\\"text-xs font-mono tabular-nums font-semibold text-[#2F4526]\\\">\\n                          {st.phone\\n                            ? `Phone: ${st.phone}`\\n                            : \'Public direct number not listed \302\267 Dial 100 / 112\'}\\n                        </p>\\n                        {st.address && (\\n                          <p className=\\\"text-xs text-[#4B5844] leading-relaxed\\\">\\n                            {st.address}\\n                          </p>\\n                        )}\\n                      </div>\\n\\n                      <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n                        <a\\n                          href={`tel:${dialTarget}`}\\n                          className=\\\"flex-1 min-h-[40px] px-3.5 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-semibold inline-flex items-center justify-center gap-1.5 whitespace-nowrap\\\"\\n                        >\\n                          <Phone className=\\\"w-3.5 h-3.5\\\" />\\n                          <span>Call {st.phone || \'100\'}</span>\\n                        </a>\\n                        {st.mapsUri && (\\n                          <a\\n                            href={st.mapsUri}\\n                            target=\\\"_blank\\\"\\n                            rel=\\\"noopener noreferrer\\\"\\n                            className=\\\"min-h-[40px] px-3 py-2 rounded-xl bg-[#FCFDF9] hover:bg-[#E7EFE0] border border-[#C3D0B4] text-[#182215] text-xs font-semibold inline-flex items-center gap-1 whitespace-nowrap\\\"\\n                          >\\n                            <span>Maps</span>\\n                            <ExternalLink className=\\\"w-3.5 h-3.5\\\" />\\n                          </a>\\n                        )}\\n                      </div>\\n                    </div>\\n                  );\\n                })}\\n              </div>\\n            )}\\n\\n            {nearbyPoliceResult.summaryText && (\\n              <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#D4DFC8] p-4 text-xs text-[#384632] whitespace-pre-line leading-relaxed\\\">\\n                {nearbyPoliceResult.summaryText}\\n              </div>\\n            )}\\n\\n            {nearbyPoliceResult.mapLinks.length > 0 && (\\n              <div className=\\\"pt-2 border-t border-[#DCE5D1] space-y-1.5\\\">\\n                <p className=\\\"text-[11px] font-semibold text-[#4B5844]\\\">\\n                  Verified Google Maps Sources\\n                </p>\\n                <div className=\\\"flex flex-wrap gap-2\\\">\\n                  {nearbyPoliceResult.mapLinks.map((link, idx) => (\\n                    <a\\n                      key={`${link.uri}-${idx}`}\\n                      href={link.uri}\\n                      target=\\\"_blank\\\"\\n                      rel=\\\"noopener noreferrer\\\"\\n                      className=\\\"text-xs font-semibold text-[#2F4526] hover:underline inline-flex items-center gap-1\\\"\\n                    >\\n                      <span>{link.title}</span>\\n                      <ExternalLink className=\\\"w-3 h-3\\\" />\\n                    </a>\\n                  ))}\\n                </div>\\n              </div>\\n            )}\\n          </div>\\n        )}\\n      </section>\\n\\n      {/* A. Emergency Audio & Video Recording + B. Device Continuity Protection */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n        {/* Emergency Evidence Recording */}\\n        <div className=\\\"lg:col-span-7 bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 space-y-4\\\">\\n          <div className=\\\"flex flex-wrap items-start justify-between gap-3\\\">\\n            <div>\\n              <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n                Emergency Evidence Capture \302\267 Local Browser Storage\\n              </p>\\n              <h2 className=\\\"mt-1 text-lg sm:text-xl font-semibold text-[#182215]\\\">\\n                Audio &amp; Video Recording\\n              </h2>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenHistory}\\n              className=\\\"min-h-[38px] px-3 py-1.5 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] text-[#24371D] text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n            >\\n              <History className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Evidence History</span>\\n            </button>\\n          </div>\\n\\n          <p className=\\\"text-xs text-[#4B5844] leading-relaxed\\\">\\n            Recordings require explicit browser microphone/camera permission, stay stored privately on your device (IndexedDB), and can be played back, shared as an evidence summary with guardians, or permanently deleted anytime from Evidence History.\\n          </p>\\n\\n          {recordingError && (\\n            <p className=\\\"rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs font-medium text-red-700\\\">\\n              {recordingError}\\n            </p>\\n          )}\\n\\n          {recordingSavedNotice && (\\n            <div className=\\\"rounded-xl bg-emerald-50 border border-emerald-200 px-3.5 py-2.5 text-xs font-medium text-emerald-800 flex items-center justify-between gap-2\\\">\\n              <span>{recordingSavedNotice}</span>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onOpenHistory}\\n                className=\\\"font-bold underline shrink-0 cursor-pointer\\\"\\n              >\\n                Review\\n              </button>\\n            </div>\\n          )}\\n\\n          <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n            {recordingMode === \'none\' ? (\\n              <>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => startRecording(\'audio\')}\\n                  className=\\\"flex-1 min-w-[160px] min-h-[48px] px-4 py-2.5 rounded-xl bg-[#2F4526] hover:bg-[#23351C] text-[#F6F9F2] text-sm font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <Mic className=\\\"w-4 h-4\\\" />\\n                  <span>Start Audio Recording</span>\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => startRecording(\'video\')}\\n                  className=\\\"flex-1 min-w-[160px] min-h-[48px] px-4 py-2.5 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] border border-[#C3D0B4] text-[#24371D] text-sm font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <Video className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n                  <span>Start Video Recording</span>\\n                </button>\\n              </>\\n            ) : (\\n              <div className=\\\"w-full rounded-2xl bg-red-50 border border-red-200 p-4 flex flex-wrap items-center justify-between gap-3\\\">\\n                <div className=\\\"flex items-center gap-2.5\\\">\\n                  <Clock className=\\\"w-4 h-4 text-red-600\\\" />\\n                  <div>\\n                    <p className=\\\"text-sm font-bold text-red-800\\\">\\n                      Recording {recordingMode === \'video\' ? \'Video + Audio\' : \'Audio\'}{\' \'}\\n                      \302\267{\' \'}\\n                      <span className=\\\"font-mono tabular-nums\\\">\\n                        {String(Math.floor(recordingSeconds / 60)).padStart(2, \'0\')}:\\n                        {String(recordingSeconds % 60).padStart(2, \'0\')}\\n                      </span>\\n                    </p>\\n                    <p className=\\\"text-xs text-red-700\\\">\\n                      Captured securely locally until stopped\\n                    </p>\\n                  </div>\\n                </div>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={stopRecording}\\n                  className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n                >\\n                  <Square className=\\\"w-3.5 h-3.5 fill-current\\\" />\\n                  <span>Stop &amp; Save Evidence</span>\\n                </button>\\n              </div>\\n            )}\\n          </div>\\n\\n          {recordingMode === \'video\' && (\\n            <div className=\\\"rounded-2xl overflow-hidden bg-[#182215] border border-[#B8C6A8] aspect-video\\\">\\n              <video\\n                ref={videoPreviewRef}\\n                autoPlay\\n                playsInline\\n                muted\\n                className=\\\"w-full h-full object-cover\\\"\\n              />\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Device Continuity & Connectivity Preservation */}\\n        <div className=\\\"lg:col-span-5 bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 space-y-4\\\">\\n          <div>\\n            <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n              Device Continuity &amp; Disconnect Preservation\\n            </p>\\n            <h2 className=\\\"mt-1 text-lg font-semibold text-[#182215]\\\">\\n              Connectivity &amp; Sudden Drop Protection\\n            </h2>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-2 gap-3 text-xs\\\">\\n            <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#D4DFC8] p-3.5\\\">\\n              <p className=\\\"text-[#54634D] flex items-center gap-1.5\\\">\\n                {isOnline ? (\\n                  <Wifi className=\\\"w-3.5 h-3.5 text-emerald-600\\\" />\\n                ) : (\\n                  <WifiOff className=\\\"w-3.5 h-3.5 text-amber-600\\\" />\\n                )}\\n                <span>Network State</span>\\n              </p>\\n              <p className=\\\"mt-1 font-bold text-[#182215]\\\">\\n                {isOnline ? \'Connected\' : \'Offline \342\200\224 Local Queue\'}\\n              </p>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#D4DFC8] p-3.5\\\">\\n              <p className=\\\"text-[#54634D] flex items-center gap-1.5\\\">\\n                <Battery className=\\\"w-3.5 h-3.5 text-[#2F4526]\\\" />\\n                <span>Device Battery</span>\\n              </p>\\n              <p className=\\\"mt-1 font-bold font-mono tabular-nums text-[#182215]\\\">\\n                {batteryPercent !== null ? `${batteryPercent}%` : \'Browser Restricted\'}\\n              </p>\\n            </div>\\n          </div>\\n\\n          <p className=\\\"text-xs text-[#465340] leading-relaxed\\\">\\n            While Threat Mode is active, OurSafe saves a heartbeat snapshot (last GPS coordinates, battery level, and connectivity state) every 10 seconds so emergency data is preserved if connectivity drops unexpectedly.\\n          </p>\\n\\n          <p className=\\\"text-[11px] text-[#54634D] leading-relaxed rounded-xl bg-[#F4F7EF] border border-[#D4DFC8] p-3\\\">\\n            <strong>Honest technical limitation:</strong> Software cannot detect every type of physical phone damage or continue recording after complete power loss.\\n          </p>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-2.5 pt-1\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onSimulateConnectivityDrop}\\n              className=\\\"flex-1 min-h-[42px] px-4 py-2 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] text-[#24371D] text-xs font-semibold cursor-pointer whitespace-nowrap\\\"\\n            >\\n              Simulate Sudden Disconnect\\n            </button>\\n\\n            {primaryGuardian && (\\n              <a\\n                href={`tel:${formatPhoneForTel(primaryGuardian.phone)}`}\\n                className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-[#FCFDF9] hover:bg-[#F4F7EF] border border-[#C3D0B4] text-[#182215] text-xs font-semibold inline-flex items-center gap-1.5 whitespace-nowrap\\\"\\n              >\\n                <Phone className=\\\"w-3.5 h-3.5 text-[#2F4526]\\\" />\\n                <span>Call Guardian</span>\\n              </a>\\n            )}\\n          </div>\\n        </div>\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Upgrade ThreatModePage with AI-powered nearby police station numbers via Gemini Maps Grounding, direct tel: dial buttons, Maps source links, and OurSafe sage theme\", \"Overwrite\":true, \"TargetFile\":\"/src/components/pages/ThreatModePage.tsx\", \"toolAction\":\"Updating ThreatModePage with AI police lookup\", \"toolSummary\":\"Update ThreatModePage\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2941438183797952818"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useEffect } from \'react\';\\nimport {\\n  CheckCircle2,\\n  Clock,\\n  LocateFixed,\\n  MapPin,\\n  Phone,\\n  Radio,\\n  Send,\\n  Shield,\\n  ShieldAlert,\\n  Users,\\n  Wifi,\\n  WifiOff,\\n  X,\\n} from \'lucide-react\';\\nimport {\\n  AlertDeliveryStatus,\\n  DualCallDispatchState,\\n  GeoLocationState,\\n  LiveLocationShareSession,\\n  NearbyPoliceAiResult,\\n  SosAlertRecord,\\n  SosContact,\\n} from \'../../types/safety\';\\nimport { formatDateTimeShort, formatPhoneForTel } from \'../../utils/storage\';\\n\\ninterface SosPageProps {\\n  userName: string;\\n  contacts: SosContact[];\\n  geoLocation: GeoLocationState;\\n  isOnline: boolean;\\n  latestSosAlert: SosAlertRecord | null;\\n  liveLocationShare: LiveLocationShareSession | null;\\n  dualCallState: DualCallDispatchState | null;\\n  nearbyPoliceResult: NearbyPoliceAiResult | null;\\n  quickDialEnabled: boolean;\\n  onRequestLocation: () => void;\\n  onTriggerSosAlert: (triggerSource: string, note?: string) => void;\\n  onOpenDualCall: (triggeredBy: string) => void;\\n  onMarkDualCallDialed: (target: \'guardian\' | \'police\') => void;\\n  onCloseDualCall: () => void;\\n  onClearSosStatus: () => void;\\n  onToggleLiveLocationShare: (active: boolean, durationMinutes?: number) => void;\\n  onToggleQuickDial: () => void;\\n  onOpenContacts: () => void;\\n  onOpenNearbyPolice: () => void;\\n}\\n\\nconst STATUS_LABELS: Record<AlertDeliveryStatus, { text: string; tone: string }> = {\\n  standby: { text: \'Standby \342\200\224 Ready\', tone: \'text-[#4B5844]\' },\\n  initiated: { text: \'Initiated \342\200\224 Preparing Dispatch\', tone: \'text-amber-700\' },\\n  delivered_demo: {\\n    text: \'Alert Logged (Prototype Demo \342\200\224 No Real SMS Sent)\',\\n    tone: \'text-emerald-700\',\\n  },\\n  queued_offline: {\\n    text: \'Offline \342\200\224 Preserved Locally (Will Queue Until Online)\',\\n    tone: \'text-amber-800\',\\n  },\\n  failed: { text: \'Delivery Failed \342\200\224 No Contacts Configured\', tone: \'text-red-700\' },\\n};\\n\\nexport const SosPage: React.FC<SosPageProps> = ({\\n  userName,\\n  contacts,\\n  geoLocation,\\n  isOnline,\\n  latestSosAlert,\\n  liveLocationShare,\\n  dualCallState,\\n  nearbyPoliceResult,\\n  quickDialEnabled,\\n  onRequestLocation,\\n  onTriggerSosAlert,\\n  onOpenDualCall,\\n  onMarkDualCallDialed,\\n  onCloseDualCall,\\n  onClearSosStatus,\\n  onToggleLiveLocationShare,\\n  onToggleQuickDial,\\n  onOpenContacts,\\n  onOpenNearbyPolice,\\n}) => {\\n  const primaryGuardian = contacts.find((c) => c.isPrimary) ?? contacts[0];\\n  const hasCoords =\\n    geoLocation.status === \'granted\' &&\\n    geoLocation.latitude !== null &&\\n    geoLocation.longitude !== null;\\n\\n  const nearestAiStationWithPhone = nearbyPoliceResult?.stations.find(\\n    (s) => Boolean(s.phone)\\n  );\\n\\n  useEffect(() => {\\n    if (geoLocation.status === \'idle\') {\\n      onRequestLocation();\\n    }\\n  }, [geoLocation.status, onRequestLocation]);\\n\\n  const currentStatus: AlertDeliveryStatus = latestSosAlert?.status ?? \'standby\';\\n  const statusMeta = STATUS_LABELS[currentStatus];\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Dual Emergency Call Panel (Voice Controller -> Call BOTH Guardian & Police) */}\\n      {dualCallState?.active && (\\n        <section\\n          role=\\\"region\\\"\\n          aria-label=\\\"Dual Emergency Call Controller\\\"\\n          className=\\\"rounded-3xl bg-[#FCFDF9] border-2 border-red-500 p-6 shadow-md space-y-4\\\"\\n        >\\n          <div className=\\\"flex items-start justify-between gap-4\\\">\\n            <div>\\n              <p className=\\\"text-xs font-bold text-red-700\\\">\\n                Dual Emergency Call Dispatch \302\267 Triggered via {dualCallState.triggeredBy}\\n              </p>\\n              <h2 className=\\\"mt-1 text-xl sm:text-2xl font-semibold text-[#182215]\\\">\\n                Call Both Your Guardian &amp; Police Now\\n              </h2>\\n              <p className=\\\"mt-1 text-xs text-[#465340] max-w-2xl\\\">\\n                Browser security requires one tap per phone dialer action. Tap both emergency buttons below to initiate calls to your guardian and police immediately.\\n              </p>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onCloseDualCall}\\n              aria-label=\\\"Close dual call panel\\\"\\n              className=\\\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#54634D] hover:bg-[#F4F7EF] cursor-pointer\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-4\\\">\\n            {/* Step 1: Guardian Call */}\\n            <div className=\\\"rounded-2xl bg-red-50/70 border border-red-200 p-4 flex flex-col justify-between gap-3\\\">\\n              <div>\\n                <p className=\\\"text-xs font-semibold text-red-800\\\">\\n                  1. Registered Guardian\\n                  {dualCallState.guardianDialAttempted ? \' \302\267 Dialer Opened\' : \'\'}\\n                </p>\\n                <p className=\\\"mt-1 text-lg font-bold text-[#182215]\\\">\\n                  {dualCallState.guardianName || \'No Guardian Added\'}\\n                </p>\\n                <p className=\\\"text-xs font-mono tabular-nums text-[#465340]\\\">\\n                  {dualCallState.guardianPhone || \'Add a guardian contact first\'}\\n                </p>\\n              </div>\\n\\n              {dualCallState.guardianPhone ? (\\n                <a\\n                  href={`tel:${formatPhoneForTel(dualCallState.guardianPhone)}`}\\n                  onClick={() => onMarkDualCallDialed(\'guardian\')}\\n                  className=\\\"w-full min-h-[48px] px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n                >\\n                  <Phone className=\\\"w-4 h-4\\\" />\\n                  <span>Call {dualCallState.guardianName}</span>\\n                </a>\\n              ) : (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onOpenContacts}\\n                  className=\\\"w-full min-h-[48px] px-4 py-2.5 rounded-xl bg-[#2F4526] text-white text-sm font-semibold cursor-pointer\\\"\\n                >\\n                  Add Guardian Number\\n                </button>\\n              )}\\n            </div>\\n\\n            {/* Step 2: Police Call */}\\n            <div className=\\\"rounded-2xl bg-red-50/70 border border-red-200 p-4 flex flex-col justify-between gap-3\\\">\\n              <div>\\n                <p className=\\\"text-xs font-semibold text-red-800\\\">\\n                  2. Police Dispatch\\n                  {dualCallState.policeDialAttempted ? \' \302\267 Dialer Opened\' : \'\'}\\n                </p>\\n                <p className=\\\"mt-1 text-lg font-bold text-[#182215]\\\">\\n                  {dualCallState.nearestStationName || dualCallState.policeName}\\n                </p>\\n                <p className=\\\"text-xs font-mono tabular-nums text-[#465340]\\\">\\n                  Direct: {dualCallState.nearestStationPhone || dualCallState.policePhone}{\' \'}\\n                  \302\267 National Emergency: 112\\n                </p>\\n              </div>\\n\\n              <div className=\\\"flex flex-wrap gap-2\\\">\\n                <a\\n                  href={`tel:${formatPhoneForTel(\\n                    dualCallState.nearestStationPhone || dualCallState.policePhone\\n                  )}`}\\n                  onClick={() => onMarkDualCallDialed(\'police\')}\\n                  className=\\\"flex-1 min-h-[48px] px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n                >\\n                  <Phone className=\\\"w-4 h-4\\\" />\\n                  <span>\\n                    Call Police (\\n                    {dualCallState.nearestStationPhone || dualCallState.policePhone})\\n                  </span>\\n                </a>\\n                <a\\n                  href=\\\"tel:112\\\"\\n                  onClick={() => onMarkDualCallDialed(\'police\')}\\n                  className=\\\"min-h-[48px] px-4 py-2.5 rounded-xl bg-white hover:bg-red-50 border border-red-300 text-red-700 text-sm font-bold flex items-center justify-center whitespace-nowrap\\\"\\n                >\\n                  112\\n                </a>\\n              </div>\\n            </div>\\n          </div>\\n        </section>\\n      )}\\n\\n      {/* Top Emergency Hero Banner */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch\\\">\\n        <div className=\\\"lg:col-span-7 rounded-3xl bg-red-600 text-white p-6 sm:p-8 flex flex-col justify-between gap-6 shadow-md shadow-red-900/15\\\">\\n          <div className=\\\"space-y-2\\\">\\n            <div className=\\\"flex flex-wrap items-center gap-2 text-xs font-semibold text-red-100\\\">\\n              <span>OurSafe SOS Emergency Controller</span>\\n              <span aria-hidden=\\\"true\\\">\302\267</span>\\n              <span>{isOnline ? \'Online\' : \'Offline Mode Active\'}</span>\\n            </div>\\n            <h1 className=\\\"text-2xl sm:text-3xl font-semibold tracking-tight\\\">\\n              Immediate Emergency Assistance\\n            </h1>\\n            <p className=\\\"text-sm text-red-50/90 leading-relaxed max-w-xl\\\">\\n              Trigger SOS manually or by saying &ldquo;Open SOS&rdquo; or &ldquo;Call both guardian and police&rdquo; to the AI Voice Assistant. Captures live GPS, prepares guardian alerts, and launches dual guardian + police dialing.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center gap-3\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                onTriggerSosAlert(\'Manual SOS Page Button\');\\n                onOpenDualCall(\'Manual SOS Activation\');\\n              }}\\n              className=\\\"flex-1 min-w-[210px] min-h-[54px] px-6 py-3 rounded-2xl bg-white hover:bg-red-50 active:scale-[0.99] text-red-700 text-base font-extrabold flex items-center justify-center gap-2 transition-all shadow-sm cursor-pointer whitespace-nowrap\\\"\\n            >\\n              <ShieldAlert className=\\\"w-5 h-5\\\" />\\n              <span>Trigger SOS &amp; Dual Call</span>\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => onOpenDualCall(\'Dual Emergency Call Button\')}\\n              className=\\\"min-h-[54px] px-5 py-3 rounded-2xl bg-red-800/80 hover:bg-red-900 border border-white/25 text-white text-sm font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap cursor-pointer\\\"\\n            >\\n              <Phone className=\\\"w-4 h-4\\\" />\\n              <span>Call Guardian &amp; Police</span>\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Emergency Status Tracker */}\\n        <div className=\\\"lg:col-span-5 bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 flex flex-col justify-between gap-4 shadow-sm\\\">\\n          <div className=\\\"space-y-3\\\">\\n            <div className=\\\"flex items-center justify-between gap-2\\\">\\n              <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n                Emergency Status Tracker\\n              </p>\\n              {latestSosAlert && (\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={onClearSosStatus}\\n                  className=\\\"text-xs font-semibold text-[#54634D] hover:text-[#182215] cursor-pointer\\\"\\n                >\\n                  Reset Status\\n                </button>\\n              )}\\n            </div>\\n\\n            <div>\\n              <p className={`text-base font-bold ${statusMeta.tone}`}>\\n                {statusMeta.text}\\n              </p>\\n              {latestSosAlert ? (\\n                <p className=\\\"mt-1 text-xs text-[#54634D] flex items-center gap-1.5 tabular-nums\\\">\\n                  <Clock className=\\\"w-3.5 h-3.5\\\" />\\n                  <span>\\n                    Activated {formatDateTimeShort(latestSosAlert.activatedAt)} via{\' \'}\\n                    {latestSosAlert.triggerSource}\\n                  </span>\\n                </p>\\n              ) : (\\n                <p className=\\\"mt-1 text-xs text-[#54634D]\\\">\\n                  No active SOS dispatch. Press the red SOS button or use voice command &ldquo;Call both guardian and police&rdquo;.\\n                </p>\\n              )}\\n            </div>\\n\\n            {latestSosAlert && (\\n              <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] p-3.5 space-y-2 text-xs\\\">\\n                <p className=\\\"font-semibold text-[#182215]\\\">\\n                  Alert Payload Prepared for {latestSosAlert.recipients.length} Contact(s)\\n                </p>\\n                <p className=\\\"font-mono text-[11px] text-[#3E4C37] leading-relaxed\\\">\\n                  &ldquo;SOS from {userName} via OurSafe. Need immediate assistance. GPS:{\' \'}\\n                  {latestSosAlert.latitude !== null && latestSosAlert.longitude !== null\\n                    ? `${latestSosAlert.latitude.toFixed(5)}, ${latestSosAlert.longitude.toFixed(5)}`\\n                    : \'Location unavailable\'}\\n                  .&rdquo;\\n                </p>\\n                {latestSosAlert.recipients.length > 0 && (\\n                  <div className=\\\"pt-2 border-t border-[#DCE5D1] space-y-1\\\">\\n                    {latestSosAlert.recipients.map((r, i) => (\\n                      <div\\n                        key={`${r.phone}-${i}`}\\n                        className=\\\"flex items-center justify-between gap-2 text-[11px]\\\"\\n                      >\\n                        <span className=\\\"font-semibold text-[#182215]\\\">\\n                          {r.name}\\n                        </span>\\n                        <span className=\\\"text-[#4B5844] capitalize\\\">\\n                          {r.status.replace(\'_\', \' \')}\\n                        </span>\\n                      </div>\\n                    ))}\\n                  </div>\\n                )}\\n              </div>\\n            )}\\n          </div>\\n\\n          <div className=\\\"pt-3 border-t border-[#DCE5D1] flex items-center justify-between gap-3\\\">\\n            <div className=\\\"text-xs text-[#465340]\\\">\\n              <p className=\\\"font-semibold text-[#182215]\\\">\\n                Voice SOS Dual-Call Priority\\n              </p>\\n              <p className=\\\"text-[11px] text-[#54634D]\\\">\\n                Surface guardian + police dialers automatically on voice SOS\\n              </p>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              role=\\\"switch\\\"\\n              aria-checked={quickDialEnabled}\\n              onClick={onToggleQuickDial}\\n              className={`w-11 h-6 rounded-full p-0.5 transition-colors shrink-0 cursor-pointer flex items-center ${\\n                quickDialEnabled\\n                  ? \'bg-[#2F4526] justify-end\'\\n                  : \'bg-[#C4D1B6] justify-start\'\\n              }`}\\n            >\\n              <span className=\\\"w-5 h-5 rounded-full bg-white shadow-sm block\\\" />\\n            </button>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Live Location Sharing + Nearest Police Station */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n        <div className=\\\"lg:col-span-6 bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 space-y-4\\\">\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n            <div>\\n              <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n                Live Location Sharing\\n              </p>\\n              <h2 className=\\\"text-lg font-semibold text-[#182215] mt-0.5\\\">\\n                Current GPS Coordinates\\n              </h2>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onRequestLocation}\\n              className=\\\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] text-[#24371D] text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n            >\\n              <LocateFixed className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Refresh GPS</span>\\n            </button>\\n          </div>\\n\\n          <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#D4DFC8] p-4 space-y-2\\\">\\n            <div className=\\\"flex items-center gap-2 text-sm font-semibold text-[#182215]\\\">\\n              <MapPin className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n              <span className=\\\"font-mono tabular-nums\\\">\\n                {hasCoords\\n                  ? `${geoLocation.latitude!.toFixed(6)}, ${geoLocation.longitude!.toFixed(6)}`\\n                  : geoLocation.status === \'loading\'\\n                    ? \'Locating device...\'\\n                    : \'Location permission needed\'}\\n              </span>\\n            </div>\\n            <p className=\\\"text-xs text-[#54634D]\\\">\\n              {hasCoords\\n                ? `Accuracy \302\261${Math.round(geoLocation.accuracy ?? 0)}m \302\267 Ready to attach to emergency alerts`\\n                : geoLocation.errorMessage ||\\n                  \'Grant browser location permission to share exact coordinates with guardians.\'}\\n            </p>\\n          </div>\\n\\n          <div className=\\\"flex flex-wrap items-center justify-between gap-3 pt-1\\\">\\n            <div className=\\\"text-xs text-[#465340]\\\">\\n              <p className=\\\"font-semibold text-[#182215] flex items-center gap-1.5\\\">\\n                <Radio className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n                <span>\\n                  {liveLocationShare?.active\\n                    ? `Sharing Active (${liveLocationShare.sharedWithNames.length} contact(s))`\\n                    : \'Live Location Sharing Standby\'}\\n                </span>\\n              </p>\\n              <p className=\\\"text-[11px] text-[#54634D] mt-0.5\\\">\\n                {liveLocationShare?.active\\n                  ? `Started ${formatDateTimeShort(liveLocationShare.startedAt)} \302\267 Local session tracking`\\n                  : \'Starts a local live-location session linked to your trusted guardians.\'}\\n              </p>\\n            </div>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() =>\\n                onToggleLiveLocationShare(!liveLocationShare?.active, 30)\\n              }\\n              className={`min-h-[42px] px-4 py-2 rounded-xl text-xs font-semibold transition-colors whitespace-nowrap cursor-pointer ${\\n                liveLocationShare?.active\\n                  ? \'bg-red-50 hover:bg-red-100 border border-red-200 text-red-700\'\\n                  : \'bg-[#2F4526] hover:bg-[#23351C] text-[#F6F9F2]\'\\n              }`}\\n            >\\n              {liveLocationShare?.active\\n                ? \'Stop Location Share\'\\n                : \'Share Live Location\'}\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Nearest Police Station & Authorities */}\\n        <div className=\\\"lg:col-span-6 bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 flex flex-col justify-between gap-4\\\">\\n          <div className=\\\"space-y-2\\\">\\n            <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n              Immediate Law Enforcement Access\\n            </p>\\n            <h2 className=\\\"text-lg font-semibold text-[#182215]\\\">\\n              Contact Nearest Police Station\\n            </h2>\\n            <p className=\\\"text-xs text-[#4B5844] leading-relaxed\\\">\\n              {nearestAiStationWithPhone\\n                ? `AI located ${nearestAiStationWithPhone.name} (${nearestAiStationWithPhone.phone}). Dial directly below or call national dispatch.`\\n                : \'Reach official emergency dispatch immediately via your phone dialer, or open Nearby Police Stations centered on your live GPS.\'}\\n            </p>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n            <a\\n              href={`tel:${formatPhoneForTel(\\n                nearestAiStationWithPhone?.phone || \'100\'\\n              )}`}\\n              className=\\\"min-h-[48px] px-4 py-2.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n            >\\n              <Phone className=\\\"w-4 h-4\\\" />\\n              <span>\\n                Call Police ({nearestAiStationWithPhone?.phone || \'100\'})\\n              </span>\\n            </a>\\n            <a\\n              href=\\\"tel:112\\\"\\n              className=\\\"min-h-[48px] px-4 py-2.5 rounded-xl bg-red-50 hover:bg-red-100 border border-red-200 text-red-800 text-sm font-bold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\\\"\\n            >\\n              <Shield className=\\\"w-4 h-4\\\" />\\n              <span>Emergency (112)</span>\\n            </a>\\n          </div>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={onOpenNearbyPolice}\\n            className=\\\"w-full min-h-[46px] px-4 py-2.5 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] text-[#24371D] text-sm font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer\\\"\\n          >\\n            <MapPin className=\\\"w-4 h-4 text-[#2F4526]\\\" />\\n            <span>Open Nearby Police Stations</span>\\n          </button>\\n        </div>\\n      </section>\\n\\n      {/* Trusted Guardian Network & Offline Support Notice */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6\\\">\\n        <div className=\\\"lg:col-span-7 bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 space-y-4\\\">\\n          <div className=\\\"flex items-center justify-between gap-3\\\">\\n            <div>\\n              <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n                Trusted Guardian Network ({contacts.length})\\n              </p>\\n              <h2 className=\\\"text-lg font-semibold text-[#182215] mt-0.5\\\">\\n                Registered Emergency Contacts\\n              </h2>\\n            </div>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenContacts}\\n              className=\\\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] text-[#24371D] text-xs font-semibold flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n            >\\n              <Users className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Manage Network</span>\\n            </button>\\n          </div>\\n\\n          {contacts.length === 0 ? (\\n            <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#D4DFC8] p-5 text-center space-y-3\\\">\\n              <p className=\\\"text-sm text-[#4B5844]\\\">\\n                No emergency contacts registered yet.\\n              </p>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onOpenContacts}\\n                className=\\\"min-h-[42px] px-4 py-2 rounded-xl bg-[#2F4526] text-white text-xs font-semibold cursor-pointer\\\"\\n              >\\n                Add Trusted Guardian\\n              </button>\\n            </div>\\n          ) : (\\n            <div className=\\\"divide-y divide-[#DCE5D1] border border-[#CFD9C3] rounded-2xl overflow-hidden\\\">\\n              {contacts.map((c) => (\\n                <div\\n                  key={c.id}\\n                  className=\\\"p-4 bg-[#FCFDF9] flex flex-wrap items-center justify-between gap-3\\\"\\n                >\\n                  <div className=\\\"min-w-0\\\">\\n                    <p className=\\\"text-sm font-bold text-[#182215]\\\">\\n                      {c.name}\\n                      {c.isPrimary ? \' \302\267 Primary Guardian\' : \'\'}\\n                    </p>\\n                    <p className=\\\"text-xs text-[#54634D] font-mono tabular-nums mt-0.5\\\">\\n                      {c.phone} \302\267 {c.relation || \'Emergency Contact\'}\\n                    </p>\\n                  </div>\\n\\n                  <div className=\\\"flex items-center gap-2\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() =>\\n                        onTriggerSosAlert(`Direct Alert to ${c.name}`)\\n                      }\\n                      className=\\\"min-h-[40px] px-3 py-1.5 rounded-xl bg-[#EAF0E2] hover:bg-[#DCE7D2] text-[#24371D] text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer whitespace-nowrap\\\"\\n                    >\\n                      <Send className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Alert</span>\\n                    </button>\\n                    <a\\n                      href={`tel:${formatPhoneForTel(c.phone)}`}\\n                      className=\\\"min-h-[40px] px-3.5 py-1.5 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-semibold inline-flex items-center gap-1.5 whitespace-nowrap\\\"\\n                    >\\n                      <Phone className=\\\"w-3.5 h-3.5\\\" />\\n                      <span>Call</span>\\n                    </a>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Emergency Offline Support Card */}\\n        <div className=\\\"lg:col-span-5 bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 space-y-4\\\">\\n          <div className=\\\"flex items-center justify-between gap-2\\\">\\n            <div>\\n              <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n                Emergency Offline Support\\n              </p>\\n              <h2 className=\\\"text-lg font-semibold text-[#182215] mt-0.5\\\">\\n                Connectivity &amp; Offline Readiness\\n              </h2>\\n            </div>\\n            <div className=\\\"flex items-center gap-1.5 text-xs font-bold text-[#182215]\\\">\\n              {isOnline ? (\\n                <>\\n                  <Wifi className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                  <span className=\\\"text-emerald-700\\\">Online</span>\\n                </>\\n              ) : (\\n                <>\\n                  <WifiOff className=\\\"w-4 h-4 text-amber-600\\\" />\\n                  <span className=\\\"text-amber-700\\\">Offline</span>\\n                </>\\n              )}\\n            </div>\\n          </div>\\n\\n          <div className=\\\"space-y-3 text-xs\\\">\\n            <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#D4DFC8] p-4 space-y-1.5\\\">\\n              <p className=\\\"font-bold text-emerald-800 flex items-center gap-1.5\\\">\\n                <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600 shrink-0\\\" />\\n                <span>Available Offline (Cached Locally)</span>\\n              </p>\\n              <p className=\\\"text-[#465340] leading-relaxed\\\">\\n                Saved guardian numbers, direct <code className=\\\"font-mono\\\">tel:</code> emergency calling (112, 181, 100, 108, 1098), Threat Mode audio/video recording, local Evidence History, and Fake Call.\\n              </p>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#D4DFC8] p-4 space-y-1.5\\\">\\n              <p className=\\\"font-bold text-[#182215]\\\">\\n                Requires Internet Connection\\n              </p>\\n              <p className=\\\"text-[#4B5844] leading-relaxed\\\">\\n                Real-time Gemini Live Voice AI, AI nearby police station lookup, online Maps searches, and future cloud SMS alerts.\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Upgrade SosPage with Dual Emergency Call Dispatch (Guardian + Police), nearest AI police station integration, OurSafe branding, and botanical sage styling\", \"Overwrite\":true, \"TargetFile\":\"/src/components/pages/SosPage.tsx\", \"toolAction\":\"Updating SosPage with Dual Emergency Call panel\", \"toolSummary\":\"Update SosPage\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2941438183797953819"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useCallback, useEffect, useRef, useState } from \'react\';\\nimport {\\n  AlertCircle,\\n  AlertTriangle,\\n  Bot,\\n  CheckCircle2,\\n  MapPin,\\n  Mic,\\n  MicOff,\\n  Phone,\\n  Radio,\\n  Send,\\n  ShieldAlert,\\n  Volume2,\\n  WifiOff,\\n} from \'lucide-react\';\\nimport { VoiceCommandAction } from \'../../types/safety\';\\nimport { formatTimeShort } from \'../../utils/storage\';\\n\\ninterface AiVoiceAssistantPageProps {\\n  userName: string;\\n  primaryGuardianName?: string;\\n  primaryGuardianPhone?: string;\\n  threatActive: boolean;\\n  sosActive: boolean;\\n  isOnline: boolean;\\n  onExecuteVoiceCommand: (\\n    call: VoiceCommandAction\\n  ) => Promise<{ ok: boolean; summary: string; data?: Record<string, unknown> }>;\\n  onManualSos: () => void;\\n  onDualCallNow: () => void;\\n}\\n\\ninterface TranscriptItem {\\n  id: string;\\n  role: \'user\' | \'assistant\' | \'action\';\\n  text: string;\\n  timestamp: string;\\n}\\n\\nconst SAMPLE_VOICE_COMMANDS = [\\n  \'Call Both Guardian and Police\',\\n  \'Open SOS\',\\n  \'Activate Threat Mode\',\\n  \'Call My Guardian\',\\n  \'Send Emergency Alert\',\\n  \'Share My Live Location\',\\n  \'Open Nearby Police Stations\',\\n  \'Deactivate Threat Mode\',\\n];\\n\\nfunction float32ToPcm16Base64(float32: Float32Array): string {\\n  const buffer = new ArrayBuffer(float32.length * 2);\\n  const view = new DataView(buffer);\\n  for (let i = 0; i < float32.length; i += 1) {\\n    const s = Math.max(-1, Math.min(1, float32[i]));\\n    view.setInt16(i * 2, s < 0 ? s * 0x8000 : s * 0x7fff, true);\\n  }\\n  const bytes = new Uint8Array(buffer);\\n  let binary = \'\';\\n  const chunkSize = 0x8000;\\n  for (let i = 0; i < bytes.length; i += chunkSize) {\\n    binary += String.fromCharCode(...bytes.subarray(i, i + chunkSize));\\n  }\\n  return btoa(binary);\\n}\\n\\nfunction base64Pcm16ToFloat32(base64: string): Float32Array<ArrayBuffer> {\\n  const binary = atob(base64);\\n  const byteLength = binary.length;\\n  const bytes = new Uint8Array(byteLength);\\n  for (let i = 0; i < byteLength; i += 1) {\\n    bytes[i] = binary.charCodeAt(i);\\n  }\\n  const view = new DataView(bytes.buffer);\\n  const sampleCount = Math.floor(byteLength / 2);\\n  const float32 = new Float32Array(new ArrayBuffer(sampleCount * 4));\\n  for (let i = 0; i < sampleCount; i += 1) {\\n    float32[i] = view.getInt16(i * 2, true) / 32768;\\n  }\\n  return float32;\\n}\\n\\nexport const AiVoiceAssistantPage: React.FC<AiVoiceAssistantPageProps> = ({\\n  userName,\\n  primaryGuardianName,\\n  primaryGuardianPhone,\\n  threatActive,\\n  sosActive,\\n  isOnline,\\n  onExecuteVoiceCommand,\\n  onManualSos,\\n  onDualCallNow,\\n}) => {\\n  const [liveStatus, setLiveStatus] = useState<\\n    \'idle\' | \'connecting\' | \'connected\' | \'error\'\\n  >(\'idle\');\\n  const [liveError, setLiveError] = useState(\'\');\\n  const [isSpeaking, setIsSpeaking] = useState(false);\\n  const [textInput, setTextInput] = useState(\'\');\\n  const [textBusy, setTextBusy] = useState(false);\\n  const [entries, setEntries] = useState<TranscriptItem[]>([\\n    {\\n      id: \'init-voice\',\\n      role: \'assistant\',\\n      text: `Ready, ${userName}. Tap \\\"Start Live Voice\\\" to speak in real time using Gemini Live. Say \\\"Call both guardian and police\\\", \\\"Open SOS\\\", or \\\"Activate Threat Mode\\\" to control OurSafe directly.`,\\n      timestamp: new Date().toISOString(),\\n    },\\n  ]);\\n\\n  const wsRef = useRef<WebSocket | null>(null);\\n  const inputCtxRef = useRef<AudioContext | null>(null);\\n  const outputCtxRef = useRef<AudioContext | null>(null);\\n  const micStreamRef = useRef<MediaStream | null>(null);\\n  const processorRef = useRef<ScriptProcessorNode | null>(null);\\n  const nextStartTimeRef = useRef<number>(0);\\n  const activeSourcesRef = useRef<AudioBufferSourceNode[]>([]);\\n  const liveConnectedRef = useRef<boolean>(false);\\n  const executeCommandRef = useRef(onExecuteVoiceCommand);\\n  const listEndRef = useRef<HTMLDivElement | null>(null);\\n\\n  useEffect(() => {\\n    executeCommandRef.current = onExecuteVoiceCommand;\\n  }, [onExecuteVoiceCommand]);\\n\\n  useEffect(() => {\\n    listEndRef.current?.scrollIntoView({ behavior: \'smooth\', block: \'nearest\' });\\n  }, [entries]);\\n\\n  const appendEntry = useCallback(\\n    (role: TranscriptItem[\'role\'], text: string) => {\\n      const cleaned = text.trim();\\n      if (!cleaned) return;\\n      setEntries((prev) => {\\n        const last = prev[prev.length - 1];\\n        if (\\n          last &&\\n          last.role === role &&\\n          role !== \'action\' &&\\n          Date.now() - new Date(last.timestamp).getTime() < 2600\\n        ) {\\n          return [\\n            ...prev.slice(0, -1),\\n            {\\n              ...last,\\n              text: `${last.text} ${cleaned}`.replace(/\\\\s+/g, \' \').trim(),\\n              timestamp: new Date().toISOString(),\\n            },\\n          ];\\n        }\\n        return [\\n          ...prev,\\n          {\\n            id: `${role}-${Date.now()}-${Math.random().toString(36).slice(2, 6)}`,\\n            role,\\n            text: cleaned,\\n            timestamp: new Date().toISOString(),\\n          },\\n        ];\\n      });\\n    },\\n    []\\n  );\\n\\n  const stopPlaybackQueue = useCallback(() => {\\n    activeSourcesRef.current.forEach((src) => {\\n      try {\\n        src.stop();\\n      } catch {\\n        // ignore\\n      }\\n    });\\n    activeSourcesRef.current = [];\\n    if (outputCtxRef.current) {\\n      nextStartTimeRef.current = outputCtxRef.current.currentTime;\\n    } else {\\n      nextStartTimeRef.current = 0;\\n    }\\n    setIsSpeaking(false);\\n  }, []);\\n\\n  const schedulePcmPlayback = useCallback((base64Pcm: string) => {\\n    const outCtx = outputCtxRef.current;\\n    if (!outCtx) return;\\n    if (outCtx.state === \'suspended\') {\\n      outCtx.resume().catch(() => {});\\n    }\\n\\n    const floatData = base64Pcm16ToFloat32(base64Pcm);\\n    if (floatData.length === 0) return;\\n\\n    const audioBuffer = outCtx.createBuffer(1, floatData.length, 24000);\\n    audioBuffer.copyToChannel(floatData, 0);\\n\\n    const source = outCtx.createBufferSource();\\n    source.buffer = audioBuffer;\\n    source.connect(outCtx.destination);\\n\\n    const now = outCtx.currentTime;\\n    const startAt = Math.max(now + 0.01, nextStartTimeRef.current);\\n    nextStartTimeRef.current = startAt + audioBuffer.duration;\\n\\n    setIsSpeaking(true);\\n    activeSourcesRef.current.push(source);\\n    source.onended = () => {\\n      activeSourcesRef.current = activeSourcesRef.current.filter(\\n        (s) => s !== source\\n      );\\n      if (activeSourcesRef.current.length === 0) {\\n        setIsSpeaking(false);\\n      }\\n    };\\n    source.start(startAt);\\n  }, []);\\n\\n  const disconnectLiveVoice = useCallback(() => {\\n    liveConnectedRef.current = false;\\n    stopPlaybackQueue();\\n\\n    if (processorRef.current) {\\n      try {\\n        processorRef.current.disconnect();\\n      } catch {\\n        // ignore\\n      }\\n      processorRef.current = null;\\n    }\\n    if (micStreamRef.current) {\\n      micStreamRef.current.getTracks().forEach((t) => t.stop());\\n      micStreamRef.current = null;\\n    }\\n    if (inputCtxRef.current) {\\n      inputCtxRef.current.close().catch(() => {});\\n      inputCtxRef.current = null;\\n    }\\n    if (outputCtxRef.current) {\\n      outputCtxRef.current.close().catch(() => {});\\n      outputCtxRef.current = null;\\n    }\\n    if (wsRef.current) {\\n      try {\\n        wsRef.current.close();\\n      } catch {\\n        // ignore\\n      }\\n      wsRef.current = null;\\n    }\\n    setLiveStatus(\'idle\');\\n  }, [stopPlaybackQueue]);\\n\\n  useEffect(() => {\\n    return () => {\\n      disconnectLiveVoice();\\n    };\\n  }, [disconnectLiveVoice]);\\n\\n  const startLiveVoice = async () => {\\n    setLiveError(\'\');\\n    if (!isOnline) {\\n      setLiveError(\\n        \'Live AI Voice requires an internet connection. Offline emergency calling and SOS contacts remain available on the SOS page.\'\\n      );\\n      setLiveStatus(\'error\');\\n      return;\\n    }\\n\\n    if (!navigator.mediaDevices?.getUserMedia) {\\n      setLiveError(\'Microphone capture is not supported in this browser.\');\\n      setLiveStatus(\'error\');\\n      return;\\n    }\\n\\n    disconnectLiveVoice();\\n    setLiveStatus(\'connecting\');\\n\\n    try {\\n      const micStream = await navigator.mediaDevices.getUserMedia({\\n        audio: {\\n          channelCount: 1,\\n          sampleRate: 16000,\\n          echoCancellation: true,\\n          noiseSuppression: true,\\n        },\\n      });\\n      micStreamRef.current = micStream;\\n\\n      const AudioCtx =\\n        window.AudioContext ||\\n        (window as unknown as { webkitAudioContext: typeof AudioContext })\\n          .webkitAudioContext;\\n\\n      const inputCtx = new AudioCtx({ sampleRate: 16000 });\\n      const outputCtx = new AudioCtx({ sampleRate: 24000 });\\n      inputCtxRef.current = inputCtx;\\n      outputCtxRef.current = outputCtx;\\n      nextStartTimeRef.current = outputCtx.currentTime;\\n\\n      const wsProtocol = window.location.protocol === \'https:\' ? \'wss:\' : \'ws:\';\\n      const ws = new WebSocket(`${wsProtocol}//${window.location.host}/api/live-voice`);\\n      wsRef.current = ws;\\n\\n      ws.onopen = () => {\\n        ws.send(\\n          JSON.stringify({\\n            type: \'init\',\\n            userContext: {\\n              userName,\\n              primaryGuardianName,\\n              primaryGuardianPhone,\\n              threatActive,\\n              sosActive,\\n            },\\n          })\\n        );\\n      };\\n\\n      ws.onmessage = async (event) => {\\n        try {\\n          const msg = JSON.parse(event.data) as {\\n            type: string;\\n            data?: string;\\n            text?: string;\\n            message?: string;\\n            calls?: VoiceCommandAction[];\\n          };\\n\\n          if (msg.type === \'ready\') {\\n            liveConnectedRef.current = true;\\n            setLiveStatus(\'connected\');\\n            appendEntry(\\n              \'action\',\\n              \'Gemini 3.8 Live voice controller connected. Say \\\"Call both guardian and police\\\" or any safety command.\'\\n            );\\n\\n            if (inputCtxRef.current && micStreamRef.current) {\\n              const source = inputCtxRef.current.createMediaStreamSource(\\n                micStreamRef.current\\n              );\\n              const processor = inputCtxRef.current.createScriptProcessor(\\n                4096,\\n                1,\\n                1\\n              );\\n              processorRef.current = processor;\\n\\n              processor.onaudioprocess = (audioEvent) => {\\n                if (\\n                  !liveConnectedRef.current ||\\n                  !wsRef.current ||\\n                  wsRef.current.readyState !== WebSocket.OPEN\\n                ) {\\n                  return;\\n                }\\n                const channelData = audioEvent.inputBuffer.getChannelData(0);\\n                const pcmBase64 = float32ToPcm16Base64(channelData);\\n                wsRef.current.send(\\n                  JSON.stringify({ type: \'audio\', audio: pcmBase64 })\\n                );\\n              };\\n\\n              source.connect(processor);\\n              processor.connect(inputCtxRef.current.destination);\\n            }\\n          } else if (msg.type === \'audio\' && msg.data) {\\n            schedulePcmPlayback(msg.data);\\n          } else if (msg.type === \'interrupted\') {\\n            stopPlaybackQueue();\\n          } else if (msg.type === \'inputTranscript\' && msg.text) {\\n            appendEntry(\'user\', msg.text);\\n          } else if (msg.type === \'outputTranscript\' && msg.text) {\\n            appendEntry(\'assistant\', msg.text);\\n          } else if (msg.type === \'toolCall\' && Array.isArray(msg.calls)) {\\n            const responses = [];\\n            for (const call of msg.calls) {\\n              const outcome = await executeCommandRef.current(call);\\n              appendEntry(\'action\', outcome.summary);\\n              responses.push({\\n                id: call.id,\\n                name: call.name,\\n                response: {\\n                  result: outcome.summary,\\n                  ok: outcome.ok,\\n                  ...(outcome.data ?? {}),\\n                },\\n              });\\n            }\\n            if (wsRef.current && wsRef.current.readyState === WebSocket.OPEN) {\\n              wsRef.current.send(\\n                JSON.stringify({ type: \'toolResponse\', responses })\\n              );\\n            }\\n          } else if (msg.type === \'error\') {\\n            setLiveError(msg.message || \'Live voice session encountered an error.\');\\n            setLiveStatus(\'error\');\\n            disconnectLiveVoice();\\n          } else if (msg.type === \'closed\') {\\n            disconnectLiveVoice();\\n          }\\n        } catch {\\n          // ignore\\n        }\\n      };\\n\\n      ws.onerror = () => {\\n        setLiveError(\\n          \'Unable to connect to the live voice server. Check connectivity and try again.\'\\n        );\\n        setLiveStatus(\'error\');\\n        disconnectLiveVoice();\\n      };\\n\\n      ws.onclose = () => {\\n        if (liveConnectedRef.current) {\\n          disconnectLiveVoice();\\n        }\\n      };\\n    } catch {\\n      setLiveError(\\n        \'Microphone permission denied or unavailable. You can still run any command via text or quick buttons below.\'\\n      );\\n      setLiveStatus(\'error\');\\n      disconnectLiveVoice();\\n    }\\n  };\\n\\n  const runTextCommand = async (commandText: string) => {\\n    const trimmed = commandText.trim();\\n    if (!trimmed) return;\\n\\n    setLiveError(\'\');\\n    setTextInput(\'\');\\n    appendEntry(\'user\', trimmed);\\n\\n    if (\\n      liveStatus === \'connected\' &&\\n      wsRef.current &&\\n      wsRef.current.readyState === WebSocket.OPEN\\n    ) {\\n      wsRef.current.send(JSON.stringify({ type: \'text\', text: trimmed }));\\n      return;\\n    }\\n\\n    if (!isOnline) {\\n      setLiveError(\\n        \'AI command processing requires internet connectivity. Use the dedicated SOS or Threat Mode tabs offline.\'\\n      );\\n      return;\\n    }\\n\\n    setTextBusy(true);\\n    try {\\n      const res = await fetch(\'/api/assistant/command\', {\\n        method: \'POST\',\\n        headers: { \'Content-Type\': \'application/json\' },\\n        body: JSON.stringify({\\n          text: trimmed,\\n          userContext: {\\n            userName,\\n            primaryGuardianName,\\n            primaryGuardianPhone,\\n            threatActive,\\n            sosActive,\\n          },\\n        }),\\n      });\\n      const data = (await res.json()) as {\\n        reply?: string;\\n        toolCalls?: VoiceCommandAction[];\\n        error?: string;\\n      };\\n\\n      if (!res.ok) {\\n        throw new Error(data.error || \'AI command failed.\');\\n      }\\n\\n      if (Array.isArray(data.toolCalls) && data.toolCalls.length > 0) {\\n        for (const call of data.toolCalls) {\\n          const outcome = await executeCommandRef.current(call);\\n          appendEntry(\'action\', outcome.summary);\\n        }\\n      }\\n\\n      if (data.reply) {\\n        appendEntry(\'assistant\', data.reply);\\n      }\\n    } catch (err) {\\n      const msg =\\n        err instanceof Error\\n          ? err.message\\n          : \'Could not reach the AI command endpoint.\';\\n      setLiveError(msg);\\n    } finally {\\n      setTextBusy(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Live Voice Controller Hero Card */}\\n      <section className=\\\"bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 sm:p-8 shadow-sm\\\">\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-center\\\">\\n          <div className=\\\"lg:col-span-7 space-y-3\\\">\\n            <div className=\\\"flex flex-wrap items-center gap-2 text-xs font-semibold\\\">\\n              <span className=\\\"text-[#3E5632]\\\">\\n                OurSafe AI Voice Controller \302\267 Complete App Control\\n              </span>\\n              <span aria-hidden=\\\"true\\\" className=\\\"text-[#78886F]\\\">\\n                \302\267\\n              </span>\\n              <span\\n                className={\\n                  liveStatus === \'connected\'\\n                    ? \'text-emerald-700\'\\n                    : liveStatus === \'connecting\'\\n                      ? \'text-amber-700\'\\n                      : \'text-[#54634D]\'\\n                }\\n              >\\n                {liveStatus === \'connected\'\\n                  ? isSpeaking\\n                    ? \'Live Audio Active \302\267 Assistant Speaking\'\\n                    : \'Live Audio Active \302\267 Listening\'\\n                  : liveStatus === \'connecting\'\\n                    ? \'Connecting to Live Voice...\'\\n                    : \'Standby\'}\\n              </span>\\n            </div>\\n\\n            <h1 className=\\\"text-2xl sm:text-3xl font-semibold text-[#182215] tracking-tight\\\">\\n              Hands-Free Voice Control for Guardian &amp; Police Calls\\n            </h1>\\n            <p className=\\\"text-sm text-[#465340] leading-relaxed\\\">\\n              Speak naturally in real time to call both your guardian and police, open SOS, activate Threat Mode (with AI nearby police numbers), share live location, or trigger a Fake Call.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"lg:col-span-5 flex flex-col gap-3\\\">\\n            {liveStatus === \'connected\' || liveStatus === \'connecting\' ? (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={disconnectLiveVoice}\\n                className=\\\"w-full min-h-[54px] px-6 py-3 rounded-2xl bg-red-600 hover:bg-red-700 text-white text-sm font-bold flex items-center justify-center gap-2.5 transition-colors cursor-pointer\\\"\\n              >\\n                <MicOff className=\\\"w-5 h-5\\\" />\\n                <span>End Live Voice Session</span>\\n              </button>\\n            ) : (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={startLiveVoice}\\n                className=\\\"w-full min-h-[54px] px-6 py-3 rounded-2xl bg-[#2F4526] hover:bg-[#23351C] text-[#F6F9F2] text-sm font-bold flex items-center justify-center gap-2.5 shadow-sm transition-colors cursor-pointer\\\"\\n              >\\n                <Mic className=\\\"w-5 h-5\\\" />\\n                <span>Start Live Voice Conversation</span>\\n              </button>\\n            )}\\n\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\\\">\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onDualCallNow}\\n                className=\\\"min-h-[46px] px-4 py-2.5 rounded-2xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer whitespace-nowrap\\\"\\n              >\\n                <Phone className=\\\"w-4 h-4\\\" />\\n                <span>Call Guardian &amp; Police</span>\\n              </button>\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onManualSos}\\n                className=\\\"min-h-[46px] px-4 py-2.5 rounded-2xl bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 text-xs font-bold flex items-center justify-center gap-1.5 transition-colors cursor-pointer whitespace-nowrap\\\"\\n              >\\n                <ShieldAlert className=\\\"w-4 h-4\\\" />\\n                <span>Manual SOS</span>\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {!isOnline && (\\n          <div className=\\\"mt-5 rounded-2xl bg-amber-50 border border-amber-200 p-3.5 text-xs text-amber-900 flex items-center gap-2\\\">\\n            <WifiOff className=\\\"w-4 h-4 shrink-0 text-amber-700\\\" />\\n            <span>\\n              You are currently offline. Live AI Voice needs an active internet connection; use the SOS page for offline guardian numbers and direct dialers.\\n            </span>\\n          </div>\\n        )}\\n\\n        {liveError && (\\n          <div\\n            role=\\\"alert\\\"\\n            className=\\\"mt-5 rounded-2xl bg-red-50 border border-red-200 p-3.5 text-xs text-red-800 flex items-start gap-2\\\"\\n          >\\n            <AlertCircle className=\\\"w-4 h-4 text-red-600 shrink-0 mt-0.5\\\" />\\n            <span>{liveError}</span>\\n          </div>\\n        )}\\n      </section>\\n\\n      {/* Quick Executable Commands + Live Conversation Feed */}\\n      <section className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start\\\">\\n        <div className=\\\"lg:col-span-5 bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 space-y-4\\\">\\n          <div>\\n            <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n              Instant App Control Commands\\n            </p>\\n            <h2 className=\\\"mt-1 text-lg font-semibold text-[#182215]\\\">\\n              Say or Tap a Safety Command\\n            </h2>\\n            <p className=\\\"mt-1 text-xs text-[#54634D]\\\">\\n              Each command triggers the matching OurSafe safety workflow immediately via AI tool execution.\\n            </p>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-2.5\\\">\\n            {SAMPLE_VOICE_COMMANDS.map((cmd) => {\\n              const isUrgent =\\n                cmd.toLowerCase().includes(\'sos\') ||\\n                cmd.toLowerCase().includes(\'alert\') ||\\n                cmd.toLowerCase().includes(\'both guardian\');\\n              return (\\n                <button\\n                  key={cmd}\\n                  type=\\\"button\\\"\\n                  disabled={textBusy}\\n                  onClick={() => runTextCommand(cmd)}\\n                  className={`min-h-[44px] px-4 py-2.5 rounded-xl border text-left text-xs font-semibold flex items-center justify-between gap-2 transition-colors cursor-pointer disabled:opacity-60 ${\\n                    isUrgent\\n                      ? \'bg-red-50/70 hover:bg-red-100 border-red-200 text-red-800\'\\n                      : \'bg-[#F4F7EF] hover:bg-[#E7EFE0] border-[#CFD9C3] text-[#182215]\'\\n                  }`}\\n                >\\n                  <span>&ldquo;{cmd}&rdquo;</span>\\n                  {cmd.toLowerCase().includes(\'police\') &&\\n                  !cmd.toLowerCase().includes(\'both\') ? (\\n                    <MapPin className=\\\"w-3.5 h-3.5 shrink-0 text-[#2F4526]\\\" />\\n                  ) : cmd.toLowerCase().includes(\'guardian\') ||\\n                    cmd.toLowerCase().includes(\'call\') ? (\\n                    <Phone\\n                      className={`w-3.5 h-3.5 shrink-0 ${\\n                        isUrgent ? \'text-red-600\' : \'text-[#2F4526]\'\\n                      }`}\\n                    />\\n                  ) : cmd.toLowerCase().includes(\'location\') ? (\\n                    <Radio className=\\\"w-3.5 h-3.5 shrink-0 text-[#2F4526]\\\" />\\n                  ) : cmd.toLowerCase().includes(\'threat\') ? (\\n                    <AlertTriangle className=\\\"w-3.5 h-3.5 shrink-0 text-[#2F4526]\\\" />\\n                  ) : (\\n                    <ShieldAlert className=\\\"w-3.5 h-3.5 shrink-0 text-red-600\\\" />\\n                  )}\\n                </button>\\n              );\\n            })}\\n          </div>\\n        </div>\\n\\n        {/* Right: Live Transcript & Action Execution Log */}\\n        <div className=\\\"lg:col-span-7 bg-[#FCFDF9] rounded-3xl border border-[#B8C6A8] p-6 flex flex-col\\\">\\n          <div className=\\\"flex items-center justify-between gap-3 mb-4\\\">\\n            <div>\\n              <p className=\\\"text-xs font-semibold text-[#3E5632]\\\">\\n                Real-Time Transcript &amp; Controller Actions\\n              </p>\\n              <h2 className=\\\"mt-0.5 text-lg font-semibold text-[#182215]\\\">\\n                Voice Conversation Log\\n              </h2>\\n            </div>\\n            {liveStatus === \'connected\' && (\\n              <span className=\\\"text-xs font-semibold text-emerald-700 inline-flex items-center gap-1.5\\\">\\n                <Volume2 className=\\\"w-4 h-4\\\" />\\n                <span>24kHz Audio Output Ready</span>\\n              </span>\\n            )}\\n          </div>\\n\\n          <div className=\\\"rounded-2xl bg-[#F4F7EF] border border-[#CFD9C3] p-4 h-[350px] overflow-y-auto space-y-3\\\">\\n            {entries.map((item) => (\\n              <div\\n                key={item.id}\\n                className={`flex flex-col ${\\n                  item.role === \'user\'\\n                    ? \'items-end\'\\n                    : item.role === \'action\'\\n                      ? \'items-center\'\\n                      : \'items-start\'\\n                }`}\\n              >\\n                {item.role === \'action\' ? (\\n                  <div className=\\\"w-full rounded-xl bg-[#E7EFE0] border border-[#C3D0B4] px-3.5 py-2 text-xs font-semibold text-[#1E2E18] flex items-center gap-2\\\">\\n                    <CheckCircle2 className=\\\"w-4 h-4 text-[#2F4526] shrink-0\\\" />\\n                    <span>{item.text}</span>\\n                  </div>\\n                ) : (\\n                  <div\\n                    className={`max-w-[88%] rounded-2xl px-4 py-3 text-sm leading-relaxed ${\\n                      item.role === \'user\'\\n                        ? \'bg-[#2F4526] text-[#F6F9F2]\'\\n                        : \'bg-[#FCFDF9] border border-[#CFD9C3] text-[#182215]\'\\n                    }`}\\n                  >\\n                    {item.role === \'assistant\' && (\\n                      <div className=\\\"flex items-center gap-1.5 text-[11px] font-semibold text-[#3E5632] mb-1\\\">\\n                        <Bot className=\\\"w-3.5 h-3.5\\\" />\\n                        <span>OurSafe AI Controller</span>\\n                      </div>\\n                    )}\\n                    <p>{item.text}</p>\\n                  </div>\\n                )}\\n                <span className=\\\"mt-1 text-[11px] text-[#5C6B55] tabular-nums px-1\\\">\\n                  {formatTimeShort(item.timestamp)}\\n                </span>\\n              </div>\\n            ))}\\n            <div ref={listEndRef} />\\n          </div>\\n\\n          <form\\n            onSubmit={(e) => {\\n              e.preventDefault();\\n              runTextCommand(textInput);\\n            }}\\n            className=\\\"mt-4 flex items-center gap-2.5\\\"\\n          >\\n            <input\\n              type=\\\"text\\\"\\n              value={textInput}\\n              onChange={(e) => setTextInput(e.target.value)}\\n              disabled={textBusy}\\n              placeholder=\'Type a command (e.g. \\\"Call both guardian and police\\\")...\'\\n              aria-label=\\\"Send a voice or text app command\\\"\\n              className=\\\"flex-1 min-h-[46px] px-4 py-2.5 rounded-xl bg-[#F4F7EF] border border-[#C5D2B7] text-sm text-[#182215] placeholder:text-[#6B7A63] focus:bg-white focus:border-[#2F4526] focus:outline-none\\\"\\n            />\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={textBusy || !textInput.trim()}\\n              className=\\\"min-h-[46px] px-5 py-2.5 rounded-xl bg-[#2F4526] hover:bg-[#23351C] disabled:opacity-50 text-[#F6F9F2] text-sm font-semibold flex items-center gap-1.5 transition-colors whitespace-nowrap shrink-0 cursor-pointer\\\"\\n            >\\n              <span>{textBusy ? \'Running...\' : \'Send\'}</span>\\n              <Send className=\\\"w-4 h-4\\\" />\\n            </button>\\n          </form>\\n        </div>\\n      </section>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update AiVoiceAssistantPage with OurSafe branding, botanical sage styling, and Call Both Guardian & Police voice/button control\", \"Overwrite\":true, \"TargetFile\":\"/src/components/pages/AiVoiceAssistantPage.tsx\", \"toolAction\":\"Updating AiVoiceAssistantPage for dual calls and sage theme\", \"toolSummary\":\"Update AiVoiceAssistantPage\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 231
      nanos: 351692156
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "SqsCa6edPKOnmtkPxJf4kAw"
  }
