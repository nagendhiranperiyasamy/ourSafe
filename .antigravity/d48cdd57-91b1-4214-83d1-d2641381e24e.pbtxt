      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add VITE_GOOGLE_MAPS_API_KEY placeholder to .env.example\", \"EndLine\":10, \"Instruction\":\"Document VITE_GOOGLE_MAPS_API_KEY in .env.example without secrets\", \"ReplacementContent\":\"# APP_URL: The URL where this applet is hosted.\\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\\n# Used for self-referential links, OAuth callbacks, and API endpoints.\\nAPP_URL=\\\"MY_APP_URL\\\"\\n\\n# VITE_GOOGLE_MAPS_API_KEY: Scoped browser API key for Google Maps Platform (Maps JS & Routes API).\\n# Provisioned automatically in AI Studio or configured via Settings > Secrets.\\nVITE_GOOGLE_MAPS_API_KEY=\\\"\\\"\", \"StartLine\":6, \"TargetContent\":\"# APP_URL: The URL where this applet is hosted.\\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\\n# Used for self-referential links, OAuth callbacks, and API endpoints.\\nAPP_URL=\\\"MY_APP_URL\\\"\", \"TargetFile\":\"/.env.example\", \"toolAction\":\"Updating .env.example with Maps key variable\", \"toolSummary\":\"Update .env.example\"}"
