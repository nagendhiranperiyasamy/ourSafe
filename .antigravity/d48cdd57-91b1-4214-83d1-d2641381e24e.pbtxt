    end_line: 233
    content: "export type ActiveScreen = \'login\' | \'signup\' | \'home\';\n\nexport type AppPage =\n  | \'home\'\n  | \'sos\'\n  | \'threat\'\n  | \'travel\'\n  | \'assistant\'\n  | \'nearby\'\n  | \'history\';\n\nexport type ActiveModal =\n  | null\n  | \'contacts\'\n  | \'profile\'\n  | \'settings\'\n  | \'notifications\'\n  | \'fakecall\';\n\nexport interface SosContact {\n  id: string;\n  name: string;\n  phone: string;\n  relation: string;\n  isPrimary?: boolean;\n}\n\nexport interface SafetyPreferences {\n  travelCheckInReminders: boolean;\n  guardianUpdates: boolean;\n  soundAlarmEnabled: boolean;\n  locationOnlyDuringEmergency: boolean;\n  maskLockscreenPreviews: boolean;\n  shakeDetectionEnabled: boolean;\n  voiceActivationEnabled: boolean;\n  voiceKeyword: string;\n  quickDialGuardianOnVoiceSos: boolean;\n}\n\nexport interface UserProfile {\n  id: string;\n  fullName: string;\n  phone: string;\n  email: string;\n  age: number;\n  guardianName: string;\n  guardianPhone: string;\n  password: string;\n  photoDataUrl?: string;\n  createdAt: string;\n  sosContacts: SosContact[];\n  preferences: SafetyPreferences;\n}\n\nexport interface TravelSession {\n  active: boolean;\n  startLocation: string;\n  destination: string;\n  guardianId: string;\n  guardianName: string;\n  guardianPhone: string;\n  startedAt: string;\n  lastCheckInAt: string;\n}\n\nexport interface SafetyCheckInSession {\n  active: boolean;\n  label: string;\n  guardianId: string;\n  guardianName: string;\n  guardianPhone: string;\n  durationSeconds: number;\n  startedAt: string;\n  dueAt: string;\n  status: \'active\' | \'confirmed\' | \'missed\';\n}\n\nexport interface LiveLocationShareSession {\n  active: boolean;\n  startedAt: string;\n  durationMinutes: number;\n  sharedWithNames: string[];\n  lastLatitude: number | null;\n  lastLongitude: number | null;\n  lastUpdatedAt: string;\n}\n\nexport type AlertDeliveryStatus =\n  | \'standby\'\n  | \'initiated\'\n  | \'delivered_demo\'\n  | \'queued_offline\'\n  | \'failed\';\n\nexport interface SosAlertRecord {\n  id: string;\n  activatedAt: string;\n  triggerSource: string;\n  status: AlertDeliveryStatus;\n  latitude: number | null;\n  longitude: number | null;\n  recipients: Array<{\n    name: string;\n    phone: string;\n    status: \'initiated\' | \'delivered_demo\' | \'queued_offline\' | \'failed\';\n  }>;\n  note?: string;\n}\n\nexport interface ThreatSessionState {\n  active: boolean;\n  sessionId: string;\n  activatedAt: string;\n  lastHeartbeatAt: string;\n  lastLatitude: number | null;\n  lastLongitude: number | null;\n  batteryPercent: number | null;\n  isOnline: boolean;\n  recordingMode: \'none\' | \'audio\' | \'video\';\n  guardianNotificationStatus: AlertDeliveryStatus;\n  interruptedUnexpectedly?: boolean;\n}\n\nexport type EmergencyHistoryCategory =\n  | \'sos\'\n  | \'threat\'\n  | \'location\'\n  | \'recording\'\n  | \'connectivity\'\n  | \'guardian\'\n  | \'checkin\';\n\nexport interface EmergencyHistoryEntry {\n  id: string;\n  timestamp: string;\n  category: EmergencyHistoryCategory;\n  title: string;\n  detail: string;\n  statusLabel?: string;\n  locationCoords?: string;\n  recordingId?: string;\n  recordingKind?: \'audio\' | \'video\';\n}\n\nexport interface StoredRecordingMeta {\n  id: string;\n  userId: string;\n  kind: \'audio\' | \'video\';\n  mimeType: string;\n  createdAt: string;\n  durationSec: number;\n  sizeBytes: number;\n  sessionId?: string;\n  locationCoords?: string;\n  sharedWithGuardians?: boolean;\n}\n\nexport interface AppNotification {\n  id: string;\n  title: string;\n  detail: string;\n  timestamp: string;\n  category: \'travel\' | \'sos\' | \'account\' | \'safety\';\n  read: boolean;\n}\n\nexport interface UserReviewItem {\n  id: string;\n  author: string;\n  role: string;\n  rating: number;\n  comment: string;\n  createdAt: string;\n  isSample: boolean;\n}\n\nexport interface TeamInfoConfig {\n  founderName: string;\n  founderIntro: string;\n  teamMembers: string;\n  vision: string;\n  mission: string;\n}\n\nexport interface GeoLocationState {\n  status: \'idle\' | \'loading\' | \'granted\' | \'denied\' | \'unsupported\';\n  latitude: number | null;\n  longitude: number | null;\n  accuracy: number | null;\n  errorMessage?: string;\n  updatedAt?: string;\n}\n\nexport interface VoiceCommandAction {\n  id: string;\n  name: string;\n  args: Record<string, unknown>;\n}\n\nexport interface NearbyPoliceMapLink {\n  title: string;\n  uri: string;\n}\n\nexport interface NearbyPoliceStationEntry {\n  name: string;\n  phone?: string;\n  address?: string;\n  mapsUri?: string;\n}\n\nexport interface NearbyPoliceAiResult {\n  summaryText: string;\n  stations: NearbyPoliceStationEntry[];\n  mapLinks: NearbyPoliceMapLink[];\n  queriedAt: string;\n  locationLabel: string;\n}\n\nexport interface DualCallDispatchState {\n  active: boolean;\n  triggeredBy: string;\n  triggeredAt: string;\n  guardianName: string | null;\n  guardianPhone: string | null;\n  policeName: string;\n  policePhone: string;\n  nearestStationName?: string;\n  nearestStationPhone?: string;\n  guardianDialAttempted?: boolean;\n  policeDialAttempted?: boolean;\n}\n\n"
