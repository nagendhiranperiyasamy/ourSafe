        instruction: "import React from \'react\';\nimport { Phone, Shield } from \'lucide-react\';\nimport { GeoLocationState } from \'../../types/safety\';\nimport { NearbyLocationsSection } from \'../dashboard/NearbyLocationsSection\';\n\ninterface NearbyPageProps {\n  geoLocation: GeoLocationState;\n  initialCategory: \'police\' | \'restrooms\';\n  onRequestLocation: () => void;\n}\n\nexport const NearbyPage: React.FC<NearbyPageProps> = ({\n  geoLocation,\n  initialCategory,\n  onRequestLocation,\n}) => {\n  return (\n    <div className=\"space-y-6\">\n      <section className=\"bg-white rounded-3xl border border-violet-200/80 p-6 flex flex-wrap items-center justify-between gap-4\">\n        <div>\n          <p className=\"text-xs font-semibold text-violet-700\">\n            Nearby Safe Places \302\267 Verified Location Lookup\n          </p>\n          <h1 className=\"mt-1 text-2xl font-bold text-[#1A132B]\">\n            Police Stations &amp; Public Restrooms\n          </h1>\n          <p className=\"mt-1 text-xs text-[#574E6B] max-w-2xl\">\n            Center maps searches on your live device GPS without fabricated street addresses. For urgent police dispatch, dial directly below.\n          </p>\n        </div>\n\n        <div className=\"flex flex-wrap items-center gap-2.5\">\n          <a\n            href=\"tel:100\"\n            className=\"min-h-[42px] px-4 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white text-xs font-bold inline-flex items-center gap-1.5 whitespace-nowrap\"\n          >\n            <Phone className=\"w-3.5 h-3.5\" />\n            <span>Call Police (100)</span>\n          </a>\n          <a\n            href=\"tel:112\"\n            className=\"min-h-[42px] px-4 py-2 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-xs font-semibold inline-flex items-center gap-1.5 whitespace-nowrap\"\n          >\n            <Shield className=\"w-3.5 h-3.5 text-violet-700\" />\n            <span>Emergency (112)</span>\n          </a>\n        </div>\n      </section>\n\n      <NearbyLocationsSection\n        geoLocation={geoLocation}\n        onRequestLocation={onRequestLocation}\n        initialCategory={initialCategory}\n      />\n    </div>\n  );\n};\n"
