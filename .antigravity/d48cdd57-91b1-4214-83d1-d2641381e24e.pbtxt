      thinking_signature: "\022\251\031\n\246\031\001i\024}\023qV\224\262\374\'W\347w\'\243C\362\342\247\204\277\037\313\340j4\322c\352VQ\bJ\3308z\313H\017\a\336+\375\033\261\211\277\371\3504!\325\262mJu/V,tX\211\334\372lv\"\247\201\235 \314i\r\034\'N\302s\256R\322[\324\254ySj`\215\332[\364=\020x\332JS\227G*86\224WKG\345vYcL\365D\n,\3543\025v\n\244\t\v\370\335\025\341 \225\363\3657\305\237\252\221l\255(\370A6\334\251\323\203\3058\301\300\032\353\233\277\255\351\331\r\363\362\3716\210\001\237\247 [\211\a\256(\261\370\003\025\373c\345\353\310\316-\345\nz\330\030\231g3*\031\tr\234\260\032 \255\206\267\233_\'\347\016\377S!\373F\274\321\251&IR\000|L\200\240\017 \221\327>\230/`\251\243\203T\216\350\244?\037\320\026\fS\245,\004G\252\245h\300\235.\256\341#\350\267\026\307*/\275\023&\216\234/\022\257\231\245\2562\213\373xu\a\034b\344w\321\v\'\303|,\207B\334\366\214L\035&\370\302s\344\2238\227\274\367;\2126\232\314\241\003\307\352\336m\001;\202\324\347bf\300\244\207\t\261\021\342\214[B\220\244\026;\a\335\353\251&\360\206#\361\206\361k\312\b\272\017\334\225\022\204\364\210\1775\366V\230\355OZ\356\236\275\310S\204b\302\016mF\207\003H/F&\213\211\242w\355\244^\026&\255l$\365;N9\006\027d\267\361\330\306d\3237h\371\266@V\016\032\330^h\274\3177\271\2453fg/\260\254V.x\262D\320\f\335s\222\354\bz\020C\373\354\a5\250B\026\270mFni\022\264\021\341\311\247\217\245\302\320\025\256\253\202\337\304\351Z\252\376w\200Tl\323\213\317\275-r\231\367\037)\227V\315\336\261\367\033r\320\321\375,p\230E\202z:Z>\250\306\356\213\312?\351\322\356\b\301\343\247\024\305G\312\002\r\303\266\362\234P\vG\244#Y~\b\a#5\002(\344\250\322:\231\327\375e\b\025x\003t\262@\311\016dSE\312\213v\222\210G\246\316\251\203\317\205\322\257\n\274\221\020\"\375F(s\367GR\374\336\364\207\240\247\353\355\220K0\352\201]\376\316p\216b\205\357\006R\225\352\345\210\302\212\002\323\342$vt\214A\276\n4\376\2430\b%\vq\023\361Eu\261\352N\225o\032\255\313J\363Z\032pB\002\222\346`2+N\233a\303y\325\0353\230\362\277\231\032\023\3350^B\254-(\253\244l\026\203\336\335\336Ae\021\023\207\206\205\321\223\257\347\251D\327\222\372\372o\200z\310yY\353+\212\357\277\031<R\217\000\245\302\262\217\035\325}r\301\263i\005\371\265\253\362\235\022\023\242\005\345\340\353\027\023\255\352\252\350\220\356\235Q\037uj\244-dE\f\t\3141\245\367k@=,\207\344y\347\311\352\327k\237\357_\321\305\352\320\231\346\321\371\235\361\250\211u\374/\004\272\341\213j\306\26332\265>\312J\340\242\t5\375h\t,TA2B\205gM\3424\223\2310\266\207+\236\317\343\b\241\250\235\201%(6\316\033\037\217\210\346DS\311\233\220Q\301\b\234\00534\3418\367\026\262%l\244z\252\365G\316!\246[Dl\273=\363u&\335\360]\216\306\347\370\vSD\230u\036\'\344\342\215\350\217\335\210G\3736\256\200n\316m\2338\362)j\031\266\322\205\334\221\372,\350\260\252U\r4k\027\201\023\031\003\270\346\247\214w*\227In\001\316\312 \032}D\017\vi\214\377\366\341\004\001\316\226\233\327g\330\372 x\240n\2250\331^\240PV\3638\n\357\t0U`B\247\t\f\000\213^$\274\322t\257\357QD>Ou\220m$\354\306:\221\240]\376\005.\322\017F\031\326\t\020v\211\177?\217M\331\2216\210\031\322gpu\2476\217\207wv\365\331\216\235\314\320IXz\344}\005\035F\336F\317\261jq\375\001\235\026\222\'\203\376\204\277\251\374|\321U\301@my\325|\022\373E\2663=\322\353\223\375\266\277\216\023\325Xr\204\212z\3632\242\026\005o\274S(|]\373\354\001\315\355\222w\002\221Au\341 \231\177\213W)g\221\343FY\274w\353?\027;v\341l<\303u\213k)\177\037\322\027k\244\322\214\037\005n\fH\230\202\335\252\306\212\357\375\263Tv>$\340_\036\'#\017t\3664\214\353\351\"`7\332\n\022\250\305Y}=b\351j\216\307+\213\267$@H\247~\356\370\261\027d\b\234\343\356\366w`%\2705\321\332p\370\323\343\276c\023\002\031LN\327{\337\036)\001Y\f\002\036S\325\260+\276\333\b\245-Y\375\355\334\f\037\353V\317\273)\362\230\244z\310\306:<\372#5is#\037\335\337\351:Qo\3314pbX\333\343\355\335-U\233\236\353\037R\026\b\'\205\n\362Z\225\031$:\242#\240i)\275)\200_\342\322U &\243\260\215\372\t\234`x\235MJj^\235\241c\275\277TQt\232\005\327\203\337\246\342\n\276\204\025\n\f\033P\3051d\355j\345O&\214T0\202\022\371