    command_line: "sleep 2 && curl -sS http://localhost:3000/@vite/client | grep -E \"const (hmrPort|socketHost|wsToken) =\" && node -e \'\nconst http = require(\"http\");\nhttp.get(\"http://localhost:3000/@vite/client\", (res) => {\n  let body = \"\";\n  res.on(\"data\", c => body += c);\n  res.on(\"end\", async () => {\n    const m = /const wsToken = \"([^\"]+)\"/.exec(body);\n    const token = m ? m[1] : \"\";\n    const { WebSocket } = await import(\"ws\");\n    const testWs = (url, proto, label) => new Promise((resolve) => {\n      const ws = proto ? new WebSocket(url, proto) : new WebSocket(url);\n      const t = setTimeout(() => { console.log(label, \"TIMEOUT\"); ws.terminate(); resolve(); }, 3000);\n      ws.on(\"open\", () => { console.log(label, \"OPENED OK\"); clearTimeout(t); ws.close(); resolve(); });\n      ws.on(\"error\", (e) => { console.log(label, \"ERROR:\", e.message); clearTimeout(t); resolve(); });\n    });\n    await testWs(`ws://localhost:3000/?token=${token}`, \"vite-hmr\", \"VITE_WS\");\n    await testWs(\"ws://localhost:3000/api/live-voice\", undefined, \"LIVE_VOICE_WS\");\n  });\n});\n\'"
