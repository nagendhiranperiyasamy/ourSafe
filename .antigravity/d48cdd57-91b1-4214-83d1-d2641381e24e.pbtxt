      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Upgrade existing cached user profiles smoothly so all 3 quick SOS triggers default to enabled on first load after this update\", \"EndLine\":131, \"Instruction\":\"Update hydrateUser in storage.ts so profiles without screenTapSosEnabled get all 3 new quick triggers enabled by default\", \"ReplacementContent\":\"function hydrateUser(u: UserProfile): UserProfile {\\n  const existingPrefs = (u.preferences ?? {}) as Partial<SafetyPreferences>;\\n  const isLegacyPrefs = typeof existingPrefs.screenTapSosEnabled !== \'boolean\';\\n  return {\\n    ...u,\\n    preferences: {\\n      ...DEFAULT_PREFERENCES,\\n      ...existingPrefs,\\n      ...(isLegacyPrefs\\n        ? {\\n            shakeDetectionEnabled: true,\\n            voiceActivationEnabled: true,\\n            voiceKeyword:\\n              existingPrefs.voiceKeyword && existingPrefs.voiceKeyword !== \'Help me now\'\\n                ? existingPrefs.voiceKeyword\\n                : DEFAULT_PREFERENCES.voiceKeyword,\\n            screenTapSosEnabled: true,\\n            screenTapCount: 3,\\n            autoDialOnTrigger: true,\\n            quickTriggerCountdownSec: 3,\\n            quickDialGuardianOnVoiceSos: true,\\n          }\\n        : {}),\\n    },\\n    sosContacts: Array.isArray(u.sosContacts) ? u.sosContacts : [],\\n  };\\n}\", \"StartLine\":118, \"TargetContent\":\"function hydrateUser(u: UserProfile): UserProfile {\\n  return {\\n    ...u,\\n    preferences: {\\n      ...DEFAULT_PREFERENCES,\\n      ...(u.preferences ?? {}),\\n    },\\n    sosContacts: Array.isArray(u.sosContacts) ? u.sosContacts : [],\\n  };\\n}\", \"TargetFile\":\"/src/utils/storage.ts\", \"toolAction\":\"Migrating saved user preferences for quick triggers\", \"toolSummary\":\"Update hydrateUser in storage.ts\"}"
