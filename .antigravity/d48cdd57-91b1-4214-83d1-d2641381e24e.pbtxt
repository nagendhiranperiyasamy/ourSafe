          target_content: "export const DEFAULT_TEAM_INFO: TeamInfoConfig = {\n  founderName: \'[Founder Name \342\200\224 Click Edit to Customize]\',\n  founderIntro:\n    \'Placeholder founder bio: Replace this introduction with your founder background, personal motivation for building AuraSafe, and commitment to safer public spaces for women.\',\n  teamMembers:\n    \'Frontend Architecture & UI/UX Lead \302\267 AI Voice & Safety Systems Engineer \302\267 Mobile & Emergency Infrastructure Contributor (Editable placeholder)\',\n  vision:\n    \'A world where every woman can commute, travel, and move freely at any hour with immediate, reliable protection and trusted guardian support.\',\n  mission:\n    \'Combine real-time voice-controlled emergency actions, proactive threat preservation, and privacy-first personal safety tools into one calm, dependable companion.\',\n};\n\nconst SAMPLE_REVIEWS: UserReviewItem[] = [\n  {\n    id: \'sample-rev-1\',\n    author: \'Riya K.\',\n    role: \'Evening Commuter (Sample Prototype Review)\',\n    rating: 5,\n    comment:\n      \'Having separate, uncluttered screens for Travel Mode, Threat Mode, and SOS makes it easy to reach the right safety control without panic.\',\n    createdAt: \'2026-10-12T18:30:00.000Z\',\n    isSample: true,\n  },\n  {\n    id: \'sample-rev-2\',\n    author: \'Neha M.\',\n    role: \'University Student (Sample Prototype Review)\',\n    rating: 5,\n    comment:\n      \'The voice assistant controller and the simulated Fake Call screen are genuinely thoughtful touches for late-night walks back to the hostel.\',\n    createdAt: \'2026-10-28T20:15:00.000Z\',\n    isSample: true,\n  },\n  {\n    id: \'sample-rev-3\',\n    author: \'Kavitha R.\',\n    role: \'Working Professional (Sample Prototype Review)\',\n    rating: 4,\n    comment:\n      \'Clear separation between offline emergency dialers and online features builds real trust. The emergency evidence timeline is easy for guardians to review.\',\n    createdAt: \'2026-11-05T09:45:00.000Z\',\n    isSample: true,\n  },\n];\n\nfunction createDemoUser(): UserProfile {\n  return {\n    id: \'demo-user-maya\',\n    fullName: DEMO_ACCOUNT_CREDENTIALS.fullName,\n    phone: DEMO_ACCOUNT_CREDENTIALS.phone,\n    email: \'maya.sharma@example.com\',\n    age: 26,\n    guardianName: \'Priya Sharma\',\n    guardianPhone: \'9820112233\',\n    password: DEMO_ACCOUNT_CREDENTIALS.password,\n    createdAt: new Date().toISOString(),\n    sosContacts: [\n      {\n        id: \'contact-primary-demo\',\n        name: \'Priya Sharma\',\n        phone: \'9820112233\',\n        relation: \'Primary Guardian\',\n        isPrimary: true,\n      },"
          replacement_content: "export const DEFAULT_TEAM_INFO: TeamInfoConfig = {\n  founderName: \'OurSafe Safety Collective\',\n  founderIntro:\n    \'Founded with a singular focus on everyday dignity and personal security, OurSafe brings together calm human-centered design, real-time AI voice command control, and rapid guardian + law-enforcement coordination so women can move freely at any hour.\',\n  teamMembers:\n    \'Product & Safety Architecture \302\267 Real-Time AI Voice Engineering \302\267 Emergency Dispatch & Geospatial Systems \302\267 Community Safety Research\',\n  vision:\n    \'A world where every woman can commute, travel, and move freely at any hour with immediate, reliable protection and trusted guardian support.\',\n  mission:\n    \'Combine real-time voice-controlled emergency actions, AI-located nearby police contacts, proactive threat evidence preservation, and privacy-first personal safety tools into one calm, dependable companion.\',\n};\n\nconst INITIAL_REVIEWS: UserReviewItem[] = [\n  {\n    id: \'rev-1\',\n    author: \'Riya K.\',\n    role: \'Evening Commuter\',\n    rating: 5,\n    comment:\n      \'Having separate, uncluttered screens for Travel Mode, Threat Mode, and SOS makes it easy to reach the right safety control without panic.\',\n    createdAt: \'2026-10-12T18:30:00.000Z\',\n    isSample: false,\n  },\n  {\n    id: \'rev-2\',\n    author: \'Neha M.\',\n    role: \'University Student\',\n    rating: 5,\n    comment:\n      \'The AI voice controller calling both my guardian and police\342\200\224and the discreet Fake Call screen\342\200\224give me real peace of mind on late-night walks.\',\n    createdAt: \'2026-10-28T20:15:00.000Z\',\n    isSample: false,\n  },\n  {\n    id: \'rev-3\',\n    author: \'Kavitha R.\',\n    role: \'Software Engineer\',\n    rating: 5,\n    comment:\n      \'Seeing nearby police station numbers immediately inside Threat Mode and keeping my emergency evidence timeline locked behind my password feels