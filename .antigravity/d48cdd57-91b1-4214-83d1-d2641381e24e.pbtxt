      thinking_signature: "\022\200\026\n\375\025\001i\024}\023Y\245\351\270\343\255\3758\252,\264\340\241\207l\334\3205\356\247\3323m\271\tM\t\203\t6\304\301I\272\252\v\333\312\375\344\206\367\031\262*9\351\333\v&\025-{\255\313\034\273l\316\237\243\341\017\247\351\033\002\020\t\241rCR\235\204\371x\204\223\273\277\312x\336\306,3(\v\260w\317\326&\241\33114\257\204\234\"\211rY:+\251\025O\'3q\360H\026\261v\nhv\003R\303\317\352tu\352c}\376]\212\260\347U\205\\=r\333z-\v1\273\027\367\227\0366T\375\255b\006K+\302\035\\\034Z\000\030\362\030Y\030\250Ss\261\003u%5\263\262\323\3171\277op\376&95Y\336mA\324\026;\311\202$\265\203\346\260\315\314\322NsHZ6\214\203h\342\211\347O\272\321\200\237\276Y\302I\342\3254k\"hh\020\037\365t(\3406\376:}\313\316/z)\330\301\'\314aw\221\0173G,\034t\245-\230\202f9\244E\024iw\313\027\303R{\230C\241%\037\266\2005S\317}\375/.\r\000\3673pA\030\351\221je\330\337\277\217D\2263;\252\362\256\273\335\241;\3269>{\336S\006\331\365\205\213Y,mb\255u\025c@\253C\004\254x\"Q\360\233Qo\360\245\261\017\212Al\032\352e|\305*\214\341\246\224\210\312\204\000\037 \003\203\025\t\242\357\000;\277\276\034&\334-\216_\224F7\222E\204^\324\267\016\375\r\260\353\340z\263\273\025v\372\006\002\260\314_Ll\341F\257,\261\tz\262\212\245\027z9\276\204\f\357d\274\206\216\034\263\033s?\022\016\035\366\036\246\201\227Z9\237\\\3430\326S4Z&\005\021\032\313\301D\240\273y\235\307\210\316i^\360%+^t\267\362\334\224k\021\301\210\216v\207\360\333\207?I\246\351\004\241\f\204\026\224\222\356J\205\275Hsy\2001\246\'zu`2X#\345\211Voc\271\025y\275iQJ\334\204\305\351\256G\350\325\205\003\360\235Y\312~\206\326_K\320\205\334\031\271<*;\3514\245\303\323\256\323S{\2217\2554\300\236\207\302\344\223}\232\223\215\017\301HE\372\210\005\2702V\0014\n\203\263(\216\224\311\372\325\226R\204Ph\373T\273\232\341\323gp\266\r\270\315\251\335\177\020\251\250\200\363u\315\213\314_;\3240I(\000S\a\231\330\233\216<\030Ac\330\227!a\026\034@\006b4\3169G\307r\022=\355\264\313q\212\370\275\371\037\224\342\271#!\004p\310B\373\257