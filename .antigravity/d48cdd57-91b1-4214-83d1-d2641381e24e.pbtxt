  view_file {
    absolute_path_uri: "file:///src/components/dashboard/TravelModePanel.tsx"
    end_line: 375
    content: "import React, { useEffect, useState } from \'react\';\nimport {\n  CheckCircle2,\n  Clock,\n  Compass,\n  LocateFixed,\n  MapPin,\n  Navigation,\n  Phone,\n  ShieldCheck,\n  UserCheck,\n} from \'lucide-react\';\nimport {\n  GeoLocationState,\n  SosContact,\n  TravelSession,\n} from \'../../types/safety\';\nimport { formatPhoneForTel, formatTimeShort } from \'../../utils/storage\';\n\ninterface TravelModePanelProps {\n  contacts: SosContact[];\n  travelSession: TravelSession | null;\n  geoLocation: GeoLocationState;\n  onRequestLocation: () => void;\n  onStartTravel: (session: TravelSession) => void;\n  onCheckInTravel: () => void;\n  onEndTravel: () => void;\n  onManageContacts: () => void;\n}\n\nexport const TravelModePanel: React.FC<TravelModePanelProps> = ({\n  contacts,\n  travelSession,\n  geoLocation,\n  onRequestLocation,\n  onStartTravel,\n  onCheckInTravel,\n  onEndTravel,\n  onManageContacts,\n}) => {\n  const [startLocation, setStartLocation] = useState(\'\');\n  const [destination, setDestination] = useState(\'\');\n  const [selectedGuardianId, setSelectedGuardianId] = useState(\n    contacts[0]?.id ?? \'\'\n  );\n  const [formError, setFormError] = useState(\'\');\n  const [elapsedText, setElapsedText] = useState(\'00:00\');\n  const [arrivalNotice, setArrivalNotice] = useState(\'\');\n\n  useEffect(() => {\n    if (\n      contacts.length > 0 &&\n      !contacts.some((c) => c.id === selectedGuardianId)\n    ) {\n      setSelectedGuardianId(contacts[0].id);\n    }\n  }, [contacts, selectedGuardianId]);\n\n  useEffect(() => {\n    if (!travelSession?.active) {\n      setElapsedText(\'00:00\');\n      return;\n    }\n\n    const updateElapsed = () => {\n      const diffMs = Math.max(\n        0,\n        Date.now() - new Date(travelSession.startedAt).getTime()\n      );\n      const totalSeconds = Math.floor(diffMs / 1000);\n      const hrs = Math.floor(totalSeconds / 3600);\n      const mins = Math.floor((totalSeconds % 3600) / 60);\n      const secs = totalSeconds % 60;\n      if (hrs > 0) {\n        setElapsedText(\n          `${String(hrs).padStart(2, \'0\')}:${String(mins).padStart(\n            2,\n            \'0\'\n          )}:${String(secs).padStart(2, \'0\')}`\n        );\n      } else {\n        setElapsedText(\n          `${String(mins).padStart(2, \'0\')}:${String(secs).padStart(2, \'0\')}`\n        );\n      }\n    };\n\n    updateElapsed();\n    const timer = window.setInterval(updateElapsed, 1000);\n    return () => window.clearInterval(timer);\n  }, [travelSession]);\n\n  const handleUseCurrentGps = () => {\n    onRequestLocation();\n    if (geoLocation.status === \'granted\' && geoLocation.latitude !== null && geoLocation.longitude !== null) {\n      setStartLocation(\n        `GPS ${geoLocation.latitude.toFixed(5)}, ${geoLocation.longitude.toFixed(5)}`\n      );\n    }\n  };\n\n  useEffect(() => {\n    if (\n      geoLocation.status === \'granted\' &&\n      geoLocation.latitude !== null &&\n      geoLocation.longitude !== null &&\n      !startLocation\n    ) {\n      setStartLocation(\n        `GPS ${geoLocation.latitude.toFixed(5)}, ${geoLocation.longitude.toFixed(5)}`\n      );\n    }\n  }, [geoLocation.status, geoLocation.latitude, geoLocation.longitude, startLocation]);\n\n  const handleStartSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setFormError(\'\');\n    setArrivalNotice(\'\');\n\n    if (!startLocation.trim()) {\n      setFormError(\'Enter your starting location or use your current GPS coordinates.\');\n      return;\n    }\n    if (!destination.trim()) {\n      setFormError(\'Enter your destination before starting Travel Mode.\');\n      return;\n    }\n\n    const guardian = contacts.find((c) => c.id === selectedGuardianId) ?? contacts[0];\n    if (!guardian) {\n      setFormError(\'Add at least one emergency guardian contact first.\');\n      return;\n    }\n\n    const now = new Date().toISOString();\n    onStartTravel({\n      active: true,\n      startLocation: startLocation.trim(),\n      destination: destination.trim(),\n      guardianId: guardian.id,\n      guardianName: guardian.name,\n      guardianPhone: guardian.phone,\n      startedAt: now,\n      lastCheckInAt: now,\n    });\n  };\n\n  const handleSafeEnd = () => {\n    const dest = travelSession?.destination ?? \'destination\';\n    onEndTravel();\n    setArrivalNotice(`Travel Mode ended safely. Journey to ${dest} closed.`);\n    setDestination(\'\');\n  };\n\n  return (\n    <section className=\"bg-white rounded-3xl border border-violet-200/80 p-5 sm:p-6 shadow-sm shadow-violet-950/[0.02]\">\n      <div className=\"flex flex-wrap items-start justify-between gap-3 mb-5\">\n        <div>\n          <div className=\"flex items-center gap-2 text-xs text-[#6B6182]\">\n            <span className=\"font-semibold text-violet-700\">Travel Mode</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span\n              className={\n                travelSession?.active\n                  ? \'font-semibold text-emerald-700\'\n                  : \'text-[#6B6182]\'\n              }\n            >\n              {travelSession?.active ? \'Journey Active\' : \'Standby\'}\n            </span>\n          </div>\n          <h3 className=\"mt-1 text-lg sm:text-xl font-bold text-[#1A132B]\">\n            {travelSession?.active\n              ? \'Active Journey Sharing\'\n              : \'Share your journey with a guardian\'}\n          </h3>\n        </div>\n\n        <button\n          type=\"button\"\n          onClick={onManageContacts}\n          className=\"min-h-[40px] px-3 py-1.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-800 text-xs font-semibold transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n        >\n          Manage Contacts\n        </button>\n      </div>\n\n      {arrivalNotice && !travelSession?.active && (\n        <div className=\"mb-4 rounded-2xl bg-emerald-50 border border-emerald-200 px-4 py-3 text-xs font-medium text-emerald-800 flex items-center gap-2\">\n          <CheckCircle2 className=\"w-4 h-4 text-emerald-600 shrink-0\" />\n          <span>{arrivalNotice}</span>\n        </div>\n      )}\n\n      {travelSession?.active ? (\n        <div className=\"space-y-4\">\n          <div className=\"rounded-2xl bg-[#F4F0FF] border border-violet-200/80 p-4 space-y-3\">\n            <div className=\"flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-violet-200/70\">\n              <div className=\"flex items-center gap-2 text-sm font-semibold text-[#1A132B]\">\n                <Compass className=\"w-4 h-4 text-violet-700 shrink-0\" />\n                <span>Tracking Active (Local Prototype)</span>\n              </div>\n              <div className=\"flex items-center gap-1.5 text-sm font-mono font-bold text-violet-800 tabular-nums\">\n                <Clock className=\"w-4 h-4\" />\n                <span>{elapsedText}</span>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm\">\n              <div>\n                <p className=\"text-xs text-[#6B6182]\">Starting Location</p>\n                <p className=\"font-semibold text-[#1A132B] mt-0.5 break-words\">\n                  {travelSession.startLocation}\n                </p>\n              </div>\n              <div>\n                <p className=\"text-xs text-[#6B6182]\">Destination</p>\n                <p className=\"font-semibold text-[#1A132B] mt-0.5 break-words\">\n                  {travelSession.destination}\n                </p>\n              </div>\n            </div>\n\n            <div className=\"pt-3 border-t border-violet-200/70 flex flex-wrap items-center justify-between gap-3 text-xs text-[#4A4063]\">\n              <div className=\"flex items-center gap-2\">\n                <UserCheck className=\"w-4 h-4 text-violet-700 shrink-0\" />\n                <span>\n                  Assigned Guardian:{\' \'}\n                  <strong className=\"text-[#1A132B]\">\n                    {travelSession.guardianName}\n                  </strong>{\' \'}\n                  <span className=\"font-mono tabular-nums\">\n                    ({travelSession.guardianPhone})\n                  </span>\n                </span>\n              </div>\n              <span className=\"tabular-nums text-[#6B6182]\">\n                Last check-in: {formatTimeShort(travelSession.lastCheckInAt)}\n              </span>\n            </div>\n          </div>\n\n          <p className=\"text-xs text-[#6B6182]\">\n            Frontend prototype note: Real-time live GPS link sharing over SMS/WhatsApp requires backend integration. Use the call button below to reach your guardian directly.\n          </p>\n\n          <div className=\"flex flex-wrap items-center gap-3\">\n            <button\n              type=\"button\"\n              onClick={onCheckInTravel}\n              className=\"flex-1 min-w-[140px] min-h-[46px] px-4 py-2.5 rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-900 text-sm font-semibold flex items-center justify-center gap-2 transition-colors whitespace-nowrap cursor-pointer\"\n            >\n              <ShieldCheck className=\"w-4 h-4 text-violet-700\" />\n              <span>Log Safe Check-in</span>\n            </button>\n\n            <a\n              href={`tel:${formatPhoneForTel(travelSession.guardianPhone)}`}\n              className=\"min-h-[46px] px-4 py-2.5 rounded-xl bg-white hover:bg-[#FAF8FF] border border-violet-200 text-[#1A132B] text-sm font-semibold flex items-center justify-center gap-2 transition-colors whitespace-nowrap\"\n            >\n              <Phone className=\"w-4 h-4 text-violet-700\" />\n              <span>Call Guardian</span>\n            </a>\n\n            <button\n              type=\"button\"\n              onClick={handleSafeEnd}\n              className=\"flex-1 min-w-[140px] min-h-[46px] px-4 py-2.5 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold flex items-center justify-center gap-2 transition-colors whitespace-nowrap cursor-pointer\"\n            >\n              <span>End Travel</span>\n            </button>\n          </div>\n        </div>\n      ) : (\n        <form onSubmit={handleStartSubmit} className=\"space-y-4\">\n          {formError && (\n            <p className=\"rounded-xl bg-red-50 border border-red-200 px-3.5 py-2.5 text-xs font-medium text-red-700\">\n              {formError}\n            </p>\n          )}\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3.5\">\n            <div>\n              <label\n                htmlFor=\"travel-start\"\n                className=\"block text-xs font-semibold text-[#1A132B] mb-1.5\"\n              >\n                Starting Location\n              </label>\n              <div className=\"relative flex gap-2\">\n                <div className=\"relative flex-1\">\n                  <MapPin className=\"w-4 h-4 text-[#73698A] absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n                  <input\n                    id=\"travel-start\"\n                    type=\"text\"\n                    value={startLocation}\n                    onChange={(e) => setStartLocation(e.target.value)}\n                    placeholder=\"Current street or landmark\"\n                    className=\"w-full min-h-[44px] pl-9 pr-3 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm text-[#1A132B] placeholder:text-[#8E84A6] focus:bg-white focus:border-violet-600 focus:outline-none\"\n                  />\n                </div>\n                <button\n                  type=\"button\"\n                  onClick={handleUseCurrentGps}\n                  title=\"Fill using browser GPS location\"\n                  aria-label=\"Fill starting location using GPS\"\n                  className=\"min-w-[44px] min-h-[44px] rounded-xl bg-[#F4F0FF] hover:bg-violet-100 text-violet-700 flex items-center justify-center shrink-0 transition-colors cursor-pointer\"\n                >\n                  <LocateFixed className=\"w-4 h-4\" />\n                </button>\n              </div>\n            </div>\n\n            <div>\n              <label\n                htmlFor=\"travel-destination\"\n                className=\"block text-xs font-semibold text-[#1A132B] mb-1.5\"\n              >\n                Destination\n              </label>\n              <div className=\"relative\">\n                <Navigation className=\"w-4 h-4 text-[#73698A] absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none\" />\n                <input\n                  id=\"travel-destination\"\n                  type=\"text\"\n                  value={destination}\n                  onChange={(e) => setDestination(e.target.value)}\n                  placeholder=\"Where are you heading?\"\n                  className=\"w-full min-h-[44px] pl-9 pr-3 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm text-[#1A132B] placeholder:text-[#8E84A6] focus:bg-white focus:border-violet-600 focus:outline-none\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-12 gap-3.5 items-end\">\n            <div className=\"sm:col-span-7\">\n              <label\n                htmlFor=\"travel-guardian\"\n                className=\"block text-xs font-semibold text-[#1A132B] mb-1.5\"\n              >\n                Guardian Contact to Notify\n              </label>\n              <select\n                id=\"travel-guardian\"\n                value={selectedGuardianId}\n                onChange={(e) => setSelectedGuardianId(e.target.value)}\n                className=\"w-full min-h-[44px] px-3.5 py-2 rounded-xl bg-[#FAF8FF] border border-violet-200 text-sm text-[#1A132B] focus:bg-white focus:border-violet-600 focus:outline-none\"\n              >\n                {contacts.length === 0 ? (\n                  <option value=\"\">No emergency contacts added</option>\n                ) : (\n                  contacts.map((contact) => (\n                    <option key={contact.id} value={contact.id}>\n                      {contact.name} ({contact.phone})\n                    </option>\n                  ))\n                )}\n              </select>\n            </div>\n\n            <div className=\"sm:col-span-5\">\n              <button\n                type=\"submit\"\n                className=\"w-full min-h-[44px] px-5 py-2.5 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-sm font-semibold flex items-center justify-center gap-2 transition-colors whitespace-nowrap cursor-pointer\"\n              >\n                <Compass className=\"w-4 h-4\" />\n                <span>Start Travel</span>\n              </button>\n            </div>\n          </div>\n        </form>\n      )}\n    </section>\n  );\n};\n"
    num_lines: 376
    num_bytes: 14355
    line_range_bytes: 14355
  }
}
