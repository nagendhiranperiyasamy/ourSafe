      thinking_signature: "\022\342\b\n\337\b\001i\024}\023~k\246C\3602\343\n\360A\274\200%Y\213&\247\316\\\240eBH%\303\214\316\'\322\020\247\032s\301\357\353\327yN\212\032\005\037\206\267\016\266\271\355)5\303\201\350C=\373\371\326\362\227w\340+\316`\360K\n\201\331\345cN\306\341\276\344\271\217h)\325\330\235\236+/1\377\333\203\230\263lo\223\3520\215%\320\314\260\025\243kc\202\327V\200\263\334\372\025\311\334x\247\023\311{5\204\037\243\330\020.9\321\264\363\353\237\205\262\\\260\204g[\300{\003\252\327\347\336\f$7\370\200j\355\336\367L\207(e\222\303_+\211\244\357\376\254\a\237\351\227\256\200\324}\261\350\257r`\315\271\340h\r\252\177X\214-\316\v\372\346o\026\023\263=w\364\252\337\3568\230\021\273N\353\270L>\224\322(\226\350\035+\223XR\305\237\326\366\257\230\377\265\343\n\350\023\361K7\'\353o\366\274\b\302J\202\211\224\206\032\264\033\332\213i\373\017\370N d\r\005\212-c>#\2778\221\b\342\205\002\272b\230+\375\rr \272F\f\017\367)\002\250\255\322\223\272&]\356\031\373X\262\272E\221\005\300\030\332\365\3007\b\321\333C\303o\213\026\002\024\306n\262u\221\271^\247}\220=g3He)\f\273\221\333nf\245\260!\244\360\330C\327\360D\333L3UF\317g\230\v\324\035\224\371\311\357\277\002!%-+\353KOr\035\214\362\254Y\366Z\3270b\205\t\260\240\347\217\315td\034\221\\Wz\362\025CW9\032\344\257r\337@\273\261\222\321\240=\n\335\221+\216\243\362\227\372\376\234-\355\350v\361\253\v\243\262D\fH\300j\205-\240\2710\273\002\022\001~\262\313\363\002\322r[-\241k\327\022\361\t/\'\344\r\345\211\255~\332\306\230F\372(}=\353K5#O\272\331\225$\245\357&\364\215\317\032\305Z\374\360\347\350\033\326G/t\326\205\255}\227\315\201\342\304\034#XU\324\304\025\006\255r\2031`\360\363W\303\362\247[\367\314\031\223\231\334\240\263K\234\240AC\375\3354\200\300$\002\337DHo\331\227\211\221l\3426\340\340Q\rP\005~\240\234\321\"\3202Ut\310\231l\226\v\355\272^\307\024\201\266\361\244\005\233cQ\216\214\276\335$\316\325\273\250\254v\306(\035\004\334\276\033#\277\326\r_\202\217\f\316?\025j!\241>\003{\231\005a\004\032\v\217\377\320\321\017Tw\320\177\350N&.\226d\200r.o\351\a\237\265\357\366\003R\246\337\371]\271\272\232y$\362\025\021\277\317\237\316_Y\334\332\373\177>-\0256\244e\226\304q\332<\262\365t\032\a\241X\244\0066\300\306\201\314t\364\t+\224\3046\337\360\324\363\346U\350\372\033\323\342\217\207\335T\257*\314A\250\342[\027-\326\034\205\251\233^\372\206\f\006\255\r\305\343\023\2603\371\201\300\240?\234Q\341L\020\235\360j\017X\020\261\276\0344\311\375\033\377\356\343)\303\221u<\225VJxC\214\300\252-\243\020\316ul\272\272k\033\226\320\262\t\260m\217o\200\355\215\024\231\276\332\252L\201T\004O\355\341\316\260\3379\253\000\321\377\351\036\347\034\033\353\354\201<J<\354\241\222\344\177\265\303\261\006\225\273Kv&\2321\235EO\220\237\3418xm\"\267\310^,\313\276\027N\237\225]K\222P\037\207\177~\334P\360\217\a\177\205[\220d\216\345\266\336\203\352\220rf{>O\314\233\226\270\003\363T\177&\334H\315\321\375\346\223\2177\210\301\331\306\3370\326q\306\342\021\225\374\257\205@,e\363\215t\033\207\025\n\247\025\256$\024\216#\322&\357t\312>\255 S\327\246\360\3136\242\220\353\251\251%\016\022Xp\334\003os\375&\360\270S\326\200_\274,\024\313:\247Y\216\035,\017\202\024;M\n\207\304q\254ERE\254\255\362\237 \221\003PN\245\276E\3410\250\242oz\006\244FB\001\303\340\336\217{\343\256\020\360\204p\323~\207\233#Q\355h\374\241\222\305!+\234P\344L\203\373\204\205q\346t\252\270\243\177e\200{\331\251\335\223\202=U\325"
