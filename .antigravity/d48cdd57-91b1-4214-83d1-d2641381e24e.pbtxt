  planner_response {
    response: "\340\256\250\340\257\200\340\256\231\340\257\215\340\256\225\340\256\263\340\257\215 \340\256\225\340\257\207\340\256\237\340\257\215\340\256\237 **3 Hands-Free & Outside-App Emergency SOS Triggers** \340\256\207\340\256\252\340\257\215\340\256\252\340\257\213\340\256\244\340\257\201 \340\256\256\340\257\201\340\256\264\340\257\201\340\256\256\340\257\210\340\256\257\340\256\276\340\256\225 \340\256\207\340\256\257\340\256\231\340\257\215\340\256\225\340\257\201\340\256\256\340\257\215 \340\256\265\340\256\225\340\257\210\340\256\257\340\256\277\340\256\262\340\257\215 **OurSafe** \340\256\232\340\257\206\340\256\257\340\256\262\340\256\277\340\256\257\340\256\277\340\256\262\340\257\215 \340\256\232\340\257\207\340\256\260\340\257\215\340\256\225\340\257\215\340\256\225\340\256\252\340\257\215\340\256\252\340\256\237\340\257\215\340\256\237\340\257\201, Default-\340\256\206\340\256\225\340\256\265\340\257\207 **Enabled (ON)** \340\256\232\340\257\206\340\256\257\340\257\215\340\256\257\340\256\252\340\257\215\340\256\252\340\256\237\340\257\215\340\256\237\340\257\201\340\256\263\340\257\215\340\256\263\340\256\251 (\340\256\256\340\257\201\340\256\251\340\257\215\340\256\252\340\257\201 \340\256\207\340\256\260\340\257\201\340\256\250\340\257\215\340\256\244 Threat Mode Police API \340\256\252\340\256\277\340\256\264\340\257\210\340\256\257\340\257\201\340\256\256\340\257\215 \340\256\232\340\256\260\340\256\277\340\256\232\340\257\206\340\256\257\340\257\215\340\256\257\340\256\252\340\257\215\340\256\252\340\256\237\340\257\215\340\256\237\340\257\201\340\256\263\340\257\215\340\256\263\340\256\244\340\257\201).\n\n### \340\256\232\340\257\207\340\256\260\340\257\215\340\256\225\340\257\215\340\256\225\340\256\252\340\257\215\340\256\252\340\256\237\340\257\215\340\256\237\340\257\201\340\256\263\340\257\215\340\256\263 3 Emergency SOS \340\256\206\340\256\252\340\257\215\340\256\267\340\256\251\340\257\215\340\256\225\340\256\263\340\257\215\n\n1. **3x Phone Shake SOS (\340\256\256\340\257\202\340\256\251\340\257\215\340\256\261\340\257\201 \340\256\256\340\257\201\340\256\261\340\257\210 \340\256\252\340\257\213\340\256\251\340\257\210 Shake \340\256\232\340\257\206\340\256\257\340\257\215\340\256\244\340\256\276\340\256\262\340\257\215 SOS Call)**\n   - \340\256\211\340\256\243\340\257\215\340\256\256\340\257\210\340\256\257\340\256\276\340\256\251 `DeviceMotionEvent` Accelerometer \340\256\232\340\257\206\340\256\251\340\257\215\340\256\232\340\256\276\340\256\260\340\257\215 \340\256\256\340\257\202\340\256\262\340\256\256\340\257\215 **2.5 \340\256\265\340\256\277\340\256\251\340\256\276\340\256\237\340\256\277\340\256\225\340\256\263\340\257\201\340\256\225\340\257\215\340\256\225\340\257\201\340\256\263\340\257\215 3 \340\256\256\340\257\201\340\256\261\340\257\210** \340\256\252\340\257\213\340\256\251\340\257\210 Shake \340\256\232\340\257\206\340\256\257\340\257\215\340\256\244\340\256\276\340\256\262\340\257\215 \340\256\211\340\256\237\340\256\251\340\257\207 SOS Call + Live GPS Alert \340\256\244\340\257\212\340\256\237\340\256\231\340\257\215\340\256\225\340\257\201\340\256\256\340\257\215.\n   - iOS/Mobile motion sensor \340\256\205\340\256\251\340\257\201\340\256\256\340\256\244\340\256\277\340\256\225\340\257\215\340\256\225\340\256\276\340\256\251 \340\256\252\340\256\237\340\257\215\340\256\237\340\256\251\340\257\201\340\256\256\340\257\215, Laptop/Desktop-\340\256\207\340\256\262\340\257\215 \340\256\211\340\256\237\340\256\251\340\257\207 \340\256\252\340\256\260\340\256\277\340\256\232\340\257\213\340\256\244\340\256\277\340\256\225\340\257\215\340\256\225 **Test Shake (1/3 \342\206\222 2/3 \342\206\222 3/3)** \340\256\252\340\256\237\340\257\215\340\256\237\340\256\251\340\257\201\340\256\256\340\257\215 \340\256\225\340\257\212\340\256\237\340\257\201\340\256\225\340\257\215\340\256\225\340\256\252\340\257\215\340\256\252\340\256\237\340\257\215\340\256\237\340\257\201\340\256\263\340\257\215\340\256\263\340\256\251.\n\n2. **Secret Voice Code SOS (\"Hey Google\" \340\256\252\340\257\213\340\256\251\340\257\215\340\256\261\340\257\201 Secret Code \340\256\232\340\257\212\340\256\251\340\257\215\340\256\251\340\256\276\340\256\262\340\257\215 SOS Call)**\n   - Continuous Web Speech Recognition (`English (India)`, `English (US)`, \340\256\256\340\256\261\340\257\215\340\256\261\340\257\201\340\256\256\340\257\215 `\340\256\244\340\256\256\340\256\277\340\256\264\340\257\215`) \340\256\256\340\257\202\340\256\262\340\256\256\340\257\215 \340\256\211\340\256\231\340\257\215\340\256\225\340\256\263\340\257\215 \340\256\244\340\256\251\340\256\277\340\256\252\340\257\215\340\256\252\340\256\237\340\257\215\340\256\237 **Secret Code** (Default: **`Red Rose`** \342\200\224 \340\256\207\340\256\244\340\257\210 `Code 999`, `Help Me Now`, \340\256\205\340\256\262\340\257\215\340\256\262\340\256\244\340\257\201 \340\256\244\340\256\256\340\256\277\340\256\264\340\257\215/\340\256\206\340\256\231\340\257\215\340\256\225\340\256\277\340\256\262\340\256\244\340\257\215\340\256\244\340\256\277\340\256\262\340\257\215 \340\256\216\340\256\244\340\257\201\340\256\265\340\256\276\340\256\225 \340\256\265\340\257\207\340\256\243\340\257\215\340\256\237\340\257\201\340\256\256\340\256\276\340\256\251\340\256\276\340\256\262\340\257\201\340\256\256\340\257\215 \340\256\256\340\256\276\340\256\261\340\257\215\340\256\261\340\256\262\340\256\276\340\256\256\340\257\215) \340\256\232\340\257\212\340\256\251\340\257\215\340\256\251\340\256\265\340\257\201\340\256\237\340\256\251\340\257\215 \340\256\211\340\256\237\340\256\251\340\257\207 SOS Emergency Call \340\256\244\340\257\212\340\256\237\340\256\231\340\257\215\340\256\225\340\257\201\340\256\256\340\257\215.\n   - **Arm Always-On Voice Mic** \340\256\256\340\257\202\340\256\262\340\256\256\340\257\215 \340\256\250\340\257\207\340\256\260\340\256\237\340\256\277\340\256\257\340\256\276\340\256\225\340\256\252\340\257\215 \340\256\252\340\257\207\340\256\232\340\256\262\340\256\276\340\256\256\340\257\215 \340\256\205\340\256\262\340\257\215\340\256\262\340\256\244\340\257\201 **Speak Test** \340\256\256\340\257\202\340\256\262\340\256\256\340\257\215 \340\256\211\340\256\237\340\256\251\340\257\207 \340\256\232\340\257\213\340\256\244\340\256\277\340\256\244\340\257\215\340\256\244\340\257\201\340\256\252\340\257\215 \340\256\252\340\256\276\340\256\260\340\257\215\340\256\225\340\257\215\340\256\225\340\256\262\340\256\276\340\256\256\340\257\215.\n\n3. **Double-Tap / Triple-Tap Screen SOS (\340\256\244\340\256\277\340\256\260\340\257\210\340\256\257\340\256\277\340\256\262\340\257\215 2 \340\256\205\340\256\262\340\257\215\340\256\262\340\256\244\340\257\201 3 \340\256\256\340\257\201\340\256\261\340\257\210 \340\256\244\340\256\237\340\257\215\340\256\237\340\256\277\340\256\251\340\256\276\340\256\262\340\257\215 SOS Call)**\n   - **Double Tap (2x)** \340\256\205\340\256\262\340\257\215\340\256\262\340\256\244\340\257\201 **Triple Tap (3x)** \340\256\207\340\256\260\340\256\243\340\257\215\340\256\237\340\256\277\340\256\262\340\257\215 \340\256\216\340\256\244\340\257\210 \340\256\265\340\257\207\340\256\243\340\257\215\340\256\237\340\257\201\340\256\256\340\256\276\340\256\251\340\256\276\340\256\262\340\257\201\340\256\256\340\257\215 \340\256\244\340\257\207\340\256\260\340\257\215\340\256\250\340\257\215\340\256\244\340\257\206\340\256\237\340\257\201\340\256\225\340\257\215\340\256\225\340\256\262\340\256\276\340\256\256\340\257\215.\n   - **Lock-Screen Shield**, **Login \340\256\244\340\256\277\340\256\260\340\257\210**, \340\256\256\340\256\261\340\257\215\340\256\261\340\257\201\340\256\256\340\257\215 \340\256\232\340\257\206\340\256\257\340\256\262\340\256\277\340\256\257\340\256\277\340\256\251\340\257\215 \340\256\216\340\256\250\340\257\215\340\256\244\340\256\225\340\257\215 \340\256\225\340\256\276\340\256\262\340\256\277\340\256\252\340\257\215 \340\256\252\340\256\225\340\257\201\340\256\244\340\256\277\340\256\257\340\256\277\340\256\262\340\257\201\340\256\256\340\257\215 \340\256\265\340\257\207\340\256\225\340\256\256\340\256\276\340\256\225 2x / 3x \340\256\244\340\256\237\340\257\215\340\256\237\340\256\277\340\256\251\340\256\276\340\256\262\340\257\215 \340\256\211\340\256\237\340\256\251\340\257\207 SOS Call & Guardian/Police Dialer \340\256\244\340\256\277\340\256\261\340\256\225\340\257\215\340\256\225\340\257\201\340\256\256\340\257\215.\n\n---\n\n### \340\256\206\340\256\252\340\257\215\340\256\252\340\256\277\340\256\261\340\257\215\340\256\225\340\257\201\340\256\263\340\257\215 \340\256\252\340\257\213\340\256\225\340\256\276\340\256\256\340\256\262\340\257\207 \340\256\252\340\256\257\340\256\251\340\257\215\340\256\252\340\256\237\340\257\201\340\256\244\340\257\215\340\256\244: Lock-Screen Standby Shield & No-Login SOS\n- **Login \340\256\244\340\256\277\340\256\260\340\257\210\340\256\257\340\256\277\340\256\262\340\257\207\340\256\257\340\257\207 (Sign In \340\256\232\340\257\206\340\256\257\340\257\215\340\256\257\340\256\276\340\256\256\340\256\262\340\257\207\340\256\257\340\257\207)** \340\256\256\340\257\207\340\256\262\340\257\207 \340\256\211\340\256\263\340\257\215\340\256\263 **Lock-Screen SOS** \340\256\252\340\256\237\340\257\215\340\256\237\340\256\251\340\257\215 \340\256\256\340\257\202\340\256\262\340\256\256\340\256\276\340\256\225\340\256\265\340\257\213 \340\256\205\340\256\262\340\257\215\340\256\262\340\256\244\340\257\201 \340\256\250\340\257\207\340\256\260\340\256\237\340\256\277\340\256\257\340\256\276\340\256\225 3x Shake / Secret Code / Screen Tap \340\256\256\340\257\202\340\256\262\340\256\256\340\256\276\340\256\225\340\256\265\340\257\213 SOS \340\256\225\340\256\276\340\256\262\340\257\215 \340\256\232\340\257\206\340\256\257\340\257\215\340\256\257\340\256\262\340\256\276\340\256\256\340\257\215.\n- **Lock-Screen Shield** (Header-\340\256\207\340\256\262\340\25