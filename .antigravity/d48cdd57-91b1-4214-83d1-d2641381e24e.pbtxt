  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { Bell, CheckCheck, Trash2, X } from \'lucide-react\';\nimport { AppNotification } from \'../../types/safety\';\nimport { formatTimeShort } from \'../../utils/storage\';\n\ninterface NotificationsModalProps {\n  notifications: AppNotification[];\n  maskPreviews: boolean;\n  onMarkAllRead: () => void;\n  onClearAll: () => void;\n  onClose: () => void;\n}\n\nexport const NotificationsModal: React.FC<NotificationsModalProps> = ({\n  notifications,\n  maskPreviews,\n  onMarkAllRead,\n  onClearAll,\n  onClose,\n}) => {\n  return (\n    <div\n      className=\"fixed inset-0 z-50 bg-[#1A132B]/55 backdrop-blur-sm flex items-center justify-center p-4\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"notifications-modal-title\"\n    >\n      <div className=\"w-full max-w-md bg-white rounded-3xl border border-violet-200 p-6 shadow-2xl max-h-[85vh] flex flex-col\">\n        <div className=\"flex items-start justify-between gap-4 mb-4\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-10 h-10 rounded-xl bg-[#F4F0FF] text-violet-700 flex items-center justify-center shrink-0\">\n              <Bell className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <h2\n                id=\"notifications-modal-title\"\n                className=\"text-lg font-bold text-[#1A132B]\"\n              >\n                Safety Activity Log\n              </h2>\n              <p className=\"text-xs text-[#6B6182]\">\n                Local session notifications ({notifications.length})\n              </p>\n            </div>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onClose}\n            aria-label=\"Close notifications\"\n            className=\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#6B6182] hover:bg-violet-50 cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {notifications.length > 0 && (\n          <div className=\"flex items-center justify-end gap-2 mb-3\">\n            <button\n              type=\"button\"\n              onClick={onMarkAllRead}\n              className=\"min-h-[36px] px-3 py-1 rounded-lg bg-[#F4F0FF] hover:bg-violet-100 text-violet-800 text-xs font-semibold flex items-center gap-1 cursor-pointer\"\n            >\n              <CheckCheck className=\"w-3.5 h-3.5\" />\n              <span>Mark All Read</span>\n            </button>\n            <button\n              type=\"button\"\n              onClick={onClearAll}\n              className=\"min-h-[36px] px-3 py-1 rounded-lg hover:bg-red-50 text-[#6B6182] hover:text-red-700 text-xs font-semibold flex items-center gap-1 cursor-pointer\"\n            >\n              <Trash2 className=\"w-3.5 h-3.5\" />\n              <span>Clear</span>\n            </button>\n          </div>\n        )}\n\n        <div className=\"flex-1 overflow-y-auto space-y-2.5 pr-0.5\">\n          {notifications.length === 0 ? (\n            <div className=\"rounded-2xl bg-[#FAF8FF] border border-violet-200/70 p-6 text-center text-xs text-[#6B6182]\">\n              No safety notifications recorded yet.\n            </div>\n          ) : (\n            notifications.map((item) => (\n              <div\n                key={item.id}\n                className={`rounded-2xl p-3.5 border text-sm ${\n                  item.read\n                    ? \'bg-white border-violet-100\'\n                    : \'bg-[#FAF8FF] border-violet-200\'\n                }`}\n              >\n                <div className=\"flex items-baseline justify-between gap-3\">\n                  <p className=\"font-bold text-[#1A132B] text-xs\">\n                    {item.title}\n                  </p>\n                  <span className=\"text-[11px] font-mono tabular-nums text-[#7A7094] shrink-0\">\n                    {formatTimeShort(item.timestamp)}\n                  </span>\n                </div>\n                <p className=\"mt-1 text-xs text-[#4A4063] leading-relaxed\">\n                  {maskPreviews\n                    ? \'Discreet preview enabled in Privacy Settings.\'\n                    : item.detail}\n                </p>\n              </div>\n            ))\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/dashboard/NotificationsModal.tsx"
        }
        overwrite: true
      }
    }
