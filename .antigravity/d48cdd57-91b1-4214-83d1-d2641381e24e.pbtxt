  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport {\n  Bell,\n  CheckCircle2,\n  ChevronRight,\n  KeyRound,\n  LogOut,\n  Shield,\n  User,\n  Users,\n  X,\n} from \'lucide-react\';\nimport { SafetyPreferences, UserProfile } from \'../../types/safety\';\n\ninterface SettingsModalProps {\n  user: UserProfile;\n  onUpdatePreferences: (partial: Partial<SafetyPreferences>) => void;\n  onChangePassword: (newPassword: string) => void;\n  onOpenEditProfile: () => void;\n  onOpenManageContacts: () => void;\n  onLogout: () => void;\n  onClose: () => void;\n}\n\nexport const SettingsModal: React.FC<SettingsModalProps> = ({\n  user,\n  onUpdatePreferences,\n  onChangePassword,\n  onOpenEditProfile,\n  onOpenManageContacts,\n  onLogout,\n  onClose,\n}) => {\n  const [showPasswordForm, setShowPasswordForm] = useState(false);\n  const [currentPwd, setCurrentPwd] = useState(\'\');\n  const [newPwd, setNewPwd] = useState(\'\');\n  const [confirmPwd, setConfirmPwd] = useState(\'\');\n  const [pwdFeedback, setPwdFeedback] = useState<{\n    type: \'error\' | \'success\';\n    text: string;\n  } | null>(null);\n\n  const handlePasswordSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    setPwdFeedback(null);\n\n    if (currentPwd !== user.password) {\n      setPwdFeedback({ type: \'error\', text: \'Current password is incorrect.\' });\n      return;\n    }\n    if (newPwd.length < 6) {\n      setPwdFeedback({\n        type: \'error\',\n        text: \'New password must be at least 6 characters.\',\n      });\n      return;\n    }\n    if (newPwd !== confirmPwd) {\n      setPwdFeedback({\n        type: \'error\',\n        text: \'New password and confirmation do not match.\',\n      });\n      return;\n    }\n\n    onChangePassword(newPwd);\n    setCurrentPwd(\'\');\n    setNewPwd(\'\');\n    setConfirmPwd(\'\');\n    setPwdFeedback({\n      type: \'success\',\n      text: \'Password updated for your local prototype account.\',\n    });\n  };\n\n  const ToggleRow: React.FC<{\n    label: string;\n    description: string;\n    checked: boolean;\n    onToggle: () => void;\n  }> = ({ label, description, checked, onToggle }) => (\n    <div className=\"py-3 flex items-center justify-between gap-4\">\n      <div className=\"min-w-0\">\n        <p className=\"text-sm font-semibold text-[#1A132B]\">{label}</p>\n        <p className=\"text-xs text-[#6B6182]\">{description}</p>\n      </div>\n      <button\n        type=\"button\"\n        role=\"switch\"\n        aria-checked={checked}\n        onClick={onToggle}\n        className={`w-12 h-7 rounded-full p-1 transition-colors shrink-0 cursor-pointer flex items-center ${\n          checked ? \'bg-violet-700 justify-end\' : \'bg-violet-200 justify-start\'\n        }`}\n      >\n        <span className=\"w-5 h-5 rounded-full bg-white shadow-sm block\" />\n      </button>\n    </div>\n  );\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 bg-[#1A132B]/55 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-labelledby=\"settings-modal-title\"\n    >\n      <div className=\"w-full max-w-xl bg-white rounded-3xl border border-violet-200 p-6 sm:p-7 shadow-2xl my-auto max-h-[92vh] overflow-y-auto space-y-6\">\n        <div className=\"flex items-start justify-between gap-4\">\n          <div>\n            <p className=\"text-xs font-semibold text-violet-700\">\n              Account &amp; Safety Configuration\n            </p>\n            <h2\n              id=\"settings-modal-title\"\n              className=\"text-xl font-bold text-[#1A132B] mt-0.5\"\n            >\n              Settings\n            </h2>\n          </div>\n\n          <button\n            type=\"button\"\n            onClick={onClose}\n            aria-label=\"Close settings\"\n            className=\"min-w-[40px] min-h-[40px] rounded-xl flex items-center justify-center text-[#6B6182] hover:bg-violet-50 cursor-pointer\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Account Shortcuts */}\n        <div className=\"divide-y divide-violet-100 rounded-2xl border border-violet-200/80 overflow-hidden\">\n          <button\n            type=\"button\"\n            onClick={onOpenEditProfile}\n            className=\"w-full min-h-[56px] px-4 py-3 bg-white hover:bg-[#FAF8FF] flex items-center justify-between gap-3 text-left transition-colors cursor-pointer\"\n          >\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-9 h-9 rounded-xl bg-[#F4F0FF] text-violet-700 flex items-center justify-center shrink-0\">\n                <User className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <p className=\"text-sm font-semibold text-[#1A132B]\">Edit Profile</p>\n                <p className=\"text-xs text-[#6B6182]\">\n                  Update your name, phone, email, age, or guardian details\n                </p>\n              </div>\n            </div>\n            <ChevronRight className=\"w-4 h-4 text-[#73698A] shrink-0\" />\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={onOpenManageContacts}\n            className=\"w-full min-h-[56px] px-4 py-3 bg-white hover:bg-[#FAF8FF] flex items-center justify-between gap-3 text-left transition-colors cursor-pointer\"\n          >\n            <div className=\"flex items-center gap-3\">\n              <div className=\"w-9 h-9 rounded-xl bg-[#F4F0FF] text-violet-700 flex items-center justify-center shrink-0\">\n                <Users className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <p className=\"text-sm font-semibold text-[#1A132B]\">\n                  Manage Emergency Contacts\n                </p>\n                <p className=\"text-xs text-[#6B6182]\">\n                  {user.sosContacts.length} contact(s) configured for SOS and Travel Mode\n                </p>\n              </div>\n            </div>\n            <ChevronRight className=\"w-4 h-4 text-[#73698A] shrink-0\" />\n          </button>\n\n          <div className=\"bg-white\">\n            <button\n              type=\"button\"\n              onClick={() => {\n                setShowPasswordForm((prev) => !prev);\n                setPwdFeedback(null);\n              }}\n              className=\"w-full min-h-[56px] px-4 py-3 hover:bg-[#FAF8FF] flex items-center justify-between gap-3 text-left transition-colors cursor-pointer\"\n            >\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-9 h-9 rounded-xl bg-[#F4F0FF] text-violet-700 flex items-center justify-center shrink-0\">\n                  <KeyRound className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <p className=\"text-sm font-semibold text-[#1A132B]\">\n                    Change Password\n                  </p>\n                  <p className=\"text-xs text-[#6B6182]\">\n                    Update the password for your local session login\n                  </p>\n                </div>\n              </div>\n              <span className=\"text-xs font-semibold text-violet-700\">\n                {showPasswordForm ? \'Hide\' : \'Open\'}\n              </span>\n            </button>\n\n            {showPasswordForm && (\n              <form\n                onSubmit={handlePasswordSubmit}\n                className=\"px-4 pb-4 pt-2 bg-[#FAF8FF] border-t border-violet-100 space-y-3\"\n              >\n                {pwdFeedback && (\n                  <div\n                    className={`rounded-xl px-3 py-2 text-xs font-medium flex items-center gap-2 ${\n                      pwdFeedback.type === \'success\'\n                        ? \'bg-emerald-50 border border-emerald-200 text-emerald-800\'\n                        : \'bg-red-50 border border-red-200 text-red-700\'\n                    }`}\n                  >\n                    {pwdFeedback.type === \'success\' && (\n                      <CheckCircle2 className=\"w-3.5 h-3.5 shrink-0\" />\n                    )}\n                    <span>{pwdFeedback.text}</span>\n                  </div>\n                )}\n\n                <input\n                  type=\"password\"\n                  value={currentPwd}\n                  onChange={(e) => setCurrentPwd(e.target.value)}\n                  placeholder=\"Current password\"\n                  aria-label=\"Current password\"\n                  className=\"w-full min-h-[42px] px-3.5 py-2 rounded-xl bg-white border border-violet-200 text-sm focus:border-violet-600 focus:outline-none\"\n                />\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n                  <input\n                    type=\"password\"\n                    value={newPwd}\n                    onChange={(e) => setNewPwd(e.target.value)}\n                    placeholder=\"New password (min 6)\"\n                    aria-label=\"New password\"\n                    className=\"w-full min-h-[42px] px-3.5 py-2 rounded-xl bg-white border border-violet-200 text-sm focus:border-violet-600 focus:outline-none\"\n                  />\n                  <input\n                    type=\"password\"\n                    value={confirmPwd}\n                    onChange={(e) => setConfirmPwd(e.target.value)}\n                    placeholder=\"Confirm new password\"\n                    aria-label=\"Confirm new password\"\n                    className=\"w-full min-h-[42px] px-3.5 py-2 rounded-xl bg-white border border-violet-200 text-sm focus:border-violet-600 focus:outline-none\"\n                  />\n                </div>\n                <div className=\"flex justify-end\">\n                  <button\n                    type=\"submit\"\n                    className=\"min-h-[40px] px-4 py-1.5 rounded-xl bg-violet-700 hover:bg-violet-800 text-white text-xs font-semibold cursor-pointer\"\n                  >\n                    Save New Password\n                  </button>\n                </div>\n              </form>\n            )}\n          </div>\n        </div>\n\n        {/* Notification Preferences */}\n        <div className=\"space-y-1\">\n          <div className=\"flex items-center gap-2 text-sm font-bold text-[#1A132B]\">\n            <Bell className=\"w-4 h-4 text-violet-700\" />\n            <span>Notification Preferences</span>\n          </div>\n          <div className=\"divide-y divide-violet-100 rounded-2xl bg-[#FAF8FF] border border-violet-200/70 px-4\">\n            <ToggleRow\n              label=\"Travel Check-in Reminders\"\n              description=\"Remind me to confirm safe progress during active Travel Mode\"\n              checked={user.preferences.travelCheckInReminders}\n              onToggle={() =>\n                onUpdatePreferences({\n                  travelCheckInReminders: !user.preferences.travelCheckInReminders,\n                })\n              }\n            />\n            <ToggleRow\n              label=\"Guardian Activity Log\"\n              description=\"Record local safety notifications when contacts or alerts update\"\n              checked={user.preferences.guardianUpdates}\n              onToggle={() =>\n                onUpdatePreferences({\n                  guardianUpdates: !user.preferences.guardianUpdates,\n                })\n              }\n            />\n            <ToggleRow\n              label=\"Threat Mode Attention Tone\"\n              description=\"Enable the manual siren tone option inside Threat Mode\"\n              checked={user.preferences.soundAlarmEnabled}\n              onToggle={() =>\n                onUpdatePreferences({\n                  soundAlarmEnabled: !user.preferences.soundAlarmEnabled,\n                })\n              }\n            />\n          </div>\n        </div>\n\n        {/* Privacy Settings */}\n        <div className=\"space-y-1\">\n          <div className=\"flex items-center gap-2 text-sm font-bold text-[#1A132B]\">\n            <Shield className=\"w-4 h-4 text-violet-700\" />\n            <span>Privacy Settings</span>\n          </div>\n          <div className=\"divide-y divide-violet-100 rounded-2xl bg-[#FAF8FF] border border-violet-200/70 px-4\">\n            <ToggleRow\n              label=\"GPS Only During Active Safety Actions\"\n              description=\"Request browser location only when opening SOS, Travel, or Nearby\"\n              checked={user.preferences.locationOnlyDuringEmergency}\n              onToggle={() =>\n                onUpdatePreferences({\n                  locationOnlyDuringEmergency:\n                    !user.preferences.locationOnlyDuringEmergency,\n                })\n              }\n            />\n            <ToggleRow\n              label=\"Discreet Notification Text\"\n              description=\"Hide detailed alert text inside notification previews\"\n              checked={user.preferences.maskLockscreenPreviews}\n              onToggle={() =>\n                onUpdatePreferences({\n                  maskLockscreenPreviews: !user.preferences.maskLockscreenPreviews,\n                })\n              }\n            />\n          </div>\n        </div>\n\n        {/* Logout */}\n        <div className=\"pt-2 border-t border-violet-100 flex flex-wrap items-center justify-between gap-3\">\n          <p className=\"text-xs text-[#6B6182]\">\n            Your profile stays saved locally so you can sign back in later.\n          </p>\n          <button\n            type=\"button\"\n            onClick={onLogout}\n            className=\"min-h-[44px] px-5 py-2.5 rounded-xl bg-red-50 hover:bg-red-100 border border-red-200 text-red-700 text-sm font-semibold flex items-center gap-2 transition-colors cursor-pointer whitespace-nowrap\"\n          >\n            <LogOut className=\"w-4 h-4\" />\n            <span>Log Out</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/dashboard/SettingsModal.tsx"
        }
        overwrite: true
      }
    }
    action_result {
      edit {
        diff {
          unified_diff {
