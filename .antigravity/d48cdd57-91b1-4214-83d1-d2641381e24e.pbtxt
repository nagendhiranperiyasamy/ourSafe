    content: "\n    stations.push({\n      name: candidateName,\n      phone: phoneMatch ? phoneMatch[0].trim() : undefined,\n      address:\n        segments.length > 1\n          ? segments\n              .slice(1)\n              .join(\' \302\267 \')\n              .replace(phoneMatch ? phoneMatch[0] : \'\', \'\')\n              .replace(/^[\\s\302\267,-]+|[\\s\302\267,-]+$/g, \'\')\n              .slice(0, 140) || undefined\n          : undefined,\n      mapsUri: matchedMap?.uri,\n    });\n  }\n\n  // Ensure every Google Maps grounded police place appears even if bullet parsing missed it\n  for (const link of mapLinks) {\n    const already = stations.some(\n      (s) =>\n        s.mapsUri === link.uri ||\n        s.name.toLowerCase() === link.title.toLowerCase()\n    );\n    if (!already && link.title) {\n      stations.push({\n        name: link.title,\n        mapsUri: link.uri,\n      });\n    }\n  }\n\n  return stations.slice(0, 8);\n}\n\nasync function startServer() {\n  const app = express();\n  app.use(express.json({ limit: \'2mb\' }));\n\n  app.get(\'/api/health\', (_req, res) => {\n    res.json({ ok: true, liveVoiceReady: Boolean(process.env.GEMINI_API_KEY) });\n  });\n\n  // AI Nearby Police Stations & Verified Numbers (Threat Mode \342\200\224 Google Maps Grounding via gemini-4-hydrogen)\n  app.post(\'/api/threat/nearby-police\', async (req, res) => {\n    try {\n      const { latitude, longitude, areaQuery } = req.body as {\n        latitude?: number | null;\n        longitude?: number | null;\n        areaQuery?: string;\n      };\n\n      const hasCoords =\n        typeof latitude === \'number\' &&\n        typeof longitude === \'number\' &&\n        !Number.isNaN(latitude) &&\n        !Number.isNaN(longitude);\n\n      const cleanArea =\n        typeof areaQuery === \'string\' ? areaQuery.trim() : \'\';\n\n      if (!hasCoords && !cleanArea) {\n        res.status(400).json({\n          error:\n            \'Provide GPS coordinates or enter a city/neighborhood name so AI can locate nearby police stations.\',\n        });\n        return;\n      }\n\n      const ai = getAiClient();\n      const prompt = hasCoords\n        ? `Find the nearest police stations and women police help desks around latitude ${latitude}, longitude ${longitude}. List each station as a bullet point in the format: \"- Station Name | Public Phone Number (only if verified on Maps, otherwise write \'Call 100 / 112\') | Short street address\". Do NOT invent phone numbers. Also mention the local national emergency police number.`\n        : `Find the main nearby police stations and women police stations in or near \"${cleanArea}\". List each station as a bullet point in the format: \"- Station Name | Public Phone Number (only if verified on Maps, otherwise write \'Call 100 / 112\') | Short street address\". Do NOT invent phone numbers. Also mention the local national emergency police number.`;\n\n      const config: {\n        tools: Array<{ googleMaps: Record<string, never> }>;\n        toolConfig?: {\n          retrievalConfig: {\n            latLng: { latitude: number; longitude: number };\n          };\n        };\n      } = {\n        tools: [{ googleMaps: {} }],\n      };\n\n      if (hasCoords) {\n        config.toolConfig = {\n          retrievalConfig: {\n            latLng: {\n              latitude: latitude as number,\n              longitude: longitude as number,\n            },\n          },\n        };\n      }\n\n      const response = await ai.models.generateContent({\n        model: \'gemini-4-hydrogen\',\n        contents: prompt,\n        config,\n      });\n\n      const summaryText = (response.text ?? \'\').trim();\n      const rawChunks =\n        response.candidates?.[0]?.groundingMetadata?.groundingChunks ?? [];\n\n      const mapLinks: Array<{ title: string; uri: string }> = [];\n      for (const chunk of rawChunks) {\n        const mapsObj = (chunk as { maps?: { uri?: string; title?: string } })\n          .maps;\n        if (mapsObj?.uri) {\n          mapLinks.push({\n            title: mapsObj.title || \'Police Station on Google Maps\',\n            uri: mapsObj.uri,\n          });\n        }\n      }\n\n      const stations = parseStationsFromGroundedText(summaryText, mapLinks);\n\n      res.json({\n        summaryText,\n        stations,\n        mapLinks,\n        queriedAt: new Date().toISOString(),\n        locationLabel: hasCoords\n          ? `GPS ${(latitude as number).toFixed(4)}, ${(longitude as number).toFixed(4)}`\n          : cleanArea,\n      });\n    } catch (err) {\n      const message =\n        err instanceof Error\n          ? err.message\n          : \'Failed to look up nearby police stations.\';\n      res.status(500).json({ error: message });\n    }\n  });\n\n  // REST AI App-Controller Endpoint (gemini-4-hydrogen + function calling) for typed commands & quick buttons\n  app.post(\'/api/assistant/command\', async (req, res) => {\n    try {"
