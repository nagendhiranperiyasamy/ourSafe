    end_line: 183
    content: "import React, { useEffect, useRef, useState } from \'react\';\nimport { MicOff, Phone, PhoneOff, User, Volume2 } from \'lucide-react\';\n\ninterface FakeCallModalProps {\n  callerName: string;\n  onClose: () => void;\n}\n\nexport const FakeCallModal: React.FC<FakeCallModalProps> = ({\n  callerName,\n  onClose,\n}) => {\n  const [phase, setPhase] = useState<\'ringing\' | \'connected\'>(\'ringing\');\n  const [callSeconds, setCallSeconds] = useState(0);\n  const [muted, setMuted] = useState(false);\n  const [speaker, setSpeaker] = useState(false);\n\n  const audioCtxRef = useRef<AudioContext | null>(null);\n  const ringTimerRef = useRef<number | null>(null);\n\n  const stopRingtone = () => {\n    if (ringTimerRef.current !== null) {\n      window.clearInterval(ringTimerRef.current);\n      ringTimerRef.current = null;\n    }\n    if (audioCtxRef.current) {\n      audioCtxRef.current.close().catch(() => {});\n      audioCtxRef.current = null;\n    }\n  };\n\n  useEffect(() => {\n    if (phase !== \'ringing\') {\n      stopRingtone();\n      return;\n    }\n\n    try {\n      const Ctor =\n        window.AudioContext ||\n        (window as unknown as { webkitAudioContext: typeof AudioContext })\n          .webkitAudioContext;\n      const ctx = new Ctor();\n      audioCtxRef.current = ctx;\n\n      const playRingBurst = () => {\n        if (!audioCtxRef.current) return;\n        const osc1 = ctx.createOscillator();\n        const osc2 = ctx.createOscillator();\n        const gain = ctx.createGain();\n        osc1.type = \'sine\';\n        osc2.type = \'sine\';\n        osc1.frequency.setValueAtTime(440, ctx.currentTime);\n        osc2.frequency.setValueAtTime(480, ctx.currentTime);\n        gain.gain.setValueAtTime(0.001, ctx.currentTime);\n        gain.gain.exponentialRampToValueAtTime(0.09, ctx.currentTime + 0.08);\n        gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.85);\n        osc1.connect(gain);\n        osc2.connect(gain);\n        gain.connect(ctx.destination);\n        osc1.start();\n        osc2.start();\n        osc1.stop(ctx.currentTime + 0.9);\n        osc2.stop(ctx.currentTime + 0.9);\n      };\n\n      playRingBurst();\n      ringTimerRef.current = window.setInterval(playRingBurst, 1900);\n    } catch {\n      // Browser blocked autoplay before interaction\n    }\n\n    return () => {\n      stopRingtone();\n    };\n  }, [phase]);\n\n  useEffect(() => {\n    if (phase !== \'connected\') return;\n    const id = window.setInterval(() => setCallSeconds((s) => s + 1), 1000);\n    return () => window.clearInterval(id);\n  }, [phase]);\n\n  const mins = Math.floor(callSeconds / 60);\n  const secs = callSeconds % 60;\n\n  return (\n    <div\n      className=\"fixed inset-0 z-50 bg-[#140E22] text-white flex flex-col justify-between p-6 sm:p-10\"\n      role=\"dialog\"\n      aria-modal=\"true\"\n      aria-label={`Simulated incoming call from ${callerName}`}\n    >\n      <div className=\"text-center pt-4 space-y-2\">\n        <p className=\"text-[11px] font-medium text-violet-200/70\">\n          Simulated Fake Call \302\267 Safe Exit Mode\n        </p>\n        <div className=\"w-24 h-24 rounded-full bg-white/10 border border-white/20 flex items-center justify-center mx-auto mt-6\">\n          <User className=\"w-11 h-11 text-violet-100\" />\n        </div>\n        <h2 className=\"text-3xl font-bold tracking-tight pt-3\">{callerName}</h2>\n        <p className=\"text-sm text-violet-200 font-mono tabular-nums\">\n          {phase === \'ringing\'\n            ? \'Incoming mobile call...\'\n            : `${String(mins).padStart(2, \'0\')}:${String(secs).padStart(2, \'0\')}`}\n        </p>\n      </div>\n\n      {phase === \'connected\' && (\n        <div className=\"max-w-xs w-full mx-auto grid grid-cols-2 gap-4\">\n          <button\n            type=\"button\"\n            onClick={() => setMuted((m) => !m)}\n            className={`min-h-[64px] rounded-2xl border flex flex-col items-center justify-center gap-1 text-xs font-semibold cursor-pointer ${\n              muted\n                ? \'bg-white text-[#140E22] border-white\'\n                : \'bg-white/10 text-white border-white/15\'\n            }`}\n          >\n            <MicOff className=\"w-5 h-5\" />\n            <span>{muted ? \'Muted\' : \'Mute\'}</span>\n          </button>\n          <button\n            type=\"button\"\n            onClick={() => setSpeaker((s) => !s)}\n            className={`min-h-[64px] rounded-2xl border flex flex-col items-center justify-center gap-1 text-xs font-semibold cursor-pointer ${\n              speaker\n                ? \'bg-white text-[#140E22] border-white\'\n                : \'bg-white/10 text-white border-white/15\'\n            }`}\n          >\n            <Volume2 className=\"w-5 h-5\" />\n            <span>Speaker</span>\n          </button>\n        </div>\n      )}\n\n      <div className=\"max-w-xs w-full mx-auto pb-6\">\n        {phase === \'ringing\' ? (\n          <div className=\"flex items-center justify-between gap-8\">\n            <button\n              type=\"button\"\n              onClick={() => {\n                stopRingtone();\n                onClose();\n              }}\n              className=\"flex flex-col items-center gap-2 cursor-pointer\"\n            >\n              <span className=\"w-16 h-16 rounded-full bg-red-600 hover:bg-red-700 flex items-center justify-center shadow-lg\">\n                <PhoneOff className=\"w-7 h-7 text-white\" />\n              </span>\n              <span className=\"text-xs font-semibold text-violet-100\">Decline</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setPhase(\'connected\')}\n              className=\"flex flex-col items-center gap-2 cursor-pointer\"\n            >\n              <span className=\"w-16 h-16 rounded-full bg-emerald-600 hover:bg-emerald-700 flex items-center justify-center shadow-lg\">\n                <Phone className=\"w-7 h-7 text-white\" />\n              </span>\n              <span className=\"text-xs font-semibold text-violet-100\">Accept</span>\n            </button>\n          </div>\n        ) : (\n          <div className=\"flex justify-center\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"flex flex-col items-center gap-2 cursor-pointer\"\n            >\n              <span className=\"w-16 h-16 rounded-full bg-red-600 hover:bg-red-700 flex items-center justify-center shadow-lg\">\n                <PhoneOff className=\"w-7 h-7 text-white\" />\n              </span>\n              <span className=\"text-xs font-semibold text-violet-100\">End Call</span>\n            </button>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 184
