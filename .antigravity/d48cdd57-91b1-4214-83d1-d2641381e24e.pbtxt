      thinking_signature: "\022\265\021\n\262\021\001i\024}\023\265S\362&\203\fA\362\305\303S\223\342\357\177s\304\004!Sf#RsX\355\357\035\347\b\316\277\021\266\276\004\217s<\253\311\033\262\325C\367n\217[\303 \325\271\000\t\230{\322\221\252\352d\373\371\272L\336\374\3710^<$\326\241e\353\034/\340e\301\257\350\003\nX\327y@\234\305\365\216\035\002\327L\252u\037 \371\274\027\030\017\214\026-x\236`S\371\371\201Si\312.kR9\243\205\033\306\255G\373#\270\317\354\000\375\034D\275\340[\254\242\"{\024\204\210\036\375w\252 \316H\224\376\300Z\301\264n\233U\235W\336\315\200\333Q\226\250\221\263\375\325\353#\310n\'R\230\017l\274\r(\306\024\270\251\326yM[\2513\241\255\201nOP\333\367\271\005m\334T\256>\213n\256\017\004\343S\370E\274\263)\267H\367\204M\313y];\206Q$\277\257]u\241\241\304\r\263\373\232\357=\r\344\332\311\001\367k\321\353F\311)T,q]\261\361\267\272\340\267B\\\025\n\\\351-|\375\317t>\332_I\25368\214\201\210\355=D\245\370\227\347sy\353\030\303_b\333\224{\252S\\&\327\202\352\205\3749I\0252\033\363v%*Z\360\235\313Y&\271c\251?Or\327\245\363m\362\030W\375\353\275\344\206\206\023\177\210\364\244E\334\242\256\340\223U\314b\027\253l\241\370\327\032\245E\342\\\272\206(3\252\006\332\302\035\334\351:H\347a?\r&\340\350\331i\313K\005\200V\323\005\017\002+QU\372\260\317\303*\023CW\031\241\003\020\032^p\312\225\324R\245\2650\035\346\361\205t\347d|9\314\033\371\365\377l\v\002\225d\354X\215i\345\360\242\365z~m\v\365?\357\340\327I\350\264\000\234\370\316\273\363\255\347@\257\215\364 \364_$<\032\000e\\\342T \252\210\324Cy\330\222\006\241\343-\354\005\226\230i\032\302\345 \003qj\017cL\273\372S\241?\"`M\207\300\017s\224\347r\365j\020\233\313v\036\234{\005\343t\254N\rT.\274\017FV\252/\213\256\373\214t\260S1\305C\374\241c\247\353\315\246f\324\227A\'\212~\340j\031\036\f$v\237\243~+_\242\343\"\n\206\364\a\221\305\225&D\344k\233\\\370\367\267{KMg\336UW\224\207\0214\207\212\023e\332t\202n\320\206\026\256\370hmb\2503\373\320\026-\032\352\360\363\303\344=\034\306\353\246\210\250\032\3508)\243\222u\340\253\220|\235\204vg\302]\311\260\177/\242\025+LP\200\371\2717y\370\r:o\t\256K\003\003\353\020U \347\204\231\226\346$v\353\335\205\314)oq\276\177;Xx\250\03234\023\365\217\025vo\177\2514\337\200\354KN\205P\252\217\223\261\342\305\354N\254Y!Kwu\200\206i\256\242\340\252\251\341\275\247\250\370\371<\331\334\214D\313\372\303\232\r\026\207Ig p\031\375z\324\371\347\361\306wk\231@T\264~Q\250\227-]\242\022\232 ($\2133*:Gc\1777\025uP\235\216\306\250T\a\263\254\224\233\262\246\251\270 7;\314c\307\351\205\006\317\351\311\252\307\217\354\233\350\374x\364=\243\303w\004\277d\215\265K\346\212|\224\267\bl\314\314?\311\244{ksk\364\327\326\364\211v\b\004\330*\344\020\004\035\rk\226\3001\210\247\343\372\"?0\253\324y\033\216\'\243jA\036s\236\345\375g)v[\367u\r\023V\006V\0045\326\036oa\205\"\321\253D\257\025\356\202\225j\030\237*\312\027\230\f\003\276\357\353\335\236\252\323\320.r\264PF3\352\266#\360Z\304\315\261E\246\353\340Y\307~KK\237,{\275x\277\030\232\335\231/I\236\206\237\371\265\be\325\305\3668Eg\034]\2079\016\241\030\205\346,\347\3576)$F\260W\027\320\254mw\035VE3\230t@g\276\202\361\223\002&\032\030\"j\020\225\265\2427\035\330\342\257\247\027;\337\341\242p\373\335l\301\265K}\314\213\252;i\344\340@LH\220d\354^\316\223\270D\274>\026\311*ls\a\245\262\250\271\262]2\243\314Du\026\312Ll\327\215>\257\031O\350#{\036\017.\343\314\217\316\373P\362wG\247\350w\325\363\362\003\323\263[\2575\265\324#\260\251/\244\311:r\343f\224\001\314\353 \342\305|\r\301\352Lb\255\016\031\364\222\021%\317\020\345\v\224v\347f\031\322\345\235\004T\303$\r)\231\177\2165\0042\355=%Ph\304\034S\252\242N\020/1Is\n\275}\262\331[Nz\217:t\2012\325)}\213\373\n\224\036\2244z\3639;\304\372\220\366\277O\v9\276\034\241\360\357f`\342P\030\234\315\304\032(\310\225\023\035\305\252\216\201-\bL4\271\375Q\vZn\277;-\020F\320\036\a\207\200U\304c\227\002c\327^<\177h\253\263\327\022\256{e\373\301P\254&\210\252\231\017\335\256\244L\313\361i\016\a\326O\222R\252\306\000\2109\222\351\264@\240\227\fg\216\2167z\202\303_\270\314\272C\325\t\300