    tool_calls {
      id: "call_2424911476422923866"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"@import \\\"tailwindcss\\\";\\n\\n@theme {\\n  --font-display: \\\"Fraunces\\\", Georgia, \\\"Times New Roman\\\", serif;\\n  --font-sans: \\\"Plus Jakarta Sans\\\", -apple-system, BlinkMacSystemFont, sans-serif;\\n  --font-mono: \\\"JetBrains Mono\\\", ui-monospace, SFMono-Regular, monospace;\\n}\\n\\n@layer base {\\n  html {\\n    font-family: var(--font-sans);\\n    scroll-behavior: smooth;\\n    color: #182215;\\n    background-color: #CDD7C1;\\n  }\\n\\n  h1, h2, h3, h4 {\\n    font-family: var(--font-display);\\n    text-wrap: balance;\\n    letter-spacing: -0.015em;\\n  }\\n\\n  button, a, input, select, textarea {\\n    outline-color: #2F4526;\\n  }\\n}\\n\\n.tabular-nums {\\n  font-variant-numeric: tabular-nums;\\n}\\n\\n@media (prefers-reduced-motion: reduce) {\\n  *, *::before, *::after {\\n    animation-duration: 0.01ms !important;\\n    animation-iteration-count: 1 !important;\\n    transition-duration: 0.01ms !important;\\n    scroll-behavior: auto !important;\\n  }\\n}\\n\", \"Description\":\"Configure Fraunces display serif, Plus Jakarta Sans body font, and sage green base canvas in src/index.css\", \"Overwrite\":true, \"TargetFile\":\"/src/index.css\", \"toolAction\":\"Updating global stylesheet theme\", \"toolSummary\":\"Update src/index.css\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2424911476422923313"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\n\\ninterface BrandLogoProps {\\n  size?: \'sm\' | \'md\' | \'lg\';\\n  tone?: \'dark\' | \'light\';\\n}\\n\\nexport const BrandLogo: React.FC<BrandLogoProps> = ({\\n  size = \'md\',\\n  tone = \'dark\',\\n}) => {\\n  const iconDim = size === \'sm\' ? \'w-8 h-8\' : size === \'lg\' ? \'w-11 h-11\' : \'w-9 h-9\';\\n  const textClass =\\n    size === \'sm\'\\n      ? \'text-xl\'\\n      : size === \'lg\'\\n        ? \'text-3xl\'\\n        : \'text-2xl\';\\n\\n  return (\\n    <div className=\\\"inline-flex items-center gap-2.5 whitespace-nowrap shrink-0 select-none\\\">\\n      <div\\n        className={`${iconDim} rounded-xl flex items-center justify-center shrink-0 ${\\n          tone === \'light\'\\n            ? \'bg-white/15 border border-white/25 text-white\'\\n            : \'bg-[#2F4526] text-[#F5F8F1] shadow-sm shadow-[#182215]/15\'\\n        }`}\\n        aria-hidden=\\\"true\\\"\\n      >\\n        <svg\\n          viewBox=\\\"0 0 28 28\\\"\\n          fill=\\\"none\\\"\\n          className=\\\"w-5 h-5\\\"\\n          xmlns=\\\"http://www.w3.org/2000/svg\\\"\\n        >\\n          <path\\n            d=\\\"M14 2.5L4.5 6.5V13.4C4.5 19.35 8.55 24.78 14 26.25C19.45 24.78 23.5 19.35 23.5 13.4V6.5L14 2.5Z\\\"\\n            stroke=\\\"currentColor\\\"\\n            strokeWidth=\\\"2\\\"\\n            strokeLinejoin=\\\"round\\\"\\n          />\\n          <path\\n            d=\\\"M8.5 14.5H11.2L12.8 10.8L15.1 17.5L16.8 14.5H19.5\\\"\\n            stroke=\\\"currentColor\\\"\\n            strokeWidth=\\\"2\\\"\\n            strokeLinecap=\\\"round\\\"\\n            strokeLinejoin=\\\"round\\\"\\n          />\\n        </svg>\\n      </div>\\n      <span\\n        className={`font-semibold tracking-tight ${textClass} ${\\n          tone === \'light\' ? \'text-white\' : \'text-[#182215]\'\\n        }`}\\n        style={{ fontFamily: \'var(--font-display)\' }}\\n      >\\n        OurSafe\\n      </span>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Rename BrandLogo to OurSafe with Fraunces serif typography and deep botanical olive badge\", \"Overwrite\":true, \"TargetFile\":\"/src/components/BrandLogo.tsx\", \"toolAction\":\"Updating BrandLogo to OurSafe\", \"toolSummary\":\"Update BrandLogo\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_2424911476422922760"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add NearbyPoliceStationItem, NearbyPoliceResponse, and DualCallDispatchState types to src/types/safety.ts\", \"EndLine\":171, \"Instruction\":\"Append AI nearby police lookup and dual emergency call dispatch types\", \"ReplacementContent\":\"export interface VoiceCommandAction {\\n  id: string;\\n  name: string;\\n  args: Record<string, unknown>;\\n}\\n\\nexport interface NearbyPoliceMapLink {\\n  title: string;\\n  uri: string;\\n}\\n\\nexport interface NearbyPoliceStationEntry {\\n  name: string;\\n  phone?: string;\\n  address?: string;\\n  mapsUri?: string;\\n}\\n\\nexport interface NearbyPoliceAiResult {\\n  summaryText: string;\\n  stations: NearbyPoliceStationEntry[];\\n  mapLinks: NearbyPoliceMapLink[];\\n  queriedAt: string;\\n  locationLabel: string;\\n}\\n\\nexport interface DualCallDispatchState {\\n  active: boolean;\\n  triggeredBy: string;\\n  triggeredAt: string;\\n  guardianName: string | null;\\n  guardianPhone: string | null;\\n  policeName: string;\\n  policePhone: string;\\n  nearestStationName?: string;\\n  nearestStationPhone?: string;\\n  guardianDialAttempted?: boolean;\\n  policeDialAttempted?: boolean;\\n}\\n\", \"StartLine\":166, \"TargetContent\":\"export interface VoiceCommandAction {\\n  id: string;\\n  name: string;\\n  args: Record<string, unknown>;\\n}\", \"TargetFile\":\"/src/types/safety.ts\", \"toolAction\":\"Adding AI police and dual-call types\", \"toolSummary\":\"Update safety.ts types\"}"
      original_name: "replace_file_content"
    }
    tool_calls {
      id: "call_2424911476422926303"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import \'dotenv/config\';\\nimport express from \'express\';\\nimport http from \'http\';\\nimport path from \'path\';\\nimport { fileURLToPath } from \'url\';\\nimport { WebSocketServer, WebSocket } from \'ws\';\\nimport {\\n  GoogleGenAI,\\n  Modality,\\n  Type,\\n  type FunctionDeclaration,\\n  type LiveServerMessage,\\n} from \'@google/genai\';\\n\\nconst __filename = fileURLToPath(import.meta.url);\\nconst __dirname = path.dirname(__filename);\\n\\nconst PORT = Number(process.env.PORT || 3000);\\n\\nfunction getAiClient(): GoogleGenAI {\\n  const apiKey = process.env.GEMINI_API_KEY;\\n  if (!apiKey) {\\n    throw new Error(\\n      \'GEMINI_API_KEY is not configured. Add it in Settings > Secrets to use the live AI features.\'\\n    );\\n  }\\n  return new GoogleGenAI({\\n    apiKey,\\n    httpOptions: {\\n      headers: {\\n        \'User-Agent\': \'aistudio-build\',\\n      },\\n    },\\n  });\\n}\\n\\nconst SAFETY_VOICE_TOOLS: FunctionDeclaration[] = [\\n  {\\n    name: \'open_sos\',\\n    description:\\n      \'Opens the dedicated SOS Emergency page, identifies the registered guardian, prepares emergency call and alert delivery with current location, and surfaces nearest police station contact options. Call immediately when the user says \\\"Open SOS\\\", \\\"SOS\\\", or asks for urgent help.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        initiateAlert: {\\n          type: Type.BOOLEAN,\\n          description:\\n            \'Whether to immediately initiate the emergency alert status workflow with available location.\',\\n        },\\n        callBothGuardianAndPolice: {\\n          type: Type.BOOLEAN,\\n          description:\\n            \'Set to true if the user wants to call both their guardian and police immediately.\',\\n        },\\n        reason: {\\n          type: Type.STRING,\\n          description: \'Short summary of why SOS was triggered.\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'call_guardian_and_police\',\\n    description:\\n      \'Opens the Dual Emergency Call panel to call BOTH the registered guardian AND police (100 / 112 / nearest AI-found police station number), while preparing an emergency location alert. Call this whenever the user asks to call both guardian and police, call police and guardian, or make emergency calls.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        guardianName: {\\n          type: Type.STRING,\\n          description: \'Optional specific guardian name if requested.\',\\n        },\\n        policeNumber: {\\n          type: Type.STRING,\\n          description:\\n            \'Optional police phone number (defaults to 100 or nearest verified police station number).\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'activate_threat_mode\',\\n    description:\\n      \'Navigates to the Threat Mode page, activates Intelligent Threat Mode protection (notifies guardians, captures location snapshot, enables audio/video evidence recording, connectivity monitoring, and automatically fetches nearby police station numbers using AI).\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        autoStartRecording: {\\n          type: Type.STRING,\\n          description: \'Optional recording preference: \\\"none\\\", \\\"audio\\\", or \\\"video\\\".\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'deactivate_threat_mode\',\\n    description:\\n      \'Deactivates an active Threat Mode session, stops emergency recording if active, and logs safe stand-down in Emergency History.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        note: {\\n          type: Type.STRING,\\n          description: \'Optional user status note.\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'call_guardian\',\\n    description:\\n      \'Prepares and opens the emergency guardian call action for the registered primary guardian or a specifically named guardian contact.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        guardianName: {\\n          type: Type.STRING,\\n          description: \'Optional name of a specific guardian contact to call.\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'call_police\',\\n    description:\\n      \'Prepares and opens immediate police emergency calling (100 / 112 and nearest AI-located police station number).\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        policeNumber: {\\n          type: Type.STRING,\\n          description: \'Police emergency number (default 100 or 112).\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'send_emergency_alert\',\\n    description:\\n      \'Dispatches an emergency alert containing the user available GPS location to all registered emergency contacts and updates emergency delivery status.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        message: {\\n          type: Type.STRING,\\n          description: \'Optional custom emergency note to include in the alert.\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'share_live_location\',\\n    description:\\n      \'Starts live location sharing with registered trusted guardian contacts and requests fresh GPS coordinates.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        durationMinutes: {\\n          type: Type.NUMBER,\\n          description: \'Optional sharing duration in minutes (default 30).\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'open_nearby_police\',\\n    description:\\n      \'Navigates directly to the Nearby Safe Places page filtered to Nearby Police Stations with live GPS centering.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        category: {\\n          type: Type.STRING,\\n          description: \'Either \\\"police\\\" or \\\"restrooms\\\". Defaults to \\\"police\\\".\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'trigger_fake_call\',\\n    description:\\n      \'Launches the simulated incoming Fake Call screen to help the user leave an uncomfortable situation smoothly.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        callerName: {\\n          type: Type.STRING,\\n          description: \'Optional simulated caller display name (e.g. Mom, Office).\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'start_safety_checkin\',\\n    description:\\n      \'Starts a timed Safety Check-In countdown on the Travel & Check-In page.\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        minutes: {\\n          type: Type.NUMBER,\\n          description: \'Minutes until check-in is due (default 10).\',\\n        },\\n      },\\n    },\\n  },\\n  {\\n    name: \'navigate_page\',\\n    description:\\n      \'Navigates to a specific dedicated page in OurSafe: \\\"home\\\", \\\"sos\\\", \\\"threat\\\", \\\"travel\\\", \\\"assistant\\\", \\\"nearby\\\", or \\\"history\\\".\',\\n    parameters: {\\n      type: Type.OBJECT,\\n      properties: {\\n        page: {\\n          type: Type.STRING,\\n          description:\\n            \'Target page identifier: home, sos, threat, travel, assistant, nearby, or history.\',\\n        },\\n      },\\n      required: [\'page\'],\\n    },\\n  },\\n];\\n\\nfunction buildSystemInstruction(userContext?: {\\n  userName?: string;\\n  primaryGuardianName?: string;\\n  primaryGuardianPhone?: string;\\n  threatActive?: boolean;\\n  sosActive?: boolean;\\n}): string {\\n  const userName = userContext?.userName || \'the user\';\\n  const guardian = userContext?.primaryGuardianName\\n    ? `${userContext.primaryGuardianName} (${userContext.primaryGuardianPhone || \'number on file\'})`\\n    : \'not yet configured\';\\n\\n  return `You are OurSafe Voice Controller, a calm, decisive, trustworthy AI safety assistant built into the OurSafe Women Safety Application.\\nYou are speaking with ${userName}. Their primary registered guardian is ${guardian}.\\nCurrent state: Threat Mode is ${userContext?.threatActive ? \'ACTIVE\' : \'inactive\'}, SOS is ${userContext?.sosActive ? \'ACTIVE\' : \'inactive\'}.\\n\\nCRITICAL ROLE:\\n- You are an APPLICATION CONTROLLER, not just a conversational chatbot.\\n- Whenever the user asks to perform an app action (\\\"Open SOS\\\", \\\"Call both guardian and police\\\", \\\"Call my guardian and police\\\", \\\"Call police\\\", \\\"Call my guardian\\\", \\\"Activate Threat Mode\\\", \\\"Deactivate Threat Mode\\\", \\\"Send emergency alert\\\", \\\"Share my live location\\\", \\\"Open nearby police stations\\\", \\\"Start a fake call\\\", \\\"Set a check-in\\\", etc.), you MUST immediately call the matching tool function first, then briefly confirm what happened in a calm, concise voice.\\n- When the user asks to call both guardian and police (or makes an urgent SOS call request), call call_guardian_and_police immediately so the dual emergency call controller opens for BOTH their guardian and police (100 / 112 / nearest station).\\n- For \\\"Open SOS\\\", call open_sos with initiateAlert: true and callBothGuardianAndPolice: true so the SOS screen opens with dual guardian + police call actions ready.\\n- Never invent fake phone numbers or street addresses. Keep spoken replies brief (1 to 3 short sentences), clear, and reassuring.`;\\n}\\n\\nfunction parseStationsFromGroundedText(\\n  text: string,\\n  mapLinks: Array<{ title: string; uri: string }>\\n): Array<{ name: string; phone?: string; address?: string; mapsUri?: string }> {\\n  const stations: Array<{\\n    name: string;\\n    phone?: string;\\n    address?: string;\\n    mapsUri?: string;\\n  }> = [];\\n\\n  const lines = text\\n    .split(\'\\\\n\')\\n    .map((l) => l.trim())\\n    .filter(Boolean);\\n\\n  const phoneRegex = /(\\\\+?\\\\d[\\\\d\\\\s\\\\-()]{6,17}\\\\d|\\\\b100\\\\b|\\\\b112\\\\b|\\\\b181\\\\b|\\\\b911\\\\b|\\\\b999\\\\b)/;\\n\\n  for (const line of lines) {\\n    if (!/^([-*\342\200\242]|\\\\d+[.)])/.test(line)) continue;\\n    const cleaned = line.replace(/^([-*\342\200\242]|\\\\d+[.)])\\\\s*/, \'\').replace(/\\\\*\\\\*/g, \'\');\\n    const phoneMatch = cleaned.match(phoneRegex);\\n    const segments = cleaned.split(/\\\\s*[\342\200\224\342\200\223|:]\\\\s*/);\\n    const candidateName = (segments[0] || cleaned).slice(0, 90).trim();\\n    if (!candidateName || candidateName.length < 3) continue;\\n\\n    const matchedMap = mapLinks.find(\\n      (m) =>\\n        m.title.toLowerCase().includes(candidateName.toLowerCase()) ||\\n        candidateName.toLowerCase().includes(m.title.toLowerCase())\\n    );\\n\\n    stations.push({\\n      name: candidateName,\\n      phone: phoneMatch ? phoneMatch[0].trim() : undefined,\\n      address:\\n        segments.length > 1\\n          ? segments\\n              .slice(1)\\n              .join(\' \302\267 \')\\n              .replace(phoneMatch ? phoneMatch[0] : \'\', \'\')\\n              .replace(/^[\\\\s\302\267,-]+|[\\\\s\302\267,-]+$/g, \'\')\\n              .slice(0, 140) || undefined\\n          : undefined,\\n      mapsUri: matchedMap?.uri,\\n    });\\n  }\\n\\n  // Ensure every Google Maps grounded police place appears even if bullet parsing missed it\\n  for (const link of mapLinks) {\\n    const already = stations.some(\\n      (s) =>\\n        s.mapsUri === link.uri ||\\n        s.name.toLowerCase() === link.title.toLowerCase()\\n    );\\n    if (!already && link.title) {\\n      stations.push({\\n        name: link.title,\\n        mapsUri: link.uri,\\n      });\\n    }\\n  }\\n\\n  return stations.slice(0, 8);\\n}\\n\\nasync function startServer() {\\n  const app = express();\\n  app.use(express.json({ limit: \'2mb\' }));\\n\\n  app.get(\'/api/health\', (_req, res) => {\\n    res.json({ ok: true, liveVoiceReady: Boolean(process.env.GEMINI_API_KEY) });\\n  });\\n\\n  // AI Nearby Police Stations & Verified Numbers (Threat Mode \342\200\224 Google Maps Grounding via gemini-4-hydrogen)\\n  app.post(\'/api/threat/nearby-police\', async (req, res) => {\\n    try {\\n      const { latitude, longitude, areaQuery } = req.body as {\\n        latitude?: number | null;\\n        longitude?: number | null;\\n        areaQuery?: string;\\n      };\\n\\n      const hasCoords =\\n        typeof latitude === \'number\' &&\\n        typeof longitude === \'number\' &&\\n        !Number.isNaN(latitude) &&\\n        !Number.isNaN(longitude);\\n\\n      const cleanArea =\\n        typeof areaQuery === \'string\' ? areaQuery.trim() : \'\';\\n\\n      if (!hasCoords && !cleanArea) {\\n        res.status(400).json({\\n          error:\\n            \'Provide GPS coordinates or enter a city/neighborhood name so AI can locate nearby police stations.\',\\n        });\\n        return;\\n      }\\n\\n      const ai = getAiClient();\\n      const prompt = hasCoords\\n        ? `Find the nearest police stations and women police help desks around latitude ${latitude}, longitude ${longitude}. List each station as a bullet point in the format: \\\"- Station Name | Public Phone Number (only if verified on Maps, otherwise write \'Call 100 / 112\') | Short street address\\\". Do NOT invent phone numbers. Also mention the local national emergency police number.`\\n        : `Find the main nearby police stations and women police stations in or near \\\"${cleanArea}\\\". List each station as a bullet point in the format: \\\"- Station Name | Public Phone Number (only if verified on Maps, otherwise write \'Call 100 / 112\') | Short street address\\\". Do NOT invent phone numbers. Also mention the local national emergency police number.`;\\n\\n      const config: {\\n        tools: Array<{ googleMaps: Record<string, never> }>;\\n        toolConfig?: {\\n          retrievalConfig: {\\n            latLng: { latitude: number; longitude: number };\\n          };\\n        };\\n      } = {\\n        tools: [{ googleMaps: {} }],\\n      };\\n\\n      if (hasCoords) {\\n        config.toolConfig = {\\n          retrievalConfig: {\\n            latLng: {\\n              latitude: latitude as number,\\n              longitude: longitude as number,\\n            },\\n          },\\n        };\\n      }\\n\\n      const response = await ai.models.generateContent({\\n        model: \'gemini-4-hydrogen\',\\n        contents: prompt,\\n        config,\\n      });\\n\\n      const summaryText = (response.text ?? \'\').trim();\\n      const rawChunks =\\n        response.candidates?.[0]?.groundingMetadata?.groundingChunks ?? [];\\n\\n      const mapLinks: Array<{ title: string; uri: string }> = [];\\n      for (const chunk of rawChunks) {\\n        const mapsObj = (chunk as { maps?: { uri?: string; title?: string } })\\n          .maps;\\n        if (mapsObj?.uri) {\\n          mapLinks.push({\\n            title: mapsObj.title || \'Police Station on Google Maps\',\\n            uri: mapsObj.uri,\\n          });\\n        }\\n      }\\n\\n      const stations = parseStationsFromGroundedText(summaryText, mapLinks);\\n\\n      res.json({\\n        summaryText,\\n        stations,\\n        mapLinks,\\n        queriedAt: new Date().toISOString(),\\n        locationLabel: hasCoords\\n          ? `GPS ${(latitude as number).toFixed(4)}, ${(longitude as number).toFixed(4)}`\\n          : cleanArea,\\n      });\\n    } catch (err) {\\n      const message =\\n        err instanceof Error\\n          ? err.message\\n          : \'Failed to look up nearby police stations.\';\\n      res.status(500).json({ error: message });\\n    }\\n  });\\n\\n  // REST AI App-Controller Endpoint (gemini-4-hydrogen + function calling) for typed commands & quick buttons\\n  app.post(\'/api/assistant/command\', async (req, res) => {\\n    try {\\n      const { text, userContext } = req.body as {\\n        text?: string;\\n        userContext?: {\\n          userName?: string;\\n          primaryGuardianName?: string;\\n          primaryGuardianPhone?: string;\\n          threatActive?: boolean;\\n          sosActive?: boolean;\\n        };\\n      };\\n\\n      if (!text || typeof text !== \'string\' || !text.trim()) {\\n        res.status(400).json({ error: \'Command text is required.\' });\\n        return;\\n      }\\n\\n      const ai = getAiClient();\\n      const response = await ai.models.generateContent({\\n        model: \'gemini-4-hydrogen\',\\n        contents: text.trim(),\\n        config: {\\n          systemInstruction: buildSystemInstruction(userContext),\\n          tools: [{ functionDeclarations: SAFETY_VOICE_TOOLS }],\\n        },\\n      });\\n\\n      const functionCalls = (response.functionCalls ?? []).map((fc) => ({\\n        id: fc.id ?? `fc-${Date.now()}`,\\n        name: fc.name ?? \'\',\\n        args: fc.args ?? {},\\n      }));\\n\\n      res.json({\\n        reply:\\n          response.text?.trim() ||\\n          (functionCalls.length > 0\\n            ? `Executing ${functionCalls.map((c) => c.name.replace(/_/g, \' \')).join(\', \')}.`\\n            : \'I am ready to help. Say or type commands like \\\"Call both guardian and police\\\", \\\"Open SOS\\\", or \\\"Activate Threat Mode\\\".\'),\\n        toolCalls: functionCalls,\\n      });\\n    } catch (err) {\\n      const message =\\n        err instanceof Error ? err.message : \'Failed to process AI command.\';\\n      res.status(500).json({ error: message });\\n    }\\n  });\\n\\n  const server = http.createServer(app);\\n\\n  // Real-Time Gemini 3.8 Live API WebSocket Bridge\\n  const wss = new WebSocketServer({ server, path: \'/api/live-voice\' });\\n\\n  wss.on(\'connection\', (clientWs: WebSocket) => {\\n    let liveSession: Awaited<ReturnType<GoogleGenAI[\'live\'][\'connect\']>> | null =\\n      null;\\n    let closed = false;\\n\\n    const sendJson = (payload: Record<string, unknown>) => {\\n      if (clientWs.readyState === WebSocket.OPEN) {\\n        clientWs.send(JSON.stringify(payload));\\n      }\\n    };\\n\\n    const connectLiveSession = async (userContext?: {\\n      userName?: string;\\n      primaryGuardianName?: string;\\n      primaryGuardianPhone?: string;\\n      threatActive?: boolean;\\n      sosActive?: boolean;\\n    }) => {\\n      try {\\n        const ai = getAiClient();\\n        liveSession = await ai.live.connect({\\n          model: \'gemini-3.8-live\',\\n          config: {\\n            responseModalities: [Modality.AUDIO],\\n            speechConfig: {\\n              voiceConfig: {\\n                prebuiltVoiceConfig: { voiceName: \'Kore\' },\\n              },\\n            },\\n            inputAudioTranscription: {},\\n            outputAudioTranscription: {},\\n            tools: [{ functionDeclarations: SAFETY_VOICE_TOOLS }],\\n            systemInstruction: buildSystemInstruction(userContext),\\n          },\\n          callbacks: {\\n            onopen: () => {\\n              if (!closed) {\\n                sendJson({ type: \'ready\' });\\n              }\\n            },\\n            onmessage: (message: LiveServerMessage) => {\\n              if (closed) return;\\n\\n              const content = message.serverContent;\\n              if (content?.inputTranscription?.text) {\\n                sendJson({\\n                  type: \'inputTranscript\',\\n                  text: content.inputTranscription.text,\\n                });\\n              }\\n              if (content?.outputTranscription?.text) {\\n                sendJson({\\n                  type: \'outputTranscript\',\\n                  text: content.outputTranscription.text,\\n                });\\n              }\\n\\n              for (const part of content?.modelTurn?.parts ?? []) {\\n                if (part.inlineData?.data) {\\n                  sendJson({\\n                    type: \'audio\',\\n                    data: part.inlineData.data,\\n                  });\\n                }\\n              }\\n\\n              if (content?.interrupted) {\\n                sendJson({ type: \'interrupted\' });\\n              }\\n\\n              if (content?.turnComplete) {\\n                sendJson({ type: \'turnComplete\' });\\n              }\\n\\n              const calls = message.toolCall?.functionCalls;\\n              if (calls && calls.length > 0) {\\n                sendJson({\\n                  type: \'toolCall\',\\n                  calls: calls.map((c) => ({\\n                    id: c.id ?? `live-tc-${Date.now()}`,\\n                    name: c.name ?? \'\',\\n                    args: c.args ?? {},\\n                  })),\\n                });\\n              }\\n            },\\n            onerror: (err: unknown) => {\\n              const msg =\\n                err instanceof Error\\n                  ? err.message\\n                  : \'Gemini Live session encountered an error.\';\\n              sendJson({ type: \'error\', message: msg });\\n            },\\n            onclose: () => {\\n              if (!closed) {\\n                sendJson({ type: \'closed\' });\\n              }\\n            },\\n          },\\n        });\\n      } catch (err) {\\n        const message =\\n          err instanceof Error\\n            ? err.message\\n            : \'Unable to connect to Gemini Live API.\';\\n        sendJson({ type: \'error\', message });\\n      }\\n    };\\n\\n    clientWs.on(\'message\', async (raw) => {\\n      try {\\n        const msg = JSON.parse(raw.toString()) as {\\n          type?: string;\\n          audio?: string;\\n          text?: string;\\n          userContext?: {\\n            userName?: string;\\n            primaryGuardianName?: string;\\n            primaryGuardianPhone?: string;\\n            threatActive?: boolean;\\n            sosActive?: boolean;\\n          };\\n          responses?: Array<{\\n            id: string;\\n            name: string;\\n            response: Record<string, unknown>;\\n          }>;\\n        };\\n\\n        if (msg.type === \'init\') {\\n          if (!liveSession) {\\n            await connectLiveSession(msg.userContext);\\n          }\\n          return;\\n        }\\n\\n        if (!liveSession) return;\\n\\n        if (msg.type === \'audio\' && msg.audio) {\\n          liveSession.sendRealtimeInput({\\n            audio: { data: msg.audio, mimeType: \'audio/pcm;rate=16000\' },\\n          });\\n        } else if (msg.type === \'text\' && msg.text) {\\n          liveSession.sendRealtimeInput({ text: msg.text });\\n        } else if (msg.type === \'toolResponse\' && Array.isArray(msg.responses)) {\\n          liveSession.sendToolResponse({\\n            functionResponses: msg.responses,\\n          });\\n        }\\n      } catch (err) {\\n        const message =\\n          err instanceof Error ? err.message : \'Invalid Live Voice message.\';\\n        sendJson({ type: \'error\', message });\\n      }\\n    });\\n\\n    clientWs.on(\'close\', () => {\\n      closed = true;\\n      if (liveSession) {\\n        try {\\n          liveSession.close();\\n        } catch {\\n          // ignore close errors\\n        }\\n        liveSession = null;\\n      }\\n    });\\n  });\\n\\n  if (process.env.NODE_ENV !== \'production\') {\\n    const { createServer: createViteServer } = await import(\'vite\');\\n    const vite = await createViteServer({\\n      server: { middlewareMode: true },\\n      appType: \'spa\',\\n    });\\n    app.use(vite.middlewares);\\n  } else {\\n    const distPath = path.resolve(__dirname, \'dist\');\\n    app.use(express.static(distPath));\\n    app.get(\'*\', (_req, res) => {\\n      res.sendFile(path.join(distPath, \'index.html\'));\\n    });\\n  }\\n\\n  server.listen(PORT, \'0.0.0.0\', () => {\\n    console.log(`OurSafe server running on http://0.0.0.0:${PORT}`);\\n  });\\n}\\n\\nstartServer();\\n\", \"Description\":\"Update server.ts to OurSafe branding, add call_guardian_and_police + call_police voice tools, and add POST /api/threat/nearby-police endpoint using Gemini Maps Grounding\", \"Overwrite\":true, \"TargetFile\":\"/server.ts\", \"toolAction\":\"Upgrading server with AI police lookup and dual-call tools\", \"toolSummary\":\"Upgrade server.ts\"}"
      original_name: "write_to_file"
    }
