      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Default quickTriggerCountdownSec to 0 for immediate automated SOS dispatch on Red Rose / Shake / Screen Tap\", \"EndLine\":40, \"Instruction\":\"Set quickTriggerCountdownSec default to 0 for immediate automated emergency calling and message dispatch\", \"ReplacementContent\":\"  autoDialOnTrigger: true,\\n  quickTriggerCountdownSec: 0,\\n  quickDialGuardianOnVoiceSos: true,\\n};\", \"StartLine\":34, \"TargetContent\":\"  autoDialOnTrigger: true,\\n  quickTriggerCountdownSec: 3,\\n  quickDialGuardianOnVoiceSos: true,\\n};\", \"TargetFile\":\"/src/utils/storage.ts\", \"toolAction\":\"Setting immediate automated SOS trigger default\", \"toolSummary\":\"Update DEFAULT_PREFERENCES in storage.ts\"}"
