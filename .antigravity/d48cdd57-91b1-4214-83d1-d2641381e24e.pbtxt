    tool_calls {
      id: "call_8807906586179817072"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Finish cleaning storage.ts references from SAMPLE_REVIEWS to INITIAL_REVIEWS and remove prototype wording\", \"Instruction\":\"Update resetPasswordByIdentifier error and getReviews references in storage.ts\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":232, \"ReplacementContent\":\"  if (!target) {\\n    return {\\n      ok: false,\\n      error: \'No account matches that phone number, name, or email.\',\\n    };\\n  }\", \"StartLine\":220, \"TargetContent\":\"  if (!target) {\\n    return {\\n      ok: false,\\n      error: \'No local prototype account matches that phone number, name, or email.\',\\n    };\\n  }\"}, {\"AllowMultiple\":false, \"EndLine\":396, \"ReplacementContent\":\"export function getReviews(): UserReviewItem[] {\\n  try {\\n    const raw = localStorage.getItem(REVIEWS_KEY);\\n    if (!raw) {\\n      localStorage.setItem(REVIEWS_KEY, JSON.stringify(INITIAL_REVIEWS));\\n      return INITIAL_REVIEWS;\\n    }\\n    const parsed = JSON.parse(raw);\\n    if (!Array.isArray(parsed) || parsed.length === 0) {\\n      return INITIAL_REVIEWS;\\n    }\\n    return (parsed as UserReviewItem[]).map((item) => ({\\n      ...item,\\n      role: item.role.replace(/\\\\s*\\\\(Sample Prototype Review\\\\)/gi, \'\'),\\n      isSample: false,\\n    }));\\n  } catch {\\n    return INITIAL_REVIEWS;\\n  }\\n}\\n\\nexport function saveReviews(reviews: UserReviewItem[]): void {\\n  localStorage.setItem(REVIEWS_KEY, JSON.stringify(reviews));\\n}\\n\\nexport function getTeamInfo(): TeamInfoConfig {\\n  try {\\n    const raw = localStorage.getItem(TEAM_KEY);\\n    if (!raw) return DEFAULT_TEAM_INFO;\\n    const parsed = JSON.parse(raw) as Partial<TeamInfoConfig>;\\n    if (\\n      parsed.founderName?.includes(\'Click Edit to Customize\') ||\\n      parsed.founderIntro?.includes(\'Placeholder founder bio\')\\n    ) {\\n      localStorage.setItem(TEAM_KEY, JSON.stringify(DEFAULT_TEAM_INFO));\\n      return DEFAULT_TEAM_INFO;\\n    }\\n    return { ...DEFAULT_TEAM_INFO, ...parsed };\\n  } catch {\\n    return DEFAULT_TEAM_INFO;\\n  }\\n}\", \"StartLine\":367, \"TargetContent\":\"export function getReviews(): UserReviewItem[] {\\n  try {\\n    const raw = localStorage.getItem(REVIEWS_KEY);\\n    if (!raw) {\\n      localStorage.setItem(REVIEWS_KEY, JSON.stringify(SAMPLE_REVIEWS));\\n      return SAMPLE_REVIEWS;\\n    }\\n    const parsed = JSON.parse(raw);\\n    return Array.isArray(parsed) && parsed.length > 0\\n      ? (parsed as UserReviewItem[])\\n      : SAMPLE_REVIEWS;\\n  } catch {\\n    return SAMPLE_REVIEWS;\\n  }\\n}\\n\\nexport function saveReviews(reviews: UserReviewItem[]): void {\\n  localStorage.setItem(REVIEWS_KEY, JSON.stringify(reviews));\\n}\\n\\nexport function getTeamInfo(): TeamInfoConfig {\\n  try {\\n    const raw = localStorage.getItem(TEAM_KEY);\\n    if (!raw) return DEFAULT_TEAM_INFO;\\n    return { ...DEFAULT_TEAM_INFO, ...(JSON.parse(raw) as Partial<TeamInfoConfig>) };\\n  } catch {\\n    return DEFAULT_TEAM_INFO;\\n  }\\n}\"}], \"TargetFile\":\"/src/utils/storage.ts\", \"toolAction\":\"Cleaning up storage.ts review and team loaders\", \"toolSummary\":\"Clean storage.ts loaders\"}"
      original_name: "multi_replace_file_content"
    }
