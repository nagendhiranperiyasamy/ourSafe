# ==========================================
# OurSafe Women's Safety Companion Environment
# ==========================================

# GEMINI_API_KEY: Required for Gemini AI API calls (Voice Assistant, Maps Grounding, Vehicle Plate OCR).
# AI Studio automatically injects this at runtime or configure via Secrets panel.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://oursafe-app.web.app or http://localhost:3000)
APP_URL="http://localhost:3000"

# VITE_GOOGLE_MAPS_API_KEY: Scoped browser API key for Google Maps Platform (Maps JS & Routes API).
VITE_GOOGLE_MAPS_API_KEY=""

# ==========================================
# FIREBASE CLOUD BACKEND (Spark Free Plan)
# ==========================================
# Get these from Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKey"
VITE_FIREBASE_AUTH_DOMAIN="oursafe-women-safety.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="oursafe-women-safety"
VITE_FIREBASE_STORAGE_BUCKET="oursafe-women-safety.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
