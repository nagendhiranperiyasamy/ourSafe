    android:exported="true" />
-->

<!-- Background Lock-Screen & Home-Screen Shield Foreground Service -->
<service
    android:name="app.oursafe.safety.shield.OurSafeBackgroundShieldService"
    android:enabled="true"
    android:exported="false"
    android:foregroundServiceType="microphone|location" />

<!-- System-Wide Double/Triple Tap Detector for Phone Main Lock Screen & Home Screen -->
<service
    android:name="app.oursafe.safety.shield.OurSafeTapAccessibilityService"
    android:label="OurSafe Lock &amp; Home Screen Tap SOS"
    android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
    android:exported="false">
    <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
    </intent-filter>
</service>

<!-- Native Android Home Screen SOS Widget -->
<receiver
    android:name="app.oursafe.safety.shield.OurSafeHomeWidgetProvider"
    android:exported="false">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
    </intent-filter>
</receiver>
